# HPL-MxP 3x4 allocation-resweep on pristine nodes — resource-alloc
# experiment 3 "affinity-resweep-clean-node" (see resource-alloc/README.md).
#
# Redoes experiment 1's allocation-variance series (identical requests,
# fresh scheduler carve-outs per attempt, no binding flags) with the
# co-tenant variable removed: every attempt is host-pinned to pristine
# nodes chosen from a live `pbsnodes -aSj` check. Motivation: experiment 2
# proved co-tenant host contention dominates the 3x4 degradation, so
# experiment 1's mismatch/variance data was confounded; experiment 2 also
# showed PBS's carve-out on pristine nodes is deterministic (identical
# GPU subset + cpuset on every attempt), so this series measures the
# clean-node run-to-run noise band, confirms determinism on the fixed
# trio, and samples cross-node default-carve-out contrast on rotated
# attempts when other pristine nodes are available.
#
# Attempts: v1-v3 on the fixed pristine trio; v4-v5 opportunistically
# rotated onto other pristine (or nearly-pristine, documented) nodes.
# Instrumentation identical to experiment 2: pre/post per-node capture v2,
# in-run 10 s per-node host-load sampler, UCX_LOG_LEVEL=info and
# NCCL_DEBUG=INFO forwarded into the container, --monitor-gpu telemetry.
#
# Expected working directory: the resource-alloc directory on GAAS. Submit
# each attempt (from that directory) with — hosts from a live pbsnodes
# check, REQ_HOSTS plus-separated because PBS -v splits on commas. Each
# chunk mirrors experiments 1-2's actual request shape (ncpus=48,
# mem=1000GB per chunk; omitting them triggers the server-default cgroup
# memory limit — see the clean250k_v1 failure record):
#   qsub -l "select=host=A:ngpus=4:ncpus=48:mem=1000GB+host=B:ngpus=4:ncpus=48:mem=1000GB+host=C:ngpus=4:ncpus=48:mem=1000GB" \
#        -v "ATTEMPT=cleanalloc250k_v1,REQ_HOSTS=A+B+C" \
#        -o outputs/cleanalloc250k_v1.o -e outputs/cleanalloc250k_v1.e \
#        debug-scripts/run_3x4_alloc_resweep_clean.pbs

#PBS -N hpl_mxp_alloc_rs
#PBS -q gpu_as
#PBS -P hpc_admin
#PBS -l place=scatter
#PBS -l walltime=00:30:00

set -euo pipefail
cd "$PBS_O_WORKDIR"
mkdir -p "$PWD/outputs"

: "${ATTEMPT:?submit with -v ATTEMPT=<attempt label, e.g. cleanalloc250k_v1>}"
: "${REQ_HOSTS:?submit with -v REQ_HOSTS=<host1+host2+host3>}"

GPUS=4                                   # GPUs (and ranks) per node
NPROW=3
NPCOL=4
NPORDER=row
N=250000
NB=1024

UCX_LOG_LEVEL=info
NCCL_DEBUG=INFO
export UCX_LOG_LEVEL NCCL_DEBUG

REPO_ROOT="$(cd "$PBS_O_WORKDIR/../../.." && pwd)"
BRIDGE="$REPO_ROOT/multi-node-test/rsh_pbsdsh_container.sh"
SIF="/home/pham0094/hpl_hpcg_hplmxp_container/hpc-benchmarks_26.02.sif"
CAPTURE="$PBS_O_WORKDIR/debug-scripts/capture_node_alloc_v2.sh"
SAMPLER="$PBS_O_WORKDIR/debug-scripts/sample_node_load.sh"

PREFIX="$PWD/outputs/${ATTEMPT}"
LOCK_PRE="$PWD/outputs/.locks_precap_${ATTEMPT}"
LOCK_POST="$PWD/outputs/.locks_postcap_${ATTEMPT}"
LOCK_SAMP="$PWD/outputs/.locks_sampler_${ATTEMPT}"
STOP_FILE="$PWD/outputs/.sampler_stop_${ATTEMPT}"
SAMPLER_INTERVAL=10
SAMPLER_MAX_TICKS=170                    # 170 x 10 s = ~28.3 min < 30 min walltime

module purge
module load apptainer/1.4.1 nvhpc/26.3 squashfuse/0.5.2 gocryptfs/2.5.0
chmod +x "$BRIDGE"

NNODES=$(sort -u "$PBS_NODEFILE" | wc -l)
NPROCS=$((NNODES * GPUS))
if [ "$((NPROW * NPCOL))" -ne "$NPROCS" ]; then
  echo "ERROR: grid ${NPROW}x${NPCOL}=$((NPROW * NPCOL)) != ${NPROCS} ranks" >&2
  exit 1
fi

# Host-pinning assertion: the scheduler must have granted exactly the
# requested nodes (a host= chunk cannot be placed elsewhere; a mismatch
# means the submission and the request disagree — abort before running).
REQUESTED=$(printf '%s\n' "$REQ_HOSTS" | tr ',+' '\n\n' | sed 's/[[:space:]]//g' | grep -v '^$' | sort | paste -sd,)
GRANTED=$(sort -u "$PBS_NODEFILE" | paste -sd,)
if [ "$REQUESTED" != "$GRANTED" ]; then
  echo "ERROR: granted nodes (${GRANTED}) != requested (${REQUESTED})" >&2
  exit 1
fi

GPU_AFFINITY=$(seq -s: 0 $((GPUS - 1)))

# De-duplicated hostfile with explicit per-node slot count.
awk -v g="$GPUS" '{ sub(/\r$/,""); if (!seen[$0]++) print $0 " slots=" g }' \
  "$PBS_NODEFILE" > "$PWD/hostfile"

echo "experiment_id=resource-alloc-exp3"
echo "attempt=${ATTEMPT}"
echo "pbs_job_id=${PBS_JOBID:-unknown}"
date --iso-8601=seconds
echo "layout=${NNODES} nodes x ${GPUS} GPUs = ${NPROCS} ranks"
echo "grid=nprow=${NPROW} npcol=${NPCOL} order=${NPORDER}"
echo "n=${N} nb=${NB}"
echo "nodes=${GRANTED}"
echo "req_hosts=${REQ_HOSTS}"
echo "gpu_affinity=${GPU_AFFINITY}"
echo "ucx_log_level=${UCX_LOG_LEVEL}"
echo "nccl_debug=${NCCL_DEBUG}"
echo "=== PBS_NODEFILE (raw) ==="
cat "$PBS_NODEFILE"
echo "=== hostfile ==="
cat "$PWD/hostfile"

# Fresh per-attempt lock bases and sentinel for this attempt only.
rm -rf "$LOCK_PRE" "$LOCK_POST" "$LOCK_SAMP"
rm -f "$STOP_FILE"
mkdir -p "$LOCK_PRE" "$LOCK_POST" "$LOCK_SAMP"

# Per-node pre-run capture: best-effort instrumentation, must not block.
echo "=== pre-run per-node capture (pbsdsh, once per node) ==="
/opt/pbs/bin/pbsdsh -- /bin/bash "$CAPTURE" "$PREFIX" "$LOCK_PRE" pre \
  || echo "WARN: pre-run capture returned nonzero; continuing"

# In-run per-node sampler in the background; stopped via sentinel after the
# application finishes (bounded wait), with the tick cap as failsafe.
echo "=== start in-run per-node sampler (background, ${SAMPLER_INTERVAL} s interval) ==="
/opt/pbs/bin/pbsdsh -- /bin/bash "$SAMPLER" "$PREFIX" "$LOCK_SAMP" \
  "$SAMPLER_INTERVAL" "$STOP_FILE" "$SAMPLER_MAX_TICKS" &
SAMPLER_PID=$!

# Application launch: identical to experiments 1-2.
set +e
apptainer exec --nv \
  -B /opt/pbs:/opt/pbs \
  -B /var/spool/pbs:/var/spool/pbs \
  -B "$REPO_ROOT":"$REPO_ROOT" \
  "$SIF" \
  /usr/local/mpi/bin/mpirun -np "$NPROCS" \
    --hostfile "$PWD/hostfile" \
    --mca plm_rsh_agent "$BRIDGE" \
    --mca plm_rsh_no_tree_spawn 1 \
    --mca plm_rsh_num_concurrent 1 \
    --mca routed direct \
    -x PATH -x LD_LIBRARY_PATH \
    -x UCX_LOG_LEVEL \
    -x NCCL_DEBUG \
    --bind-to none \
    /workspace/hpl-mxp.sh \
      --gpu-affinity "$GPU_AFFINITY" \
      --nprow "$NPROW" \
      --npcol "$NPCOL" \
      --nporder "$NPORDER" \
      --n "$N" \
      --nb "$NB" \
      --skip-tests 1 \
      --monitor-gpu 1 \
      --monitor-gpu-interval 10 \
      --monitor-gpu-pcie-width-warning 16 \
      --monitor-gpu-pcie-gen-warning 5
APPRC=$?
set -e

# Stop the sampler: sentinel file, then bounded wait for the pbsdsh client
# (samplers poll the sentinel each tick, so they exit within one interval).
echo "=== stop in-run sampler ==="
touch "$STOP_FILE"
for _ in $(seq 1 12); do
  kill -0 "$SAMPLER_PID" 2>/dev/null || break
  sleep 5
done
kill "$SAMPLER_PID" 2>/dev/null || true
wait "$SAMPLER_PID" 2>/dev/null || true

# Per-node post-run capture (separate lock base so it always runs).
echo "=== post-run per-node capture (pbsdsh, once per node) ==="
/opt/pbs/bin/pbsdsh -- /bin/bash "$CAPTURE" "$PREFIX" "$LOCK_POST" post \
  || echo "WARN: post-run capture returned nonzero; continuing"

echo "app_exit_code=${APPRC}"
echo "=== attempt evidence files ==="
ls -la "$PWD/outputs/${ATTEMPT}"* 2>/dev/null || true
echo "=== resource-alloc exp3 attempt ${ATTEMPT} complete ==="
exit "$APPRC"
