#!/bin/bash
# Phase 2 Stage 2 container NCCL GDR A/B at 3x4 WITH HCA filter (pre-authorized
# contingency for the case 2026-09-17-A analog): the v1 default-GDR ctrl
# allreduce aborted on the bond-rail misalignment signature (mixed RoCE/IB
# link warnings from ib_plugin.c + connection closed, rc=3) on the
# g22+g20+g03 mix. Identical to run_phase2_stage2_nccl_3x4.pbs except
# NCCL_IB_HCA restricts NET device selection to the eight InfiniBand HCAs,
# excluding the RoCE bond (mlx5_bond_0) — the fix validated on host in job
# 67584.gaas (step2_gdr_coll_3x4_v2). The filter applies to BOTH arms so the
# A/B stays device-symmetric. Full test set rerun (sendrecv, broadcast root
# 0, all_reduce at 12 ranks) so the 3x4 cell set carries one consistent
# condition. Submit from debug-scripts/phase2-stage2/ with host-pinned
# select chunks, attempt-specific PBS output names, and the node-hunting
# procedure documented in README.md.

#PBS -N P2S2_NCCL_3X4_HCA
#PBS -P hpc_ebslee
#PBS -q gpu_ded
#PBS -l place=scatter
#PBS -l walltime=00:45:00

set -euo pipefail
cd "$PBS_O_WORKDIR"
export TOPOLOGY=3x4 EXPECTED_NNODES=3 RANKS_PER_NODE=4
export TESTS="sendrecv broadcast allreduce" ARMS="ctrl gdroff" RESULT_TAG=PHASE2_STAGE2_NCCL
export NCCL_IB_HCA=mlx5_0,mlx5_1,mlx5_2,mlx5_3,mlx5_4,mlx5_5,mlx5_8,mlx5_9
exec /bin/bash "$PBS_O_WORKDIR/run_phase2_stage2_nccl_common.sh"
