#!/bin/bash
# Phase 2 Stage 1 completion (option (a)): scaling smoke for the staged host
# OSU-CUDA binaries + container-native NCCL tooling, across 1x2 / 2x1 / 3x1 /
# 3x4. Smoke scope: launch/tooling/ABI validation only — no A/B arms, no
# transport gates; numbers are recorded for review, not judged.
#
# Per rung (one job, submitted one at a time, any available gpu_as/gpu_ded
# nodes — no pristine hunting per user direction 2026-09-18):
#   0. (first job only) stage the host osu-micro-benchmarks-cuda copy into
#      ../../osu-cuda-host/ (guarded rsync; provenance recorded). The stage
#      lives under /home, which apptainer binds into every container instance
#      by default — including the bridge-spawned remote orted containers,
#      which ignore custom -B flags. Per-rank visibility is verified as
#      evidence; fallback if it fails: export APPTAINER_BINDPATH.
#   1. In-container ABI validation of the staged osu_bw (mother node): the
#      staged binaries' host RPATH ($ORIGIN/../../lib) does not exist at the
#      stage location, so libmpi resolves to the container's /opt/hpcx stack
#      (same HPC-X 2.25.1 OMPI 4.1.9a1 family). The run wrapper prepends
#      /opt/hpcx/ompi/lib:/opt/hpcx/ucx/lib to LD_LIBRARY_PATH (scoped to the
#      osu processes) to make this deterministic.
#   2. Per-rank mapping + staged-binary visibility (full rank count).
#   3. osu_bw D D + H H and osu_latency D D (np=2; inter-node pair via the
#      slots=1 hostfile on multi-node rungs; intra-node pair at 1x2).
#   4. osu_allreduce -d cuda + H H at the full rank count (12 ranks at 3x4).
#   5. One tiny container-native NCCL all_reduce_perf (1 MiB, w1 n2,
#      NCCL_DEBUG=INFO) at the full rank count.
#
# PASS per rung: ABI clean + mapping OK + visibility YES + every test rc=0
# with the expected output shape (osu table rows / NCCL zero-error marker).
#
# Expected working directory: debug-scripts/phase2-preflight/ on GAAS.
# Inputs: ATTEMPT, REQ_HOSTS, TOPO via qsub -v.
# Outputs: PBS .o/.e (attempt-named) + per-test logs, hostfiles, ABI log,
#          snapshots under ../../outputs/phase2-preflight/.

#PBS -N P2_OSU_SMOKE
#PBS -P hpc_ebslee
#PBS -q gpu_ded
#PBS -l place=scatter
#PBS -l walltime=00:20:00

set -uo pipefail

cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"
: "${PBS_JOBID:?}"
: "${PBS_NODEFILE:?}"
: "${ATTEMPT:?submit with -v ATTEMPT=<unique attempt label>}"
: "${REQ_HOSTS:?submit with -v REQ_HOSTS=<host1[+host2][+host3]>}"
: "${TOPO:?submit with -v TOPO=1x2|2x1|3x1|3x4}"

case "$TOPO" in
  1x2) EXPECTED_NNODES=1; RANKS_PER_NODE=2 ;;
  2x1) EXPECTED_NNODES=2; RANKS_PER_NODE=1 ;;
  3x1) EXPECTED_NNODES=3; RANKS_PER_NODE=1 ;;
  3x4) EXPECTED_NNODES=3; RANKS_PER_NODE=4 ;;
  *) echo "FATAL: unknown TOPO=$TOPO" >&2; exit 1 ;;
esac
TOTAL_RANKS=$((EXPECTED_NNODES * RANKS_PER_NODE))

OUTDIR="$(cd "$PBS_O_WORKDIR/../.." && pwd)/outputs/phase2-preflight"
mkdir -p "$OUTDIR"
DEBUG_DIR="$(cd "$PBS_O_WORKDIR/../.." && pwd)"
OSU_HOME="$DEBUG_DIR/osu-cuda-host"
STAGE="$OSU_HOME/osu-micro-benchmarks-cuda"
REPO_ROOT="$(cd "$PBS_O_WORKDIR/../../../.." && pwd)"
BRIDGE="$REPO_ROOT/multi-node-test/rsh_pbsdsh_container.sh"
SNAPSHOT="$PBS_O_WORKDIR/../phase1-step1/collb2_node_snapshot.sh"
SIF="/home/pham0094/hpl_hpcg_hplmxp_container/hpc-benchmarks_26.02.sif"
HOST_OSU_SRC="/usr/local/nvhpc/Linux_x86_64/26.3/comm_libs/13.1/hpcx/hpcx-2.25.1/ompi/tests/osu-micro-benchmarks-cuda"
NCCL_TESTS_DIR="/workspace/microbenchmarks/nccl_tests"
export STAGE

module purge || true
module load apptainer/1.4.1 nvhpc/26.3 squashfuse/0.5.2 gocryptfs/2.5.0 \
  || { echo "FATAL: cannot load the validated module set" >&2; exit 1; }

for tool in apptainer timeout sort paste sed grep awk cat date chmod rsync sha256sum; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "FATAL: required tool '$tool' not found" >&2; exit 1;
  }
done
[ -x /opt/pbs/bin/pbsdsh ] || { echo "FATAL: /opt/pbs/bin/pbsdsh not executable" >&2; exit 1; }
[ -r "$PBS_NODEFILE" ] || { echo "FATAL: PBS_NODEFILE unreadable" >&2; exit 1; }
[ -f "$BRIDGE" ] || { echo "FATAL: container bridge missing: $BRIDGE" >&2; exit 1; }
chmod +x "$BRIDGE"
[ -f "$SNAPSHOT" ] || { echo "FATAL: snapshot helper missing: $SNAPSHOT" >&2; exit 1; }
[ -f "$SIF" ] || { echo "FATAL: SIF not found: $SIF" >&2; exit 1; }
[ -d "$HOST_OSU_SRC" ] && [ -x "$HOST_OSU_SRC/osu_bw" ] || {
  echo "FATAL: host OSU-CUDA source missing: $HOST_OSU_SRC" >&2; exit 1;
}

normalize_list() {
  printf '%s\n' "$1" | tr ',+' '\n\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' \
    | grep -v '^$' | sort -u | paste -sd+
}

NNODES="$(awk '{gsub(/\r/, ""); sub(/^[ \t]+/, ""); sub(/[ \t]+$/, ""); if ($0 != "" && !seen[$0]++) n++} END {print n+0}' "$PBS_NODEFILE")"
REQ_HOST_COUNT="$(printf '%s\n' "$REQ_HOSTS" | awk -F'[+,]' '{print NF}')"
REQUESTED_HOSTS="$(normalize_list "$REQ_HOSTS")"
GRANTED_HOSTS="$(awk '{gsub(/\r/, ""); sub(/^[ \t]+/, ""); sub(/[ \t]+$/, ""); if ($0 != "") print $0}' "$PBS_NODEFILE" | sort -u | paste -sd+)"

echo "=== Phase 2 OSU-mount smoke metadata ==="
echo "attempt=$ATTEMPT"
echo "topology=$TOPO (nodes=$EXPECTED_NNODES ranks_per_node=$RANKS_PER_NODE total_ranks=$TOTAL_RANKS)"
echo "pbs_job_id=$PBS_JOBID"
date --iso-8601=seconds
echo "requested_hosts=$REQUESTED_HOSTS"
echo "granted_hosts=$GRANTED_HOSTS"
echo "host_osu_src=$HOST_OSU_SRC"
echo "stage=$STAGE"
echo "scope=smoke (launch/tooling/ABI validation; no A/B arms, no numeric gates)"

if [ "$NNODES" -ne "$EXPECTED_NNODES" ] || [ "$REQ_HOST_COUNT" -ne "$EXPECTED_NNODES" ] || [ "$REQUESTED_HOSTS" != "$GRANTED_HOSTS" ]; then
  echo "FATAL: expected exactly the requested hosts; nodes=$NNODES requested=[$REQUESTED_HOSTS] granted=[$GRANTED_HOSTS]" >&2
  exit 1
fi

node_snapshot() {
  local tag="$1"
  local lockbase="$OUTDIR/.locks_${ATTEMPT}_${PBS_JOBID}_${tag}"
  echo "=== clean-node checkpoint: $tag (pbsdsh, once per node) ==="
  /opt/pbs/bin/pbsdsh -- /bin/bash "$SNAPSHOT" "$OUTDIR" "$ATTEMPT" "$tag" "$lockbase" \
    || echo "WARN: clean-node checkpoint $tag failed; preserving smoke execution"
}

node_snapshot pre

echo
echo "============================================================"
echo "SECTION 0: OSU STAGING (host copy, guarded, once)"
echo "============================================================"
if [ ! -x "$STAGE/osu_bw" ]; then
  echo "staged tree absent — copying from $HOST_OSU_SRC"
  mkdir -p "$OSU_HOME"
  rsync -a "$HOST_OSU_SRC" "$OSU_HOME/" \
    || { echo "FATAL: rsync of host OSU-CUDA tree failed" >&2; exit 1; }
  echo "staging_done=yes"
else
  echo "staged tree already present — reusing"
fi
[ -x "$STAGE/osu_bw" ] && [ -x "$STAGE/osu_latency" ] && [ -x "$STAGE/osu_allreduce" ] || {
  echo "FATAL: staged OSU tree incomplete at $STAGE" >&2; exit 1;
}
echo "--- staging provenance ---"
echo "source=$HOST_OSU_SRC"
echo "file_count=$(find "$STAGE" -type f | wc -l)"
du -sh "$STAGE"
stat -c "osu_bw size=%s mtime=%y" "$STAGE/osu_bw"
echo "host_sha256_osu_bw=$(sha256sum "$STAGE/osu_bw" | cut -d' ' -f1)"
ls "$STAGE" | grep -E "^osu_(bw|latency|allreduce|bcast|hello)$" || true

echo
echo "============================================================"
echo "SECTION 1: IN-CONTAINER ABI VALIDATION (mother node)"
echo "============================================================"
ABI_LOG="$OUTDIR/${ATTEMPT}_osu_abi.log"
apptainer exec --nv "$SIF" bash -c '
  echo "--- staged osu_bw (container view) ---"
  ls -la "$STAGE/osu_bw" || { echo "STAGED_BINARY_NOT_VISIBLE"; exit 0; }
  echo "container_sha256_osu_bw=$(sha256sum "$STAGE/osu_bw" | cut -d" " -f1)"
  echo "--- ldd staged osu_bw (container default resolution) ---"
  ldd "$STAGE/osu_bw" 2>&1 | grep -iE "mpi|cuda|not found" || echo "(no mpi/cuda lines)"
  echo "--- ldd with container hpcx libdir prepended (run configuration) ---"
  LD_LIBRARY_PATH="/opt/hpcx/ompi/lib:/opt/hpcx/ucx/lib:$LD_LIBRARY_PATH" \
    ldd "$STAGE/osu_bw" 2>&1 | grep -iE "libmpi|libopen|cuda|not found" || echo "(no lib lines)"
' 2>&1 | tee "$ABI_LOG"
echo "abi_exec_rc=${PIPESTATUS[0]}"

STAGED_VISIBLE=0
grep -q "STAGED_BINARY_NOT_VISIBLE" "$ABI_LOG" || STAGED_VISIBLE=1
# Gate on the run-configuration ldd (with the container hpcx libdir prepend);
# the plain-resolution ldd above it is informational only.
ABI_RUN_BLOCK="$(sed -n '/ldd with container hpcx libdir prepended/,$p' "$ABI_LOG")"
ABI_CLEAN=0
if printf "%s\n" "$ABI_RUN_BLOCK" | grep -q 'libmpi.so.40 => /opt/hpcx' \
   && ! printf "%s\n" "$ABI_RUN_BLOCK" | grep -qi "not found"; then
  ABI_CLEAN=1
fi
echo "staged_binary_visible_in_container=$STAGED_VISIBLE"
echo "abi_clean=$ABI_CLEAN (libmpi resolves to container /opt/hpcx; no missing libs)"
[ "$STAGED_VISIBLE" -eq 1 ] || { echo "FATAL: staged binary not visible in container (default /home bind assumption failed)" >&2; exit 1; }
[ "$ABI_CLEAN" -eq 1 ] || { echo "FATAL: staged osu_bw does not resolve cleanly against the container stack" >&2; exit 1; }

echo
echo "============================================================"
echo "SECTION 2: HOSTFILES + PER-RANK MAPPING/VISIBILITY"
echo "============================================================"
HF_FULL="$PWD/${ATTEMPT}_hf_full_${PBS_JOBID}"
HF_PT2PT="$PWD/${ATTEMPT}_hf_pt2pt_${PBS_JOBID}"
awk -v slots="$RANKS_PER_NODE" '
  { gsub(/\r/,""); sub(/^[ \t]+/,""); sub(/[ \t]+$/,""); if ($0=="") next }
  { if (!seen[$0]++) print $0 " slots=" slots }
' "$PBS_NODEFILE" > "$HF_FULL"
PT2PT_SLOTS=1
[ "$EXPECTED_NNODES" -eq 1 ] && PT2PT_SLOTS="$RANKS_PER_NODE"
awk -v slots="$PT2PT_SLOTS" '
  { gsub(/\r/,""); sub(/^[ \t]+/,""); sub(/[ \t]+$/,""); if ($0=="") next }
  { if (!seen[$0]++) print $0 " slots=" slots }
' "$PBS_NODEFILE" > "$HF_PT2PT"
echo "--- hostfile full (slots=$RANKS_PER_NODE) ---"; cat "$HF_FULL"
echo "--- hostfile pt2pt (slots=$PT2PT_SLOTS) ---"; cat "$HF_PT2PT"

launch() {
  local hf="$1"; local np="$2"; shift 2
  timeout 300 apptainer exec --nv \
    -B /opt/pbs:/opt/pbs \
    -B /var/spool/pbs:/var/spool/pbs \
    -B "$REPO_ROOT/multi-node-test":"$REPO_ROOT/multi-node-test" \
    -B "$PBS_O_WORKDIR":"$PBS_O_WORKDIR" \
    "$SIF" \
    /usr/local/mpi/bin/mpirun -np "$np" \
      --hostfile "$hf" \
      --mca plm_rsh_agent "$BRIDGE" \
      --mca plm_rsh_no_tree_spawn 1 \
      --mca plm_rsh_num_concurrent 1 \
      --mca routed direct \
      -x PATH -x LD_LIBRARY_PATH -x STAGE \
      --bind-to none "$@"
}

MAP_LOG="$OUTDIR/${ATTEMPT}_rank_map.log"
launch "$HF_FULL" "$TOTAL_RANKS" bash -c '
  echo "rank=$OMPI_COMM_WORLD_RANK/$OMPI_COMM_WORLD_SIZE host=$(hostname) local_rank=$OMPI_COMM_WORLD_LOCAL_RANK/$OMPI_COMM_WORLD_LOCAL_SIZE container_cvd=$(printenv CUDA_VISIBLE_DEVICES || echo unset) cpus_allowed=$(grep Cpus_allowed_list /proc/self/status | cut -f2)"
  if [ -x "$STAGE/osu_bw" ]; then echo "staged_osu_visible=YES"; else echo "staged_osu_visible=NO"; fi
  echo "gpus_visible=$(nvidia-smi -L 2>/dev/null | wc -l)"
' 2>&1 | tee "$MAP_LOG"
MAP_RC="${PIPESTATUS[0]}"
echo "rank_map_rc=$MAP_RC"
RANK_LINES=$(grep -c "^rank=" "$MAP_LOG" || true)
VIS_NO=$(grep -c "staged_osu_visible=NO" "$MAP_LOG" || true)
echo "rank_lines=$RANK_LINES expected=$TOTAL_RANKS staged_not_visible_ranks=$VIS_NO"
if [ "$MAP_RC" -ne 0 ] || [ "$RANK_LINES" -ne "$TOTAL_RANKS" ] || [ "$VIS_NO" -ne 0 ]; then
  echo "FATAL: rank mapping/visibility check failed (rc=$MAP_RC lines=$RANK_LINES vis_no=$VIS_NO)" >&2
  exit 1
fi

echo
echo "============================================================"
echo "SECTION 3: TESTS"
echo "============================================================"
export NCCL_DEBUG=INFO
export NCCL_DEBUG_SUBSYS=INIT,BOOTSTRAP,ENV,NET,GRAPH
export NCCL_DEBUG_FILE=/dev/stderr

FAILS=0
TOTAL=0

run_osu() {
  local name="$1" bin="$2"; shift 2
  local np="$1" hf="$2"; shift 2
  local log="$OUTDIR/${ATTEMPT}_${name}.log"
  TOTAL=$((TOTAL+1))
  echo ""
  echo "########## TEST: $name (np=$np) ##########"
  date --iso-8601=seconds
  launch "$hf" "$np" bash -c "
    export LD_LIBRARY_PATH=/opt/hpcx/ompi/lib:/opt/hpcx/ucx/lib:\$LD_LIBRARY_PATH
    export CUDA_VISIBLE_DEVICES=\$OMPI_COMM_WORLD_LOCAL_RANK
    exec \"\$STAGE/$bin\" $*
  " > "$log" 2>&1
  local rc=$?
  cat "$log"
  local rows
  rows=$(grep -cE "^[0-9]+[[:space:]]+[0-9]" "$log" || true)
  echo "test_${name}_rc=$rc table_rows=$rows"
  if [ "$rc" -ne 0 ] || [ "$rows" -lt 5 ]; then
    echo "test_${name}=FAIL"
    FAILS=$((FAILS+1))
  else
    echo "test_${name}=PASS"
  fi
}

# pt2pt: np=2, inter-node pair on multi-node rungs (slots=1 hostfile)
run_osu osu_bw_dd    osu_bw      2 "$HF_PT2PT" D D
run_osu osu_bw_hh    osu_bw      2 "$HF_PT2PT" H H
run_osu osu_latency_dd osu_latency 2 "$HF_PT2PT" D D

# collectives: full rank count
run_osu osu_allreduce_cuda osu_allreduce "$TOTAL_RANKS" "$HF_FULL" -d cuda
run_osu osu_allreduce_hh   osu_allreduce "$TOTAL_RANKS" "$HF_FULL"

# tiny container-native NCCL smoke at full rank count
NCCL_LOG="$OUTDIR/${ATTEMPT}_nccl_allreduce.log"
TOTAL=$((TOTAL+1))
echo ""
echo "########## TEST: nccl_allreduce_1mib (np=$TOTAL_RANKS) ##########"
date --iso-8601=seconds
launch "$HF_FULL" "$TOTAL_RANKS" \
  -x NCCL_DEBUG -x NCCL_DEBUG_SUBSYS -x NCCL_DEBUG_FILE \
  bash -c '
    export CUDA_VISIBLE_DEVICES=$OMPI_COMM_WORLD_LOCAL_RANK
    export NCCL_TESTS_DEVICE=0
    exec '"$NCCL_TESTS_DIR"'/all_reduce_perf -b 1048576 -e 1048576 -g 1 -w 1 -n 2
  ' > "$NCCL_LOG" 2>&1
NCCL_RC=$?
cat "$NCCL_LOG"
echo "test_nccl_allreduce_rc=$NCCL_RC"
NCCL_OK=0
if [ "$NCCL_RC" -eq 0 ] && grep -Fq "Out of bounds values : 0" "$NCCL_LOG"; then NCCL_OK=1; fi
if grep -q "via NET/IBext" "$NCCL_LOG"; then
  echo "nccl_via_ibext_channels=$(grep -c 'via NET/IBext' "$NCCL_LOG") gdrdma_channels=$(grep -c GDRDMA "$NCCL_LOG")"
fi
if [ "$NCCL_OK" -eq 1 ]; then
  echo "test_nccl_allreduce=PASS"
else
  echo "test_nccl_allreduce=FAIL"
  FAILS=$((FAILS+1))
fi

cp "$HF_FULL" "$OUTDIR/${ATTEMPT}_hf_full_${PBS_JOBID}"
cp "$HF_PT2PT" "$OUTDIR/${ATTEMPT}_hf_pt2pt_${PBS_JOBID}"
rm -f "$HF_FULL" "$HF_PT2PT"

node_snapshot post

echo
echo "============================================================"
echo "SECTION 4: SUMMARY"
echo "============================================================"
echo "phase2_osu_smoke_end=$(date --iso-8601=seconds)"
echo "topology=$TOPO abi_clean=$ABI_CLEAN staged_visible=$STAGED_VISIBLE"
echo "total_tests=$TOTAL failed_tests=$FAILS"
if [ "$FAILS" -eq 0 ]; then
  echo "PHASE2_OSU_SMOKE_RESULT=PASS"
  exit 0
else
  echo "PHASE2_OSU_SMOKE_RESULT=FAIL"
  exit 1
fi
