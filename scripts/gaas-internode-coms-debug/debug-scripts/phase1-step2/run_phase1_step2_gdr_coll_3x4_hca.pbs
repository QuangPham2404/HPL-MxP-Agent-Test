#!/bin/bash
# Phase 1 Step 2 NCCL GDR A/B, collective mode with HCA filter (Track 2 case
# 2026-09-17-A fix): broadcast_perf (fixed root 0) + all_reduce_perf on
# 3 nodes x 4 GPUs (12 MPI/NCCL ranks), ctrl vs gdroff arms on the same
# allocation. Identical to run_phase1_step2_gdr_coll_3x4.pbs except
# NCCL_IB_HCA restricts NET device selection to the eight InfiniBand HCAs,
# excluding the RoCE bond (mlx5_bond_0) whose asymmetric rail assignment
# (g22 bond vs peer mlx5_4) broke the v1 ctrl-allreduce with an NCCL
# internal error (ib_plugin.c:1312 link-type incompatibility ->
# transport/net.cc:555 -> 3). The filter applies to BOTH arms so the A/B
# stays device-symmetric. Submit from debug-scripts/phase1-step2/ with
# host-pinned select chunks and attempt-specific PBS output names
# documented in README.md.

#PBS -N P1S2_GDRCOLL_3X4_HCA
#PBS -P hpc_ebslee
#PBS -q gpu_ded
#PBS -l place=scatter
#PBS -l walltime=00:45:00

set -euo pipefail
cd "$PBS_O_WORKDIR"
export TOPOLOGY=3x4 EXPECTED_NNODES=3 GPUS_PER_NODE=4
export TESTS="broadcast allreduce" ARMS="ctrl gdroff" RESULT_TAG=STEP2_GDR_COLL
export NCCL_IB_HCA=mlx5_0,mlx5_1,mlx5_2,mlx5_3,mlx5_4,mlx5_5,mlx5_8,mlx5_9
exec /bin/bash "$PBS_O_WORKDIR/run_phase1_step2_sendrecv_common.sh"
