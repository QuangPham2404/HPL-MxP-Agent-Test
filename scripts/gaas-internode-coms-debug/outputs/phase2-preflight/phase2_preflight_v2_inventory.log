#!/usr/bin/env bash

SCRIPT_DIR=$( cd -- "$( dirname -- "$( readlink -f "${BASH_SOURCE[0]}" )" )" &> /dev/null && pwd )
OSU_BASE_PATH="${SCRIPT_DIR}/osu_mpi_tests/mpi"
RUN_BENCHMARK="${SCRIPT_DIR}/run_benchmark.sh"

# Check if run_benchmark.sh exists and is readable
if [[ ! -r "${RUN_BENCHMARK}" ]]; then
    echo "Error: ${RUN_BENCHMARK} not found or not readable"
    exit 1
fi

# Function to display usage information
usage() {
    echo "Usage: $0 --op <operation> [--test-params <params>] [additional options]"
    echo "Available operations:"
    echo ""
    echo "Collective Operations:"
    echo "  allgather        - Run OSU MPI Allgather test"
    echo "  allgatherv       - Run OSU MPI Allgatherv test"
    echo "  allreduce        - Run OSU MPI Allreduce test"
    echo "  alltoall         - Run OSU MPI Alltoall test"
    echo "  alltoallv        - Run OSU MPI Alltoallv test"
    echo "  alltoallw        - Run OSU MPI Alltoallw test"
    echo "  barrier          - Run OSU MPI Barrier test"
    echo "  bcast            - Run OSU MPI Bcast test"
    echo "  gather           - Run OSU MPI Gather test"
    echo "  gatherv          - Run OSU MPI Gatherv test"
    echo "  iallgather       - Run OSU MPI Iallgather test"
    echo "  iallgatherv      - Run OSU MPI Iallgatherv test"
