--- osu_mpi_tests.sh runner (head) ---
#!/usr/bin/env bash

SCRIPT_DIR=$( cd -- "$( dirname -- "$( readlink -f "${BASH_SOURCE[0]}" )" )" &> /dev/null && pwd )
OSU_BASE_PATH="${SCRIPT_DIR}/osu_mpi_tests/mpi"
RUN_BENCHMARK="${SCRIPT_DIR}/run_benchmark.sh"

# Check if run_benchmark.sh exists and is readable
if [[ ! -r "${RUN_BENCHMARK}" ]]; then
    echo "Error: ${RUN_BENCHMARK} not found or not readable"
    exit 1
fi

# Function to display usage information
usage() {
    echo "Usage: $0 --op <operation> [--test-params <params>] [additional options]"
    echo "Available operations:"
    echo ""
    echo "Collective Operations:"
    echo "  allgather        - Run OSU MPI Allgather test"
    echo "  allgatherv       - Run OSU MPI Allgatherv test"
    echo "  allreduce        - Run OSU MPI Allreduce test"
    echo "  alltoall         - Run OSU MPI Alltoall test"
    echo "  alltoallv        - Run OSU MPI Alltoallv test"
    echo "  alltoallw        - Run OSU MPI Alltoallw test"
    echo "  barrier          - Run OSU MPI Barrier test"
    echo "  bcast            - Run OSU MPI Bcast test"
    echo "  gather           - Run OSU MPI Gather test"
    echo "  gatherv          - Run OSU MPI Gatherv test"
    echo "  iallgather       - Run OSU MPI Iallgather test"
    echo "  iallgatherv      - Run OSU MPI Iallgatherv test"
    echo "  ialltoall        - Run OSU MPI Ialltoall test"
    echo "  ialltoallv       - Run OSU MPI Ialltoallv test"
    echo "  ialltoallw       - Run OSU MPI Ialltoallw test"
    echo "  ibarrier         - Run OSU MPI Ibarrier test"
    echo "  ibcast           - Run OSU MPI Ibcast test"
    echo "  igather          - Run OSU MPI Igather test"
    echo "  igatherv         - Run OSU MPI Igatherv test"
    echo "  ineighbor-allgather    - Run OSU MPI Ineighbor_allgather test"
    echo "  ineighbor-allgatherv   - Run OSU MPI Ineighbor_allgatherv test"
    echo "  ineighbor-alltoall     - Run OSU MPI Ineighbor_alltoall test"
    echo "  ineighbor-alltoallv    - Run OSU MPI Ineighbor_alltoallv test"
    echo "  ineighbor-alltoallw    - Run OSU MPI Ineighbor_alltoallw test"
    echo "  ireduce          - Run OSU MPI Ireduce test"
    echo "  ireduce-scatter  - Run OSU MPI Ireduce_scatter test"
    echo "  ireduce-scatter-block - Run OSU MPI Ireduce_scatter_block test"
    echo "  iscatter         - Run OSU MPI Iscatter test"
    echo "  iscatterv        - Run OSU MPI Iscatterv test"
    echo "  neighbor-allgather     - Run OSU MPI Neighbor_allgather test"
    echo "  neighbor-allgatherv    - Run OSU MPI Neighbor_allgatherv test"
