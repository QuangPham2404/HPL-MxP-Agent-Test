#!/bin/bash
# Sweep matrix size (N) to see if we can maximize computation
# Expected working directory: this experiment directory on GAAS.
# Inputs: fixed PBS resources and HPL-MxP parameters copied from the GAAS
# manual-test reference. Outputs: attempt-specific PBS stdout and stderr.
# Assumptions: the approved container and required modules exist on GAAS.

#PBS -N HPL_MXP_N_SWEEP_V1
#PBS -q gpu_as
#PBS -P hpc_admin
#PBS -l select=1:ngpus=8
#PBS -l walltime=00:45:00
#PBS -o outputs/N-sweep_v1.o
#PBS -e outputs/N-sweep_v1.e

set -euo pipefail

# Enter the experiment directory and print reproducibility metadata.
cd "$PBS_O_WORKDIR"
echo "experiment_id=N-sweep"
echo "attempt=N-sweep_v1"
echo "pbs_job_id=${PBS_JOBID:-unknown}"
echo "submitted_workdir=$PWD"
date --iso-8601=seconds
hostname

# Load the exact minimal module environment from the GAAS reference script.
module purge
module load apptainer/1.4.1
module load nvhpc/26.3
module load squashfuse/0.5.2
module load gocryptfs/2.5.0

# Record the allocated GPU topology before launching the container workload.
nvidia-smi topo -m

# Execute the unchanged HPL-MxP baseline command from the GAAS reference.
apptainer exec --nv "/home/pham0094/hpl_hpcg_hplmxp_container/hpc-benchmarks_26.02.sif" \
  mpirun -np 8 \
    --bind-to none \
    /workspace/hpl-mxp.sh \
      --gpu-affinity 0:1:2:3:4:5:6:7 \
      --nprow 2 \
      --npcol 4 \
      --nporder row \
      --n 400000 \
      --nb 1024 \
      --skip-tests 1 \
      --monitor-gpu 1 \
      --monitor-gpu-interval 10 \
      --monitor-gpu-pcie-width-warning 16 \
      --monitor-gpu-pcie-gen-warning 5
