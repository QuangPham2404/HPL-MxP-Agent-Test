# Separate-stream-for-GEMM toggle at N=491520 (separate-stream-for-gemm).
# Expected working directory: this experiment directory
# (experiments/separate-stream-for-gemm/) on GAAS. Submit with
# `qsub run_separate_stream.pbs` (no -v args needed).
#
# A single node-matched job loops over the two values of the
# `--use-separate-stream-for-gemm` toggle, bracketed by the on (1) control,
# which is the current best configuration.
#
# Study objective: observe whether giving GEMMs their own CUDA stream changes
# end-to-end GFLOP/s at the current best configuration (NOT an optimum search).
#
# Swept variable: --use-separate-stream-for-gemm = 1 (control, current best),
#   0 (toggle off).
# Fixed config (current best, factorization priority on):
#   N=491520, NB=3072, 2x4 row grid, gpu-affinity 0:1:2:3:4:5:6:7,
#   no --cpu-affinity / --mem-affinity,
#   OMP_NUM_THREADS=8, OMP_PLACES=sockets, OMP_PROC_BIND=TRUE,
#   --fill-device 1 --fill-device-buffer-size 2048 --cuda-host-register-step 2048,
#   --prioritize-factorization 1 (--prioritize-trsm omitted -> default 0),
#   --skip-tests 1 + GPU monitoring flags.
#   --use-mpi-panel-broadcast and --u-panel-chunk-nbs are OMITTED so the
#   package defaults (50 and 8) apply.
# Outputs: attempt-specific stdout/stderr under outputs/.
# Assumptions: the approved container and required modules exist on GAAS; one
# GPU per MPI process (8 processes, 8 GPUs); OMP env vars forwarded via
# `mpirun -x`.

#PBS -N hpl_mxp_ss_sweep
#PBS -q gpu_as
#PBS -P hpc_admin
#PBS -l select=1:ngpus=8
#PBS -l walltime=01:00:00
#PBS -o outputs/hpl_mxp_ss_sweep.o
#PBS -e outputs/hpl_mxp_ss_sweep.e

set -euo pipefail

cd "$PBS_O_WORKDIR"

# Load the exact minimal module environment validated for GAAS.
module purge
module load apptainer/1.4.1
module load nvhpc/26.3
module load squashfuse/0.5.2
module load gocryptfs/2.5.0

# PBS clobbers OMP_NUM_THREADS with the allocated core count (96), so re-export
# the fixed host-thread configuration after `module purge`.
export OMP_NUM_THREADS=8
export OMP_PLACES=sockets
export OMP_PROC_BIND=TRUE

mkdir -p outputs

# Toggle sequence: control (1, current best) -> 0.
SWEEP_SS=(1 0)
SWEEP_LABEL=(ss_1 ss_0)

run_one() {
  local ss="$1" label="$2"
  local out="outputs/${label}.o" err="outputs/${label}.e"
  {
    echo "experiment_id=separate-stream-for-gemm"
    echo "attempt=${label}"
    echo "n=491520"
    echo "nb=3072"
    echo "nprow=2"
    echo "npcol=4"
    echo "nporder=row"
    echo "gpu_affinity=0:1:2:3:4:5:6:7"
    echo "fill_device=1"
    echo "fill_device_buffer_size=2048"
    echo "cuda_host_register_step=2048"
    echo "prioritize_trsm=0"
    echo "prioritize_factorization=1"
    echo "use_separate_stream_for_gemm=${ss}"
    echo "pbs_job_id=${PBS_JOBID:-unknown}"
    echo "submitted_workdir=$PWD"
    date --iso-8601=seconds
    hostname
    echo "omp_num_threads=${OMP_NUM_THREADS:-unset}"
    echo "omp_places=${OMP_PLACES:-unset}"
    echo "omp_proc_bind=${OMP_PROC_BIND:-unset}"
    nvidia-smi topo -m
    apptainer exec --nv "/home/pham0094/hpl_hpcg_hplmxp_container/hpc-benchmarks_26.02.sif" \
      mpirun -np 8 \
        --bind-to none \
        -x OMP_NUM_THREADS \
        -x OMP_PLACES \
        -x OMP_PROC_BIND \
        /workspace/hpl-mxp.sh \
          --gpu-affinity 0:1:2:3:4:5:6:7 \
          --nprow 2 \
          --npcol 4 \
          --nporder row \
          --n 491520 \
          --nb 3072 \
          --fill-device 1 \
          --fill-device-buffer-size 2048 \
          --cuda-host-register-step 2048 \
          --prioritize-factorization 1 \
          --use-separate-stream-for-gemm "${ss}" \
          --skip-tests 1 \
          --monitor-gpu 1 \
          --monitor-gpu-interval 10 \
          --monitor-gpu-pcie-width-warning 16 \
          --monitor-gpu-pcie-gen-warning 5
  } > "${out}" 2> "${err}"
}

for i in "${!SWEEP_SS[@]}"; do
  echo "[$(date --iso-8601=seconds)] running ${SWEEP_LABEL[$i]} separate_stream=${SWEEP_SS[$i]}"
  run_one "${SWEEP_SS[$i]}" "${SWEEP_LABEL[$i]}"
done

echo "separate-stream-for-gemm complete."