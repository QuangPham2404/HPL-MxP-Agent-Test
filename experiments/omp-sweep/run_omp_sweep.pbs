#!/bin/bash
# Parametrized HPL-MxP OpenMP (OMP_NUM_THREADS / OMP_PLACES / OMP_PROC_BIND) sweep
# on GAAS. Expected working directory: this experiment directory
# (experiments/omp-sweep/) on GAAS. Submit with qsub -v
# 'ATTEMPT=<label>,OMP_NUM_THREADS=<n>[,OMP_PLACES=<p>][,OMP_PROC_BIND=<b>]' plus
# -o/-e for the attempt-specific PBS stdout/stderr under outputs/.
# Inputs: ATTEMPT (output stem) and OMP_* values. OMP_PLACES/OMP_PROC_BIND are
# optional; when unset the corresponding OpenMP env var is omitted (OpenMP
# default). Fixed matrix size N=491520, block size NB=3072, 2x4 row grid,
# gpu-affinity 0:1:2:3:4:5:6:7, no --cpu-affinity / --mem-affinity (the current
# best from 2026-08-24). Outputs: attempt-specific PBS stdout and stderr under
# outputs/. Assumptions: the approved container and required modules exist on
# GAAS; one GPU per MPI process (8 processes, 8 GPUs); OMP env vars are forwarded
# to each MPI rank via `mpirun -x`.

#PBS -N hpl_mxp_omp_sweep
#PBS -q gpu_as
#PBS -P hpc_admin
#PBS -l select=1:ngpus=8
#PBS -l walltime=00:45:00

set -euo pipefail

# Enter the experiment directory and print reproducibility metadata.
cd "$PBS_O_WORKDIR"
echo "experiment_id=omp-sweep"
echo "attempt=${ATTEMPT:-unknown}"
echo "n=491520"
echo "nb=3072"
echo "nprow=2"
echo "npcol=4"
echo "nporder=row"
echo "gpu_affinity=0:1:2:3:4:5:6:7"
echo "omp_num_threads=${OMP_NUM_THREADS:-unset}"
echo "omp_places=${OMP_PLACES:-unset}"
echo "omp_proc_bind=${OMP_PROC_BIND:-unset}"
echo "pbs_job_id=${PBS_JOBID:-unknown}"
echo "submitted_workdir=$PWD"
date --iso-8601=seconds
hostname

# Load the exact minimal module environment validated for GAAS.
module purge
module load apptainer/1.4.1
module load nvhpc/26.3
module load squashfuse/0.5.2
module load gocryptfs/2.5.0

# Record the allocated GPU topology before launching the container workload.
nvidia-smi topo -m

# Build the OMP forwarding flags for mpirun. Each OMP env var set by qsub -v is
# already in this shell's environment; mpirun needs explicit `-x` to propagate
# it to the launched ranks (apptainer exec inherits the host env by default).
OMP_X=()
[[ -n "${OMP_NUM_THREADS:-}" ]] && OMP_X+=(-x OMP_NUM_THREADS)
[[ -n "${OMP_PLACES:-}" ]]     && OMP_X+=(-x OMP_PLACES)
[[ -n "${OMP_PROC_BIND:-}" ]]  && OMP_X+=(-x OMP_PROC_BIND)

# Execute HPL-MxP with fixed workload and the requested OpenMP environment.
# --skip-tests is set per project convention; GPU monitoring flags are included
# for bottleneck evidence.
apptainer exec --nv "/home/pham0094/hpl_hpcg_hplmxp_container/hpc-benchmarks_26.02.sif" \
  mpirun -np 8 \
    --bind-to none \
    "${OMP_X[@]}" \
    /workspace/hpl-mxp.sh \
      --gpu-affinity 0:1:2:3:4:5:6:7 \
      --nprow 2 \
      --npcol 4 \
      --nporder row \
      --n 491520 \
      --nb 3072 \
      --skip-tests 1 \
      --monitor-gpu 1 \
      --monitor-gpu-interval 10 \
      --monitor-gpu-pcie-width-warning 16 \
      --monitor-gpu-pcie-gen-warning 5