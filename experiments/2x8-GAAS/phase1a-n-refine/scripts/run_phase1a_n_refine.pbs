#!/bin/bash
# HPL-MxP 2x8-GAAS Phase-1A local N refinement sweep: 2 GAAS nodes x 8 H200
# GPUs (16 ranks, 4x4 column grid). The five TASK-002-approved N candidates
# run sequentially within this single PBS allocation; only N varies.
#
# Purpose: TASK-002 Phase-1A local N / FP64-residency refinement (see
# tasks/TASK-002.md Sections 1.4A-1.4C). Every scientific control other than
# N is fixed and identical to the TASK-001 Phase-1A coarse-sweep controls
# (TASK-002 Section 1.4B), i.e. the TASK-000 baseline configuration plus
# --fill-device 1. The candidates 404480, 454656, and 504832 deliberately
# repeat the TASK-001 coarse anchors as the approved reproducibility/
# bracketing check (TASK-002 Section 1.7.13). A candidate with a nonzero
# exit is recorded and the sweep continues with the next candidate; the job
# returns nonzero overall if any candidate failed.
#
# Expected working directory: this experiment directory
# (experiments/2x8-GAAS/phase1a-n-refine/) on GAAS. Submit with (the queue is
# deliberately NOT selected in this script; pass an approved one at qsub):
#   qsub -q <gpu_as|gpu_ded> -v "ATTEMPT_TAG=v1" \
#        -o outputs/2x8-GAAS-phase1a-n-refine_v1.o \
#        -e outputs/2x8-GAAS-phase1a-n-refine_v1.e \
#        scripts/run_phase1a_n_refine.pbs
#
# Inputs (environment, via qsub -v):
#   ATTEMPT_TAG  REQUIRED sweep attempt tag (e.g. v1); it names every
#                per-candidate evidence file. A rerun must use a new tag.
#   N_SUBSET     OPTIONAL space-separated subset of the five approved N
#                values, for the TASK-002 Section 1.4C split-across-
#                allocations fallback. Default: run all five, in the listed
#                order. Any value outside the approved five, or a duplicate,
#                is a fatal error.
# Outputs: per-candidate application stdout/stderr and status files under
#   outputs/2x8-GAAS-phase1a-n-refine_n<N>_<ATTEMPT_TAG>.{out,err,status};
#   PBS-level stdout/stderr names are passed at qsub with -o/-e (this script
#   deliberately has no #PBS -o/-e directives). Existing attempt files are
#   never overwritten: the script aborts before running anything if a target
#   file already exists. A candidate killed mid-run (e.g. by walltime) keeps
#   its .out/.err but has no .status file.
# Assumptions: approved container and modules exist on GAAS; one GPU per MPI
# process; validated Approach-1 multinode launch (container mpirun +
# rsh_pbsdsh_container.sh bridge; see multi-node-test/GAAS_MULTINODE_SETUP.md).
#
# Queue policy: no queue is preselected here. TASK-002 authorizes only
# gpu_as and gpu_ded; the submitting qsub must pass -q explicitly, and this
# script verifies the actually-assigned queue and aborts on anything else.
# select=2:ngpus=8 (no mpiprocs) may likewise be overridden on the qsub
# command line by a documented host-pinned select (see README.md).

#PBS -N 2x8_phase1a_nrefine
#PBS -P hpc_ebslee
#PBS -l select=2:ngpus=8
#PBS -l place=scatter
#PBS -l walltime=01:30:00

set -euo pipefail

# --- Experiment metadata --------------------------------------------------------
cd "$PBS_O_WORKDIR"
EXPERIMENT_ID="2x8-GAAS-phase1a-n-refine"
OUTDIR="$PWD/outputs"
mkdir -p "$OUTDIR"

ATTEMPT_TAG="${ATTEMPT_TAG:-}"
if [ -z "$ATTEMPT_TAG" ]; then
  echo "FATAL: ATTEMPT_TAG is required (e.g. -v \"ATTEMPT_TAG=v1\"); it names this sweep's evidence files" >&2
  exit 1
fi

# Only gpu_as and gpu_ded are authorized for TASK-002 (Section 1.7). The
# queue is not preselected in this script; fail fast if PBS assigned any
# other queue (including an omitted -q falling through to a default queue).
QUEUE="${PBS_O_QUEUE:-unknown}"
case "$QUEUE" in
  gpu_as|gpu_ded) ;;
  *) echo "FATAL: queue '${QUEUE}' is not authorized for TASK-002 (only gpu_as or gpu_ded); pass -q at qsub" >&2; exit 1 ;;
esac

# Approved refinement-N candidates (TASK-002 Section 1.4A): the complete
# sweep. 404480/454656/504832 deliberately repeat TASK-001 coarse anchors
# (Section 1.7.13); 429056/480256 are the new ~85%/~95% pivot points.
APPROVED_N=(404480 429056 454656 480256 504832)

# Optional operational split (TASK-002 Section 1.4C): restrict this
# allocation to a subset of the approved candidates, controls unchanged.
N_SUBSET="${N_SUBSET:-}"
if [ -n "$N_SUBSET" ]; then
  N_CANDIDATES=""
  seen=""
  for n in $N_SUBSET; do
    case " ${APPROVED_N[*]} " in
      *" $n "*) ;;
      *) echo "FATAL: N=${n} is not one of the five TASK-002-approved candidates (${APPROVED_N[*]})" >&2; exit 1 ;;
    esac
    case " $seen " in
      *" $n "*) echo "FATAL: duplicate N=${n} in N_SUBSET" >&2; exit 1 ;;
    esac
    seen="$seen $n"
    N_CANDIDATES="$N_CANDIDATES $n"
  done
else
  N_CANDIDATES="${APPROVED_N[*]}"
fi
NCAND=$(set -- $N_CANDIDATES; echo $#)

echo "experiment_id=${EXPERIMENT_ID}"
echo "attempt_tag=${ATTEMPT_TAG}"
echo "pbs_job_id=${PBS_JOBID:-unknown}"
echo "queue=${QUEUE}"
echo "project=hpc_ebslee"
date --iso-8601=seconds
echo "fixed scientific controls (identical across candidates; only N varies):"
echo "OMP_NUM_THREADS=8"
echo "--nb 3072"
echo "--nprow 4"
echo "--npcol 4"
echo "--nporder column"
echo "--gpu-affinity 0:1:2:3:4:5:6:7"
echo "--sloppy-type FP16"
echo "--use-mpi-panel-broadcast 0"
echo "--use-separate-stream-for-gemm 1"
echo "--prioritize-trsm 0"
echo "--prioritize-factorization 0"
echo "--fill-device 1"
echo "--test-loop 1"
echo "--skip-tests 0"
echo "--monitor-gpu 0"
echo "n candidates for this allocation (TASK-002 Section 1.4A):${N_CANDIDATES}"
echo "n_candidate_count=${NCAND}"

# --- Locate repo root and the validated launch bridge ---------------------------
# Submission dir is experiments/2x8-GAAS/phase1a-n-refine/, so the repo root
# is three levels up.
REPO_ROOT="$(cd "${PBS_O_WORKDIR}/../../.." && pwd)"
BRIDGE="${REPO_ROOT}/multi-node-test/rsh_pbsdsh_container.sh"
SIF="/home/pham0094/hpl_hpcg_hplmxp_container/hpc-benchmarks_26.02.sif"

[ -f "$BRIDGE" ] || { echo "FATAL: bridge not found at ${BRIDGE}; submit from the experiment directory (experiments/2x8-GAAS/phase1a-n-refine/)" >&2; exit 1; }
[ -f "$SIF" ] || { echo "FATAL: container image not found: ${SIF}" >&2; exit 1; }

# --- Allocation checks (place=scatter, no mpiprocs; fixed 4x4 grid) --------------
GPUS=8                                   # GPUs (and ranks) per node
EXPECTED_NODES=2
NNODES=$(sort -u "$PBS_NODEFILE" | wc -l)
[ "$NNODES" -eq "$EXPECTED_NODES" ] || { echo "FATAL: expected ${EXPECTED_NODES} distinct nodes, got ${NNODES}" >&2; exit 1; }
NPROCS=$((NNODES * GPUS))

# Fixed process grid and order (supplied configuration; do NOT auto-derive).
NPROW=4
NPCOL=4
NPORDER=column
GPU_AFFINITY=0:1:2:3:4:5:6:7
[ "$NPROCS" -eq $((NPROW * NPCOL)) ] || { echo "FATAL: fixed grid ${NPROW}x${NPCOL} requires $((NPROW * NPCOL)) ranks, got ${NPROCS}" >&2; exit 1; }

echo "layout=${NNODES} nodes x ${GPUS} GPUs = ${NPROCS} ranks"
echo "grid=nprow=${NPROW} npcol=${NPCOL} nporder=${NPORDER}"
echo "nodes=$(sort -u "$PBS_NODEFILE" | paste -sd' ')"
echo "gpu_affinity=${GPU_AFFINITY}"
echo "bridge=${BRIDGE}"
echo "container=${SIF}"

# --- Environment (validated module set) ------------------------------------------
module purge
module load apptainer/1.4.1 nvhpc/26.3 squashfuse/0.5.2 gocryptfs/2.5.0
chmod +x "$BRIDGE"
# Supplied configuration sets OMP_NUM_THREADS=8 only; OMP_PLACES and
# OMP_PROC_BIND are deliberately not set (not supplied).
export OMP_NUM_THREADS=8

# --- Pre-sweep hardware-health snapshot (ordinary evidence; must not block) ------
nvidia-smi topo -m || echo "warn: nvidia-smi topo failed"
nvidia-smi --query-gpu=index,name,driver_version,temperature.gpu,power.draw,clocks.sm,memory.used,memory.total --format=csv || echo "warn: nvidia-smi query failed"

# De-duplicated hostfile with explicit per-node slot count (GAAS Blocker 8);
# shared by all candidates in this allocation.
awk -v g="$GPUS" '{ sub(/\r$/,""); if (!seen[$0]++) print $0 " slots=" g }' \
  "$PBS_NODEFILE" > "$PWD/hostfile"
echo "=== hostfile ==="
cat "$PWD/hostfile"

# --- Attempt-evidence guard (never overwrite existing evidence) -------------------
# Every candidate writes attempt-specific .out/.err/.status files. If any
# target file already exists, this ATTEMPT_TAG was already (partially) used:
# abort before running anything; a rerun must take a new ATTEMPT_TAG.
for N in $N_CANDIDATES; do
  ATTEMPT="${EXPERIMENT_ID}_n${N}_${ATTEMPT_TAG}"
  for f in "${OUTDIR}/${ATTEMPT}.out" "${OUTDIR}/${ATTEMPT}.err" "${OUTDIR}/${ATTEMPT}.status"; do
    if [ -e "$f" ]; then
      echo "FATAL: refusing to overwrite existing evidence ${f}; resubmit with a new ATTEMPT_TAG" >&2
      exit 1
    fi
  done
done

# --- Sequential candidate sweep within this single allocation --------------------
# One candidate at a time, all sharing this allocation's nodes and hostfile.
# A nonzero candidate exit is recorded (status file + job stdout) and the
# sweep CONTINUES with the next candidate; the job exits nonzero overall if
# any candidate failed. The `|| RC=$?` form keeps set -e from aborting the
# sweep on an individual candidate failure.
FAILURES=0
RUN=0
for N in $N_CANDIDATES; do
  RUN=$((RUN + 1))
  ATTEMPT="${EXPERIMENT_ID}_n${N}_${ATTEMPT_TAG}"
  STDOUT_FILE="${OUTDIR}/${ATTEMPT}.out"
  STDERR_FILE="${OUTDIR}/${ATTEMPT}.err"
  STATUS_FILE="${OUTDIR}/${ATTEMPT}.status"
  START_TS=$(date --iso-8601=seconds)
  echo "=== candidate ${RUN}/${NCAND} N=${N} attempt=${ATTEMPT} start=${START_TS} ==="

  # Validated Approach-1 launch, identical to the TASK-001 sweep launch
  # (run_phase1a_n_coarse.pbs) except the approved refinement N set; the
  # fixed controls are the TASK-002 Section 1.4B set (TASK-000 baseline
  # plus --fill-device 1). No other tuning, monitoring, or environment
  # flags are passed.
  RC=0
  apptainer exec --nv \
    -B /opt/pbs:/opt/pbs \
    -B /var/spool/pbs:/var/spool/pbs \
    -B "$REPO_ROOT":"$REPO_ROOT" \
    "$SIF" \
    /usr/local/mpi/bin/mpirun -np "$NPROCS" \
      --hostfile "$PWD/hostfile" \
      --mca plm_rsh_agent "$BRIDGE" \
      --mca plm_rsh_no_tree_spawn 1 \
      --mca plm_rsh_num_concurrent 1 \
      --mca routed direct \
      -x PATH -x LD_LIBRARY_PATH \
      --bind-to none \
      /workspace/hpl-mxp.sh \
        --n "$N" \
        --nb 3072 \
        --nprow 4 \
        --npcol 4 \
        --nporder column \
        --gpu-affinity 0:1:2:3:4:5:6:7 \
        --sloppy-type FP16 \
        --use-mpi-panel-broadcast 0 \
        --use-separate-stream-for-gemm 1 \
        --prioritize-trsm 0 \
        --prioritize-factorization 0 \
        --fill-device 1 \
        --test-loop 1 \
        --skip-tests 0 \
        --monitor-gpu 0 \
    > "$STDOUT_FILE" 2> "$STDERR_FILE" || RC=$?

  END_TS=$(date --iso-8601=seconds)
  if [ "$RC" -ne 0 ]; then
    FAILURES=$((FAILURES + 1))
    echo "=== candidate ${RUN}/${NCAND} N=${N} attempt=${ATTEMPT} FAILED exit_status=${RC} end=${END_TS}; continuing with the next candidate ==="
  else
    echo "=== candidate ${RUN}/${NCAND} N=${N} attempt=${ATTEMPT} exit_status=0 end=${END_TS} ==="
  fi
  {
    echo "attempt=${ATTEMPT}"
    echo "experiment_id=${EXPERIMENT_ID}"
    echo "pbs_job_id=${PBS_JOBID:-unknown}"
    echo "queue=${QUEUE}"
    echo "nodes=$(sort -u "$PBS_NODEFILE" | paste -sd' ')"
    echo "n=${N}"
    echo "fixed_controls=OMP_NUM_THREADS=8 --nb 3072 --nprow 4 --npcol 4 --nporder column --gpu-affinity 0:1:2:3:4:5:6:7 --sloppy-type FP16 --use-mpi-panel-broadcast 0 --use-separate-stream-for-gemm 1 --prioritize-trsm 0 --prioritize-factorization 0 --fill-device 1 --test-loop 1 --skip-tests 0 --monitor-gpu 0"
    echo "start=${START_TS}"
    echo "end=${END_TS}"
    echo "exit_status=${RC}"
    echo "stdout=${STDOUT_FILE}"
    echo "stderr=${STDERR_FILE}"
  } > "$STATUS_FILE"
done

# --- Post-sweep hardware-health snapshot (ordinary evidence; must not block) -----
nvidia-smi topo -m || echo "warn: nvidia-smi topo failed"
nvidia-smi --query-gpu=index,name,driver_version,temperature.gpu,power.draw,clocks.sm,memory.used,memory.total --format=csv || echo "warn: nvidia-smi query failed"

# --- Overall sweep result ----------------------------------------------------------
# Nonzero overall if any candidate failed, even though later candidates were
# still attempted (their evidence is preserved either way).
if [ "$FAILURES" -ne 0 ]; then
  echo "=== HPL-MxP 2x8-GAAS phase1a-n-refine sweep finished with ${FAILURES}/${NCAND} candidate(s) exited nonzero (tag ${ATTEMPT_TAG}) ==="
  exit 1
fi
echo "=== HPL-MxP 2x8-GAAS phase1a-n-refine sweep complete: all ${NCAND} candidate(s) exited 0 (tag ${ATTEMPT_TAG}) ==="
