#!/bin/bash
# HPL-MxP 2x8-GAAS Phase-2C bracketed UCX affinity confirmation: 2 GAAS nodes
# x 8 H200 GPUs (16 ranks). The three TASK-008-approved scored arms run
# sequentially within this single PBS allocation at the retained Phase-2A
# operating point N=429056, NB=3072, 4x4 row, OMP_NUM_THREADS=8 and the fixed
# retained scientific controls (tasks/TASK-008.md Section 1.2); ONLY the UCX
# device-affinity policy varies, in the exact approved bracket order
# (tasks/TASK-008.md Section 1.3):
#
#   C0a --ucx-affinity omitted   (automatic/default UCX device policy)
#   C1  --ucx-affinity mlx5_0:mlx5_1:mlx5_2:mlx5_3:mlx5_4:mlx5_5:mlx5_8:mlx5_9
#       (explicit GPU-PIX-paired HCA map under the retained identity GPU map)
#   C0b --ucx-affinity omitted   (automatic UCX repeat, local drift bracket)
#
# GPU/memory/CPU placement is fixed for every arm: --gpu-affinity
# 0:1:2:3:4:5:6:7, --mem-affinity omitted, --cpu-affinity omitted (Section
# 1.2). No arm-subset option exists: all three arms share this one
# allocation, one node pair, one rank-placement contract and one
# container/software environment (Section 1.7); arms split across multiple
# allocations are not comparable. An arm with a nonzero exit or an invalid
# verification is recorded as evidence and the bracket CONTINUES with the
# next arm (isolated arm failure is evidence; there is no in-script retry);
# the job returns nonzero overall if any arm exited nonzero or failed
# verification.
#
# Observational preflight failures abort BEFORE any scored arm (Track 2 stop
# rules; workflow/05-Workflow-Error-Patching-Procedures.md and
# workflow/08-Workflow-Multinode-Tuning.md Section 5): (1) an allocated
# cpuset/topology that differs from the accepted Phase-0 topology on EITHER
# allocated node invalidates the approved GPU-to-HCA map (tasks/TASK-008.md
# Sections 1.4 and 1.8) - the mother node is gated from the job shell and
# BOTH nodes are gated per host inside the rank-map probe stage (node-local
# rank 0 per host reports its hostname, cpuset, Mems_allowed_list, GPU
# count, the eight 400G IB HCAs, and nvidia-smi topo -m into the rank-map
# log; a replacement pair such as g13+g15 may include a node with no
# accepted Phase-0 capture), and (2) a rank-map probe that fails its
# mechanical 16-rank/8-per-node/2-host check indicates a launch or
# rank-mapping problem. In both cases evidence is preserved, no scored arm
# runs, and any rerun needs a new ATTEMPT_TAG plus human direction; the
# script never retries a hang, failed MPI_Init, rank misplacement, transport
# fallback, or uncertain correctness result.
#
# Purpose: minimal same-allocation bracket of the unresolved TASK-007 Stage-C
# UCX result. Execution records factual scores/evidence only; the strategic
# retain/reject decision is reserved for the post-task Strategic Analyst via
# ANALYSE_RESULTS (tasks/TASK-008.md Section 1.5). This script computes no
# percentage deltas and performs no ranking.
#
# Expected working directory: this experiment directory
# (experiments/2x8-GAAS/phase2c-ucx-affinity-confirm/) on GAAS. Submit with
# (the queue is deliberately NOT selected in this script; pass an approved
# one at qsub):
#   qsub -q <gpu_as|gpu_ded> -v "ATTEMPT_TAG=v1" \
#        -o outputs/2x8-GAAS-phase2c-ucx-affinity-confirm_v1.o \
#        -e outputs/2x8-GAAS-phase2c-ucx-affinity-confirm_v1.e \
#        scripts/run_phase2c_ucx_affinity_confirm.pbs
#
# Inputs (environment, via qsub -v):
#   ATTEMPT_TAG  REQUIRED bracket attempt tag (e.g. v1); it names every
#                per-arm evidence file. A rerun must use a new tag. Before
#                any use the tag is validated against a conservative
#                filename-safe pattern: nonempty, only ASCII alphanumeric
#                characters, dot, underscore, and hyphen, and not '.' or
#                '..' (matched under LC_ALL=C inside a subshell, so the
#                check is locale-independent and leaves the job environment
#                untouched); anything else aborts before anything runs.
# Outputs: per-arm application stdout/stderr and status files under
#   outputs/2x8-GAAS-phase2c-ucx-affinity-confirm_<arm>_<ATTEMPT_TAG>.{out,err,status};
#   the allocation-level rank-map log
#   outputs/2x8-GAAS-phase2c-ucx-affinity-confirm_rankmap_<ATTEMPT_TAG>.log
#   (16 rank lines plus the per-host local-rank-0 topology reports for both
#   allocated nodes);
#   four per-HCA port_xmit_data snapshots (before C0a / after C0a before C1 /
#   after C1 before C0b / after C0b) echoed to the PBS .o on the mother node;
#   environment provenance records echoed to the PBS .o after the validated
#   module load: loaded modules ('module list', an optional record that must
#   not fail the job), the Apptainer version, and the container MPI version
#   (/usr/local/mpi/bin/mpirun --version, a lightweight read-only query of
#   the exact container mpirun the probe and arms launch, run before the
#   rank-map probe; both version invocations are required-runtime checks
#   handled deterministically: explicit rc capture and a fatal abort before
#   any scored work on nonzero rc), plus the execution-worktree git revision
#   (git -C "$REPO_ROOT" rev-parse HEAD; non-fatal provenance: REPO_ROOT
#   stays inside the approved remote project root and a commit SHA exposes
#   no secrets; no external image-digest inspection is performed);
#   PBS-level stdout/stderr names are passed at qsub with -o/-e (this script
#   deliberately has no #PBS -o/-e directives). Existing attempt files are
#   never overwritten: the script aborts before running anything if a target
#   file already exists. An arm killed mid-run (e.g. by walltime) keeps its
#   .out/.err but has no .status file.
# Assumptions: approved container and modules exist on GAAS; one GPU per MPI
# process; validated Approach-1 multinode launch (container mpirun +
# rsh_pbsdsh_container.sh bridge; see multi-node-test/GAAS_MULTINODE_SETUP.md);
# the installed v26.02 launcher implements the captured affinity semantics
# (--gpu-affinity/--mem-affinity/--cpu-affinity/--ucx-affinity per local rank,
# --ucx-affinity -> UCX_NET_DEVICES=<dev>:1; see todo.md captured launcher and
# the flag check evidence in
# experiments/2x8-GAAS/baseline/outputs/hplmxp_v2602_flag_check_v1.log).
#
# Queue policy: no queue is preselected here. TASK-008 authorizes only gpu_as
# and gpu_ded (Section 1.8); the submitting qsub must pass -q explicitly, and
# this script verifies the actually-assigned queue and aborts on anything
# else. select=2:ngpus=8 (no mpiprocs) may likewise be overridden on the qsub
# command line by a documented host-pinned select (see README.md).

#PBS -N 2x8_phase2c_ucx
#PBS -P hpc_ebslee
#PBS -l select=2:ngpus=8
#PBS -l place=scatter
#PBS -l walltime=01:30:00

set -euo pipefail

# --- Experiment metadata --------------------------------------------------------
cd "$PBS_O_WORKDIR"
EXPERIMENT_ID="2x8-GAAS-phase2c-ucx-affinity-confirm"
OUTDIR="$PWD/outputs"
mkdir -p "$OUTDIR"

ATTEMPT_TAG="${ATTEMPT_TAG:-}"
if [ -z "$ATTEMPT_TAG" ]; then
  echo "FATAL: ATTEMPT_TAG is required (e.g. -v \"ATTEMPT_TAG=v1\"); it names this bracket's evidence files" >&2
  exit 1
fi
# ATTEMPT_TAG is embedded in every evidence filename, so before it is used
# anywhere it must pass a conservative filename-safety gate: nonempty
# (checked above), only ASCII alphanumeric characters, dot, underscore and
# hyphen, and not '.' or '..'. The match runs under LC_ALL=C inside a
# subshell, making the character ranges byte-exact and locale-independent
# without modifying the job environment; any other value aborts before
# anything runs.
if ( LC_ALL=C
     case "$ATTEMPT_TAG" in
       '.'|'..'|*[!A-Za-z0-9._-]*) exit 1 ;;
     esac
   )
then
  echo "attempt_tag_validation=PASS (conservative filename-safe pattern: nonempty, ASCII alphanumeric '.' '_' '-' only, not '.' or '..')"
else
  echo "FATAL: ATTEMPT_TAG='${ATTEMPT_TAG}' is not a conservative filename-safe tag (required: nonempty, only ASCII alphanumeric characters, '.', '_', '-'; '.' and '..' are not valid tags); it names this bracket's evidence files" >&2
  exit 1
fi

# Only gpu_as and gpu_ded are authorized for TASK-008 (Section 1.8). The
# queue is not preselected in this script; fail fast if PBS assigned any
# other queue (including an omitted -q falling through to a default queue).
QUEUE="${PBS_O_QUEUE:-unknown}"
case "$QUEUE" in
  gpu_as|gpu_ded) ;;
  *) echo "FATAL: queue '${QUEUE}' is not authorized for TASK-008 (only gpu_as or gpu_ded); pass -q at qsub" >&2; exit 1 ;;
esac

# --- Fixed scientific controls (TASK-008 Section 1.2) -----------------------------
# Only the UCX device-affinity policy varies (C0a/C0b automatic vs C1
# PIX-paired). GPU/memory/CPU placement and everything below is fixed and
# identical for all three arms.
N_FIXED=429056
NB_FIXED=3072
NPROW=4
NPCOL=4
NPORDER=row

# Fixed identity GPU map (TASK-008 Section 1.2): local rank r -> GPU r.
# --mem-affinity and --cpu-affinity are omitted for every arm.
GPU_AFFINITY_FIXED="0:1:2:3:4:5:6:7"

# Approved C1 PIX-paired HCA map (TASK-008 Section 1.3, exact string). Each
# local rank maps to the 400G IB HCA PIX-paired with its assigned GPU
# (Phase-0 topology: GPU0-7 -> mlx5_0,mlx5_1,mlx5_2,mlx5_3,mlx5_4,mlx5_5,
# mlx5_8,mlx5_9); the installed launcher converts it to
# UCX_NET_DEVICES=<mlx5_X>:1 per node-local rank.
C1_UCX="mlx5_0:mlx5_1:mlx5_2:mlx5_3:mlx5_4:mlx5_5:mlx5_8:mlx5_9"

# The three approved arms, in the exact bracket order (TASK-008 Section
# 1.3): C0a automatic -> C1 explicit PIX-paired -> C0b automatic repeat. No
# other arm exists in this script and no arm may be skipped or reordered.
ARM_KEYS=(c0a c1 c0b)
ARM_LABELS=(c0a-ucx-auto c1-ucx-pix c0b-ucx-auto)

echo "experiment_id=${EXPERIMENT_ID}"
echo "attempt_tag=${ATTEMPT_TAG}"
echo "pbs_job_id=${PBS_JOBID:-unknown}"
echo "queue=${QUEUE}"
echo "project=hpc_ebslee"
date --iso-8601=seconds
echo "fixed scientific controls (identical across all 3 arms; only the UCX device policy varies):"
echo "OMP_NUM_THREADS=8 (OMP_PLACES/OMP_PROC_BIND deliberately unset in the job environment; the installed launcher's package defaults apply unchanged, same as TASK-004/TASK-005/TASK-006/TASK-007)"
echo "--n 429056"
echo "--nb 3072"
echo "--nprow 4 --npcol 4 --nporder row"
echo "--gpu-affinity 0:1:2:3:4:5:6:7 (fixed identity map; --mem-affinity omitted, --cpu-affinity omitted for every arm)"
echo "--sloppy-type FP16"
echo "--use-mpi-panel-broadcast 0"
echo "--use-separate-stream-for-gemm 1"
echo "--prioritize-trsm 0"
echo "--prioritize-factorization 0"
echo "--fill-device 1"
echo "--test-loop 1"
echo "--skip-tests 0"
echo "--monitor-gpu 0"
echo "deferred controls NOT used anywhere in this bracket (TASK-008 Section 1.6): --ucx-tls / UCX_TLS, --use-mpi-panel-broadcast changes, --mpi-use-mpi, --use-host-mpi, --u-panel-chunk-nbs, OMP/CPU/memory-affinity tuning, N/NB/grid changes"
echo "bracket order: C0a (automatic UCX) -> C1 (explicit PIX-paired UCX) -> C0b (automatic UCX repeat); exactly 3 scored arms in this one allocation (TASK-008 Sections 1.3, 1.7)"
echo "arm_count=${#ARM_KEYS[@]}"

# --- Locate repo root and the validated launch bridge ---------------------------
# Submission dir is experiments/2x8-GAAS/phase2c-ucx-affinity-confirm/, so the
# repo root is three levels up.
REPO_ROOT="$(cd "${PBS_O_WORKDIR}/../../.." && pwd)"
BRIDGE="${REPO_ROOT}/multi-node-test/rsh_pbsdsh_container.sh"
SIF="/home/pham0094/hpl_hpcg_hplmxp_container/hpc-benchmarks_26.02.sif"

if [ ! -f "$BRIDGE" ]; then
  echo "FATAL: bridge not found at ${BRIDGE}; submit from the experiment directory (experiments/2x8-GAAS/phase2c-ucx-affinity-confirm/)" >&2
  exit 1
fi
if [ ! -f "$SIF" ]; then
  echo "FATAL: container image not found: ${SIF}" >&2
  exit 1
fi

# --- Execution-worktree revision record (provenance; non-fatal) --------------------
# Print the Git revision of the tree this script executes from. REPO_ROOT is
# derived from the submission directory and stays inside the approved remote
# project root (the primary clone or a detached .codex-worktrees/ execution
# worktree beneath it), and 'git rev-parse HEAD' prints only a commit SHA, so
# the record cannot expose secrets. Provenance tool, not a required runtime:
# warn and record 'unknown' if git or the revision is unavailable
# (workflow/03: provenance tools must not block an otherwise valid run).
GIT_RC=0
GIT_REVISION="$(git -C "$REPO_ROOT" rev-parse HEAD 2>&1)" || GIT_RC=$?
if [ "$GIT_RC" -ne 0 ]; then
  echo "warn: 'git -C ${REPO_ROOT} rev-parse HEAD' failed with rc=${GIT_RC}: ${GIT_REVISION}"
  echo "execution_worktree_git_revision=unknown"
else
  echo "execution_worktree_root=${REPO_ROOT}"
  echo "execution_worktree_git_revision=${GIT_REVISION}"
fi

# --- Allocation checks (place=scatter, no mpiprocs; fixed 4x4 grid) ---------------
GPUS=8                                   # GPUs (and ranks) per node
EXPECTED_NODES=2
NNODES=$(sort -u "$PBS_NODEFILE" | wc -l)
if [ "$NNODES" -ne "$EXPECTED_NODES" ]; then
  echo "FATAL: expected ${EXPECTED_NODES} distinct nodes, got ${NNODES}" >&2
  exit 1
fi
NPROCS=$((NNODES * GPUS))
if [ "$NPROCS" -ne $((NPROW * NPCOL)) ]; then
  echo "FATAL: fixed grid ${NPROW}x${NPCOL} requires $((NPROW * NPCOL)) ranks, got ${NPROCS}" >&2
  exit 1
fi

echo "layout=${NNODES} nodes x ${GPUS} GPUs = ${NPROCS} ranks"
echo "grid=nprow=4 x npcol=4, nporder=row (fixed for every arm)"
echo "nodes=$(sort -u "$PBS_NODEFILE" | paste -sd' ')"
echo "bridge=${BRIDGE}"
echo "container=${SIF}"

# --- Phase-0 topology consistency gates (TASK-008 Section 1.4; Track 2) -----------
# The approved C1 GPU-to-HCA PIX map and the reused Phase-0 topology evidence
# are valid only for the accepted Phase-0 topology. This block gates the
# mother node (where this script and rank 0 run) from the job shell; it is
# retained from the validated TASK-007 script as an immediate pre-probe
# check. Cross-node identity is NO LONGER assumed from Phase-0 evidence: the
# accepted captures cover only g12 and g15, while a replacement pair (e.g.
# g13+g15, the only currently free eligible pair at the 2026-09-28
# preflight) may include a node with no accepted Phase-0 capture, so the
# rank-map probe stage below validates EVERY allocated host per host
# (two-host gate; TASK-008 Section 1.8 replacement-node eligibility). A
# mismatch on either node means the approved HCA map / topology reuse is no
# longer valid -> abort before scored work (observational preflight failure;
# Track 2 stop, no auto retry).
CPUSET="$(grep -F 'Cpus_allowed_list:' /proc/self/status | awk '{print $2}')"
if [ "$CPUSET" != "0-49,56-101" ]; then
  echo "FATAL: allocated cpuset '${CPUSET}' differs from the accepted Phase-0 cpuset '0-49,56-101'; the reused Phase-0 topology evidence and the approved GPU-to-HCA map are no longer valid (TASK-008 Section 1.4; Track 2 stop)" >&2
  exit 1
fi
MEMSET="$(grep -F 'Mems_allowed_list:' /proc/self/status | awk '{print $2}')"
if [ "$MEMSET" != "0-1" ]; then
  echo "FATAL: allocated Mems_allowed_list '${MEMSET}' differs from the accepted Phase-0 value '0-1'; the reused Phase-0 topology evidence and the approved GPU-to-HCA map are no longer valid (TASK-008 Section 1.4; Track 2 stop)" >&2
  exit 1
fi
NGPU_VISIBLE="$(nvidia-smi -L 2>/dev/null | wc -l || true)"
if [ "$NGPU_VISIBLE" -ne "$GPUS" ]; then
  echo "FATAL: expected ${GPUS} GPUs on the mother node, saw '${NGPU_VISIBLE}'" >&2
  exit 1
fi
for HCA in mlx5_0 mlx5_1 mlx5_2 mlx5_3 mlx5_4 mlx5_5 mlx5_8 mlx5_9; do
  if [ ! -d "/sys/class/infiniband/${HCA}" ]; then
    echo "FATAL: expected IB HCA ${HCA} is absent; the approved C1 HCA map is no longer valid (TASK-008 Section 1.4; Track 2 stop)" >&2
    exit 1
  fi
done
TOPO_MATRIX="$(nvidia-smi topo -m 2>/dev/null || true)"
echo "=== mother-node GPU topology matrix (gate input + evidence) ==="
echo "$TOPO_MATRIX"
# Row selection is whitespace-tolerant: in the accepted Phase-0 evidence the
# GPU data rows start at column 0 and only the header is tab-indented
# (header bytes: TAB ESC[4m GPU0 TAB GPU1 ...), so the tolerant anchor still
# excludes the header while also accepting a matrix whose data rows arrive
# with leading whitespace. The gate assertion itself is the second-stage
# fixed-string check (CPU-affinity column value), unchanged. The GPU0/GPU4
# NUMA anchors verify that the GPU enumeration still matches the Phase-0
# identity map the PIX pairing was derived from.
if ! printf '%s\n' "$TOPO_MATRIX" | grep '^[[:space:]]*GPU0' | grep -Fq '0-49'; then
  echo "FATAL: GPU0 is not on NUMA0 CPUs 0-49 as in the accepted Phase-0 topology; the fixed identity GPU map and the approved GPU-to-HCA PIX map are no longer valid (TASK-008 Section 1.4; Track 2 stop)" >&2
  exit 1
fi
if ! printf '%s\n' "$TOPO_MATRIX" | grep '^[[:space:]]*GPU4' | grep -Fq '56-101'; then
  echo "FATAL: GPU4 is not on NUMA1 CPUs 56-101 as in the accepted Phase-0 topology; the fixed identity GPU map and the approved GPU-to-HCA PIX map are no longer valid (TASK-008 Section 1.4; Track 2 stop)" >&2
  exit 1
fi
for PAIR in "NIC0: mlx5_0" "NIC1: mlx5_1" "NIC2: mlx5_2" "NIC3: mlx5_3" "NIC4: mlx5_4" "NIC5: mlx5_5" "NIC6: mlx5_8" "NIC7: mlx5_9"; do
  if ! printf '%s\n' "$TOPO_MATRIX" | grep -Fq "$PAIR"; then
    echo "FATAL: topology legend no longer maps '${PAIR}'; the approved C1 PIX-paired HCA map is no longer valid (TASK-008 Section 1.4; Track 2 stop)" >&2
    exit 1
  fi
done
echo "topology_gate=PASS (cpuset=${CPUSET} mems=${MEMSET} gpus=${NGPU_VISIBLE} hcas=mlx5_0..mlx5_5,mlx5_8,mlx5_9 GPU0->NUMA0 GPU4->NUMA1 NIC legend matches Phase-0)"

# --- Environment (validated module set) ------------------------------------------
module purge
module load apptainer/1.4.1 nvhpc/26.3 squashfuse/0.5.2 gocryptfs/2.5.0
chmod +x "$BRIDGE"
# Supplied configuration sets OMP_NUM_THREADS=8 only; OMP_PLACES and
# OMP_PROC_BIND are deliberately not set (not supplied, same as
# TASK-004/TASK-005/TASK-006/TASK-007; the installed launcher applies its
# package defaults OMP_PROC_BIND=TRUE / OMP_PLACES=sockets inside the
# container).
export OMP_NUM_THREADS=8

# --- Environment provenance records (PBS stdout) -----------------------------------
# Read-only records for the PBS .o evidence, taken right after the validated
# module load. 'module list' is an OPTIONAL record: it must not fail the job
# (warn and continue). The Apptainer and container-MPI version invocations
# are REQUIRED runtime checks (the rank-map probe and every scored arm launch
# through these exact runtimes): each rc is captured explicitly and a nonzero
# rc aborts deterministically BEFORE any scored work (workflow/03 preflight
# rule: a tool check is fatal when the next command directly depends on the
# tool). No external image-digest inspection is performed.
echo "=== loaded modules (module list; optional record, non-fatal) ==="
module list 2>&1 || echo "warn: 'module list' failed (optional provenance record; continuing)"

APPTAINER_RC=0
APPTAINER_VERSION_OUTPUT="$(apptainer --version 2>&1)" || APPTAINER_RC=$?
echo "=== apptainer version (required runtime; rc=${APPTAINER_RC}) ==="
echo "${APPTAINER_VERSION_OUTPUT:-<no output>}"
if [ "$APPTAINER_RC" -ne 0 ]; then
  echo "FATAL: 'apptainer --version' failed with rc=${APPTAINER_RC}; apptainer is the required container runtime for every launch in this bracket (deterministic abort before scored work)" >&2
  exit 1
fi

# Container MPI version: lightweight read-only query of the exact container
# mpirun binary the rank-map probe and every scored arm launch, through the
# same apptainer exec prefix and bind mounts as those launches, run BEFORE
# the rank-map probe. REQUIRED runtime: a nonzero rc aborts deterministically
# before scored work (the probe and arms would fail identically).
CONTAINER_MPI_RC=0
CONTAINER_MPI_VERSION_OUTPUT="$(apptainer exec --nv \
  -B /opt/pbs:/opt/pbs \
  -B /var/spool/pbs:/var/spool/pbs \
  -B "$REPO_ROOT":"$REPO_ROOT" \
  "$SIF" \
  /usr/local/mpi/bin/mpirun --version 2>&1)" || CONTAINER_MPI_RC=$?
echo "=== container MPI version (/usr/local/mpi/bin/mpirun --version; required runtime; rc=${CONTAINER_MPI_RC}) ==="
echo "${CONTAINER_MPI_VERSION_OUTPUT:-<no output>}"
if [ "$CONTAINER_MPI_RC" -ne 0 ]; then
  echo "FATAL: container mpirun --version query failed with rc=${CONTAINER_MPI_RC}; the container MPI runtime is required for the rank-map probe and every scored arm (deterministic abort before scored work)" >&2
  exit 1
fi

# --- Pre-bracket hardware-health snapshot (ordinary evidence; must not block) ----
echo "=== pre-bracket hardware-health snapshot (mother node $(hostname)) ==="
nvidia-smi topo -m || echo "warn: nvidia-smi topo failed"
nvidia-smi --query-gpu=index,name,driver_version,temperature.gpu,power.draw,clocks.sm,memory.used,memory.total --format=csv || echo "warn: nvidia-smi query failed"

# De-duplicated hostfile with explicit per-node slot count (GAAS Blocker 8);
# shared by the rank-map probe and all arms in this allocation.
awk -v g="$GPUS" '{ sub(/\r$/,""); if (!seen[$0]++) print $0 " slots=" g }' \
  "$PBS_NODEFILE" > "$PWD/hostfile"
echo "=== hostfile ==="
cat "$PWD/hostfile"

# --- Attempt-evidence guard (never overwrite existing evidence) -------------------
# Every arm writes attempt-specific .out/.err/.status files, and the
# allocation writes one rank-map .log. If any target file already exists,
# this ATTEMPT_TAG was already (partially) used: abort before running
# anything; a rerun must take a new ATTEMPT_TAG.
for LABEL in "${ARM_LABELS[@]}"; do
  ATTEMPT="${EXPERIMENT_ID}_${LABEL}_${ATTEMPT_TAG}"
  for SUFFIX in out err status; do
    if [ -e "${OUTDIR}/${ATTEMPT}.${SUFFIX}" ]; then
      echo "FATAL: refusing to overwrite existing evidence ${OUTDIR}/${ATTEMPT}.${SUFFIX}; resubmit with a new ATTEMPT_TAG" >&2
      exit 1
    fi
  done
done
if [ -e "${OUTDIR}/${EXPERIMENT_ID}_rankmap_${ATTEMPT_TAG}.log" ]; then
  echo "FATAL: refusing to overwrite existing evidence ${OUTDIR}/${EXPERIMENT_ID}_rankmap_${ATTEMPT_TAG}.log; resubmit with a new ATTEMPT_TAG" >&2
  exit 1
fi

# --- Allocation-level rank-map probe (TASK-008 Section 1.4) ------------------------
# One lightweight 16-rank MPI mapping probe BEFORE any scored arm, using the
# SAME shared hostfile and the SAME container mpirun + bridge + daemon flags
# as the scored launch. Diagnostic only: it adds no communication tracing
# and must not alter scientific controls. It preserves global_rank /
# local_rank / hostname for all 16 ranks (confirming 16 MPI ranks, 8
# ranks/node) so the effective local-rank -> GPU -> HCA mapping of every arm
# can later be reconstructed from the rank map plus the per-arm
# UCX-affinity strings.
#
# Two-host topology validation (added 2026-09-28): remote preflight for this
# bracket found g13+g15 as the only currently free eligible pair, and g13
# has NO accepted Phase-0 capture (only g12 and g15 do). Cross-node topology
# identity therefore cannot be assumed from Phase-0 evidence for a
# replacement pair (tasks/TASK-008.md Section 1.8). Inside this SAME single
# 16-rank probe launch - no extra jobs, ranks, arms, or launcher changes -
# only the node-local rank 0 on each allocated host additionally reports
# the local node topology facts into the SAME rank-map log, one line per
# fact, prefixed "topo host=<hostname>": hostname, cpuset,
# Mems_allowed_list, GPU count, presence of each of the eight 400G IB HCAs
# (mlx5_0..mlx5_5, mlx5_8, mlx5_9), and the full nvidia-smi topo -m matrix.
# Reads are node-local /proc, /sys and nvidia-smi inside the same container
# the arms use (in-container nvidia-smi per rank is validated precedent:
# multi-node-test/GAAS_MULTINODE_SETUP.md and the multi-node-test probe
# scripts). The per-host gate below then requires BOTH allocated hosts to
# match the accepted Phase-0 topology before any scored arm.
RANKMAP_LOG="${OUTDIR}/${EXPERIMENT_ID}_rankmap_${ATTEMPT_TAG}.log"
RC=0
apptainer exec --nv \
  -B /opt/pbs:/opt/pbs \
  -B /var/spool/pbs:/var/spool/pbs \
  -B "$REPO_ROOT":"$REPO_ROOT" \
  "$SIF" \
  /usr/local/mpi/bin/mpirun -np "$NPROCS" \
    --hostfile "$PWD/hostfile" \
    --mca plm_rsh_agent "$BRIDGE" \
    --mca plm_rsh_no_tree_spawn 1 \
    --mca plm_rsh_num_concurrent 1 \
    --mca routed direct \
    -x PATH -x LD_LIBRARY_PATH \
    --bind-to none \
    bash -c '
      # Mapping line for every rank (unchanged rank-map evidence).
      if [ "${OMPI_COMM_WORLD_LOCAL_RANK:-}" = "0" ]; then
        # Node-local rank 0 only, once per host: read-only report of the
        # local node topology facts into the same rank-map log. No
        # scientific control is touched; a failed query yields a missing or
        # empty fact, which the per-host gate below fails safely.
        H="$(hostname)"
        echo "topo host=${H} begin local_rank0 global_rank=${OMPI_COMM_WORLD_RANK}"
        L="$(grep -F "Cpus_allowed_list:" /proc/self/status || true)"
        L="${L#*:}"; L="${L//[[:space:]]/}"
        echo "topo host=${H} cpuset=${L:-missing}"
        M="$(grep -F "Mems_allowed_list:" /proc/self/status || true)"
        M="${M#*:}"; M="${M//[[:space:]]/}"
        echo "topo host=${H} mems=${M:-missing}"
        NG="$(nvidia-smi -L 2>/dev/null | wc -l || true)"
        NG="${NG//[[:space:]]/}"
        echo "topo host=${H} ngpus=${NG:-missing}"
        for D in mlx5_0 mlx5_1 mlx5_2 mlx5_3 mlx5_4 mlx5_5 mlx5_8 mlx5_9; do
          if [ -d "/sys/class/infiniband/${D}" ]; then
            echo "topo host=${H} hca=${D} present=yes"
          else
            echo "topo host=${H} hca=${D} present=no"
          fi
        done
        nvidia-smi topo -m 2>/dev/null | while IFS= read -r LINE; do
          echo "topo host=${H} topo_m=${LINE}"
        done
        echo "topo host=${H} end local_rank0"
      fi
      echo "rank=${OMPI_COMM_WORLD_RANK}/${OMPI_COMM_WORLD_SIZE} host=$(hostname) local_rank=${OMPI_COMM_WORLD_LOCAL_RANK}/${OMPI_COMM_WORLD_LOCAL_SIZE}"
    ' \
  > "$RANKMAP_LOG" 2>&1 || RC=$?

# Mechanical gate: the probe must have exited 0, emitted exactly NPROCS rank
# lines, exactly EXPECTED_NODES distinct hostnames, and exactly GPUS rank
# lines per host. Otherwise abort BEFORE any scored arm (launch/rank-mapping
# problem; Track 2 stop); the probe evidence is preserved in RANKMAP_LOG and
# a rerun needs a new ATTEMPT_TAG.
RANK_LINES=$(grep -c "^rank=" "$RANKMAP_LOG" || true)
HOST_COUNT=$(grep "^rank=" "$RANKMAP_LOG" | awk '{ sub(/^host=/, "", $2); seen[$2] = 1 } END { n = 0; for (h in seen) n++; print n }' || true)
MIN_RANKS_PER_HOST=$(grep "^rank=" "$RANKMAP_LOG" | awk '{ sub(/^host=/, "", $2); cnt[$2]++ } END { n = 0; for (h in cnt) { if (n == 0 || cnt[h] < m) m = cnt[h]; n++ } print (n == 0 ? 0 : m) }' || true)
MAX_RANKS_PER_HOST=$(grep "^rank=" "$RANKMAP_LOG" | awk '{ sub(/^host=/, "", $2); cnt[$2]++ } END { n = 0; for (h in cnt) { if (n == 0 || cnt[h] > m) m = cnt[h]; n++ } print (n == 0 ? 0 : m) }' || true)
if [ "$MIN_RANKS_PER_HOST" = "$MAX_RANKS_PER_HOST" ]; then
  RANKS_PER_HOST_SUMMARY="$MIN_RANKS_PER_HOST"
else
  RANKS_PER_HOST_SUMMARY="${MIN_RANKS_PER_HOST}-${MAX_RANKS_PER_HOST}"
fi
echo "=== rank-map probe: rc=${RC} rank_lines=${RANK_LINES} hosts=${HOST_COUNT} ranks_per_host=${RANKS_PER_HOST_SUMMARY} log=${RANKMAP_LOG} ==="
if [ "$RC" -ne 0 ] || [ "$RANK_LINES" -ne "$NPROCS" ] || [ "$HOST_COUNT" -ne "$EXPECTED_NODES" ] || [ "$MIN_RANKS_PER_HOST" -ne "$GPUS" ] || [ "$MAX_RANKS_PER_HOST" -ne "$GPUS" ]; then
  echo "FATAL: rank-map probe failed its mechanical check (rc=${RC} rank_lines=${RANK_LINES} hosts=${HOST_COUNT} ranks_per_host=${RANKS_PER_HOST_SUMMARY}; launch/rank-mapping problem; Track 2 stop; evidence preserved in ${RANKMAP_LOG}; rerun needs a new ATTEMPT_TAG)" >&2
  exit 1
fi

# Per-host topology gate (two-host gate; TASK-008 Sections 1.4 and 1.8):
# verify the local-rank-0 topology report collected by the probe above for
# EVERY distinct host in the rank map (the mechanical gate already fixed the
# host set at exactly EXPECTED_NODES hosts with GPUS ranks each). Each host
# must match the accepted Phase-0 topology the approved C1 GPU-to-HCA PIX
# map requires - the same assertions as the mother-node gate above, now
# applied to BOTH allocated nodes. This is required for replacement-node
# eligibility: the accepted Phase-0 evidence covers only g12 and g15, and
# the 2026-09-28 preflight found g13+g15 as the only currently free
# eligible pair, so g13 must be validated live. Any mismatch means the
# approved HCA map / Phase-0 reuse is invalid on that host: the rank-map
# stage FAILS and aborts BEFORE any scored arm (observational preflight
# failure; Track 2 stop, no auto retry), with the per-host reports
# preserved in RANKMAP_LOG; a rerun needs a new ATTEMPT_TAG.
TOPO_FAILED_HOSTS=""
for TOPO_HOST in $(grep "^rank=" "$RANKMAP_LOG" | awk '{ sub(/^host=/, "", $2); print $2 }' | sort -u); do
  TOPO_OK=1
  if [ "$(grep -c "^topo host=${TOPO_HOST} begin local_rank0" "$RANKMAP_LOG" || true)" -ne 1 ] \
     || [ "$(grep -c "^topo host=${TOPO_HOST} end local_rank0$" "$RANKMAP_LOG" || true)" -ne 1 ]; then
    echo "  host=${TOPO_HOST} topology_gate=FAIL: expected exactly one local-rank-0 topology report (begin=$(grep -c "^topo host=${TOPO_HOST} begin local_rank0" "$RANKMAP_LOG" || true) end=$(grep -c "^topo host=${TOPO_HOST} end local_rank0$" "$RANKMAP_LOG" || true))" >&2
    TOPO_OK=0
  fi
  TOPO_VAL="$(grep "^topo host=${TOPO_HOST} cpuset=" "$RANKMAP_LOG" | head -n 1 || true)"
  if [ "$TOPO_VAL" != "topo host=${TOPO_HOST} cpuset=0-49,56-101" ]; then
    echo "  host=${TOPO_HOST} topology_gate=FAIL: cpuset is not the accepted Phase-0 value 0-49,56-101 (reported: '${TOPO_VAL:-<none>}')" >&2
    TOPO_OK=0
  fi
  TOPO_VAL="$(grep "^topo host=${TOPO_HOST} mems=" "$RANKMAP_LOG" | head -n 1 || true)"
  if [ "$TOPO_VAL" != "topo host=${TOPO_HOST} mems=0-1" ]; then
    echo "  host=${TOPO_HOST} topology_gate=FAIL: Mems_allowed_list is not the accepted Phase-0 value 0-1 (reported: '${TOPO_VAL:-<none>}')" >&2
    TOPO_OK=0
  fi
  TOPO_VAL="$(grep "^topo host=${TOPO_HOST} ngpus=" "$RANKMAP_LOG" | head -n 1 || true)"
  if [ "$TOPO_VAL" != "topo host=${TOPO_HOST} ngpus=8" ]; then
    echo "  host=${TOPO_HOST} topology_gate=FAIL: expected 8 GPUs on this host (reported: '${TOPO_VAL:-<none>}')" >&2
    TOPO_OK=0
  fi
  for TOPO_HCA in mlx5_0 mlx5_1 mlx5_2 mlx5_3 mlx5_4 mlx5_5 mlx5_8 mlx5_9; do
    if ! grep -q "^topo host=${TOPO_HOST} hca=${TOPO_HCA} present=yes$" "$RANKMAP_LOG"; then
      echo "  host=${TOPO_HOST} topology_gate=FAIL: expected IB HCA ${TOPO_HCA} not reported present (accepted Phase-0 inventory: mlx5_0..mlx5_5,mlx5_8,mlx5_9)" >&2
      TOPO_OK=0
    fi
  done
  # Row selection is whitespace-tolerant (same precedent as the mother-node
  # gate): the GPU0/GPU4 NUMA anchors verify the GPU enumeration still
  # matches the Phase-0 identity map the PIX pairing was derived from.
  if ! grep "^topo host=${TOPO_HOST} topo_m=" "$RANKMAP_LOG" | grep "topo_m=[[:space:]]*GPU0[[:space:]]" | grep -Fq "0-49"; then
    echo "  host=${TOPO_HOST} topology_gate=FAIL: GPU0 is not on NUMA0 CPUs 0-49 as in the accepted Phase-0 topology (full matrix preserved in the rank-map log)" >&2
    TOPO_OK=0
  fi
  if ! grep "^topo host=${TOPO_HOST} topo_m=" "$RANKMAP_LOG" | grep "topo_m=[[:space:]]*GPU4[[:space:]]" | grep -Fq "56-101"; then
    echo "  host=${TOPO_HOST} topology_gate=FAIL: GPU4 is not on NUMA1 CPUs 56-101 as in the accepted Phase-0 topology (full matrix preserved in the rank-map log)" >&2
    TOPO_OK=0
  fi
  for TOPO_PAIR in "NIC0: mlx5_0" "NIC1: mlx5_1" "NIC2: mlx5_2" "NIC3: mlx5_3" "NIC4: mlx5_4" "NIC5: mlx5_5" "NIC6: mlx5_8" "NIC7: mlx5_9"; do
    if ! grep "^topo host=${TOPO_HOST} topo_m=" "$RANKMAP_LOG" | grep -Fq "$TOPO_PAIR"; then
      echo "  host=${TOPO_HOST} topology_gate=FAIL: topology legend no longer maps '${TOPO_PAIR}' (approved C1 PIX-paired HCA map invalid on this host)" >&2
      TOPO_OK=0
    fi
  done
  if [ "$TOPO_OK" -eq 1 ]; then
    echo "  host=${TOPO_HOST} topology_gate=PASS (cpuset=0-49,56-101 mems=0-1 gpus=8 hcas=mlx5_0..mlx5_5,mlx5_8,mlx5_9 GPU0->NUMA0(0-49) GPU4->NUMA1(56-101) NIC0..NIC7->mlx5_0..mlx5_9)"
  else
    TOPO_FAILED_HOSTS="${TOPO_FAILED_HOSTS} ${TOPO_HOST}"
  fi
done
if [ -n "$TOPO_FAILED_HOSTS" ]; then
  echo "rankmap_per_host_topology_gate=FAIL (failed hosts:${TOPO_FAILED_HOSTS})" >&2
  echo "FATAL: rank-map probe per-host topology gate failed on${TOPO_FAILED_HOSTS}; a host that does not match the accepted Phase-0 topology invalidates the approved GPU-to-HCA PIX map (TASK-008 Sections 1.4, 1.8: replacement-node eligibility; the 2026-09-28 preflight found g13+g15 as the only free eligible pair and g13 has no accepted Phase-0 capture); aborting BEFORE any scored arm (Track 2 stop; evidence preserved in ${RANKMAP_LOG}; rerun needs a new ATTEMPT_TAG)" >&2
  exit 1
fi
echo "rankmap_per_host_topology_gate=PASS (every allocated host matches the accepted Phase-0 topology; per-host reports preserved in ${RANKMAP_LOG})"

# --- Helper functions --------------------------------------------------------------
# Overall HPL-MxP GFLOP/s from an application .out file (first "GFLOPS = "
# match is the overall score; "LU GFLOPS" appears later), or empty.
extract_gflops() {
  grep -o 'GFLOPS = [0-9.eE+-]*' "$1" 2>/dev/null | head -n 1 | awk '{ print $3 }' || true
}

# LU factorization time (AVG seconds) from "LU seconds: AVG = <v>, ...".
extract_lu_seconds() {
  grep -o 'LU seconds: AVG = [0-9.]*' "$1" 2>/dev/null | head -n 1 | awk '{ print $5 }' || true
}

# LU GFLOP/s from "LU GFLOPS = <v>, per GPU = ...".
extract_lu_gflops() {
  grep -o 'LU GFLOPS = [0-9.eE+-]*' "$1" 2>/dev/null | head -n 1 | awk '{ print $4 }' || true
}

# Iterative-refinement time (AVG seconds) from
# "Iterative Solver seconds: AVG = <v>, ...".
extract_ir_seconds() {
  grep -o 'Iterative Solver seconds: AVG = [0-9.]*' "$1" 2>/dev/null | head -n 1 | awk '{ print $6 }' || true
}

# Solver iteration count from the "Solver iteration <k>, ..." lines.
count_solver_iterations() {
  grep -c '^Solver iteration' "$1" 2>/dev/null || true
}

# Last line of the .out containing the fixed string (raw emitted evidence).
capture_line() {
  grep -F "$2" "$1" 2>/dev/null | tail -n 1 || true
}

# Mechanical IR/LU time ratio (TASK-008 Section 1.4 factual derived value),
# or empty when either input is missing/non-numeric.
ir_lu_ratio() {
  awk -v ir="$1" -v lu="$2" 'BEGIN { if (ir ~ /^[0-9.]+$/ && lu ~ /^[0-9.]+$/ && lu > 0) printf "%.3f", ir / lu }' || true
}

# Cheap, non-perturbing per-HCA xmit counter snapshot on the mother node
# (TASK-008 Section 1.4: lightweight UCX rail/locality evidence; raw
# cumulative counter values, informational only). Called four times:
# before C0a, after C0a/before C1, after C1/before C0b, after C0b.
hca_snapshot() {
  echo "=== HCA port_xmit_data snapshot ${1} $(date --iso-8601=seconds) (mother node $(hostname)) ==="
  for HCA in mlx5_0 mlx5_1 mlx5_2 mlx5_3 mlx5_4 mlx5_5 mlx5_8 mlx5_9; do
    VAL="$(cat "/sys/class/infiniband/${HCA}/ports/1/counters/port_xmit_data" 2>/dev/null || echo unavailable)"
    echo "${HCA} ${VAL}"
  done
}

# Per-arm score/validity/exit records.
declare -A ARM_SCORE ARM_VALID ARM_EXIT
FAILURES=0
INVALID_ARMS=0

# run_arm <key> <label> <gpu-affinity> <mem-affinity|""> <cpu-affinity|""> <ucx-affinity|"">
# Runs one scored arm with the validated Approach-1 launch at the fixed
# controls, then extracts the overall GFLOP/s, LU/IR timing, iteration count,
# memory evidence, and verification verdict, and writes the arm's .status
# file (TASK-008 Section 1.4). A nonzero exit or an invalid verification is
# recorded and the bracket continues (isolated arm failure is evidence; no
# in-script retry).
run_arm() {
  KEY="$1"; LABEL="$2"; GA="$3"; MA="$4"; CA="$5"; UA="$6"
  ATTEMPT="${EXPERIMENT_ID}_${LABEL}_${ATTEMPT_TAG}"
  STDOUT_FILE="${OUTDIR}/${ATTEMPT}.out"
  STDERR_FILE="${OUTDIR}/${ATTEMPT}.err"
  STATUS_FILE="${OUTDIR}/${ATTEMPT}.status"
  START_TS="$(date --iso-8601=seconds)"
  echo "=== arm ${KEY} (${LABEL}) attempt=${ATTEMPT} gpu_affinity=${GA} mem_affinity=${MA:-omitted} cpu_affinity=${CA:-omitted} ucx_affinity=${UA:-omitted} start=${START_TS} ==="

  APP_ARGS=(--n "$N_FIXED" --nb "$NB_FIXED" --nprow "$NPROW" --npcol "$NPCOL" --nporder "$NPORDER")
  APP_ARGS+=(--gpu-affinity "$GA")
  if [ -n "$MA" ]; then APP_ARGS+=(--mem-affinity "$MA"); fi
  if [ -n "$CA" ]; then APP_ARGS+=(--cpu-affinity "$CA"); fi
  if [ -n "$UA" ]; then APP_ARGS+=(--ucx-affinity "$UA"); fi
  APP_ARGS+=(--sloppy-type FP16 --use-mpi-panel-broadcast 0 --use-separate-stream-for-gemm 1)
  APP_ARGS+=(--prioritize-trsm 0 --prioritize-factorization 0 --fill-device 1)
  APP_ARGS+=(--test-loop 1 --skip-tests 0 --monitor-gpu 0)

  RC=0
  apptainer exec --nv \
    -B /opt/pbs:/opt/pbs \
    -B /var/spool/pbs:/var/spool/pbs \
    -B "$REPO_ROOT":"$REPO_ROOT" \
    "$SIF" \
    /usr/local/mpi/bin/mpirun -np "$NPROCS" \
      --hostfile "$PWD/hostfile" \
      --mca plm_rsh_agent "$BRIDGE" \
      --mca plm_rsh_no_tree_spawn 1 \
      --mca plm_rsh_num_concurrent 1 \
      --mca routed direct \
      -x PATH -x LD_LIBRARY_PATH \
      --bind-to none \
      /workspace/hpl-mxp.sh "${APP_ARGS[@]}" \
    > "$STDOUT_FILE" 2> "$STDERR_FILE" || RC=$?

  END_TS="$(date --iso-8601=seconds)"

  # Extract the score, timing/iteration/memory evidence, and the verification
  # verdict (mechanical, TASK-008 Section 1.4 / APPLICATION.md correctness
  # criteria).
  SCORE="$(extract_gflops "$STDOUT_FILE")"
  LU_SECONDS="$(extract_lu_seconds "$STDOUT_FILE")"
  LU_GFLOPS="$(extract_lu_gflops "$STDOUT_FILE")"
  IR_SECONDS="$(extract_ir_seconds "$STDOUT_FILE")"
  SOLVER_ITERATIONS="$(count_solver_iterations "$STDOUT_FILE")"
  IR_LU_RATIO="$(ir_lu_ratio "${IR_SECONDS}" "${LU_SECONDS}")"
  HOST_MEM_LINE="$(capture_line "$STDOUT_FILE" 'Per process host memory consumption MAX =')"
  DEVICE_MEM_LINE="$(capture_line "$STDOUT_FILE" 'Per process device memory consumption MAX =')"
  MATGEN_HEADROOM_LINE="$(capture_line "$STDOUT_FILE" 'Per process memory available MIN system =')"
  VERDICT="INVALID"
  RES_VAL=""
  RES_LINE="$(grep -F '||Ax-b||_oo / (EPS' "$STDOUT_FILE" 2>/dev/null | tail -n 1 || true)"
  if [ -n "$RES_LINE" ]; then
    case "$RES_LINE" in
      *PASSED*) VERDICT="PASSED" ;;
      *FAILED*) VERDICT="FAILED" ;;
    esac
    case "$RES_LINE" in
      *[Nn][Aa][Nn]*|*[Ii][Nn][Ff]*) VERDICT="INVALID_NONFINITE" ;;
    esac
    RES_VAL="$(printf '%s\n' "$RES_LINE" | sed -E 's/^.*= +([0-9][0-9.Ee+-]*).*$/\1/' || true)"
    if [ -z "$RES_VAL" ]; then VERDICT="INVALID"; fi
  fi
  if grep -Fq 'FAILED' "$STDOUT_FILE" 2>/dev/null; then VERDICT="FAILED"; fi
  if [ -z "$SCORE" ]; then VERDICT="INVALID_NO_SCORE"; fi
  if ! grep -Fq '****** Matrix Generation ******' "$STDOUT_FILE" 2>/dev/null; then VERDICT="INVALID_NO_MATGEN"; fi
  if ! grep -Fq 'LU seconds: AVG =' "$STDOUT_FILE" 2>/dev/null; then VERDICT="INVALID_NO_LU"; fi
  if [ "$RC" -ne 0 ]; then VERDICT="INVALID_EXIT_${RC}"; fi

  ARM_SCORE[$KEY]="$SCORE"
  ARM_EXIT[$KEY]="$RC"
  if [ "$VERDICT" = "PASSED" ]; then
    ARM_VALID[$KEY]="yes"
  else
    ARM_VALID[$KEY]="no"
    INVALID_ARMS=$((INVALID_ARMS + 1))
  fi
  if [ "$RC" -ne 0 ]; then
    FAILURES=$((FAILURES + 1))
  fi

  if [ "$RC" -ne 0 ]; then
    echo "=== arm ${KEY} (${LABEL}) FAILED exit_status=${RC} verdict=${VERDICT} end=${END_TS}; continuing with the next arm ==="
  else
    echo "=== arm ${KEY} (${LABEL}) exit_status=0 verdict=${VERDICT} gflops=${SCORE:-none} end=${END_TS} ==="
  fi
  {
    echo "attempt=${ATTEMPT}"
    echo "experiment_id=${EXPERIMENT_ID}"
    echo "bracket_arm=${KEY}"
    echo "arm_label=${LABEL}"
    echo "pbs_job_id=${PBS_JOBID:-unknown}"
    echo "queue=${QUEUE}"
    echo "nodes=$(sort -u "$PBS_NODEFILE" | paste -sd' ')"
    echo "gpu_affinity=${GA}"
    echo "mem_affinity=${MA:-omitted}"
    echo "cpu_affinity=${CA:-omitted}"
    echo "ucx_affinity=${UA:-omitted}"
    echo "n=${N_FIXED}"
    echo "nb=${NB_FIXED}"
    echo "nprow=${NPROW}"
    echo "npcol=${NPCOL}"
    echo "nporder=${NPORDER}"
    echo "fixed_controls=OMP_NUM_THREADS=8 --n 429056 --nb 3072 --nprow 4 --npcol 4 --nporder row --gpu-affinity ${GA} --mem-affinity omitted --cpu-affinity omitted --sloppy-type FP16 --use-mpi-panel-broadcast 0 --use-separate-stream-for-gemm 1 --prioritize-trsm 0 --prioritize-factorization 0 --fill-device 1 --test-loop 1 --skip-tests 0 --monitor-gpu 0"
    echo "omp_policy=OMP_NUM_THREADS=8 only; OMP_PLACES/OMP_PROC_BIND unset (installed launcher package defaults apply unchanged)"
    echo "start=${START_TS}"
    echo "end=${END_TS}"
    echo "exit_status=${RC}"
    echo "gflops=${SCORE:-unknown}"
    echo "lu_seconds=${LU_SECONDS:-unknown}"
    echo "lu_gflops=${LU_GFLOPS:-unknown}"
    echo "ir_seconds=${IR_SECONDS:-unknown}"
    echo "solver_iterations=${SOLVER_ITERATIONS:-unknown}"
    echo "ir_lu_ratio=${IR_LU_RATIO:-unknown}"
    echo "host_memory=${HOST_MEM_LINE:-unknown}"
    echo "device_memory=${DEVICE_MEM_LINE:-unknown}"
    echo "matgen_headroom=${MATGEN_HEADROOM_LINE:-unknown}"
    echo "verification=${VERDICT}"
    echo "normalized_residual=${RES_VAL:-unknown}"
    echo "stdout=${STDOUT_FILE}"
    echo "stderr=${STDERR_FILE}"
  } > "$STATUS_FILE"
}

# --- The bracket: C0a -> C1 -> C0b (TASK-008 Sections 1.3, 1.7) --------------------
# Exactly three scored arms, sequentially, in this one allocation, bracketed
# by the four cheap mother-node per-HCA port_xmit_data snapshots (before C0a,
# after C0a/before C1, after C1/before C0b, after C0b; informational only).
# GPU/memory/CPU placement is fixed for every arm; only the UCX policy varies.
hca_snapshot "before-c0a"
run_arm c0a c0a-ucx-auto "$GPU_AFFINITY_FIXED" "" "" ""
hca_snapshot "after-c0a-before-c1"
run_arm c1 c1-ucx-pix "$GPU_AFFINITY_FIXED" "" "" "$C1_UCX"
hca_snapshot "after-c1-before-c0b"
run_arm c0b c0b-ucx-auto "$GPU_AFFINITY_FIXED" "" "" ""
hca_snapshot "after-c0b"

# --- Post-bracket hardware-health snapshot (ordinary evidence; must not block) ----
echo "=== post-bracket hardware-health snapshot (mother node $(hostname)) ==="
nvidia-smi topo -m || echo "warn: nvidia-smi topo failed"
nvidia-smi --query-gpu=index,name,driver_version,temperature.gpu,power.draw,clocks.sm,memory.used,memory.total --format=csv || echo "warn: nvidia-smi query failed"

# --- Overall bracket result ---------------------------------------------------------
# Factual per-arm recap only (no percentages, no ranking, no retain/reject
# decision; the strategic interpretation is reserved for the post-task
# Strategic Analyst via ANALYSE_RESULTS, TASK-008 Section 1.5). Nonzero
# overall if any arm exited nonzero or failed verification, even though all
# three arms were still attempted and their evidence preserved. Do not
# classify success from exit status alone; the per-arm .status files and
# .out verification markers are the validity record.
echo "=== bracket recap (factual scores only; interpretation reserved for ANALYSE_RESULTS) ==="
for i in "${!ARM_KEYS[@]}"; do
  KEY="${ARM_KEYS[$i]}"
  echo "arm=${KEY} label=${ARM_LABELS[$i]} gflops=${ARM_SCORE[$KEY]:-none} valid=${ARM_VALID[$KEY]:-no} exit=${ARM_EXIT[$KEY]:-unknown}"
done
NARMS=${#ARM_KEYS[@]}
if [ "$FAILURES" -ne 0 ] || [ "$INVALID_ARMS" -ne 0 ]; then
  echo "=== HPL-MxP 2x8-GAAS phase2c-ucx-affinity-confirm bracket finished with ${FAILURES}/${NARMS} arm(s) exited nonzero and ${INVALID_ARMS}/${NARMS} arm(s) without PASSED verification (tag ${ATTEMPT_TAG}) ==="
  exit 1
fi
echo "=== HPL-MxP 2x8-GAAS phase2c-ucx-affinity-confirm bracket complete: all ${NARMS} arm(s) exited 0 with PASSED verification (tag ${ATTEMPT_TAG}) ==="
