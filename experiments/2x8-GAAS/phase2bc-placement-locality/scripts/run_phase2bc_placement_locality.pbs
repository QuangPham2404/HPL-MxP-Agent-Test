#!/bin/bash
# HPL-MxP 2x8-GAAS Phase-2B/2C placement/locality sweep: 2 GAAS nodes x 8 H200
# GPUs (16 ranks). The ten TASK-007-approved Stage-A/B/C arms run sequentially
# within this single PBS allocation at the retained Phase-2A operating point
# N=429056, NB=3072, 4x4 row, OMP_NUM_THREADS=8 and the fixed retained
# scientific controls; ONLY the physical placement controls vary
# (GPU affinity x memory affinity -> CPU affinity -> UCX device affinity),
# per the exact approved arm set and pre-authorized mechanical carry-forward
# rules in tasks/TASK-007.md Sections 1.4B-1.4D.
#
# Purpose: TASK-007 Phase-2B/2C same-allocation placement/locality sweep. The
# Stage-B CPU masks and the Stage-C HCA map are derived INSIDE this script
# from the retained G0/G1 GPU map exactly as specified in TASK-007 Section
# 1.4 (no other masks or maps exist in this script). All 10 arms MUST share
# this one allocation (TASK-007 Sections 1.4F, 1.7.10): there is deliberately
# NO arm-subset option. Every approved arm is attempted in the exact order
# A0,A1,A2,A3 -> B0,B1,B2,B3 -> C0,C1; an arm with a nonzero exit or an
# invalid verification is recorded as evidence and the sweep CONTINUES with
# the next arm (isolated affinity-candidate failure is evidence; TASK-007
# Section 1.9), with two documented stop conditions handled mechanically:
# (1) an invalid A0 control stops the sweep before Stage B/C (no valid
# branching basis; TASK-007 Section 1.9), and (2) an allocated
# cpuset/topology that differs from the accepted Phase-0 topology aborts
# before any scored arm (the approved CPU/HCA strings would no longer be
# valid; TASK-007 Section 1.9). The job returns nonzero overall if any arm
# exited nonzero or failed verification.
#
# Expected working directory: this experiment directory
# (experiments/2x8-GAAS/phase2bc-placement-locality/) on GAAS. Submit with
# (the queue is deliberately NOT selected in this script; pass an approved
# one at qsub):
#   qsub -q <gpu_as|gpu_ded> -v "ATTEMPT_TAG=v1" \
#        -o outputs/2x8-GAAS-phase2bc-placement-locality_v1.o \
#        -e outputs/2x8-GAAS-phase2bc-placement-locality_v1.e \
#        scripts/run_phase2bc_placement_locality.pbs
#
# Inputs (environment, via qsub -v):
#   ATTEMPT_TAG  REQUIRED sweep attempt tag (e.g. v1); it names every
#                per-arm evidence file. A rerun must use a new tag.
# Outputs: per-arm application stdout/stderr and status files under
#   outputs/2x8-GAAS-phase2bc-placement-locality_<arm>_<ATTEMPT_TAG>.{out,err,status};
#   the allocation-level rank-map log
#   outputs/2x8-GAAS-phase2bc-placement-locality_rankmap_<ATTEMPT_TAG>.log;
#   the mechanical carry-forward decision log
#   outputs/2x8-GAAS-phase2bc-placement-locality_carryforward_<ATTEMPT_TAG>.log;
#   PBS-level stdout/stderr names are passed at qsub with -o/-e (this script
#   deliberately has no #PBS -o/-e directives). Existing attempt files are
#   never overwritten: the script aborts before running anything if a target
#   file already exists. An arm killed mid-run (e.g. by walltime) keeps its
#   .out/.err but has no .status file.
# Assumptions: approved container and modules exist on GAAS; one GPU per MPI
# process; validated Approach-1 multinode launch (container mpirun +
# rsh_pbsdsh_container.sh bridge; see multi-node-test/GAAS_MULTINODE_SETUP.md);
# the installed v26.02 launcher implements the captured affinity semantics
# (--gpu-affinity/--mem-affinity/--cpu-affinity/--ucx-affinity per local rank;
# see todo.md captured launcher and the flag check evidence in
# experiments/2x8-GAAS/baseline/outputs/hplmxp_v2602_flag_check_v1.log).
#
# Queue policy: no queue is preselected here. TASK-007 authorizes only gpu_as
# and gpu_ded; the submitting qsub must pass -q explicitly, and this script
# verifies the actually-assigned queue and aborts on anything else.
# select=2:ngpus=8 (no mpiprocs) may likewise be overridden on the qsub
# command line by a documented host-pinned select (see README.md).

#PBS -N 2x8_phase2bc_place
#PBS -P hpc_ebslee
#PBS -l select=2:ngpus=8
#PBS -l place=scatter
#PBS -l walltime=01:30:00

set -euo pipefail

# --- Experiment metadata --------------------------------------------------------
cd "$PBS_O_WORKDIR"
EXPERIMENT_ID="2x8-GAAS-phase2bc-placement-locality"
OUTDIR="$PWD/outputs"
mkdir -p "$OUTDIR"

ATTEMPT_TAG="${ATTEMPT_TAG:-}"
if [ -z "$ATTEMPT_TAG" ]; then
  echo "FATAL: ATTEMPT_TAG is required (e.g. -v \"ATTEMPT_TAG=v1\"); it names this sweep's evidence files" >&2
  exit 1
fi

# Only gpu_as and gpu_ded are authorized for TASK-007 (Section 1.7). The
# queue is not preselected in this script; fail fast if PBS assigned any
# other queue (including an omitted -q falling through to a default queue).
QUEUE="${PBS_O_QUEUE:-unknown}"
case "$QUEUE" in
  gpu_as|gpu_ded) ;;
  *) echo "FATAL: queue '${QUEUE}' is not authorized for TASK-007 (only gpu_as or gpu_ded); pass -q at qsub" >&2; exit 1 ;;
esac

# --- Fixed scientific controls (TASK-007 Section 1.4A) ---------------------------
# Only physical placement controls vary (GPU/memory affinity in Stage A, CPU
# affinity in Stage B, UCX device affinity in Stage C). Everything below is
# fixed and identical for all 10 arms.
N_FIXED=429056
NB_FIXED=3072
NPROW=4
NPCOL=4
NPORDER=row

# Approved Stage-A GPU/memory maps (TASK-007 Section 1.4B, exact strings).
# G0 identity: local ranks 0-3 -> GPU0-3 (NUMA0), local ranks 4-7 -> GPU4-7
# (NUMA1); process rows are NUMA-local under the retained 4x4-row grid.
G0_GPU="0:1:2:3:4:5:6:7"
G0_MEM="0:0:0:0:1:1:1:1"
# G1 column-local: same-node process-column pairs (0,4),(1,5),(2,6),(3,7)
# become NUMA-local (rank pair -> GPU pair -> one NUMA domain).
G1_GPU="0:4:2:6:1:5:3:7"
G1_MEM="0:1:0:1:0:1:0:1"

# Approved Stage-B CPU masks (TASK-007 Section 1.4C, exact strings; selected
# by the retained G0/G1 map). Ranges respect the Phase-0 PBS-visible cpuset
# 0-49,56-101 (50 CPUs per NUMA node).
G0_B1="0-49:0-49:0-49:0-49:56-101:56-101:56-101:56-101"
G0_B2="0-9:10-19:20-29:30-39:56-65:66-75:76-85:86-95"
G0_B3="0-7:8-15:16-23:24-31:56-63:64-71:72-79:80-87"
G1_B1="0-49:56-101:0-49:56-101:0-49:56-101:0-49:56-101"
G1_B2="0-9:56-65:10-19:66-75:20-29:76-85:30-39:86-95"
G1_B3="0-7:56-63:8-15:64-71:16-23:72-79:24-31:80-87"

# Approved Stage-C PIX-paired HCA maps (TASK-007 Section 1.4D, exact strings;
# selected by the retained G0/G1 map). Each local rank is mapped to the 400G
# IB HCA that is PIX-paired with its assigned GPU (Phase-0 topology:
# GPU0-7 -> mlx5_0,mlx5_1,mlx5_2,mlx5_3,mlx5_4,mlx5_5,mlx5_8,mlx5_9).
G0_UCX="mlx5_0:mlx5_1:mlx5_2:mlx5_3:mlx5_4:mlx5_5:mlx5_8:mlx5_9"
G1_UCX="mlx5_0:mlx5_4:mlx5_2:mlx5_8:mlx5_1:mlx5_5:mlx5_3:mlx5_9"

# The ten approved arms, in the exact execution order (TASK-007 Sections
# 1.4B-1.4F). Arm labels name the stage and policy; the Stage-B/C argument
# strings are derived from the retained Stage-A map at run time.
ARM_KEYS=(a0 a1 a2 a3 b0 b1 b2 b3 c0 c1)
ARM_LABELS=(a0-identity-nomem a1-identity-mem a2-columnlocal-nomem a3-columnlocal-mem \
            b0-cpu-free b1-cpu-loose b2-cpu-medium b3-cpu-strict \
            c0-ucx-auto c1-ucx-pix)

echo "experiment_id=${EXPERIMENT_ID}"
echo "attempt_tag=${ATTEMPT_TAG}"
echo "pbs_job_id=${PBS_JOBID:-unknown}"
echo "queue=${QUEUE}"
echo "project=hpc_ebslee"
date --iso-8601=seconds
echo "fixed scientific controls (identical across all 10 arms; only GPU/memory/CPU/UCX placement varies):"
echo "OMP_NUM_THREADS=8 (OMP_PLACES/OMP_PROC_BIND deliberately unset in the job environment; the installed launcher's package defaults apply unchanged, same as TASK-004/TASK-005/TASK-006)"
echo "--n 429056"
echo "--nb 3072"
echo "--nprow 4 --npcol 4 --nporder row"
echo "--sloppy-type FP16"
echo "--use-mpi-panel-broadcast 0"
echo "--use-separate-stream-for-gemm 1"
echo "--prioritize-trsm 0"
echo "--prioritize-factorization 0"
echo "--fill-device 1"
echo "--test-loop 1"
echo "--skip-tests 0"
echo "--monitor-gpu 0"
echo "deferred communication controls NOT used anywhere in this sweep: --ucx-tls / UCX_TLS, --use-mpi-panel-broadcast changes, --mpi-use-mpi, --use-host-mpi, --u-panel-chunk-nbs"
echo "stage order: A0,A1,A2,A3 -> B0,B1,B2,B3 -> C0,C1 with pre-authorized >2.0% mechanical carry-forward (TASK-007 Sections 1.4B-1.4D)"
echo "arm_count=${#ARM_KEYS[@]}"

# --- Locate repo root and the validated launch bridge ---------------------------
# Submission dir is experiments/2x8-GAAS/phase2bc-placement-locality/, so the
# repo root is three levels up.
REPO_ROOT="$(cd "${PBS_O_WORKDIR}/../../.." && pwd)"
BRIDGE="${REPO_ROOT}/multi-node-test/rsh_pbsdsh_container.sh"
SIF="/home/pham0094/hpl_hpcg_hplmxp_container/hpc-benchmarks_26.02.sif"

if [ ! -f "$BRIDGE" ]; then
  echo "FATAL: bridge not found at ${BRIDGE}; submit from the experiment directory (experiments/2x8-GAAS/phase2bc-placement-locality/)" >&2
  exit 1
fi
if [ ! -f "$SIF" ]; then
  echo "FATAL: container image not found: ${SIF}" >&2
  exit 1
fi

# --- Allocation checks (place=scatter, no mpiprocs; fixed 4x4 grid) ---------------
GPUS=8                                   # GPUs (and ranks) per node
EXPECTED_NODES=2
NNODES=$(sort -u "$PBS_NODEFILE" | wc -l)
if [ "$NNODES" -ne "$EXPECTED_NODES" ]; then
  echo "FATAL: expected ${EXPECTED_NODES} distinct nodes, got ${NNODES}" >&2
  exit 1
fi
NPROCS=$((NNODES * GPUS))
if [ "$NPROCS" -ne $((NPROW * NPCOL)) ]; then
  echo "FATAL: fixed grid ${NPROW}x${NPCOL} requires $((NPROW * NPCOL)) ranks, got ${NPROCS}" >&2
  exit 1
fi

echo "layout=${NNODES} nodes x ${GPUS} GPUs = ${NPROCS} ranks"
echo "grid=nprow=4 x npcol=4, nporder=row (fixed for every arm)"
echo "nodes=$(sort -u "$PBS_NODEFILE" | paste -sd' ')"
echo "bridge=${BRIDGE}"
echo "container=${SIF}"

# --- Phase-0 topology consistency gates (TASK-007 Sections 1.4G, 1.9) ------------
# The approved CPU masks and PIX-paired HCA strings are valid only for the
# accepted Phase-0 topology. Verify the mother node (where this script and
# rank 0 run) matches before any scored arm; cross-node identity is covered
# by the accepted Phase-0 evidence (scripts/probing_report.md 2x8 supplement)
# and measured by the rank-map probe below. A mismatch means the exact
# approved CPU/HCA strings are no longer valid -> abort before scored work.
CPUSET="$(grep -F 'Cpus_allowed_list:' /proc/self/status | awk '{print $2}')"
if [ "$CPUSET" != "0-49,56-101" ]; then
  echo "FATAL: allocated cpuset '${CPUSET}' differs from the accepted Phase-0 cpuset '0-49,56-101'; the approved Stage-B CPU masks are no longer valid (TASK-007 Section 1.9)" >&2
  exit 1
fi
MEMSET="$(grep -F 'Mems_allowed_list:' /proc/self/status | awk '{print $2}')"
if [ "$MEMSET" != "0-1" ]; then
  echo "FATAL: allocated Mems_allowed_list '${MEMSET}' differs from the accepted Phase-0 value '0-1'; the approved Stage-A memory-affinity indices are no longer valid (TASK-007 Section 1.9)" >&2
  exit 1
fi
NGPU_VISIBLE="$(nvidia-smi -L 2>/dev/null | wc -l || true)"
if [ "$NGPU_VISIBLE" -ne "$GPUS" ]; then
  echo "FATAL: expected ${GPUS} GPUs on the mother node, saw '${NGPU_VISIBLE}'" >&2
  exit 1
fi
for HCA in mlx5_0 mlx5_1 mlx5_2 mlx5_3 mlx5_4 mlx5_5 mlx5_8 mlx5_9; do
  if [ ! -d "/sys/class/infiniband/${HCA}" ]; then
    echo "FATAL: expected IB HCA ${HCA} is absent; the approved Stage-C HCA strings are no longer valid (TASK-007 Section 1.9)" >&2
    exit 1
  fi
done
TOPO_MATRIX="$(nvidia-smi topo -m 2>/dev/null || true)"
echo "=== mother-node GPU topology matrix (gate input + evidence) ==="
echo "$TOPO_MATRIX"
if ! printf '%s\n' "$TOPO_MATRIX" | grep '^GPU0' | grep -Fq '0-49'; then
  echo "FATAL: GPU0 is not on NUMA0 CPUs 0-49 as in the accepted Phase-0 topology; the approved G0/G1 maps are no longer valid (TASK-007 Section 1.9)" >&2
  exit 1
fi
if ! printf '%s\n' "$TOPO_MATRIX" | grep '^GPU4' | grep -Fq '56-101'; then
  echo "FATAL: GPU4 is not on NUMA1 CPUs 56-101 as in the accepted Phase-0 topology; the approved G0/G1 maps are no longer valid (TASK-007 Section 1.9)" >&2
  exit 1
fi
for PAIR in "NIC0: mlx5_0" "NIC1: mlx5_1" "NIC2: mlx5_2" "NIC3: mlx5_3" "NIC4: mlx5_4" "NIC5: mlx5_5" "NIC6: mlx5_8" "NIC7: mlx5_9"; do
  if ! printf '%s\n' "$TOPO_MATRIX" | grep -Fq "$PAIR"; then
    echo "FATAL: topology legend no longer maps '${PAIR}'; the approved PIX-paired HCA strings are no longer valid (TASK-007 Section 1.9)" >&2
    exit 1
  fi
done
echo "topology_gate=PASS (cpuset=${CPUSET} mems=${MEMSET} gpus=${NGPU_VISIBLE} hcas=mlx5_0..mlx5_5,mlx5_8,mlx5_9 GPU0->NUMA0 GPU4->NUMA1 NIC legend matches Phase-0)"

# --- Environment (validated module set) ------------------------------------------
module purge
module load apptainer/1.4.1 nvhpc/26.3 squashfuse/0.5.2 gocryptfs/2.5.0
chmod +x "$BRIDGE"
# Supplied configuration sets OMP_NUM_THREADS=8 only; OMP_PLACES and
# OMP_PROC_BIND are deliberately not set (not supplied, same as
# TASK-004/TASK-005/TASK-006; the installed launcher applies its package
# defaults OMP_PROC_BIND=TRUE / OMP_PLACES=sockets inside the container).
export OMP_NUM_THREADS=8

# --- Pre-sweep hardware-health snapshot (ordinary evidence; must not block) ------
echo "=== pre-sweep hardware-health snapshot (mother node $(hostname)) ==="
nvidia-smi topo -m || echo "warn: nvidia-smi topo failed"
nvidia-smi --query-gpu=index,name,driver_version,temperature.gpu,power.draw,clocks.sm,memory.used,memory.total --format=csv || echo "warn: nvidia-smi query failed"

# De-duplicated hostfile with explicit per-node slot count (GAAS Blocker 8);
# shared by the rank-map probe and all arms in this allocation.
awk -v g="$GPUS" '{ sub(/\r$/,""); if (!seen[$0]++) print $0 " slots=" g }' \
  "$PBS_NODEFILE" > "$PWD/hostfile"
echo "=== hostfile ==="
cat "$PWD/hostfile"

# --- Attempt-evidence guard (never overwrite existing evidence) -------------------
# Every arm writes attempt-specific .out/.err/.status files, and the
# allocation writes one rank-map .log and one carry-forward .log. If any
# target file already exists, this ATTEMPT_TAG was already (partially) used:
# abort before running anything; a rerun must take a new ATTEMPT_TAG.
for LABEL in "${ARM_LABELS[@]}"; do
  ATTEMPT="${EXPERIMENT_ID}_${LABEL}_${ATTEMPT_TAG}"
  for SUFFIX in out err status; do
    if [ -e "${OUTDIR}/${ATTEMPT}.${SUFFIX}" ]; then
      echo "FATAL: refusing to overwrite existing evidence ${OUTDIR}/${ATTEMPT}.${SUFFIX}; resubmit with a new ATTEMPT_TAG" >&2
      exit 1
    fi
  done
done
if [ -e "${OUTDIR}/${EXPERIMENT_ID}_rankmap_${ATTEMPT_TAG}.log" ]; then
  echo "FATAL: refusing to overwrite existing evidence ${OUTDIR}/${EXPERIMENT_ID}_rankmap_${ATTEMPT_TAG}.log; resubmit with a new ATTEMPT_TAG" >&2
  exit 1
fi
if [ -e "${OUTDIR}/${EXPERIMENT_ID}_carryforward_${ATTEMPT_TAG}.log" ]; then
  echo "FATAL: refusing to overwrite existing evidence ${OUTDIR}/${EXPERIMENT_ID}_carryforward_${ATTEMPT_TAG}.log; resubmit with a new ATTEMPT_TAG" >&2
  exit 1
fi

# --- Allocation-level rank-map probe (TASK-007 Section 1.4G) ----------------------
# One lightweight 16-rank MPI mapping probe BEFORE any scored arm, using the
# SAME shared hostfile and the SAME container mpirun + bridge + daemon flags
# as the scored launch. Diagnostic only: it adds no topology profiling or
# communication tracing and must not alter scientific controls. It preserves
# global_rank / local_rank / hostname for all 16 ranks (TASK-007 Section
# 1.4G) so the effective local-rank -> GPU -> HCA mapping of every arm can
# later be reconstructed from the rank map plus the per-arm affinity strings.
RANKMAP_LOG="${OUTDIR}/${EXPERIMENT_ID}_rankmap_${ATTEMPT_TAG}.log"
RC=0
apptainer exec --nv \
  -B /opt/pbs:/opt/pbs \
  -B /var/spool/pbs:/var/spool/pbs \
  -B "$REPO_ROOT":"$REPO_ROOT" \
  "$SIF" \
  /usr/local/mpi/bin/mpirun -np "$NPROCS" \
    --hostfile "$PWD/hostfile" \
    --mca plm_rsh_agent "$BRIDGE" \
    --mca plm_rsh_no_tree_spawn 1 \
    --mca plm_rsh_num_concurrent 1 \
    --mca routed direct \
    -x PATH -x LD_LIBRARY_PATH \
    --bind-to none \
    bash -c 'echo "rank=$OMPI_COMM_WORLD_RANK/$OMPI_COMM_WORLD_SIZE host=$(hostname) local_rank=$OMPI_COMM_WORLD_LOCAL_RANK/$OMPI_COMM_WORLD_LOCAL_SIZE"' \
  > "$RANKMAP_LOG" 2>&1 || RC=$?

# Mechanical gate: the probe must have exited 0, emitted exactly NPROCS rank
# lines, exactly EXPECTED_NODES distinct hostnames, and exactly GPUS rank
# lines per host. Otherwise abort BEFORE any scored arm; the probe evidence
# is preserved in RANKMAP_LOG and a rerun needs a new ATTEMPT_TAG.
RANK_LINES=$(grep -c "^rank=" "$RANKMAP_LOG" || true)
HOST_COUNT=$(grep "^rank=" "$RANKMAP_LOG" | awk '{ sub(/^host=/, "", $2); seen[$2] = 1 } END { n = 0; for (h in seen) n++; print n }' || true)
MIN_RANKS_PER_HOST=$(grep "^rank=" "$RANKMAP_LOG" | awk '{ sub(/^host=/, "", $2); cnt[$2]++ } END { n = 0; for (h in cnt) { if (n == 0 || cnt[h] < m) m = cnt[h]; n++ } print (n == 0 ? 0 : m) }' || true)
MAX_RANKS_PER_HOST=$(grep "^rank=" "$RANKMAP_LOG" | awk '{ sub(/^host=/, "", $2); cnt[$2]++ } END { n = 0; for (h in cnt) { if (n == 0 || cnt[h] > m) m = cnt[h]; n++ } print (n == 0 ? 0 : m) }' || true)
if [ "$MIN_RANKS_PER_HOST" = "$MAX_RANKS_PER_HOST" ]; then
  RANKS_PER_HOST_SUMMARY="$MIN_RANKS_PER_HOST"
else
  RANKS_PER_HOST_SUMMARY="${MIN_RANKS_PER_HOST}-${MAX_RANKS_PER_HOST}"
fi
echo "=== rank-map probe: rc=${RC} rank_lines=${RANK_LINES} hosts=${HOST_COUNT} ranks_per_host=${RANKS_PER_HOST_SUMMARY} log=${RANKMAP_LOG} ==="
if [ "$RC" -ne 0 ] || [ "$RANK_LINES" -ne "$NPROCS" ] || [ "$HOST_COUNT" -ne "$EXPECTED_NODES" ] || [ "$MIN_RANKS_PER_HOST" -ne "$GPUS" ] || [ "$MAX_RANKS_PER_HOST" -ne "$GPUS" ]; then
  echo "FATAL: rank-map probe failed its mechanical check (rc=${RC} rank_lines=${RANK_LINES} hosts=${HOST_COUNT} ranks_per_host=${RANKS_PER_HOST_SUMMARY}; mapping/launch problem; evidence preserved in ${RANKMAP_LOG}; rerun needs a new ATTEMPT_TAG)" >&2
  exit 1
fi

# --- Helper functions --------------------------------------------------------------
# Overall HPL-MxP GFLOP/s from an application .out file (first "GFLOPS = "
# match is the overall score; "LU GFLOPS" appears later), or empty.
extract_gflops() {
  grep -o 'GFLOPS = [0-9.eE+-]*' "$1" 2>/dev/null | head -n 1 | awk '{ print $3 }' || true
}

# gt2pct <candidate> <base>: returns 0 iff candidate is strictly >2.0% above
# base (the TASK-007 pre-authorized gate; a value exactly 2.0% above does NOT
# clear the gate).
gt2pct() {
  awk -v c="$1" -v b="$2" 'BEGIN { exit (c > b * 1.02) ? 0 : 1 }'
}

# gt_num <a> <b>: returns 0 iff a > b (plain numeric comparison for
# tie-breaking between arms that already cleared their gate).
gt_num() {
  awk -v a="$1" -v b="$2" 'BEGIN { exit (a > b) ? 0 : 1 }'
}

# Cheap, non-perturbing per-HCA xmit counter snapshot on the mother node
# (TASK-007 Section 1.4G: lightweight Stage-C rail/locality evidence; raw
# cumulative counter values, informational only).
hca_snapshot() {
  echo "=== HCA port_xmit_data snapshot ${1} $(date --iso-8601=seconds) (mother node $(hostname)) ==="
  for HCA in mlx5_0 mlx5_1 mlx5_2 mlx5_3 mlx5_4 mlx5_5 mlx5_8 mlx5_9; do
    VAL="$(cat "/sys/class/infiniband/${HCA}/ports/1/counters/port_xmit_data" 2>/dev/null || echo unavailable)"
    echo "${HCA} ${VAL}"
  done
}

# Mechanical carry-forward decision log (evidence; also echoed to job stdout).
CFLOG="${OUTDIR}/${EXPERIMENT_ID}_carryforward_${ATTEMPT_TAG}.log"
cflog() { echo "$*" | tee -a "$CFLOG"; }

# Per-arm score/validity/exit records.
declare -A ARM_SCORE ARM_VALID ARM_EXIT
FAILURES=0
INVALID_ARMS=0

# run_arm <key> <label> <gpu-affinity> <mem-affinity|""> <cpu-affinity|""> <ucx-affinity|"">
# Runs one scored arm with the validated Approach-1 launch at the fixed
# controls, then extracts the overall GFLOP/s and verification verdict and
# writes the arm's .status file. A nonzero exit or an invalid verification is
# recorded and the sweep continues (isolated arm failure is evidence).
run_arm() {
  KEY="$1"; LABEL="$2"; GA="$3"; MA="$4"; CA="$5"; UA="$6"
  ATTEMPT="${EXPERIMENT_ID}_${LABEL}_${ATTEMPT_TAG}"
  STDOUT_FILE="${OUTDIR}/${ATTEMPT}.out"
  STDERR_FILE="${OUTDIR}/${ATTEMPT}.err"
  STATUS_FILE="${OUTDIR}/${ATTEMPT}.status"
  START_TS="$(date --iso-8601=seconds)"
  echo "=== arm ${KEY} (${LABEL}) attempt=${ATTEMPT} gpu_affinity=${GA} mem_affinity=${MA:-omitted} cpu_affinity=${CA:-omitted} ucx_affinity=${UA:-omitted} start=${START_TS} ==="

  APP_ARGS=(--n "$N_FIXED" --nb "$NB_FIXED" --nprow "$NPROW" --npcol "$NPCOL" --nporder "$NPORDER")
  APP_ARGS+=(--gpu-affinity "$GA")
  if [ -n "$MA" ]; then APP_ARGS+=(--mem-affinity "$MA"); fi
  if [ -n "$CA" ]; then APP_ARGS+=(--cpu-affinity "$CA"); fi
  if [ -n "$UA" ]; then APP_ARGS+=(--ucx-affinity "$UA"); fi
  APP_ARGS+=(--sloppy-type FP16 --use-mpi-panel-broadcast 0 --use-separate-stream-for-gemm 1)
  APP_ARGS+=(--prioritize-trsm 0 --prioritize-factorization 0 --fill-device 1)
  APP_ARGS+=(--test-loop 1 --skip-tests 0 --monitor-gpu 0)

  RC=0
  apptainer exec --nv \
    -B /opt/pbs:/opt/pbs \
    -B /var/spool/pbs:/var/spool/pbs \
    -B "$REPO_ROOT":"$REPO_ROOT" \
    "$SIF" \
    /usr/local/mpi/bin/mpirun -np "$NPROCS" \
      --hostfile "$PWD/hostfile" \
      --mca plm_rsh_agent "$BRIDGE" \
      --mca plm_rsh_no_tree_spawn 1 \
      --mca plm_rsh_num_concurrent 1 \
      --mca routed direct \
      -x PATH -x LD_LIBRARY_PATH \
      --bind-to none \
      /workspace/hpl-mxp.sh "${APP_ARGS[@]}" \
    > "$STDOUT_FILE" 2> "$STDERR_FILE" || RC=$?

  END_TS="$(date --iso-8601=seconds)"

  # Extract the overall score and the verification verdict (mechanical,
  # TASK-007 Section 1.4H / APPLICATION.md correctness criteria).
  SCORE="$(extract_gflops "$STDOUT_FILE")"
  VERDICT="INVALID"
  RES_VAL=""
  RES_LINE="$(grep -F '||Ax-b||_oo / (EPS' "$STDOUT_FILE" 2>/dev/null | tail -n 1 || true)"
  if [ -n "$RES_LINE" ]; then
    case "$RES_LINE" in
      *PASSED*) VERDICT="PASSED" ;;
      *FAILED*) VERDICT="FAILED" ;;
    esac
    case "$RES_LINE" in
      *[Nn][Aa][Nn]*|*[Ii][Nn][Ff]*) VERDICT="INVALID_NONFINITE" ;;
    esac
    RES_VAL="$(printf '%s\n' "$RES_LINE" | sed -E 's/^.*= +([0-9][0-9.Ee+-]*).*$/\1/' || true)"
    if [ -z "$RES_VAL" ]; then VERDICT="INVALID"; fi
  fi
  if grep -Fq 'FAILED' "$STDOUT_FILE" 2>/dev/null; then VERDICT="FAILED"; fi
  if [ -z "$SCORE" ]; then VERDICT="INVALID_NO_SCORE"; fi
  if ! grep -Fq '****** Matrix Generation ******' "$STDOUT_FILE" 2>/dev/null; then VERDICT="INVALID_NO_MATGEN"; fi
  if ! grep -Fq 'LU seconds: AVG =' "$STDOUT_FILE" 2>/dev/null; then VERDICT="INVALID_NO_LU"; fi
  if [ "$RC" -ne 0 ]; then VERDICT="INVALID_EXIT_${RC}"; fi

  ARM_SCORE[$KEY]="$SCORE"
  ARM_EXIT[$KEY]="$RC"
  if [ "$VERDICT" = "PASSED" ]; then
    ARM_VALID[$KEY]="yes"
  else
    ARM_VALID[$KEY]="no"
    INVALID_ARMS=$((INVALID_ARMS + 1))
  fi
  if [ "$RC" -ne 0 ]; then
    FAILURES=$((FAILURES + 1))
  fi

  if [ "$RC" -ne 0 ]; then
    echo "=== arm ${KEY} (${LABEL}) FAILED exit_status=${RC} verdict=${VERDICT} end=${END_TS}; continuing with the next arm ==="
  else
    echo "=== arm ${KEY} (${LABEL}) exit_status=0 verdict=${VERDICT} gflops=${SCORE:-none} end=${END_TS} ==="
  fi
  {
    echo "attempt=${ATTEMPT}"
    echo "experiment_id=${EXPERIMENT_ID}"
    echo "stage_arm=${KEY}"
    echo "stage_label=${LABEL}"
    echo "pbs_job_id=${PBS_JOBID:-unknown}"
    echo "queue=${QUEUE}"
    echo "nodes=$(sort -u "$PBS_NODEFILE" | paste -sd' ')"
    echo "gpu_affinity=${GA}"
    echo "mem_affinity=${MA:-omitted}"
    echo "cpu_affinity=${CA:-omitted}"
    echo "ucx_affinity=${UA:-omitted}"
    echo "n=${N_FIXED}"
    echo "nb=${NB_FIXED}"
    echo "nprow=${NPROW}"
    echo "npcol=${NPCOL}"
    echo "nporder=${NPORDER}"
    echo "fixed_controls=OMP_NUM_THREADS=8 --n 429056 --nb 3072 --nprow 4 --npcol 4 --nporder row --gpu-affinity ${GA} --sloppy-type FP16 --use-mpi-panel-broadcast 0 --use-separate-stream-for-gemm 1 --prioritize-trsm 0 --prioritize-factorization 0 --fill-device 1 --test-loop 1 --skip-tests 0 --monitor-gpu 0"
    echo "start=${START_TS}"
    echo "end=${END_TS}"
    echo "exit_status=${RC}"
    echo "gflops=${SCORE:-unknown}"
    echo "verification=${VERDICT}"
    echo "normalized_residual=${RES_VAL:-unknown}"
    echo "stdout=${STDOUT_FILE}"
    echo "stderr=${STDERR_FILE}"
  } > "$STATUS_FILE"
}

# --- Stage A: GPU affinity x memory affinity (TASK-007 Section 1.4B) --------------
# Exactly the approved 2x2 matrix, in order A0, A1, A2, A3. All four results
# are preserved regardless of the carry-forward branch.
run_arm a0 a0-identity-nomem "$G0_GPU" "" "" ""
run_arm a1 a1-identity-mem   "$G0_GPU" "$G0_MEM" "" ""
run_arm a2 a2-columnlocal-nomem "$G1_GPU" "" "" ""
run_arm a3 a3-columnlocal-mem   "$G1_GPU" "$G1_MEM" "" ""

cflog "=== Stage-A mechanical carry-forward (TASK-007 Section 1.4B; >2.0% gates; pre-authorized execution logic, not strategic analysis) ==="
for KEY in a0 a1 a2 a3; do
  cflog "stageA ${KEY}: score=${ARM_SCORE[$KEY]:-none} valid=${ARM_VALID[$KEY]:-no} exit=${ARM_EXIT[$KEY]:-unknown}"
done

# Stop condition: an invalid A0 control leaves Stage-A branching with no
# valid basis (TASK-007 Section 1.9). All four Stage-A arms have already run
# and are preserved as evidence; Stages B and C are NOT run.
if [ "${ARM_VALID[a0]:-no}" != "yes" ]; then
  cflog "STOP: A0 control is invalid (verdict not PASSED); Stage-A branching has no valid basis; Stage B and Stage C are not run (TASK-007 Section 1.9)."
  echo "FATAL: A0 control invalid; stopping before Stage B/C; Stage-A evidence preserved" >&2
  exit 1
fi

# Rule 1: within G0, retain matching memory affinity only if A1 is >2.0%
# above A0; otherwise retain G0 with memory affinity omitted.
G0_RET_SCORE="${ARM_SCORE[a0]}"
G0_MEM_RETAINED="no"
if [ "${ARM_VALID[a1]:-no}" = "yes" ] && gt2pct "${ARM_SCORE[a1]}" "$G0_RET_SCORE"; then
  G0_RET_SCORE="${ARM_SCORE[a1]}"
  G0_MEM_RETAINED="yes"
  cflog "stageA rule1: A1 is >2.0% above valid A0 -> retain G0 WITH memory affinity ${G0_MEM} (retained score ${G0_RET_SCORE})"
else
  cflog "stageA rule1: A1 is not >2.0% above valid A0 (or A1 invalid) -> retain G0 with memory affinity omitted (retained score ${G0_RET_SCORE})"
fi

# Rule 2: within G1, retain matching memory affinity only if A3 is >2.0%
# above A2; otherwise retain G1 with memory affinity omitted. Invalid
# candidates cannot be promoted.
G1_RET_SCORE=""
G1_MEM_RETAINED="no"
if [ "${ARM_VALID[a2]:-no}" = "yes" ] && [ "${ARM_VALID[a3]:-no}" = "yes" ] && gt2pct "${ARM_SCORE[a3]}" "${ARM_SCORE[a2]}"; then
  G1_RET_SCORE="${ARM_SCORE[a3]}"
  G1_MEM_RETAINED="yes"
  cflog "stageA rule2: A3 is >2.0% above valid A2 -> retain G1 WITH memory affinity ${G1_MEM} (retained score ${G1_RET_SCORE})"
elif [ "${ARM_VALID[a2]:-no}" = "yes" ]; then
  G1_RET_SCORE="${ARM_SCORE[a2]}"
  cflog "stageA rule2: A3 is not >2.0% above valid A2 (or A3 invalid) -> retain G1 with memory affinity omitted (retained score ${G1_RET_SCORE})"
else
  cflog "stageA rule2: A2 invalid -> retained G1 variant is invalid; G1 cannot be promoted (invalid candidates cannot be promoted)"
fi

# Rule 3: carry G1 into Stage B only if the retained G1 variant is >2.0%
# above the retained G0 variant; otherwise carry G0.
RETAINED_GPU="$G0_GPU"
RETAINED_MEM=""
if [ -n "$G1_RET_SCORE" ] && gt2pct "$G1_RET_SCORE" "$G0_RET_SCORE"; then
  RETAINED_GPU="$G1_GPU"
  if [ "$G1_MEM_RETAINED" = "yes" ]; then RETAINED_MEM="$G1_MEM"; fi
  cflog "stageA rule3: retained G1 >2.0% above retained G0 -> carry G1 into Stage B (gpu_affinity=${RETAINED_GPU} mem_affinity=${RETAINED_MEM:-omitted})"
else
  cflog "stageA rule3: retained G1 is not >2.0% above retained G0 (or G1 invalid) -> carry G0 into Stage B (gpu_affinity=${RETAINED_GPU} mem_affinity=omitted)"
fi

# --- Stage B: CPU affinity (TASK-007 Section 1.4C) ---------------------------------
# B0 free / B1 loose / B2 medium (10 CPUs/rank) / B3 strict (8 CPUs/rank),
# under the retained Stage-A GPU map and memory-affinity state. The exact
# masks are the approved strings for the retained map.
if [ "$RETAINED_GPU" = "$G1_GPU" ]; then
  B1_MASK="$G1_B1"; B2_MASK="$G1_B2"; B3_MASK="$G1_B3"
else
  B1_MASK="$G0_B1"; B2_MASK="$G0_B2"; B3_MASK="$G0_B3"
fi
cflog "stageB CPU masks derived from the retained GPU map ${RETAINED_GPU}: loose=${B1_MASK} medium=${B2_MASK} strict=${B3_MASK}"

run_arm b0 b0-cpu-free   "$RETAINED_GPU" "$RETAINED_MEM" "" ""
run_arm b1 b1-cpu-loose  "$RETAINED_GPU" "$RETAINED_MEM" "$B1_MASK" ""
run_arm b2 b2-cpu-medium "$RETAINED_GPU" "$RETAINED_MEM" "$B2_MASK" ""
run_arm b3 b3-cpu-strict "$RETAINED_GPU" "$RETAINED_MEM" "$B3_MASK" ""

cflog "=== Stage-B mechanical carry-forward (TASK-007 Section 1.4C; >2.0% gates) ==="
for KEY in b0 b1 b2 b3; do
  cflog "stageB ${KEY}: score=${ARM_SCORE[$KEY]:-none} valid=${ARM_VALID[$KEY]:-no} exit=${ARM_EXIT[$KEY]:-unknown}"
done

# An explicit CPU policy is eligible only if it is valid AND >2.0% above a
# valid B0. If more than one clears the gate, carry the highest valid score.
# If none clears the gate (or B0 is invalid), carry B0 / no explicit CPU
# affinity. All four Stage-B results are preserved.
BEST_KEY=""
BEST_SCORE=""
for KEY in b1 b2 b3; do
  if [ "${ARM_VALID[$KEY]:-no}" = "yes" ] && [ "${ARM_VALID[b0]:-no}" = "yes" ] && gt2pct "${ARM_SCORE[$KEY]}" "${ARM_SCORE[b0]}"; then
    if [ -z "$BEST_KEY" ] || gt_num "${ARM_SCORE[$KEY]}" "$BEST_SCORE"; then
      BEST_KEY="$KEY"
      BEST_SCORE="${ARM_SCORE[$KEY]}"
    fi
  fi
done
RETAINED_CPU=""
if [ -n "$BEST_KEY" ]; then
  case "$BEST_KEY" in
    b1) RETAINED_CPU="$B1_MASK" ;;
    b2) RETAINED_CPU="$B2_MASK" ;;
    b3) RETAINED_CPU="$B3_MASK" ;;
  esac
  cflog "stageB: ${BEST_KEY} is the highest valid score >2.0% above valid B0 -> carry explicit CPU policy ${RETAINED_CPU}"
else
  cflog "stageB: no explicit CPU policy is >2.0% above valid B0 (or B0 invalid) -> carry B0 / no explicit CPU affinity"
fi

# --- Stage C: UCX device affinity (TASK-007 Section 1.4D) ---------------------------
# C0 = --ucx-affinity omitted (automatic/default device policy) vs
# C1 = explicit GPU-PIX-paired HCA mapping for the retained GPU map, both
# under the retained Stage-A placement and Stage-B CPU policy. Cheap HCA
# xmit-counter snapshots around each C arm preserve lightweight rail/locality
# evidence (informational).
if [ "$RETAINED_GPU" = "$G1_GPU" ]; then
  C1_UCX_MAP="$G1_UCX"
else
  C1_UCX_MAP="$G0_UCX"
fi
cflog "stageC PIX-paired HCA map derived from the retained GPU map ${RETAINED_GPU}: ${C1_UCX_MAP}"

hca_snapshot "before-c0"
run_arm c0 c0-ucx-auto "$RETAINED_GPU" "$RETAINED_MEM" "$RETAINED_CPU" ""
hca_snapshot "after-c0-before-c1"
run_arm c1 c1-ucx-pix "$RETAINED_GPU" "$RETAINED_MEM" "$RETAINED_CPU" "$C1_UCX_MAP"
hca_snapshot "after-c1"

cflog "=== Stage-C mechanical carry-forward (TASK-007 Section 1.4D; >2.0% gate) ==="
for KEY in c0 c1; do
  cflog "stageC ${KEY}: score=${ARM_SCORE[$KEY]:-none} valid=${ARM_VALID[$KEY]:-no} exit=${ARM_EXIT[$KEY]:-unknown}"
done

# Retain explicit PIX-paired UCX affinity only if C1 is >2.0% above valid C0;
# otherwise retain the automatic/default device policy. Both results are
# preserved. This is only an execution carry-forward result; final strategic
# closure requires explicit ANALYSE_RESULTS.
RETAINED_UCX=""
if [ "${ARM_VALID[c1]:-no}" = "yes" ] && [ "${ARM_VALID[c0]:-no}" = "yes" ] && gt2pct "${ARM_SCORE[c1]}" "${ARM_SCORE[c0]}"; then
  RETAINED_UCX="$C1_UCX_MAP"
  cflog "stageC: C1 is >2.0% above valid C0 -> retain explicit PIX-paired UCX affinity ${RETAINED_UCX}"
else
  cflog "stageC: C1 is not >2.0% above valid C0 (or either arm invalid) -> retain the automatic/default device policy"
fi

cflog "final execution carry-forward placement (mechanical task-rule outcome only; final strategic closure requires explicit ANALYSE_RESULTS): gpu_affinity=${RETAINED_GPU} mem_affinity=${RETAINED_MEM:-omitted} cpu_affinity=${RETAINED_CPU:-free-omitted} ucx_affinity=${RETAINED_UCX:-automatic-omitted}"

# --- Post-sweep hardware-health snapshot (ordinary evidence; must not block) ------
echo "=== post-sweep hardware-health snapshot (mother node $(hostname)) ==="
nvidia-smi topo -m || echo "warn: nvidia-smi topo failed"
nvidia-smi --query-gpu=index,name,driver_version,temperature.gpu,power.draw,clocks.sm,memory.used,memory.total --format=csv || echo "warn: nvidia-smi query failed"

# --- Overall sweep result -----------------------------------------------------------
# Nonzero overall if any arm exited nonzero or failed verification, even
# though later arms were still attempted (their evidence is preserved either
# way). Do not classify success from exit status alone; the per-arm .status
# files and .out verification markers are the validity record.
NARMS=${#ARM_KEYS[@]}
if [ "$FAILURES" -ne 0 ] || [ "$INVALID_ARMS" -ne 0 ]; then
  echo "=== HPL-MxP 2x8-GAAS phase2bc-placement-locality sweep finished with ${FAILURES}/${NARMS} arm(s) exited nonzero and ${INVALID_ARMS}/${NARMS} arm(s) without PASSED verification (tag ${ATTEMPT_TAG}) ==="
  exit 1
fi
echo "=== HPL-MxP 2x8-GAAS phase2bc-placement-locality sweep complete: all ${NARMS} arm(s) exited 0 with PASSED verification (tag ${ATTEMPT_TAG}) ==="
