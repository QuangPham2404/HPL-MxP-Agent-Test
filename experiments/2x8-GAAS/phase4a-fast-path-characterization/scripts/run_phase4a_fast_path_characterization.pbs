#!/bin/bash
# HPL-MxP 2x8-GAAS TASK-2X8-013 Phase 4A communication fast-path
# characterization: 2 GAAS nodes x 8 H200 GPUs (16 ranks). The
# TASK-2X8-013-approved arms run sequentially within this single PBS
# allocation at the fixed retained Phase-3 stack
# (tasks/TASK-2X8-013.md Sections 1.6A-1.6F); NO scientific control varies
# between arms - the only intended differences are diagnostic
# environment/logging controls:
#
#   A0 (a0-clean): one clean scored reference arm under the retained
#       configuration. No UCX/NCCL diagnostic logging beyond normal
#       application/runtime output (Section 1.6B); the per-arm env probe
#       verifies the diagnostic variables are UNSET on all 16 ranks.
#   A1 (a1-diag): exact scientific clone of A0 in the same allocation with
#       targeted communication-path diagnostics (Section 1.6C):
#         UCX_LOG_LEVEL=info
#         UCX_PROTO_INFO=y
#         NCCL_DEBUG=INFO
#         NCCL_DEBUG_SUBSYS=INIT,BOOTSTRAP,ENV,NET,GRAPH,P2P,COLL,SHM,TUNING
#         NCCL_DEBUG_FILE=/dev/stderr   (validated phase2-stage2 routing
#                                        style for this exact container NCCL
#                                        2.29.x stack; keeps NCCL logs in
#                                        the arm .err evidence file)
#       All diagnostic variables are -x forwarded to every MPI rank and
#       verified effective on all 16 ranks by the per-arm env probe. A1's
#       benchmark score is sanity evidence only (Section 1.6C: do not
#       interpret A0/A1 score differences as communication-performance
#       results). No UCX_LOG_LEVEL=debug, no per-message tracing, no
#       Nsight, no other high-overhead profiler.
#
#   Conditional arms (Sections 1.6D-1.6F), run ONLY when A1 is
#   transfer-level ambiguous for that stack, each separately, keeping all
#   A1 diagnostics and scientific controls unchanged and adding exactly one
#   previously validated GDR-off diagnostic control:
#   A2-U (a2u-ucx-gdroff): + UCX_IB_GPU_DIRECT_RDMA=n   (MPI/UCX stack)
#   A2-N (a2n-nccl-gdroff): + NCCL_NET_GDR_LEVEL=LOC    (NCCL stack)
#   Never both stacks disabled in one arm; maximum four HPL arms total
#   (A0+A1+A2-U+A2-N); no further diagnostics after the conditional arms.
#
#   The Section 1.6F conditional logic is operationalized mechanically in
#   this script (documented in the experiment README):
#   - MPI/UCX is CONCLUSIVE iff A1's logs contain UCX_PROTO_INFO
#     transfer-level protocol rows identifying the protocol class
#     (rendezvous zero-copy / cuda_copy / gdr_copy / frag host) AND
#     rc_mlx5 transport/lane evidence. Conclusive -> skip A2-U.
#   - NCCL is CONCLUSIVE iff A1's logs contain per-channel inter-node
#     'via NET/IBext' graph evidence (so the GDRDMA-tagged fraction is
#     countable). Conclusive -> skip A2-N.
#   - Ambiguity (missing evidence class) triggers the corresponding A2 arm.
#   - A2-U direction check: the validated GDR-off signature (frag-host
#     staging rows) must appear in A2-U; otherwise the ambiguity is
#     unresolved or the knob failed (stop condition).
#   - A2-N direction check: GDRDMA-tagged channels must drop to 0 while
#     the IBext backend remains; otherwise stop condition.
#   - Unexpected transport fallback revealed by A1 (inter-node UCX lanes
#     tcp-only, NCCL data path Socket, non-IBext NCCL backend, or
#     bond/RoCE/mixed-link NCCL warnings matching the case 2026-09-17-A
#     signature) is a STOP condition (Section 1.9), not an A2 trigger.
#
# Fixed scientific controls for EVERY arm (TASK-2X8-013 Section 1.2/1.6A,
# the complete retained Phase-3 stack, identical for all arms):
#   N=429056, NB=3072, nprow=4, npcol=4, nporder=row,
#   --gpu-affinity 0:1:2:3:4:5:6:7 (identity map),
#   --cpu-affinity omitted, --mem-affinity omitted, --ucx-affinity
#   omitted/automatic (closed for this task; TASK-007/008 outcome),
#   UCX_TLS / UCX_NET_DEVICES not set (automatic; recorded per rank),
#   OMP_NUM_THREADS=4, OMP_PLACES/OMP_PROC_BIND omitted (effective
#   launcher package defaults sockets/TRUE),
#   --fill-device 1 --fill-device-buffer-size 3048,
#   --cuda-host-register-step 2048 --call-dgemv-with-multiple-threads 0,
#   --sloppy-type FP16, --use-mpi-panel-broadcast 0,
#   --use-separate-stream-for-gemm 1, --prioritize-trsm 0,
#   --prioritize-factorization 0, --test-loop 1, --skip-tests 0,
#   --monitor-gpu 0.
#   Default-equal controls applied via the installed package defaults
#   (validated TASK-010/TASK-2X8-011/012 launch form; echoed values
#   verified per arm):
#     --u-panel-chunk-nbs                    = 8    (installed default)
#     --preset-gemm-kernel                   = 90   (EFFECTIVE value; the
#       v26.02 CLI accepts only {0,80} - flag-check evidence
#       experiments/2x8-GAAS/baseline/outputs/hplmxp_v2602_flag_check_v1.log
#       - so the flag is OMITTED and the echoed effective value is verified
#       = 90 per arm).
#   NO communication tuning value is introduced by this task (Section 1.6A:
#   --ucx-affinity, --ucx-tls/UCX_TLS, --use-mpi-panel-broadcast, and
#   --u-panel-chunk-nbs stay at the retained values).
#
# Per-HCA InfiniBand evidence around EVERY executed arm (Sections 1.4B,
# 1.7 rules 3-4): a pre-arm and post-arm host-side snapshot on BOTH
# allocated nodes via pbsdsh + scripts/hca_counter_snapshot.sh, covering
# the eight expected physical IB HCAs (mlx5_0..mlx5_5, mlx5_8, mlx5_9; any
# other visible device, e.g. the known RoCE bond mlx5_bond_0, is recorded
# factually with expected=no but never treated as a normal data path):
# port state/rate/numa plus port_xmit_data, port_rcv_data,
# port_xmit_packets, port_rcv_packets, port_xmit_discards, port_xmit_wait,
# port_rcv_errors, port_rcv_constraint_errors, port_xmit_constraint_errors,
# port_rcv_remote_physical_errors, port_rcv_switch_relay_errors,
# link_error_recovery, link_downed, excessive_buffer_overrun_errors,
# symbol_error. Deltas per arm are derived mechanically (TX/RX delta per
# HCA and per node, per-HCA traffic share, max/mean and coefficient of
# variation across the eight rails, port_xmit_wait delta, and any
# nonzero/new error/discard/recovery counter delta) into the per-arm
# .hcadelta evidence file. Per-HCA bytes and rail balance are explanatory
# metrics only. Link state is gated before every arm (all eight expected
# HCAs ACTIVE at 400 Gb/sec on both nodes; a down/derated link is a
# Section 1.9 stop).
#
# Retained host-runtime contract (verified by TASK-009 phase3ab v2, PBS job
# 73174.gaas; TASK-2X8-013 Sections 1.6A, 1.2 keep it fixed for every arm):
#   OMP_NUM_THREADS=4  - explicitly exported in the job shell AFTER the
#                        module/job environment is established, forwarded to
#                        all MPI ranks with mpirun -x OMP_NUM_THREADS, and
#                        VERIFIED = 4 on all 16 ranks by a per-arm
#                        environment probe run immediately before every
#                        launch (a mismatch aborts before that arm's
#                        launch; Sections 1.4, 1.6A, 1.9).
#   OMP_PLACES /       - omitted: the job shell unsets them after recording
#   OMP_PROC_BIND        the incoming values; the allocation-level rank-map
#                        probe verifies they are UNSET on all 16 ranks
#                        (abort before any arm otherwise); the per-arm env
#                        probe verifies omp_places=UNSET omp_proc_bind=UNSET
#                        on all 16 ranks with the arm's exact -x set.
#                        Effective placement policy = the installed
#                        launcher's package defaults OMP_PLACES=sockets /
#                        OMP_PROC_BIND=TRUE.
#
# Environment-propagation contract (Blocker E, multi-node-test/
# GAAS_MULTINODE_SETUP.md): remote-node ranks inherit the remote
# orted/container environment and receive ONLY variables explicitly
# forwarded through mpirun -x. Every diagnostic variable of an arm is
# therefore -x forwarded and verified on all 16 ranks by that arm's env
# probe (the raw probe output is preserved as the per-arm .envprobe
# evidence file).
#
# Arm-failure behavior (operational contract, mirroring the validated
# TASK-2X8-012 phase3d script):
# - An arm command that exits NONZERO: the arm's evidence is preserved
#   first (.out/.err/.status fully written, post-arm HCA snapshot taken,
#   carry-forward records the abort), then the sweep STOPS before any
#   later arm and the job returns nonzero immediately. No in-script
#   retry; a rerun needs a new ATTEMPT_TAG plus human direction (error
#   classification per workflow/05 from the preserved evidence).
# - An arm that exits 0 with an invalid verification (FAILED / non-finite
#   residual / missing score or markers) or a failed settings-echo check
#   is a scientific-correctness failure: preserved invalid/boundary
#   evidence under the approved workflow/task rules (TASK-2X8-013
#   Sections 1.4, 1.8; workflow/05 scientific-correctness exception); the
#   sweep continues with the next authorized arm and the job returns
#   nonzero overall at the end if any arm was invalid. Invalid arms are
#   never repeated for performance.
#
# Observational preflight failures abort BEFORE any arm (Track 2 stop
# rules; workflow/05 and workflow/08 Section 5): (1) an allocated
# cpuset/topology that differs from the accepted Phase-0 topology on
# EITHER allocated node; (2) a rank-map probe that fails its mechanical
# 16-rank/8-per-node/2-host check; (3) any rank reporting an incoming
# OMP_PLACES or OMP_PROC_BIND value; (4) a pre-arm HCA link-state gate
# failure (HCA absent, not ACTIVE, or not 400 Gb/sec). In all cases
# evidence is preserved, no arm runs, and any rerun needs a new
# ATTEMPT_TAG plus human direction; the script never retries a hang,
# failed MPI_Init, rank misplacement, transport fallback, or uncertain
# correctness result.
#
# Purpose: execute the TASK-2X8-013 Phase-4A characterization
# (tasks/TASK-2X8-013.md Sections 1.1-1.6) as ONE same-allocation
# sequential path (Section 1.6A/1.7 rule 1: A0, A1, and any triggered A2
# arm share the same node pair and launcher state). Execution records
# factual scores/timing/memory/correctness evidence, factual per-arm HCA
# traffic deltas, and factual communication-path diagnostics; the script
# computes ONLY mechanical facts and gate decisions. No winner is
# declared, no Phase-4B value is chosen, and no campaign-level conclusion
# is drawn; the strategic reading belongs to the post-task Strategic
# Analyst via ANALYSE_RESULTS (Sections 1.4E, 1.10-1.11). This script
# computes no percentage deltas versus the campaign baseline.
#
# Expected working directory: this experiment directory
# (experiments/2x8-GAAS/phase4a-fast-path-characterization/) on GAAS.
# Submit with (the queue is deliberately NOT selected in this script; pass
# an approved one at qsub):
#   qsub -q <gpu_as|gpu_ded> -v "ATTEMPT_TAG=v1" \
#        -o outputs/2x8-GAAS-phase4a-fast-path-characterization_v1.o \
#        -e outputs/2x8-GAAS-phase4a-fast-path-characterization_v1.e \
#        scripts/run_phase4a_fast_path_characterization.pbs
#
# Inputs (environment, via qsub -v):
#   ATTEMPT_TAG  REQUIRED attempt tag (e.g. v1); it names every per-arm
#                evidence file. A rerun must use a new tag. Before any use
#                the tag is validated against a conservative filename-safe
#                pattern: nonempty, only ASCII alphanumeric characters,
#                dot, underscore, and hyphen, and not '.' or '..' (matched
#                under LC_ALL=C inside a subshell, so the check is
#                locale-independent and leaves the job environment
#                untouched); anything else aborts before anything runs.
# Outputs: per-arm application stdout/stderr and status files under
#   outputs/2x8-GAAS-phase4a-fast-path-characterization_<label>_<ATTEMPT_TAG>.{out,err,status}
#   with <label> one of a0-clean, a1-diag, a2u-ucx-gdroff, a2n-nccl-gdroff;
#   the per-arm raw environment-probe evidence
#   outputs/..._<label>_<ATTEMPT_TAG>.envprobe;
#   the per-arm application timing-marker extract
#   outputs/..._<label>_<ATTEMPT_TAG>.timings (every emitted
#   "<phase> seconds: AVG/MAX/MIN (rank->host)" line, raw);
#   the per-arm HCA snapshots (both nodes, pre and post)
#   outputs/..._<label>_<ATTEMPT_TAG>_hcapre_hca_<node>.log and
#   outputs/..._<label>_<ATTEMPT_TAG>_hcapost_hca_<node>.log;
#   the per-arm derived HCA traffic deltas
#   outputs/..._<label>_<ATTEMPT_TAG>.hcadelta;
#   the allocation-level rank-map log
#   outputs/..._rankmap_<ATTEMPT_TAG>.log;
#   the per-arm effective-environment probe log
#   outputs/..._envmap_<ATTEMPT_TAG>.log;
#   the mechanical factual carry-forward log (per-arm facts, gate
#   decisions, conditional-arm decisions, stop records)
#   outputs/..._carryforward_<ATTEMPT_TAG>.log;
#   the deduplicated hostfile
#   outputs/..._hostfile_<ATTEMPT_TAG>;
#   environment provenance records echoed to the PBS .o after the
#   validated module load (loaded modules, Apptainer version, container
#   MPI version, and the container-image identity: size, mtime, and a
#   one-shot sha256 of the SIF - provenance if available, non-fatal)
#   plus the execution-worktree git revision; PBS-level stdout/stderr
#   names are passed at qsub with -o/-e (this script deliberately has no
#   #PBS -o/-e directives). All runtime artifacts this script creates are
#   written beneath outputs/ under attempt-specific names; nothing is left
#   in the experiment root. Existing attempt files are never overwritten:
#   the script aborts before running anything if any target file of this
#   attempt already exists (every arm label x {out,err,status,envprobe,
#   timings,hcadelta}, both per-node hcapre/hcapost snapshot globs, and
#   the rankmap/envmap/carryforward logs and attempt hostfile). An arm
#   killed mid-run (e.g. by walltime) keeps its .out/.err but has no
#   .status file, and later arms of the authorized path were not run.
# Assumptions: approved container and modules exist on GAAS; one GPU per
#   MPI process; validated Approach-1 multinode launch (container mpirun +
#   rsh_pbsdsh_container.sh bridge; multi-node-test/GAAS_MULTINODE_SETUP.md);
#   the installed v26.02 launcher implements the captured affinity/OpenMP
#   semantics and the flags used here (flag-check evidence in
#   experiments/2x8-GAAS/baseline/outputs/hplmxp_v2602_flag_check_v1.log);
#   the accepted Phase-0 topology: PBS-visible cpuset 0-49,56-101 (96 CPUs),
#   Mems_allowed_list 0-1, GPUs 0-3 -> NUMA0, GPUs 4-7 -> NUMA1, the eight
#   400G IB HCAs (scripts/probing_report.md, 2x8 supplement; job 72591.gaas);
#   /opt/pbs/bin/pbsdsh usable from the job shell (validated host-side
#   per-node capture pattern from the resource-alloc debug work).
#
# Walltime note: TASK-2X8-012's 15-arm full-fill sweep used 00:20:40 of
# 02:00:00 (PBS job 76370.gaas), each full-fill arm ~00:00:55-00:01:01
# plus a per-arm env probe. This task runs at most four arms (each the
# same ~1 min full-fill workload, with A1/A2 additionally paying bounded
# UCX/NCCL info-level logging overhead) plus per-arm pre/post HCA
# snapshots on both nodes, so well under 30 minutes is expected;
# 02:00:00 gives generous margin; may be overridden at qsub.
#
# Queue policy: no queue is preselected here. TASK-2X8-013 authorizes only
#   gpu_as and gpu_ded (Sections 1.6A, 1.9); the submitting qsub must pass
#   -q explicitly, and this script verifies the actually-assigned queue and
#   aborts on anything else. select=2:ncpus=96:ngpus=8:mem=2000GB (no
#   mpiprocs; one rank per GPU; place=scatter) may likewise be overridden
#   on the qsub command line by a documented host-pinned select (see
#   README.md). Before submission, use the approved node-status workflow
#   (pbsnodes -aSj over the eligible queues) to prefer the cleanest
#   eligible same-queue 2-node allocation and record contention/provenance;
#   that presubmit snapshot is submission-side evidence, not part of this
#   script. One multinode job at a time (GAAS Blocker 7).

#PBS -N 2x8_phase4a_fp
#PBS -P hpc_ebslee
#PBS -l select=2:ncpus=96:ngpus=8:mem=2000GB
#PBS -l place=scatter
#PBS -l walltime=02:00:00

set -euo pipefail

# --- Experiment metadata --------------------------------------------------------
cd "$PBS_O_WORKDIR"
EXPERIMENT_ID="2x8-GAAS-phase4a-fast-path-characterization"
OUTDIR="$PWD/outputs"
mkdir -p "$OUTDIR"

ATTEMPT_TAG="${ATTEMPT_TAG:-}"
if [ -z "$ATTEMPT_TAG" ]; then
  echo "FATAL: ATTEMPT_TAG is required (e.g. -v \"ATTEMPT_TAG=v1\"); it names this attempt's evidence files" >&2
  exit 1
fi
# ATTEMPT_TAG is embedded in every evidence filename, so before it is used
# anywhere it must pass a conservative filename-safety gate: nonempty
# (checked above), only ASCII alphanumeric characters, dot, underscore and
# hyphen, and not '.' or '..'. The match runs under LC_ALL=C inside a
# subshell, making the character ranges byte-exact and locale-independent
# without modifying the job environment; any other value aborts before
# anything runs.
if ( LC_ALL=C
     case "$ATTEMPT_TAG" in
       '.'|'..'|*[!A-Za-z0-9._-]*) exit 1 ;;
     esac
   )
then
  echo "attempt_tag_validation=PASS (conservative filename-safe pattern: nonempty, ASCII alphanumeric '.' '_' '-' only, not '.' or '..')"
else
  echo "FATAL: ATTEMPT_TAG='${ATTEMPT_TAG}' is not a conservative filename-safe tag (required: nonempty, only ASCII alphanumeric characters, '.', '_', '-'; '.' and '..' are not valid tags); it names this attempt's evidence files" >&2
  exit 1
fi

# Only gpu_as and gpu_ded are authorized for TASK-2X8-013 (Sections 1.6A,
# 1.9). The queue is not preselected in this script; fail fast if PBS
# assigned any other queue (including an omitted -q falling through to a
# default queue).
QUEUE="${PBS_O_QUEUE:-unknown}"
case "$QUEUE" in
  gpu_as|gpu_ded) ;;
  *) echo "FATAL: queue '${QUEUE}' is not authorized for TASK-2X8-013 (only gpu_as or gpu_ded; Sections 1.6A, 1.9); pass -q at qsub" >&2; exit 1 ;;
esac

# --- Fixed scientific controls (TASK-2X8-013 Sections 1.2, 1.6A) -----------------
# Identical for every arm. No scientific control varies in Phase 4A; only
# the diagnostic environment sets differ (clean / diag / +one GDR-off knob).
N_FIXED=429056
NB_FIXED=3072
NPROW=4
NPCOL=4
NPORDER=row
OMP_T_FIXED=4
FILL_MODE_FIXED=1
FILL_BUFFER_FIXED=3048
REG_CONTROL=2048
DGEMV_CONTROL=0

# The retained Phase-3D controls are passed EXPLICITLY on every arm so the
# requested values are unambiguous (installed flag contract
# --cuda-host-register-step INT:POSITIVE [2048],
# --call-dgemv-with-multiple-threads INT:NONNEGATIVE [0]; flag-check
# evidence experiments/2x8-GAAS/baseline/outputs/hplmxp_v2602_flag_check_v1.log;
# both values have prior CLI acceptance evidence: register-step 2048 and
# dgemv 0 in TASK-2X8-012 phase3d job 76370.gaas).

# Fixed identity GPU map (TASK-2X8-013 Section 1.2): local rank r -> GPU r.
# --cpu-affinity, --mem-affinity and --ucx-affinity are omitted for every
# arm (UCX device policy stays omitted/automatic, the retained TASK-008
# outcome; closed for this task).
GPU_AFFINITY_FIXED="0:1:2:3:4:5:6:7"

# Expected physical IB HCAs (Section 1.4B); anything else visible (e.g. the
# known RoCE bond mlx5_bond_0) is recorded factually but never gated as a
# normal data path.
EXPECTED_HCAS="mlx5_0 mlx5_1 mlx5_2 mlx5_3 mlx5_4 mlx5_5 mlx5_8 mlx5_9"

# Diagnostic environment sets (Sections 1.6C-1.6E). The NCCL subsystem set
# and the /dev/stderr routing follow the previously validated in-container
# phase2-stage2 style for this exact NCCL 2.29.x + IBext_v11 stack.
UCX_LOG_LEVEL_SET=info
UCX_PROTO_INFO_SET=y
NCCL_DEBUG_SET=INFO
NCCL_DEBUG_SUBSYS_SET="INIT,BOOTSTRAP,ENV,NET,GRAPH,P2P,COLL,SHM,TUNING"
NCCL_DEBUG_FILE_SET="/dev/stderr"
UCX_GDR_OFF_SET=n
NCCL_GDR_LEVEL_SET=LOC

echo "experiment_id=${EXPERIMENT_ID}"
echo "attempt_tag=${ATTEMPT_TAG}"
echo "pbs_job_id=${PBS_JOBID:-unknown}"
echo "queue=${QUEUE}"
echo "project=hpc_ebslee"
date --iso-8601=seconds
echo "fixed scientific controls (identical across all arms; NO scientific control varies in Phase 4A; TASK-2X8-013 Sections 1.2, 1.6A):"
echo "--n 429056 --nb 3072 --nprow 4 --npcol 4 --nporder row"
echo "--gpu-affinity 0:1:2:3:4:5:6:7 (fixed identity map; --cpu-affinity omitted, --mem-affinity omitted, --ucx-affinity omitted/automatic for every arm; UCX_TLS/UCX_NET_DEVICES not set)"
echo "OMP_NUM_THREADS=4 (explicit job-shell export after module setup + mpirun -x OMP_NUM_THREADS; verified = 4 on all 16 ranks by the per-arm env probe)"
echo "OMP_PLACES/OMP_PROC_BIND omitted (unset in the job shell; verified UNSET on all 16 ranks; effective launcher package defaults: OMP_PLACES=sockets, OMP_PROC_BIND=TRUE)"
echo "--fill-device 1 --fill-device-buffer-size 3048 (retained full-fill residency mode)"
echo "--cuda-host-register-step 2048 --call-dgemv-with-multiple-threads 0 (retained Phase-3D closure controls, explicit on every arm)"
echo "--sloppy-type FP16"
echo "--use-mpi-panel-broadcast 0 (retained; NOT changed by 4A)"
echo "--u-panel-chunk-nbs = 8 via installed package default (retained; NOT changed by 4A)"
echo "--use-separate-stream-for-gemm 1 --prioritize-trsm 0 --prioritize-factorization 0"
echo "--test-loop 1 --skip-tests 0 --monitor-gpu 0"
echo "default-equal controls applied via the installed package defaults exactly as in the validated TASK-010/TASK-2X8-011/012 launch, echoed values verified per arm: --u-panel-chunk-nbs = 8, --preset-gemm-kernel = 90 (EFFECTIVE value; v26.02 CLI accepts only {0,80} so the flag is omitted and the default supplies the SM90 preset; flag-check evidence hplmxp_v2602_flag_check_v1.log)"
echo "arm set: A0 (a0-clean, no diagnostics) -> A1 (a1-diag, UCX_LOG_LEVEL=info UCX_PROTO_INFO=y NCCL_DEBUG=INFO NCCL_DEBUG_SUBSYS=${NCCL_DEBUG_SUBSYS_SET} NCCL_DEBUG_FILE=${NCCL_DEBUG_FILE_SET}) -> conditional A2-U (a2u-ucx-gdroff, +UCX_IB_GPU_DIRECT_RDMA=n) and/or A2-N (a2n-nccl-gdroff, +NCCL_NET_GDR_LEVEL=LOC), each only if A1 is transfer-level ambiguous for that stack (Section 1.6F); maximum four HPL arms; never both stacks disabled in one arm"
echo "controls NOT reopened by TASK-2X8-013 (Section 1.6G prohibited list): ucx-affinity/ucx-tls/UCX_TLS, panel-broadcast, U-panel chunk, MPI/NCCL fallbacks, N/NB/grid/order, GPU/CPU/memory affinity, OpenMP policy, residency/buffer/register-step/DGEMV, precision, GEMM kernel, scheduling controls; no historical HCA/bond/UCC/rendezvous mitigations; no microbenchmark ladder; no profiler"
echo "task: TASK-2X8-013 Phase 4A characterization; order A0 -> A1 -> conditional A2-U -> conditional A2-N; one attempt per arm; stops after the authorized conditional arms (no Phase 4B/4C)"

# --- Locate repo root and the validated launch bridge ---------------------------
# Submission dir is experiments/2x8-GAAS/phase4a-fast-path-characterization/,
# so the repo root is three levels up.
REPO_ROOT="$(cd "${PBS_O_WORKDIR}/../../.." && pwd)"
BRIDGE="${REPO_ROOT}/multi-node-test/rsh_pbsdsh_container.sh"
HCA_HELPER="${REPO_ROOT}/experiments/2x8-GAAS/phase4a-fast-path-characterization/scripts/hca_counter_snapshot.sh"
SIF="/home/pham0094/hpl_hpcg_hplmxp_container/hpc-benchmarks_26.02.sif"

if [ ! -f "$BRIDGE" ]; then
  echo "FATAL: bridge not found at ${BRIDGE}; submit from the experiment directory (experiments/2x8-GAAS/phase4a-fast-path-characterization/)" >&2
  exit 1
fi
if [ ! -f "$HCA_HELPER" ]; then
  echo "FATAL: HCA snapshot helper not found at ${HCA_HELPER}" >&2
  exit 1
fi
if [ ! -f "$SIF" ]; then
  echo "FATAL: container image not found: ${SIF}" >&2
  exit 1
fi
[ -x /opt/pbs/bin/pbsdsh ] || { echo "FATAL: /opt/pbs/bin/pbsdsh not executable (required for the per-node HCA snapshots)" >&2; exit 1; }

# --- Execution-worktree revision record (provenance; non-fatal) ------------------
# Print the Git revision of the tree this script executes from. REPO_ROOT is
# derived from the submission directory and stays inside the approved remote
# project root (the primary clone or a detached .codex-worktrees/ execution
# worktree beneath it), and 'git rev-parse HEAD' prints only a commit SHA, so
# the record cannot expose secrets. Provenance tool, not a required runtime:
# warn and record 'unknown' if git or the revision is unavailable
# (workflow/03: provenance tools must not block an otherwise valid run).
GIT_RC=0
GIT_REVISION="$(git -C "$REPO_ROOT" rev-parse HEAD 2>&1)" || GIT_RC=$?
if [ "$GIT_RC" -ne 0 ]; then
  echo "warn: 'git -C ${REPO_ROOT} rev-parse HEAD' failed with rc=${GIT_RC}: ${GIT_REVISION}"
  echo "execution_worktree_git_revision=unknown"
else
  echo "execution_worktree_root=${REPO_ROOT}"
  echo "execution_worktree_git_revision=${GIT_REVISION}"
fi

# --- Allocation checks (place=scatter, no mpiprocs; fixed 4x4 grid) --------------
GPUS=8                                   # GPUs (and ranks) per node
EXPECTED_NODES=2
NNODES=$(sort -u "$PBS_NODEFILE" | wc -l)
if [ "$NNODES" -ne "$EXPECTED_NODES" ]; then
  echo "FATAL: expected ${EXPECTED_NODES} distinct nodes, got ${NNODES}" >&2
  exit 1
fi
NPROCS=$((NNODES * GPUS))
if [ "$NPROCS" -ne $((NPROW * NPCOL)) ]; then
  echo "FATAL: fixed grid ${NPROW}x${NPCOL} requires $((NPROW * NPCOL)) ranks, got ${NPROCS}" >&2
  exit 1
fi
ALLOC_HOSTS="$(sort -u "$PBS_NODEFILE" | paste -sd' ')"

echo "layout=${NNODES} nodes x ${GPUS} GPUs = ${NPROCS} ranks (one rank per GPU)"
echo "grid=nprow=4 x npcol=4, nporder=row (fixed for every arm)"
echo "nodes=${ALLOC_HOSTS}"
echo "bridge=${BRIDGE}"
echo "hca_helper=${HCA_HELPER}"
echo "container=${SIF}"

# --- Phase-0 topology consistency gates (TASK-2X8-013 Sections 1.6A, 1.9) --------
# The retained platform identity (accepted Phase-0 topology: PBS-visible
# cpuset 0-49,56-101, Mems_allowed_list 0-1, GPUs 0-3 -> NUMA0 / GPUs 4-7 ->
# NUMA1, the eight 400G IB HCAs) underpins the retained identity GPU map, the
# automatic UCX device policy and the launcher package-default placement
# semantics of the retained host-runtime contract. This block gates the
# mother node (where this script and rank 0 run) from the job shell; the
# rank-map probe stage below additionally validates EVERY allocated host per
# host (two-host gate, retained unchanged from the validated TASK-008/
# TASK-009/TASK-010/TASK-2X8-011/012 scripts).
CPUSET="$(grep -F 'Cpus_allowed_list:' /proc/self/status | awk '{print $2}')"
if [ "$CPUSET" != "0-49,56-101" ]; then
  echo "FATAL: allocated cpuset '${CPUSET}' differs from the accepted Phase-0 cpuset '0-49,56-101'; the retained GPU/NUMA map and the retained host-runtime contract assumptions are no longer valid (TASK-2X8-013 Sections 1.6A, 1.9; Track 2 stop)" >&2
  exit 1
fi
MEMSET="$(grep -F 'Mems_allowed_list:' /proc/self/status | awk '{print $2}')"
if [ "$MEMSET" != "0-1" ]; then
  echo "FATAL: allocated Mems_allowed_list '${MEMSET}' differs from the accepted Phase-0 value '0-1'; the retained GPU/NUMA map is no longer valid (TASK-2X8-013 Sections 1.6A, 1.9; Track 2 stop)" >&2
  exit 1
fi
NGPU_VISIBLE="$(nvidia-smi -L 2>/dev/null | wc -l || true)"
if [ "$NGPU_VISIBLE" -ne "$GPUS" ]; then
  echo "FATAL: expected ${GPUS} GPUs on the mother node, saw '${NGPU_VISIBLE}'" >&2
  exit 1
fi
for HCA in $EXPECTED_HCAS; do
  if [ ! -d "/sys/class/infiniband/${HCA}" ]; then
    echo "FATAL: expected IB HCA ${HCA} is absent; the retained platform identity (automatic UCX device policy) is no longer valid (TASK-2X8-013 Sections 1.6A, 1.9; Track 2 stop)" >&2
    exit 1
  fi
done
TOPO_MATRIX="$(nvidia-smi topo -m 2>/dev/null || true)"
echo "=== mother-node GPU topology matrix (gate input + evidence) ==="
echo "$TOPO_MATRIX"
# Row selection is whitespace-tolerant: in the accepted Phase-0 evidence the
# GPU data rows start at column 0 and only the header is tab-indented
# (header bytes: TAB ESC[4m GPU0 TAB GPU1 ...), so the tolerant anchor still
# excludes the header while also accepting a matrix whose data rows arrive
# with leading whitespace. The gate assertion itself is the second-stage
# fixed-string check (CPU-affinity column value), unchanged. The GPU0/GPU4
# NUMA anchors verify that the GPU enumeration still matches the Phase-0
# identity map the retained host-runtime contract assumes.
if ! printf '%s\n' "$TOPO_MATRIX" | grep '^[[:space:]]*GPU0' | grep -Fq '0-49'; then
  echo "FATAL: GPU0 is not on NUMA0 CPUs 0-49 as in the accepted Phase-0 topology; the fixed identity GPU map and the retained host-runtime contract assumptions are no longer valid (TASK-2X8-013 Sections 1.6A, 1.9; Track 2 stop)" >&2
  exit 1
fi
if ! printf '%s\n' "$TOPO_MATRIX" | grep '^[[:space:]]*GPU4' | grep -Fq '56-101'; then
  echo "FATAL: GPU4 is not on NUMA1 CPUs 56-101 as in the accepted Phase-0 topology; the fixed identity GPU map and the retained host-runtime contract assumptions are no longer valid (TASK-2X8-013 Sections 1.6A, 1.9; Track 2 stop)" >&2
  exit 1
fi
for PAIR in "NIC0: mlx5_0" "NIC1: mlx5_1" "NIC2: mlx5_2" "NIC3: mlx5_3" "NIC4: mlx5_4" "NIC5: mlx5_5" "NIC6: mlx5_8" "NIC7: mlx5_9"; do
  if ! printf '%s\n' "$TOPO_MATRIX" | grep -Fq "$PAIR"; then
    echo "FATAL: topology legend no longer maps '${PAIR}'; the retained platform identity is no longer valid (TASK-2X8-013 Section 1.9; Track 2 stop)" >&2
    exit 1
  fi
done
echo "topology_gate=PASS (cpuset=${CPUSET} mems=${MEMSET} gpus=${NGPU_VISIBLE} hcas=mlx5_0..mlx5_5,mlx5_8,mlx5_9 GPU0->NUMA0(0-49) GPU4->NUMA1(56-101) NIC legend matches Phase-0)"

# --- Environment (validated module set) ------------------------------------------
module purge
module load apptainer/1.4.1 nvhpc/26.3 squashfuse/0.5.2 gocryptfs/2.5.0
chmod +x "$BRIDGE"
chmod +x "$HCA_HELPER"
# Record the incoming job-shell OpenMP environment BEFORE the retained
# per-arm control application (retained launcher contract: PBS has
# previously populated/clobbered OMP_NUM_THREADS with the allocation CPU
# count; every arm re-exports OMP_NUM_THREADS=4 after this environment is
# in place and -x forwards it to all ranks).
echo "incoming job-shell OpenMP environment (before per-arm control application):"
echo "  OMP_NUM_THREADS=${OMP_NUM_THREADS:-UNSET}"
echo "  OMP_PLACES=${OMP_PLACES:-UNSET}"
echo "  OMP_PROC_BIND=${OMP_PROC_BIND:-UNSET}"
# The retained host-runtime contract requires OMP_PLACES and OMP_PROC_BIND to
# be OMITTED from the job environment: guarantee the omission against any
# PBS/module clobbering. run_env_probe re-applies this before every arm, so a
# stale value can never leak into a scored launch. The diagnostic variables
# are never exported at job-shell level; each arm sets and clears its own set
# inside run_env_probe/run_arm so A0 (clean) cannot inherit any diagnostic
# logging.
unset OMP_PLACES OMP_PROC_BIND

# --- Environment provenance records (PBS stdout) ----------------------------------
# Read-only records for the PBS .o evidence, taken right after the validated
# module load. 'module list' is an OPTIONAL record: it must not fail the job
# (warn and continue). The Apptainer and container-MPI version invocations
# are REQUIRED runtime checks (the rank-map probe and every arm launch
# through these exact runtimes): each rc is captured explicitly and a nonzero
# rc aborts deterministically BEFORE any arm (workflow/03 preflight rule: a
# tool check is fatal when the next command directly depends on the tool).
echo "=== loaded modules (module list; optional record, non-fatal) ==="
module list 2>&1 || echo "warn: 'module list' failed (optional provenance record; continuing)"

APPTAINER_RC=0
APPTAINER_VERSION_OUTPUT="$(apptainer --version 2>&1)" || APPTAINER_RC=$?
echo "=== apptainer version (required runtime; rc=${APPTAINER_RC}) ==="
echo "${APPTAINER_VERSION_OUTPUT:-<no output>}"
if [ "$APPTAINER_RC" -ne 0 ]; then
  echo "FATAL: 'apptainer --version' failed with rc=${APPTAINER_RC}; apptainer is the required container runtime for every launch in this task (deterministic abort before any arm)" >&2
  exit 1
fi

# Container image identity (TASK-2X8-013 Section 1.4: image
# identity/provenance if available): size, mtime, and a one-shot sha256.
# Provenance record, non-fatal: a failed query records 'unknown' and must
# not block the run (workflow/03).
SIF_SIZE="$(stat -c %s "$SIF" 2>/dev/null || echo unknown)"
SIF_MTIME="$(stat -c %y "$SIF" 2>/dev/null || echo unknown)"
echo "=== container image identity (provenance; non-fatal) ==="
echo "container_image=${SIF}"
echo "container_image_size_bytes=${SIF_SIZE}"
echo "container_image_mtime=${SIF_MTIME}"
SIF_SHA="$(sha256sum "$SIF" 2>/dev/null | awk '{print $1}' || true)"
if [ -n "${SIF_SHA:-}" ]; then
  echo "container_image_sha256=${SIF_SHA}"
else
  echo "container_image_sha256=unknown (sha256sum unavailable or failed; non-fatal provenance record)"
fi

# Container MPI version: lightweight read-only query of the exact container
# mpirun binary the rank-map probe and every arm launch, through the same
# apptainer exec prefix and bind mounts as those launches, run BEFORE the
# rank-map probe. REQUIRED runtime: a nonzero rc aborts deterministically
# before any arm (the probe and arms would fail identically).
CONTAINER_MPI_RC=0
CONTAINER_MPI_VERSION_OUTPUT="$(apptainer exec --nv \
  -B /opt/pbs:/opt/pbs \
  -B /var/spool/pbs:/var/spool/pbs \
  -B "$REPO_ROOT":"$REPO_ROOT" \
  "$SIF" \
  /usr/local/mpi/bin/mpirun --version 2>&1)" || CONTAINER_MPI_RC=$?
echo "=== container MPI version (/usr/local/mpi/bin/mpirun --version; required runtime; rc=${CONTAINER_MPI_RC}) ==="
echo "${CONTAINER_MPI_VERSION_OUTPUT:-<no output>}"
if [ "$CONTAINER_MPI_RC" -ne 0 ]; then
  echo "FATAL: container mpirun --version query failed with rc=${CONTAINER_MPI_RC}; the container MPI runtime is required for the rank-map probe and every arm (deterministic abort before any arm)" >&2
  exit 1
fi

# --- Pre-sweep hardware-health snapshot (ordinary evidence; must not block) ------
echo "=== pre-sweep hardware-health snapshot (mother node $(hostname)) ==="
nvidia-smi topo -m || echo "warn: nvidia-smi topo failed"
nvidia-smi --query-gpu=index,name,driver_version,temperature.gpu,power.draw,clocks.sm,memory.used,memory.total --format=csv || echo "warn: nvidia-smi query failed"

# --- Attempt-evidence guard (never overwrite existing evidence) -------------------
# Every arm writes attempt-specific .out/.err/.status/.envprobe/.timings/
# .hcadelta files plus per-node hcapre/hcapost snapshot logs, and the
# allocation writes one rank-map .log, one env-map .log, one carry-forward
# .log and one deduplicated hostfile, all beneath outputs/. The guard covers
# EVERY target name the authorized path can possibly emit: for each of the
# four arm labels the six per-arm suffixes, both per-node snapshot globs,
# plus the rankmap/envmap/carryforward logs and the attempt hostfile. The
# guard runs BEFORE any of those targets is created (including the hostfile
# below). If any target file already exists, this ATTEMPT_TAG was already
# (partially) used: abort before running anything; a rerun must take a new
# ATTEMPT_TAG (anti-loop: every arm runs at most once per attempt;
# TASK-2X8-013 Sections 1.6F, 1.6G).
GUARD_LABELS=(a0-clean a1-diag a2u-ucx-gdroff a2n-nccl-gdroff)
for LABEL in "${GUARD_LABELS[@]}"; do
  ATTEMPT="${EXPERIMENT_ID}_${LABEL}_${ATTEMPT_TAG}"
  for SUFFIX in out err status envprobe timings hcadelta; do
    if [ -e "${OUTDIR}/${ATTEMPT}.${SUFFIX}" ]; then
      echo "FATAL: refusing to overwrite existing evidence ${OUTDIR}/${ATTEMPT}.${SUFFIX}; resubmit with a new ATTEMPT_TAG" >&2
      exit 1
    fi
  done
  for SNAPGLOB in hcapre hcapost; do
    if ls "${OUTDIR}/${ATTEMPT}_${SNAPGLOB}_hca_"*.log >/dev/null 2>&1; then
      echo "FATAL: refusing to overwrite existing evidence ${OUTDIR}/${ATTEMPT}_${SNAPGLOB}_hca_*.log; resubmit with a new ATTEMPT_TAG" >&2
      exit 1
    fi
  done
done
for GUARD_TARGET in \
  "${EXPERIMENT_ID}_rankmap_${ATTEMPT_TAG}.log" \
  "${EXPERIMENT_ID}_envmap_${ATTEMPT_TAG}.log" \
  "${EXPERIMENT_ID}_carryforward_${ATTEMPT_TAG}.log" \
  "${EXPERIMENT_ID}_hostfile_${ATTEMPT_TAG}"; do
  if [ -e "${OUTDIR}/${GUARD_TARGET}" ]; then
    echo "FATAL: refusing to overwrite existing evidence ${OUTDIR}/${GUARD_TARGET}; resubmit with a new ATTEMPT_TAG" >&2
    exit 1
  fi
done

# De-duplicated hostfile with explicit per-node slot count (GAAS Blocker 8),
# shared by the rank-map probe, the per-arm env probes, the per-node HCA
# snapshots' node set, and all arms in this allocation. Written beneath
# outputs/ with an attempt-specific name and covered by the guard above, so
# no runtime artifact is left in the experiment root.
MPI_HOSTFILE="${OUTDIR}/${EXPERIMENT_ID}_hostfile_${ATTEMPT_TAG}"
awk -v g="$GPUS" '{ sub(/\r$/,""); if (!seen[$0]++) print $0 " slots=" g }' \
  "$PBS_NODEFILE" > "$MPI_HOSTFILE"
echo "=== hostfile (${MPI_HOSTFILE}) ==="
cat "$MPI_HOSTFILE"

# --- Allocation-level rank-map probe (TASK-2X8-013 Sections 1.4, 1.6A, 1.9) ------
# One lightweight 16-rank MPI mapping probe BEFORE any arm, using the SAME
# shared hostfile and the SAME container mpirun + bridge + daemon flags as
# the arm launches. No OMP variable is -x forwarded in this probe (only
# PATH/LD_LIBRARY_PATH), so the reported values are what each rank's
# execution environment supplies BEFORE the retained per-arm controls are
# applied. Diagnostic only: it adds no communication tracing and must not
# alter scientific controls. It preserves global_rank / local_rank /
# hostname for all 16 ranks (confirming 16 MPI ranks, 8 ranks/node; the
# rank/node mapping evidence of Section 1.4) AND the INCOMING OMP_NUM_THREADS /
# OMP_PLACES / OMP_PROC_BIND values seen inside each rank's execution
# environment.
#
# The per-host topology validation is retained unchanged from the validated
# TASK-008/TASK-009/TASK-010/TASK-2X8-011/012 two-host gate: node-local rank
# 0 on each allocated host reports the local node topology facts into the
# SAME rank-map log, and the per-host gate below requires BOTH allocated
# hosts to match the accepted Phase-0 topology before any arm.
RANKMAP_LOG="${OUTDIR}/${EXPERIMENT_ID}_rankmap_${ATTEMPT_TAG}.log"
RC=0
apptainer exec --nv \
  -B /opt/pbs:/opt/pbs \
  -B /var/spool/pbs:/var/spool/pbs \
  -B "$REPO_ROOT":"$REPO_ROOT" \
  "$SIF" \
  /usr/local/mpi/bin/mpirun -np "$NPROCS" \
    --hostfile "$MPI_HOSTFILE" \
    --mca plm_rsh_agent "$BRIDGE" \
    --mca plm_rsh_no_tree_spawn 1 \
    --mca plm_rsh_num_concurrent 1 \
    --mca routed direct \
    -x PATH -x LD_LIBRARY_PATH \
    --bind-to none \
    bash -c '
      if [ "${OMPI_COMM_WORLD_LOCAL_RANK:-}" = "0" ]; then
        # Node-local rank 0 only, once per host: read-only report of the
        # local node topology facts into the same rank-map log. No
        # scientific control is touched; a failed query yields a missing or
        # empty fact, which the per-host gate below fails safely.
        H="$(hostname)"
        echo "topo host=${H} begin local_rank0 global_rank=${OMPI_COMM_WORLD_RANK}"
        L="$(grep -F "Cpus_allowed_list:" /proc/self/status || true)"
        L="${L#*:}"; L="${L//[[:space:]]/}"
        echo "topo host=${H} cpuset=${L:-missing}"
        M="$(grep -F "Mems_allowed_list:" /proc/self/status || true)"
        M="${M#*:}"; M="${M//[[:space:]]/}"
        echo "topo host=${H} mems=${M:-missing}"
        NG="$(nvidia-smi -L 2>/dev/null | wc -l || true)"
        NG="${NG//[[:space:]]/}"
        echo "topo host=${H} ngpus=${NG:-missing}"
        for D in mlx5_0 mlx5_1 mlx5_2 mlx5_3 mlx5_4 mlx5_5 mlx5_8 mlx5_9; do
          if [ -d "/sys/class/infiniband/${D}" ]; then
            echo "topo host=${H} hca=${D} present=yes"
          else
            echo "topo host=${H} hca=${D} present=no"
          fi
        done
        nvidia-smi topo -m 2>/dev/null | while IFS= read -r LINE; do
          echo "topo host=${H} topo_m=${LINE}"
        done
        echo "topo host=${H} end local_rank0"
      fi
      echo "rank=${OMPI_COMM_WORLD_RANK}/${OMPI_COMM_WORLD_SIZE} host=$(hostname) local_rank=${OMPI_COMM_WORLD_LOCAL_RANK}/${OMPI_COMM_WORLD_LOCAL_SIZE} omp_num_threads=${OMP_NUM_THREADS:-UNSET} omp_places=${OMP_PLACES:-UNSET} omp_proc_bind=${OMP_PROC_BIND:-UNSET}"
    ' \
  > "$RANKMAP_LOG" 2>&1 || RC=$?

# Mechanical gate: the probe must have exited 0, emitted exactly NPROCS rank
# lines, exactly EXPECTED_NODES distinct hostnames, and exactly GPUS rank
# lines per host. Otherwise abort BEFORE any arm (launch/rank-mapping
# problem; TASK-2X8-013 Section 1.9; Track 2 stop); the probe evidence is
# preserved in RANKMAP_LOG and a rerun needs a new ATTEMPT_TAG.
RANK_LINES=$(grep -c "^rank=" "$RANKMAP_LOG" || true)
HOST_COUNT=$(grep "^rank=" "$RANKMAP_LOG" | awk '{ sub(/^host=/, "", $2); seen[$2] = 1 } END { n = 0; for (h in seen) n++; print n }' || true)
MIN_RANKS_PER_HOST=$(grep "^rank=" "$RANKMAP_LOG" | awk '{ sub(/^host=/, "", $2); cnt[$2]++ } END { n = 0; for (h in cnt) { if (n == 0 || cnt[h] < m) m = cnt[h]; n++ } print (n == 0 ? 0 : m) }' || true)
MAX_RANKS_PER_HOST=$(grep "^rank=" "$RANKMAP_LOG" | awk '{ sub(/^host=/, "", $2); cnt[$2]++ } END { n = 0; for (h in cnt) { if (n == 0 || cnt[h] > m) m = cnt[h]; n++ } print (n == 0 ? 0 : m) }' || true)
if [ "$MIN_RANKS_PER_HOST" = "$MAX_RANKS_PER_HOST" ]; then
  RANKS_PER_HOST_SUMMARY="$MIN_RANKS_PER_HOST"
else
  RANKS_PER_HOST_SUMMARY="${MIN_RANKS_PER_HOST}-${MAX_RANKS_PER_HOST}"
fi
echo "=== rank-map probe: rc=${RC} rank_lines=${RANK_LINES} hosts=${HOST_COUNT} ranks_per_host=${RANKS_PER_HOST_SUMMARY} log=${RANKMAP_LOG} ==="
if [ "$RC" -ne 0 ] || [ "$RANK_LINES" -ne "$NPROCS" ] || [ "$HOST_COUNT" -ne "$EXPECTED_NODES" ] || [ "$MIN_RANKS_PER_HOST" -ne "$GPUS" ] || [ "$MAX_RANKS_PER_HOST" -ne "$GPUS" ]; then
  echo "FATAL: rank-map probe failed its mechanical check (rc=${RC} rank_lines=${RANK_LINES} hosts=${HOST_COUNT} ranks_per_host=${RANKS_PER_HOST_SUMMARY}; launch/rank-mapping problem; TASK-2X8-013 Section 1.9; Track 2 stop; evidence preserved in ${RANKMAP_LOG}; rerun needs a new ATTEMPT_TAG)" >&2
  exit 1
fi

# Incoming-OpenMP-environment gate: the retained host-runtime contract
# requires OMP_PLACES and OMP_PROC_BIND to be omitted from the rank
# execution environment so the installed launcher's package defaults
# (OMP_PROC_BIND=TRUE, OMP_PLACES=sockets) remain the effective policy. The
# job shell unsets them above; this gate verifies the INCOMING values on
# every rank (no -x override in the probe). Any rank reporting a set
# OMP_PLACES or OMP_PROC_BIND means the omission cannot be guaranteed on all
# ranks and the retained host-runtime contract cannot execute as approved
# (Track 2 stop before any arm; evidence preserved). The incoming
# OMP_NUM_THREADS values are recorded as evidence only: PBS has previously
# clobbered it with the allocation CPU count, and every arm re-exports
# OMP_NUM_THREADS=4 and -x forwards it, which overrides any incoming value
# on every rank.
OMP_PLACES_SET_LINES=$(grep "^rank=" "$RANKMAP_LOG" | grep -vcF "omp_places=UNSET" || true)
OMP_BIND_SET_LINES=$(grep "^rank=" "$RANKMAP_LOG" | grep -vcF "omp_proc_bind=UNSET" || true)
echo "incoming OMP environment across ${RANK_LINES} ranks: ranks_with_OMP_PLACES_set=${OMP_PLACES_SET_LINES} ranks_with_OMP_PROC_BIND_set=${OMP_BIND_SET_LINES}"
echo "incoming OMP_NUM_THREADS values seen (evidence; neutralized per arm by explicit export + -x forwarding):"
grep "^rank=" "$RANKMAP_LOG" | sed 's/^/  /'
if [ "$OMP_PLACES_SET_LINES" -ne 0 ] || [ "$OMP_BIND_SET_LINES" -ne 0 ]; then
  echo "FATAL: incoming OMP_PLACES/OMP_PROC_BIND are set on some ranks (OMP_PLACES_set=${OMP_PLACES_SET_LINES}, OMP_PROC_BIND_set=${OMP_BIND_SET_LINES}); the 'omitted' placement controls of the retained host-runtime contract cannot be guaranteed on all ranks, so the TASK-2X8-013 arm family cannot execute as approved (Sections 1.6A, 1.9; Track 2 stop; evidence preserved in ${RANKMAP_LOG}; rerun needs a new ATTEMPT_TAG)" >&2
  exit 1
fi
echo "incoming_openmp_gate=PASS (OMP_PLACES/OMP_PROC_BIND unset on all ${RANK_LINES} ranks; launcher package defaults remain the effective placement policy)"

# Per-host topology gate (two-host gate; TASK-2X8-013 Sections 1.6A, 1.7, 1.9):
# verify the local-rank-0 topology report collected by the probe above for
# EVERY distinct host in the rank map (the mechanical gate already fixed the
# host set at exactly EXPECTED_NODES hosts with GPUS ranks each). Each host
# must match the accepted Phase-0 topology the retained GPU/NUMA identity
# map and the retained host-runtime contract assumptions require - the same
# assertions as the mother-node gate above, now applied to BOTH allocated
# nodes. Any mismatch means the retained topology assumptions are invalid on
# that host: the rank-map stage FAILS and aborts BEFORE any arm
# (observational preflight failure; Track 2 stop, no auto retry), with the
# per-host reports preserved in RANKMAP_LOG; a rerun needs a new
# ATTEMPT_TAG.
TOPO_FAILED_HOSTS=""
for TOPO_HOST in $(grep "^rank=" "$RANKMAP_LOG" | awk '{ sub(/^host=/, "", $2); print $2 }' | sort -u); do
  TOPO_OK=1
  if [ "$(grep -c "^topo host=${TOPO_HOST} begin local_rank0" "$RANKMAP_LOG" || true)" -ne 1 ] \
     || [ "$(grep -c "^topo host=${TOPO_HOST} end local_rank0$" "$RANKMAP_LOG" || true)" -ne 1 ]; then
    echo "  host=${TOPO_HOST} topology_gate=FAIL: expected exactly one local-rank-0 topology report (begin=$(grep -c "^topo host=${TOPO_HOST} begin local_rank0" "$RANKMAP_LOG" || true) end=$(grep -c "^topo host=${TOPO_HOST} end local_rank0$" "$RANKMAP_LOG" || true))" >&2
    TOPO_OK=0
  fi
  TOPO_VAL="$(grep "^topo host=${TOPO_HOST} cpuset=" "$RANKMAP_LOG" | head -n 1 || true)"
  if [ "$TOPO_VAL" != "topo host=${TOPO_HOST} cpuset=0-49,56-101" ]; then
    echo "  host=${TOPO_HOST} topology_gate=FAIL: cpuset is not the accepted Phase-0 value 0-49,56-101 (reported: '${TOPO_VAL:-<none>}')" >&2
    TOPO_OK=0
  fi
  TOPO_VAL="$(grep "^topo host=${TOPO_HOST} mems=" "$RANKMAP_LOG" | head -n 1 || true)"
  if [ "$TOPO_VAL" != "topo host=${TOPO_HOST} mems=0-1" ]; then
    echo "  host=${TOPO_HOST} topology_gate=FAIL: Mems_allowed_list is not the accepted Phase-0 value 0-1 (reported: '${TOPO_VAL:-<none>}')" >&2
    TOPO_OK=0
  fi
  TOPO_VAL="$(grep "^topo host=${TOPO_HOST} ngpus=" "$RANKMAP_LOG" | head -n 1 || true)"
  if [ "$TOPO_VAL" != "topo host=${TOPO_HOST} ngpus=8" ]; then
    echo "  host=${TOPO_HOST} topology_gate=FAIL: expected 8 GPUs on this host (reported: '${TOPO_VAL:-<none>}')" >&2
    TOPO_OK=0
  fi
  for TOPO_HCA in $EXPECTED_HCAS; do
    if ! grep -q "^topo host=${TOPO_HOST} hca=${TOPO_HCA} present=yes$" "$RANKMAP_LOG"; then
      echo "  host=${TOPO_HOST} topology_gate=FAIL: expected IB HCA ${TOPO_HCA} not reported present (accepted Phase-0 inventory: mlx5_0..mlx5_5,mlx5_8,mlx5_9)" >&2
      TOPO_OK=0
    fi
  done
  # Row selection is whitespace-tolerant (same precedent as the mother-node
  # gate): the GPU0/GPU4 NUMA anchors verify the GPU enumeration still
  # matches the Phase-0 identity map the retained contract assumes.
  if ! grep "^topo host=${TOPO_HOST} topo_m=" "$RANKMAP_LOG" | grep "topo_m=[[:space:]]*GPU0[[:space:]]" | grep -Fq "0-49"; then
    echo "  host=${TOPO_HOST} topology_gate=FAIL: GPU0 is not on NUMA0 CPUs 0-49 as in the accepted Phase-0 topology (full matrix preserved in the rank-map log)" >&2
    TOPO_OK=0
  fi
  if ! grep "^topo host=${TOPO_HOST} topo_m=" "$RANKMAP_LOG" | grep "topo_m=[[:space:]]*GPU4[[:space:]]" | grep -Fq "56-101"; then
    echo "  host=${TOPO_HOST} topology_gate=FAIL: GPU4 is not on NUMA1 CPUs 56-101 as in the accepted Phase-0 topology (full matrix preserved in the rank-map log)" >&2
    TOPO_OK=0
  fi
  for TOPO_PAIR in "NIC0: mlx5_0" "NIC1: mlx5_1" "NIC2: mlx5_2" "NIC3: mlx5_3" "NIC4: mlx5_4" "NIC5: mlx5_5" "NIC6: mlx5_8" "NIC7: mlx5_9"; do
    if ! grep "^topo host=${TOPO_HOST} topo_m=" "$RANKMAP_LOG" | grep -Fq "$TOPO_PAIR"; then
      echo "  host=${TOPO_HOST} topology_gate=FAIL: topology legend no longer maps '${TOPO_PAIR}' (retained platform identity invalid on this host)" >&2
      TOPO_OK=0
    fi
  done
  if [ "$TOPO_OK" -eq 1 ]; then
    echo "  host=${TOPO_HOST} topology_gate=PASS (cpuset=0-49,56-101 mems=0-1 gpus=8 hcas=mlx5_0..mlx5_5,mlx5_8,mlx5_9 GPU0->NUMA0(0-49) GPU4->NUMA1(56-101) NIC0..NIC7->mlx5_0..mlx5_9)"
  else
    TOPO_FAILED_HOSTS="${TOPO_FAILED_HOSTS} ${TOPO_HOST}"
  fi
done
if [ -n "$TOPO_FAILED_HOSTS" ]; then
  echo "rankmap_per_host_topology_gate=FAIL (failed hosts:${TOPO_FAILED_HOSTS})" >&2
  echo "FATAL: rank-map probe per-host topology gate failed on${TOPO_FAILED_HOSTS}; a host that does not match the accepted Phase-0 topology invalidates the retained GPU/NUMA identity map and the retained host-runtime contract assumptions (TASK-2X8-013 Sections 1.6A, 1.7, 1.9; aborting BEFORE any arm; Track 2 stop; evidence preserved in ${RANKMAP_LOG}; rerun needs a new ATTEMPT_TAG)" >&2
  exit 1
fi
echo "rankmap_per_host_topology_gate=PASS (every allocated host matches the accepted Phase-0 topology; per-host reports preserved in ${RANKMAP_LOG})"

# --- Helper functions --------------------------------------------------------------
# Overall HPL-MxP GFLOP/s from an application .out file (first "GFLOPS = "
# match is the overall score; "LU GFLOPS" appears later), or empty.
extract_gflops() {
  grep -o 'GFLOPS = [0-9.eE+-]*' "$1" 2>/dev/null | head -n 1 | awk '{ print $3 }' || true
}

# LU factorization time (AVG seconds) from "LU seconds: AVG = <v>, ...".
extract_lu_seconds() {
  grep -o 'LU seconds: AVG = [0-9.]*' "$1" 2>/dev/null | head -n 1 | awk '{ print $5 }' || true
}

# LU GFLOP/s from "LU GFLOPS = <v>, per GPU = ...".
extract_lu_gflops() {
  grep -o 'LU GFLOPS = [0-9.eE+-]*' "$1" 2>/dev/null | head -n 1 | awk '{ print $4 }' || true
}

# Iterative-refinement time (AVG seconds) from
# "Iterative Solver seconds: AVG = <v>, ...".
extract_ir_seconds() {
  grep -o 'Iterative Solver seconds: AVG = [0-9.]*' "$1" 2>/dev/null | head -n 1 | awk '{ print $6 }' || true
}

# Constructor/setup time (AVG seconds) from "Constructor seconds: AVG = ...".
extract_constructor_seconds() {
  grep -o 'Constructor seconds: AVG = [0-9.]*' "$1" 2>/dev/null | head -n 1 | awk '{ print $5 }' || true
}

# Solver iteration count from the "Solver iteration <k>, ..." lines.
count_solver_iterations() {
  grep -c '^Solver iteration' "$1" 2>/dev/null || true
}

# Last line of the .out containing the fixed string (raw emitted evidence).
capture_line() {
  grep -F "$2" "$1" 2>/dev/null | tail -n 1 || true
}

# Effective settings-echo value for --<name> from the application .out
# settings block (lines of the form "   --<name>   = <value> "); empty when
# the block or the entry is absent. The prefix match is exact ("--n" does
# not match the "--nb" line) and whitespace between the flag and '=' is
# tolerated (both "--nprow =  4" and "--fill-device      = 1" forms).
extract_echo() {
  awk -v f="$2" '
    {
      line = $0
      sub(/^[[:space:]]+/, "", line)
      p = "--" f
      if (index(line, p) == 1) {
        rest = substr(line, length(p) + 1)
        if (rest ~ /^[[:space:]]*=/) {
          sub(/^[[:space:]]*=[[:space:]]*/, "", rest)
          sub(/[[:space:]]+$/, "", rest)
          print rest
          exit
        }
      }
    }' "$1" 2>/dev/null || true
}

# Numeric GB value from a captured "consumption MAX = <v> GB" memory line,
# or empty when the line/value is absent.
gb_value() {
  printf '%s\n' "$1" | sed -nE 's/.*MAX = ([0-9]+(\.[0-9]+)?) GB.*/\1/p' || true
}

# Mechanical IR/LU time ratio (TASK-2X8-013 Section 1.4 factual derived
# value), or empty when either input is missing/non-numeric.
ir_lu_ratio() {
  awk -v ir="$1" -v lu="$2" 'BEGIN { if (ir ~ /^[0-9.]+$/ && lu ~ /^[0-9.]+$/ && lu > 0) printf "%.3f", ir / lu }' || true
}

# Indicative allocation/staging/OOM/fallback warning-marker counter for an
# evidence file (lines matched, summed over a fixed pattern list). The raw
# .out/.err files remain the authoritative warning evidence; this counter is
# only a compact summary for the .status/carry-forward records.
warn_count() {
  local f="$1" t=0 c
  c=$(grep -Fic 'out of memory' "$f" 2>/dev/null || true); t=$(( t + ${c:-0} ))
  c=$(grep -Fc 'OOM' "$f" 2>/dev/null || true); t=$(( t + ${c:-0} ))
  c=$(grep -Fic 'CUDA error' "$f" 2>/dev/null || true); t=$(( t + ${c:-0} ))
  c=$(grep -Fic 'failed to allocate' "$f" 2>/dev/null || true); t=$(( t + ${c:-0} ))
  c=$(grep -Fic 'allocation failure' "$f" 2>/dev/null || true); t=$(( t + ${c:-0} ))
  c=$(grep -Fic 'fallback' "$f" 2>/dev/null || true); t=$(( t + ${c:-0} ))
  echo "$t"
}

# cmp_echo <expected> <actual> <name>: records a settings-echo mismatch into
# SETTINGS_MISMATCH (the caller initializes SETTINGS_MISMATCH="").
cmp_echo() {
  if [ "$1" != "$2" ]; then
    SETTINGS_MISMATCH="${SETTINGS_MISMATCH:+$SETTINGS_MISMATCH }$3(expected=$1,echoed=${2:-missing})"
  fi
}

# Mechanical factual carry-forward log (evidence; also echoed to job
# stdout).
CFLOG="${OUTDIR}/${EXPERIMENT_ID}_carryforward_${ATTEMPT_TAG}.log"
cflog() { echo "$*" | tee -a "$CFLOG"; }

# Per-arm effective-environment probe log (evidence).
ENVMAP_LOG="${OUTDIR}/${EXPERIMENT_ID}_envmap_${ATTEMPT_TAG}.log"
: > "$ENVMAP_LOG"

# Per-arm score/validity/exit/timing/memory/settings records.
declare -A ARM_SCORE ARM_VALID ARM_EXIT ARM_RUN_VERDICT ARM_SETTINGS_OK \
  ARM_LU_SECONDS ARM_LU_GFLOPS ARM_IR_SECONDS ARM_IR_LU_RATIO \
  ARM_ITERATIONS ARM_RESIDUAL ARM_HOST_CONS ARM_DEVICE_CONS ARM_MEM_OK \
  ARM_CONSTRUCTOR_SECONDS ARM_MODE
FAILURES=0
INVALID_ARMS=0
ARMS_RUN=0
STOP_CONDITIONS=""

# HCA counter value from a snapshot file for a given host/HCA/port-1
# counter; prints NA when absent.
hca_counter_value() {
  # <snapshot-file> <host> <hca> <counter>
  awk -v dev="$3/port1" -v host="$2" -v key="$4" '
    $1 == "COUNTERS" && $2 == dev && $3 == ("node=" host) {
      for (i = 4; i <= NF; i++)
        if (index($i, key "=") == 1) { print substr($i, length(key) + 2); exit }
    }
  ' "$1" 2>/dev/null || true
}

# take_hca_snapshot <snap-label-suffix> : runs the host-side HCA snapshot
# helper on every allocated node via pbsdsh, then verifies the per-node
# snapshot files exist and completed, and gates the link state of all eight
# expected HCAs (ACTIVE at 400 Gb/sec) on BOTH nodes. Any failure is a
# Section 1.9 stop (HCA/link down or material unexpected error state):
# abort with evidence preserved; a rerun needs a new ATTEMPT_TAG. Uses the
# CURRENT_LABEL global set by run_arm so every snapshot file is
# attempt/arm-specific.
take_hca_snapshot() {
  SNAP_SUFFIX="$1"
  SNAP_LABEL="${EXPERIMENT_ID}_${CURRENT_LABEL}_${ATTEMPT_TAG}_${SNAP_SUFFIX}"
  echo "=== HCA snapshot (${SNAP_SUFFIX}, arm ${CURRENT_LABEL}): pbsdsh per-node capture ==="
  /opt/pbs/bin/pbsdsh -- /bin/bash "$HCA_HELPER" "$OUTDIR" "$SNAP_LABEL" "${PBS_JOBID:-unknown}" \
    || { echo "FATAL: pbsdsh HCA snapshot launch failed for ${SNAP_LABEL} (arm ${CURRENT_LABEL}); TASK-2X8-013 Section 1.9; Track 2 stop" >&2; exit 1; }
  GATE_FAIL=""
  for HOST in $ALLOC_HOSTS; do
    SNAP_FILE="${OUTDIR}/${SNAP_LABEL}_hca_${HOST}.log"
    if [ ! -s "$SNAP_FILE" ] || ! grep -qF "HCA_SNAPSHOT node=${HOST} label=${SNAP_LABEL}" "$SNAP_FILE" 2>/dev/null; then
      echo "FATAL: HCA snapshot file missing or incomplete for host ${HOST}: ${SNAP_FILE} (arm ${CURRENT_LABEL}, ${SNAP_SUFFIX})" >&2
      GATE_FAIL="${GATE_FAIL} ${HOST}:missing_snapshot"
      continue
    fi
    if ! grep -qF "HCA_SNAPSHOT node=${HOST} label=${SNAP_LABEL} jobid=${PBS_JOBID:-unknown} end=" "$SNAP_FILE" 2>/dev/null; then
      echo "FATAL: HCA snapshot for host ${HOST} has no end marker (incomplete capture)" >&2
      GATE_FAIL="${GATE_FAIL} ${HOST}:incomplete_snapshot"
      continue
    fi
    for HCA in $EXPECTED_HCAS; do
      DEV_LINE="$(grep -F "DEV ${HCA}/port1 node=${HOST} " "$SNAP_FILE" | head -n 1 || true)"
      if [ -z "$DEV_LINE" ]; then
        echo "  host=${HOST} hca=${HCA} link_gate=FAIL: no DEV record in snapshot" >&2
        GATE_FAIL="${GATE_FAIL} ${HOST}:${HCA}:missing"
      elif ! printf '%s\n' "$DEV_LINE" | grep -q "ACTIVE"; then
        echo "  host=${HOST} hca=${HCA} link_gate=FAIL: port not ACTIVE (${DEV_LINE})" >&2
        GATE_FAIL="${GATE_FAIL} ${HOST}:${HCA}:not_active"
      elif ! printf '%s\n' "$DEV_LINE" | grep -q "rate=400"; then
        echo "  host=${HOST} hca=${HCA} link_gate=FAIL: rate is not 400 Gb/sec (${DEV_LINE})" >&2
        GATE_FAIL="${GATE_FAIL} ${HOST}:${HCA}:rate"
      fi
    done
  done
  if [ -n "$GATE_FAIL" ]; then
    echo "FATAL: HCA link-state gate failed during ${SNAP_SUFFIX} of arm ${CURRENT_LABEL} (issues:${GATE_FAIL}); an HCA/link is down or in a material unexpected error state (TASK-2X8-013 Section 1.9; Track 2 stop; snapshot evidence preserved beneath ${OUTDIR}; rerun needs a new ATTEMPT_TAG)" >&2
    exit 1
  fi
  echo "hca_link_gate=PASS (${SNAP_SUFFIX}, arm ${CURRENT_LABEL}: all eight expected HCAs ACTIVE at 400 Gb/sec on both nodes)"
}

# derive_hca_deltas <label> : computes the per-arm per-node/per-HCA traffic
# deltas from the arm's hcapre/hcapost snapshots (mechanical factual
# arithmetic only; Section 1.4B). Writes the .hcadelta evidence file and
# echoes headline facts. Raw counter deltas are recorded as-is; a x4 octet
# column is also provided because IBTA defines PortXmitData/PortRcvData in
# 4-octet units while GAAS precedent treats the sysfs values as byte counts
# (the unit question is flagged for the Strategic Analyst, not resolved
# here). Non-numeric/NA counters produce 'NA' deltas. port_xmit_wait value
# 4294967295 is treated as the unavailable-counter sentinel seen in prior
# GAAS evidence and yields NA rather than a bogus delta.
HCA_ERROR_COUNTERS="port_xmit_discards port_rcv_errors port_rcv_constraint_errors port_xmit_constraint_errors port_rcv_remote_physical_errors port_rcv_switch_relay_errors link_error_recovery link_downed excessive_buffer_overrun_errors symbol_error"
derive_hca_deltas() {
  DL_LABEL="$1"
  ATTEMPT="${EXPERIMENT_ID}_${DL_LABEL}_${ATTEMPT_TAG}"
  DELTA_FILE="${OUTDIR}/${ATTEMPT}.hcadelta"
  {
    echo "HCA_DELTA arm=${DL_LABEL} attempt=${ATTEMPT} derived=$(date --iso-8601=seconds)"
    echo "note: tx/rx deltas are raw port_xmit_data/port_rcv_data counter deltas; GAAS precedent treats the sysfs values as byte counts while IBTA defines PortXmitData/PortRcvData in 4-octet units, so a x4 octet column is also provided (unit question deferred to analysis); shares/imbalance are computed over the eight expected physical IB HCAs; port_xmit_wait=4294967295 is treated as an unavailable-counter sentinel (prior GAAS evidence)"
    for HOST in $ALLOC_HOSTS; do
      PRE_FILE="${OUTDIR}/${EXPERIMENT_ID}_${DL_LABEL}_${ATTEMPT_TAG}_hcapre_hca_${HOST}.log"
      POST_FILE="${OUTDIR}/${EXPERIMENT_ID}_${DL_LABEL}_${ATTEMPT_TAG}_hcapost_hca_${HOST}.log"
      NODE_TX=0
      NODE_RX=0
      NEWERR=""
      RAIL_DATA=""
      for HCA in $EXPECTED_HCAS; do
        PRE_V="$(hca_counter_value "$PRE_FILE" "$HOST" "$HCA" port_xmit_data)"
        POST_V="$(hca_counter_value "$POST_FILE" "$HOST" "$HCA" port_xmit_data)"
        if [ "$PRE_V" = "NA" ] || [ "$POST_V" = "NA" ] || [ -z "$PRE_V" ] || [ -z "$POST_V" ]; then
          TXD="NA"
        else
          TXD=$(( POST_V - PRE_V ))
        fi
        PRE_V="$(hca_counter_value "$PRE_FILE" "$HOST" "$HCA" port_rcv_data)"
        POST_V="$(hca_counter_value "$POST_FILE" "$HOST" "$HCA" port_rcv_data)"
        if [ "$PRE_V" = "NA" ] || [ "$POST_V" = "NA" ] || [ -z "$PRE_V" ] || [ -z "$POST_V" ]; then
          RXD="NA"
        else
          RXD=$(( POST_V - PRE_V ))
        fi
        PRE_V="$(hca_counter_value "$PRE_FILE" "$HOST" "$HCA" port_xmit_wait)"
        POST_V="$(hca_counter_value "$POST_FILE" "$HOST" "$HCA" port_xmit_wait)"
        if [ "$PRE_V" = "NA" ] || [ "$POST_V" = "NA" ] || [ -z "$PRE_V" ] || [ -z "$POST_V" ] || [ "$POST_V" = "4294967295" ] || [ "$PRE_V" = "4294967295" ]; then
          WDX="NA"
        else
          WDX=$(( POST_V - PRE_V ))
        fi
        for ERR_C in $HCA_ERROR_COUNTERS; do
          ERR_PRE="$(hca_counter_value "$PRE_FILE" "$HOST" "$HCA" "$ERR_C")"
          ERR_POST="$(hca_counter_value "$POST_FILE" "$HOST" "$HCA" "$ERR_C")"
          if [ "$ERR_PRE" != "NA" ] && [ "$ERR_POST" != "NA" ] && [ -n "$ERR_PRE" ] && [ -n "$ERR_POST" ] && [ "$ERR_POST" -gt "$ERR_PRE" ]; then
            ERRD=$(( ERR_POST - ERR_PRE ))
            NEWERR="${NEWERR} ${HCA}:${ERR_C}=+${ERRD}"
          fi
        done
        if [ "$TXD" != "NA" ] && [ "$RXD" != "NA" ]; then
          NODE_TX=$(( NODE_TX + TXD ))
          NODE_RX=$(( NODE_RX + RXD ))
          RAIL_DATA="${RAIL_DATA}${HCA} ${TXD} ${RXD}
"
          echo "HCA node=${HOST} hca=${HCA} tx_delta_raw=${TXD} rx_delta_raw=${RXD} tx_octets_x4=$(( TXD * 4 )) rx_octets_x4=$(( RXD * 4 )) xmit_wait_delta=${WDX}"
        else
          RAIL_DATA="${RAIL_DATA}${HCA} NA NA
"
          echo "HCA node=${HOST} hca=${HCA} tx_delta_raw=${TXD} rx_delta_raw=${RXD} xmit_wait_delta=${WDX}"
        fi
      done
      echo "NODE_TOTAL node=${HOST} tx_delta_raw=${NODE_TX} rx_delta_raw=${NODE_RX}"
      echo "NEW_ERRORS node=${HOST} new_counters=${NEWERR:-none}"
      # Rail-share / imbalance summary over the eight expected HCAs
      # (population statistics; NA deltas are skipped; deterministic
      # device-name ordering).
      printf '%s' "$RAIL_DATA" | awk -v host="$HOST" '
        $2 ~ /^[0-9]+$/ { tx[$1] = $2; sum += $2; n++; if ($2 > mx) { mx = $2; mxh = $1 } }
        END {
          if (n > 0 && sum > 0) {
            mean = sum / n
            for (h in tx) { sq += (tx[h] - mean) * (tx[h] - mean); m++ }
            cv = sqrt(sq / m) / mean * 100
            for (h in tx) ord[++c] = h
            for (i = 1; i <= c; i++) for (j = i + 1; j <= c; j++) if (ord[j] < ord[i]) { t = ord[i]; ord[i] = ord[j]; ord[j] = t }
            printf "RAIL node=%s tx_share_pct:", host
            for (i = 1; i <= c; i++) printf " %s=%.2f", ord[i], tx[ord[i]] / sum * 100
            printf " max_over_mean_tx=%.3f cv_tx_pct=%.2f max_tx_hca=%s\n", mx / mean, cv, mxh
          } else if (n > 0) {
            printf "RAIL node=%s tx_share_pct=flat_zero (all %d numeric tx deltas are zero)\n", host, n
          } else {
            printf "RAIL node=%s tx_share_pct=NA (no numeric tx deltas)\n", host
          }
        }'
    done
    echo "HCA_DELTA_END arm=${DL_LABEL}"
  } > "$DELTA_FILE" 2>&1
  echo "=== HCA delta derivation (arm ${DL_LABEL}) -> ${DELTA_FILE} ==="
  grep -E "^(NODE_TOTAL|NEW_ERRORS|RAIL)" "$DELTA_FILE" || true
  if grep -E "^NEW_ERRORS" "$DELTA_FILE" | grep -qvF "new_counters=none"; then
    cflog "hca_new_error_counters arm=${DL_LABEL}: $(grep -E '^NEW_ERRORS' "$DELTA_FILE" | grep -v 'new_counters=none' | paste -sd';' -) (factual record; Section 1.4B)"
  fi
}

# count_diag_markers <out-file> <err-file> : sets the UCX_*/NCCL_* marker
# count globals for a diagnostic arm (mechanical grep counts over the arm's
# preserved raw evidence; the .out/.err files remain authoritative). Used by
# run_arm (.status record) and by the Section 1.6F gates. Counting scans
# BOTH files because routing depends on the logging library (UCX logs go to
# stderr; NCCL logs are routed to stderr by NCCL_DEBUG_FILE=/dev/stderr;
# stdout is scanned as well so a routing deviation cannot lose the count).
count_diag_markers() {
  CDM_OF="$1"; CDM_EF="$2"
  UCX_ENV_PROOF=$(cat "$CDM_OF" "$CDM_EF" 2>/dev/null | grep -cF 'UCX_* env variables' || true)
  UCX_ZC=$(cat "$CDM_OF" "$CDM_EF" 2>/dev/null | grep -cF 'rendezvous zero-copy' || true)
  UCX_STAGING=$(cat "$CDM_OF" "$CDM_EF" 2>/dev/null | grep -cE 'cuda_copy|frag host' || true)
  UCX_GDRCOPY=$(cat "$CDM_OF" "$CDM_EF" 2>/dev/null | grep -cF 'gdr_copy' || true)
  UCX_FRAGHOST=$(cat "$CDM_OF" "$CDM_EF" 2>/dev/null | grep -cF 'frag host' || true)
  UCX_RC_MLX5=$(cat "$CDM_OF" "$CDM_EF" 2>/dev/null | grep -cF 'rc_mlx5' || true)
  UCX_CFG_INTER=$(cat "$CDM_OF" "$CDM_EF" 2>/dev/null | grep -cF 'inter-node cfg' || true)
  UCX_CFG_TCP=$(cat "$CDM_OF" "$CDM_EF" 2>/dev/null | grep -F 'inter-node cfg' | grep -cF 'tcp/' || true)
  UCX_WARN=$(cat "$CDM_OF" "$CDM_EF" 2>/dev/null | grep -cE 'UCX  WARN' || true)
  NCCL_BACKENDS="$(cat "$CDM_OF" "$CDM_EF" 2>/dev/null | grep -F 'Using network' | awk '{print $NF}' | sort -u | paste -sd',' -)"
  NCCL_IBEXT_CH=$(cat "$CDM_OF" "$CDM_EF" 2>/dev/null | grep -cF 'via NET/IBext' || true)
  NCCL_GDRDMA_CH=$(cat "$CDM_OF" "$CDM_EF" 2>/dev/null | grep -F 'via NET/IBext' | grep -cF '/GDRDMA' || true)
  NCCL_SOCKET_CH=$(cat "$CDM_OF" "$CDM_EF" 2>/dev/null | grep -cF 'via NET/Socket' || true)
  NCCL_WARN=$(cat "$CDM_OF" "$CDM_EF" 2>/dev/null | grep -cE 'NCCL WARN' || true)
  NCCL_BOND_WARN=$(cat "$CDM_OF" "$CDM_EF" 2>/dev/null | grep -E 'NCCL WARN' | grep -ciE 'bond|roce|mixed|connection closed' || true)
  NCCL_ENV_KNOB_ECHO=$(cat "$CDM_OF" "$CDM_EF" 2>/dev/null | grep -cF 'NCCL_NET_GDR_LEVEL' || true)
}

# run_env_probe <key> <mode>
# Establishes the retained host-runtime environment (explicit
# OMP_NUM_THREADS=4 export after the module/job environment, OMP_PLACES and
# OMP_PROC_BIND guaranteed unset, and the mode's diagnostic environment set
# applied or guaranteed absent), runs one lightweight 16-rank probe with the
# EXACT -x forwarding set of the arm it precedes, verifies every rank
# reports the expected environment, and appends the per-rank lines to
# ENVMAP_LOG (the raw probe output is preserved as the attempt-specific
# per-arm .envprobe evidence file beneath outputs/). The probe also records
# the effective UCX_TLS / UCX_NET_DEVICES state on every rank (expected
# unset/automatic in 4A; recorded, not gated - Section 1.4C). On success the
# shell environment is left in the verified state so the immediately
# following launch inherits exactly the verified controls. A mismatch means
# the retained contract or the arm's diagnostic controls are not effectively
# applied on all ranks: abort BEFORE that arm's launch
# (control-application failure; TASK-2X8-013 Sections 1.6A, 1.6C, 1.9;
# evidence preserved). No workload runs in the probe.
run_env_probe() {
  PROBE_KEY="$1"
  PROBE_MODE="$2"
  export OMP_NUM_THREADS="$OMP_T_FIXED"
  unset OMP_PLACES OMP_PROC_BIND
  # Apply (or guarantee the absence of) the arm's diagnostic environment.
  unset UCX_LOG_LEVEL UCX_PROTO_INFO NCCL_DEBUG NCCL_DEBUG_SUBSYS NCCL_DEBUG_FILE UCX_IB_GPU_DIRECT_RDMA NCCL_NET_GDR_LEVEL
  case "$PROBE_MODE" in
    clean) ;;
    diag)
      export UCX_LOG_LEVEL="$UCX_LOG_LEVEL_SET"
      export UCX_PROTO_INFO="$UCX_PROTO_INFO_SET"
      export NCCL_DEBUG="$NCCL_DEBUG_SET"
      export NCCL_DEBUG_SUBSYS="$NCCL_DEBUG_SUBSYS_SET"
      export NCCL_DEBUG_FILE="$NCCL_DEBUG_FILE_SET"
      ;;
    diag-ucxgdroff)
      export UCX_LOG_LEVEL="$UCX_LOG_LEVEL_SET"
      export UCX_PROTO_INFO="$UCX_PROTO_INFO_SET"
      export NCCL_DEBUG="$NCCL_DEBUG_SET"
      export NCCL_DEBUG_SUBSYS="$NCCL_DEBUG_SUBSYS_SET"
      export NCCL_DEBUG_FILE="$NCCL_DEBUG_FILE_SET"
      export UCX_IB_GPU_DIRECT_RDMA="$UCX_GDR_OFF_SET"
      ;;
    diag-ncclgdroff)
      export UCX_LOG_LEVEL="$UCX_LOG_LEVEL_SET"
      export UCX_PROTO_INFO="$UCX_PROTO_INFO_SET"
      export NCCL_DEBUG="$NCCL_DEBUG_SET"
      export NCCL_DEBUG_SUBSYS="$NCCL_DEBUG_SUBSYS_SET"
      export NCCL_DEBUG_FILE="$NCCL_DEBUG_FILE_SET"
      export NCCL_NET_GDR_LEVEL="$NCCL_GDR_LEVEL_SET"
      ;;
    *) echo "FATAL: unknown probe mode ${PROBE_MODE}" >&2; exit 1 ;;
  esac
  # -x forwarding set: the retained contract always; the diagnostic set
  # exactly as exported above (mpirun -x forwards only variables that are
  # set in the launching environment, so the clean arm forwards none of
  # them and the diag arms forward exactly their set).
  XARGS=(-x PATH -x LD_LIBRARY_PATH -x OMP_NUM_THREADS)
  [ "${UCX_LOG_LEVEL+x}" = "x" ] && XARGS+=(-x UCX_LOG_LEVEL)
  [ "${UCX_PROTO_INFO+x}" = "x" ] && XARGS+=(-x UCX_PROTO_INFO)
  [ "${NCCL_DEBUG+x}" = "x" ] && XARGS+=(-x NCCL_DEBUG)
  [ "${NCCL_DEBUG_SUBSYS+x}" = "x" ] && XARGS+=(-x NCCL_DEBUG_SUBSYS)
  [ "${NCCL_DEBUG_FILE+x}" = "x" ] && XARGS+=(-x NCCL_DEBUG_FILE)
  [ "${UCX_IB_GPU_DIRECT_RDMA+x}" = "x" ] && XARGS+=(-x UCX_IB_GPU_DIRECT_RDMA)
  [ "${NCCL_NET_GDR_LEVEL+x}" = "x" ] && XARGS+=(-x NCCL_NET_GDR_LEVEL)
  # Raw probe output beneath outputs/ with an attempt-specific per-arm name
  # (evidence; covered by the pre-run overwrite guard), so no runtime
  # artifact is left in the experiment root.
  TMP="${OUTDIR}/${EXPERIMENT_ID}_${PROBE_KEY}_${ATTEMPT_TAG}.envprobe"
  PRC=0
  apptainer exec --nv \
    -B /opt/pbs:/opt/pbs \
    -B /var/spool/pbs:/var/spool/pbs \
    -B "$REPO_ROOT":"$REPO_ROOT" \
    "$SIF" \
    /usr/local/mpi/bin/mpirun -np "$NPROCS" \
      --hostfile "$MPI_HOSTFILE" \
      --mca plm_rsh_agent "$BRIDGE" \
      --mca plm_rsh_no_tree_spawn 1 \
      --mca plm_rsh_num_concurrent 1 \
      --mca routed direct \
      "${XARGS[@]}" \
      --bind-to none \
      bash -c 'echo "rank=${OMPI_COMM_WORLD_RANK}/${OMPI_COMM_WORLD_SIZE} host=$(hostname) local_rank=${OMPI_COMM_WORLD_LOCAL_RANK}/${OMPI_COMM_WORLD_LOCAL_SIZE} omp_num_threads=${OMP_NUM_THREADS:-UNSET} omp_places=${OMP_PLACES:-UNSET} omp_proc_bind=${OMP_PROC_BIND:-UNSET} ucx_log_level=${UCX_LOG_LEVEL:-UNSET} ucx_proto_info=${UCX_PROTO_INFO:-UNSET} ucx_tls=${UCX_TLS:-UNSET} ucx_net_devices=${UCX_NET_DEVICES:-UNSET} nccl_debug=${NCCL_DEBUG:-UNSET} nccl_debug_subsys=${NCCL_DEBUG_SUBSYS:-UNSET} nccl_debug_file=${NCCL_DEBUG_FILE:-UNSET} ucx_ib_gpu_direct_rdma=${UCX_IB_GPU_DIRECT_RDMA:-UNSET} nccl_net_gdr_level=${NCCL_NET_GDR_LEVEL:-UNSET} endprobe"' \
    > "$TMP" 2>&1 || PRC=$?
  LINES=$(grep -c '^rank=' "$TMP" || true)
  NT_OK=$(grep -cF " omp_num_threads=${OMP_T_FIXED} " "$TMP" || true)
  PL_OK=$(grep -cF " omp_places=UNSET " "$TMP" || true)
  PB_OK=$(grep -cF " omp_proc_bind=UNSET " "$TMP" || true)
  # Mode-specific diagnostic-variable verification (all 16 ranks must
  # report the mode's exact expected values, including UNSET for the
  # controls the mode must NOT set).
  case "$PROBE_MODE" in
    clean)
      ULL_OK=$(grep -cF " ucx_log_level=UNSET " "$TMP" || true)
      UPI_OK=$(grep -cF " ucx_proto_info=UNSET " "$TMP" || true)
      ND_OK=$(grep -cF " nccl_debug=UNSET " "$TMP" || true)
      NDS_OK=$(grep -cF " nccl_debug_subsys=UNSET " "$TMP" || true)
      NDF_OK=$(grep -cF " nccl_debug_file=UNSET " "$TMP" || true)
      UGR_OK=$(grep -cF " ucx_ib_gpu_direct_rdma=UNSET " "$TMP" || true)
      NGL_OK=$(grep -cF " nccl_net_gdr_level=UNSET " "$TMP" || true)
      ;;
    diag)
      ULL_OK=$(grep -cF " ucx_log_level=${UCX_LOG_LEVEL_SET} " "$TMP" || true)
      UPI_OK=$(grep -cF " ucx_proto_info=${UCX_PROTO_INFO_SET} " "$TMP" || true)
      ND_OK=$(grep -cF " nccl_debug=${NCCL_DEBUG_SET} " "$TMP" || true)
      NDS_OK=$(grep -cF " nccl_debug_subsys=${NCCL_DEBUG_SUBSYS_SET} " "$TMP" || true)
      NDF_OK=$(grep -cF " nccl_debug_file=${NCCL_DEBUG_FILE_SET} " "$TMP" || true)
      UGR_OK=$(grep -cF " ucx_ib_gpu_direct_rdma=UNSET " "$TMP" || true)
      NGL_OK=$(grep -cF " nccl_net_gdr_level=UNSET " "$TMP" || true)
      ;;
    diag-ucxgdroff)
      ULL_OK=$(grep -cF " ucx_log_level=${UCX_LOG_LEVEL_SET} " "$TMP" || true)
      UPI_OK=$(grep -cF " ucx_proto_info=${UCX_PROTO_INFO_SET} " "$TMP" || true)
      ND_OK=$(grep -cF " nccl_debug=${NCCL_DEBUG_SET} " "$TMP" || true)
      NDS_OK=$(grep -cF " nccl_debug_subsys=${NCCL_DEBUG_SUBSYS_SET} " "$TMP" || true)
      NDF_OK=$(grep -cF " nccl_debug_file=${NCCL_DEBUG_FILE_SET} " "$TMP" || true)
      UGR_OK=$(grep -cF " ucx_ib_gpu_direct_rdma=${UCX_GDR_OFF_SET} " "$TMP" || true)
      NGL_OK=$(grep -cF " nccl_net_gdr_level=UNSET " "$TMP" || true)
      ;;
    diag-ncclgdroff)
      ULL_OK=$(grep -cF " ucx_log_level=${UCX_LOG_LEVEL_SET} " "$TMP" || true)
      UPI_OK=$(grep -cF " ucx_proto_info=${UCX_PROTO_INFO_SET} " "$TMP" || true)
      ND_OK=$(grep -cF " nccl_debug=${NCCL_DEBUG_SET} " "$TMP" || true)
      NDS_OK=$(grep -cF " nccl_debug_subsys=${NCCL_DEBUG_SUBSYS_SET} " "$TMP" || true)
      NDF_OK=$(grep -cF " nccl_debug_file=${NCCL_DEBUG_FILE_SET} " "$TMP" || true)
      UGR_OK=$(grep -cF " ucx_ib_gpu_direct_rdma=UNSET " "$TMP" || true)
      NGL_OK=$(grep -cF " nccl_net_gdr_level=${NCCL_GDR_LEVEL_SET} " "$TMP" || true)
      ;;
  esac
  # Effective UCX_TLS / UCX_NET_DEVICES state on the ranks: recorded as
  # evidence (expected unset/automatic in 4A), flagged in the carry-forward
  # log when set; not a hard gate (the authoritative effective view is the
  # UCX 'env variables' log line inside the diagnostic arms).
  UTL_SET=$(grep -cF " ucx_tls=UNSET " "$TMP" || true)
  UND_SET=$(grep -cF " ucx_net_devices=UNSET " "$TMP" || true)
  {
    echo "envprobe arm=${PROBE_KEY} mode=${PROBE_MODE} start=$(date --iso-8601=seconds) rc=${PRC}"
    sed "s/^/arm=${PROBE_KEY} /" "$TMP"
  } >> "$ENVMAP_LOG"
  echo "=== env probe arm=${PROBE_KEY}: rc=${PRC} rank_lines=${LINES} omp_num_threads=${OMP_T_FIXED}_ok=${NT_OK} omp_places=UNSET_ok=${PL_OK} omp_proc_bind=UNSET_ok=${PB_OK} mode=${PROBE_MODE} diag_ok(ull/upi/nd/nds/ndf/ugr/ngl)=${ULL_OK}/${UPI_OK}/${ND_OK}/${NDS_OK}/${NDF_OK}/${UGR_OK}/${NGL_OK} ucx_tls_unset=${UTL_SET} ucx_net_devices_unset=${UND_SET} ==="
  if [ "$PRC" -ne 0 ] || [ "$LINES" -ne "$NPROCS" ] || [ "$NT_OK" -ne "$NPROCS" ] || [ "$PL_OK" -ne "$NPROCS" ] || [ "$PB_OK" -ne "$NPROCS" ] \
     || [ "$ULL_OK" -ne "$NPROCS" ] || [ "$UPI_OK" -ne "$NPROCS" ] || [ "$ND_OK" -ne "$NPROCS" ] || [ "$NDS_OK" -ne "$NPROCS" ] || [ "$NDF_OK" -ne "$NPROCS" ] || [ "$UGR_OK" -ne "$NPROCS" ] || [ "$NGL_OK" -ne "$NPROCS" ]; then
    echo "FATAL: env probe for arm ${PROBE_KEY} failed its control-application check (rc=${PRC} rank_lines=${LINES}/${NPROCS} omp_num_threads_ok=${NT_OK}/${NPROCS} omp_places_ok=${PL_OK}/${NPROCS} omp_proc_bind_ok=${PB_OK}/${NPROCS} diag_ok ull=${ULL_OK}/${NPROCS} upi=${UPI_OK}/${NPROCS} nd=${ND_OK}/${NPROCS} nds=${NDS_OK}/${NPROCS} ndf=${NDF_OK}/${NPROCS} ugr=${UGR_OK}/${NPROCS} ngl=${NGL_OK}/${NPROCS}); the retained host-runtime contract or the arm's diagnostic controls would not be effectively applied on all ranks, so the launch is aborted (TASK-2X8-013 Sections 1.6A, 1.6C, 1.9; evidence preserved in ${ENVMAP_LOG}; rerun needs a new ATTEMPT_TAG)" >&2
    exit 1
  fi
  if [ "$UTL_SET" -ne "$NPROCS" ] || [ "$UND_SET" -ne "$NPROCS" ]; then
    cflog "note: arm=${PROBE_KEY} ucx_tls/ucx_net_devices are set on some ranks (ucx_tls_unset=${UTL_SET}/${NPROCS}, ucx_net_devices_unset=${UND_SET}/${NPROCS}); recorded as evidence (expected unset/automatic in 4A; Section 1.4C); not a hard gate"
  fi
}

# run_arm <key> <label> <task_step> <mode>
# Runs one Phase-4A arm with the validated Approach-1 launch at the fixed
# retained controls. The mode selects ONLY the diagnostic environment set
# (clean / diag / diag-ucxgdroff / diag-ncclgdroff); the HPL-MxP command
# line is byte-identical for every arm. Sequence per arm: pre-arm HCA
# snapshot + link gate -> env probe (verified controls incl. the arm's
# diagnostic variables) -> launch -> post-arm HCA snapshot + link gate ->
# HCA delta derivation -> extraction (score, LU/IR/constructor timing,
# iterations, memory, verification verdict, settings echo, timing markers,
# diagnostic marker counts) -> .status write. A NONZERO exit of the arm
# command is preserved evidence that STOPS the sweep: the .status file is
# written first, then the script records the abort and returns nonzero
# before any later arm is launched (no in-script retry; a rerun needs a new
# ATTEMPT_TAG plus human direction). An exit-0 arm with an invalid
# verification or a failed settings-echo check is preserved invalid/boundary
# evidence and the sweep continues with the next authorized arm; the arm is
# then not a valid performance point.
run_arm() {
  KEY="$1"; LABEL="$2"; TASK_STEP="$3"; MODE="$4"
  CURRENT_LABEL="$LABEL"
  ATTEMPT="${EXPERIMENT_ID}_${LABEL}_${ATTEMPT_TAG}"
  STDOUT_FILE="${OUTDIR}/${ATTEMPT}.out"
  STDERR_FILE="${OUTDIR}/${ATTEMPT}.err"
  STATUS_FILE="${OUTDIR}/${ATTEMPT}.status"
  TIMINGS_FILE="${OUTDIR}/${ATTEMPT}.timings"

  # Pre-arm per-HCA counters + link state on BOTH nodes (Sections 1.4B,
  # 1.7 rule 3).
  take_hca_snapshot hcapre

  # Establish the retained host-runtime environment and the arm's
  # diagnostic environment (verified on all 16 ranks by the probe with the
  # arm's exact -x set).
  run_env_probe "$KEY" "$MODE"

  # Effective OpenMP policy for the record: placement controls omitted, so
  # the installed launcher's package defaults are the effective policy
  # (captured v26.02 launcher: OMP_PROC_BIND=${OMP_PROC_BIND:-TRUE},
  # OMP_PLACES=${OMP_PLACES:-sockets}).
  EFF_PL="sockets (launcher package default)"; EFF_PB="TRUE (launcher package default)"

  # -x forwarding set of this arm (identical to the probe's verified set).
  ENV_XARGS=(-x PATH -x LD_LIBRARY_PATH -x OMP_NUM_THREADS)
  [ "${UCX_LOG_LEVEL+x}" = "x" ] && ENV_XARGS+=(-x UCX_LOG_LEVEL)
  [ "${UCX_PROTO_INFO+x}" = "x" ] && ENV_XARGS+=(-x UCX_PROTO_INFO)
  [ "${NCCL_DEBUG+x}" = "x" ] && ENV_XARGS+=(-x NCCL_DEBUG)
  [ "${NCCL_DEBUG_SUBSYS+x}" = "x" ] && ENV_XARGS+=(-x NCCL_DEBUG_SUBSYS)
  [ "${NCCL_DEBUG_FILE+x}" = "x" ] && ENV_XARGS+=(-x NCCL_DEBUG_FILE)
  [ "${UCX_IB_GPU_DIRECT_RDMA+x}" = "x" ] && ENV_XARGS+=(-x UCX_IB_GPU_DIRECT_RDMA)
  [ "${NCCL_NET_GDR_LEVEL+x}" = "x" ] && ENV_XARGS+=(-x NCCL_NET_GDR_LEVEL)

  MODE_DESC="clean (no diagnostic logging; retained controls only)"
  case "$MODE" in
    diag) MODE_DESC="diagnostic clone (UCX_LOG_LEVEL=${UCX_LOG_LEVEL_SET} UCX_PROTO_INFO=${UCX_PROTO_INFO_SET} NCCL_DEBUG=${NCCL_DEBUG_SET} NCCL_DEBUG_SUBSYS=${NCCL_DEBUG_SUBSYS_SET} NCCL_DEBUG_FILE=${NCCL_DEBUG_FILE_SET})" ;;
    diag-ucxgdroff) MODE_DESC="diagnostic clone + UCX GDR-off (UCX_IB_GPU_DIRECT_RDMA=${UCX_GDR_OFF_SET}; all A1 diagnostics retained)" ;;
    diag-ncclgdroff) MODE_DESC="diagnostic clone + NCCL GDR-off (NCCL_NET_GDR_LEVEL=${NCCL_GDR_LEVEL_SET}; all A1 diagnostics retained)" ;;
  esac

  START_TS="$(date --iso-8601=seconds)"
  echo "=== arm ${KEY} (${LABEL}) step=${TASK_STEP} mode=${MODE} attempt=${ATTEMPT} start=${START_TS} ==="
  echo "arm_mode=${MODE_DESC}"

  # Fixed HPL-MxP arguments: byte-identical for every arm (the complete
  # retained Phase-3 stack; no scientific control varies in Phase 4A).
  APP_ARGS=(--n "$N_FIXED" --nb "$NB_FIXED" --nprow "$NPROW" --npcol "$NPCOL" --nporder "$NPORDER")
  APP_ARGS+=(--gpu-affinity "$GPU_AFFINITY_FIXED")
  APP_ARGS+=(--sloppy-type FP16 --use-mpi-panel-broadcast 0 --use-separate-stream-for-gemm 1)
  APP_ARGS+=(--prioritize-trsm 0 --prioritize-factorization 0)
  APP_ARGS+=(--fill-device "$FILL_MODE_FIXED" --fill-device-buffer-size "$FILL_BUFFER_FIXED")
  APP_ARGS+=(--cuda-host-register-step "$REG_CONTROL" --call-dgemv-with-multiple-threads "$DGEMV_CONTROL")
  APP_ARGS+=(--test-loop 1 --skip-tests 0 --monitor-gpu 0)

  RC=0
  apptainer exec --nv \
    -B /opt/pbs:/opt/pbs \
    -B /var/spool/pbs:/var/spool/pbs \
    -B "$REPO_ROOT":"$REPO_ROOT" \
    "$SIF" \
    /usr/local/mpi/bin/mpirun -np "$NPROCS" \
      --hostfile "$MPI_HOSTFILE" \
      --mca plm_rsh_agent "$BRIDGE" \
      --mca plm_rsh_no_tree_spawn 1 \
      --mca plm_rsh_num_concurrent 1 \
      --mca routed direct \
      "${ENV_XARGS[@]}" \
      --bind-to none \
      /workspace/hpl-mxp.sh "${APP_ARGS[@]}" \
    > "$STDOUT_FILE" 2> "$STDERR_FILE" || RC=$?

  END_TS="$(date --iso-8601=seconds)"
  # Per-arm wall-clock runtime in seconds, derived mechanically from the
  # preserved start/end timestamps (Section 1.4A "total arm wall-clock").
  WALL_SECONDS=$(( $(date -d "$END_TS" +%s) - $(date -d "$START_TS" +%s) ))

  # Post-arm per-HCA counters + link state on BOTH nodes, then the per-arm
  # traffic deltas (Sections 1.4B, 1.7 rule 3). Taken unconditionally (also
  # after a failed arm) so the fabric state around a failure is evidence.
  take_hca_snapshot hcapost
  derive_hca_deltas "$LABEL"

  # Application timing-marker extract: every emitted
  # "<phase> seconds: AVG = ..., MAX = ... (rank->host), MIN = ..."
  # line, raw (Section 1.4A per-rank/AVG/MAX/MIN timing evidence,
  # including the owning rank; covers Constructor, GEMM, MPI/NCCL U and L2
  # broadcast, pdgemv, LU, Iterative Solver, and the remaining phases).
  grep -F "seconds: AVG" "$STDOUT_FILE" > "$TIMINGS_FILE" 2>/dev/null || true
  echo "=== timing markers (arm ${LABEL}) -> ${TIMINGS_FILE} ($(grep -c '' "$TIMINGS_FILE" 2>/dev/null || true) lines) ==="

  # Extract the score, timing/iteration/memory evidence, and the verification
  # verdict (mechanical, TASK-2X8-013 Section 1.4 / APPLICATION.md
  # correctness criteria).
  SCORE="$(extract_gflops "$STDOUT_FILE")"
  LU_SECONDS="$(extract_lu_seconds "$STDOUT_FILE")"
  LU_GFLOPS="$(extract_lu_gflops "$STDOUT_FILE")"
  IR_SECONDS="$(extract_ir_seconds "$STDOUT_FILE")"
  CONSTRUCTOR_SECONDS="$(extract_constructor_seconds "$STDOUT_FILE")"
  SOLVER_ITERATIONS="$(count_solver_iterations "$STDOUT_FILE")"
  IR_LU_RATIO="$(ir_lu_ratio "${IR_SECONDS}" "${LU_SECONDS}")"
  HOST_MEM_LINE="$(capture_line "$STDOUT_FILE" 'Per process host memory consumption MAX =')"
  DEVICE_MEM_LINE="$(capture_line "$STDOUT_FILE" 'Per process device memory consumption MAX =')"
  MATGEN_HEADROOM_LINE="$(capture_line "$STDOUT_FILE" 'Per process memory available MIN system =')"
  HOST_CONS_GB="$(gb_value "$HOST_MEM_LINE")"
  DEVICE_CONS_GB="$(gb_value "$DEVICE_MEM_LINE")"
  WARN_OUT="$(warn_count "$STDOUT_FILE")"
  WARN_ERR="$(warn_count "$STDERR_FILE")"
  VERDICT="INVALID"
  RES_VAL=""
  RES_LINE="$(grep -F '||Ax-b||_oo / (EPS' "$STDOUT_FILE" 2>/dev/null | tail -n 1 || true)"
  if [ -n "$RES_LINE" ]; then
    case "$RES_LINE" in
      *PASSED*) VERDICT="PASSED" ;;
      *FAILED*) VERDICT="FAILED" ;;
    esac
    case "$RES_LINE" in
      *[Nn][Aa][Nn]*|*[Ii][Nn][Ff]*) VERDICT="INVALID_NONFINITE" ;;
    esac
    RES_VAL="$(printf '%s\n' "$RES_LINE" | sed -E 's/^.*= +([0-9][0-9.Ee+-]*).*$/\1/' || true)"
    if [ -z "$RES_VAL" ]; then VERDICT="INVALID"; fi
  fi
  if grep -Fq 'FAILED' "$STDOUT_FILE" 2>/dev/null; then VERDICT="FAILED"; fi
  if [ -z "$SCORE" ]; then VERDICT="INVALID_NO_SCORE"; fi
  if ! grep -Fq '****** Matrix Generation ******' "$STDOUT_FILE" 2>/dev/null; then VERDICT="INVALID_NO_MATGEN"; fi
  if ! grep -Fq 'LU seconds: AVG =' "$STDOUT_FILE" 2>/dev/null; then VERDICT="INVALID_NO_LU"; fi
  if [ "$RC" -ne 0 ]; then VERDICT="INVALID_EXIT_${RC}"; fi

  # Diagnostic marker counts for the diagnostic arms (raw-evidence grep
  # counts; also the Section 1.6F gate inputs). For the clean arm the
  # counts are recorded as all-zero/empty context only.
  if [ "$MODE" != "clean" ]; then
    count_diag_markers "$STDOUT_FILE" "$STDERR_FILE"
    DIAG_LINE="diag_markers: ucx_env_proof=${UCX_ENV_PROOF} ucx_zero_copy_rows=${UCX_ZC} ucx_staging_rows=${UCX_STAGING} ucx_gdr_copy_rows=${UCX_GDRCOPY} ucx_frag_host_rows=${UCX_FRAGHOST} ucx_rc_mlx5_refs=${UCX_RC_MLX5} ucx_inter_cfg_lines=${UCX_CFG_INTER} ucx_inter_cfg_tcp_lines=${UCX_CFG_TCP} ucx_warn=${UCX_WARN} nccl_backends=${NCCL_BACKENDS:-none} nccl_ibext_channels=${NCCL_IBEXT_CH} nccl_gdrdma_channels=${NCCL_GDRDMA_CH} nccl_socket_channels=${NCCL_SOCKET_CH} nccl_warn=${NCCL_WARN} nccl_bond_roce_warn=${NCCL_BOND_WARN} nccl_gdr_knob_echo_lines=${NCCL_ENV_KNOB_ECHO}"
  else
    DIAG_LINE="diag_markers: none (clean arm; diagnostic logging disabled and verified UNSET on all ranks)"
  fi

  # Settings-echo verification (TASK-2X8-013 Sections 1.4, 1.8): read the
  # application's echoed settings block and verify every fixed control of
  # the retained Phase-3 stack. The retained Phase-3D controls must echo
  # exactly --cuda-host-register-step 2048 and
  # --call-dgemv-with-multiple-threads 0. The default-equal controls
  # (u-panel-chunk-nbs 8, preset-gemm-kernel 90-effective) are applied via
  # the installed package defaults and verified here against the task's
  # fixed values. A mismatch is control-application failure evidence: the
  # arm is recorded but marked invalid, and the mismatch is flagged in the
  # carry-forward log.
  ECHO_N="$(extract_echo "$STDOUT_FILE" n)"
  ECHO_NB="$(extract_echo "$STDOUT_FILE" nb)"
  ECHO_NPROW="$(extract_echo "$STDOUT_FILE" nprow)"
  ECHO_NPCOL="$(extract_echo "$STDOUT_FILE" npcol)"
  ECHO_ORDER="$(extract_echo "$STDOUT_FILE" order)"
  ECHO_SLOPPY="$(extract_echo "$STDOUT_FILE" sloppy-type)"
  ECHO_UPANEL="$(extract_echo "$STDOUT_FILE" u-panel-chunk-nbs)"
  ECHO_PTRSM="$(extract_echo "$STDOUT_FILE" prioritize-trsm)"
  ECHO_PFACT="$(extract_echo "$STDOUT_FILE" prioritize-factorization)"
  ECHO_SEPSTREAM="$(extract_echo "$STDOUT_FILE" use-separate-stream-for-gemm)"
  ECHO_BCAST="$(extract_echo "$STDOUT_FILE" use-mpi-panel-broadcast)"
  ECHO_KERNEL="$(extract_echo "$STDOUT_FILE" preset-gemm-kernel)"
  ECHO_TESTLOOP="$(extract_echo "$STDOUT_FILE" test-loop)"
  ECHO_SKIPTESTS="$(extract_echo "$STDOUT_FILE" skip-tests)"
  ECHO_MONITORGPU="$(extract_echo "$STDOUT_FILE" monitor-gpu)"
  ECHO_FILL="$(extract_echo "$STDOUT_FILE" fill-device)"
  ECHO_ANQ="$(extract_echo "$STDOUT_FILE" Anq-device)"
  ECHO_BUFFER="$(extract_echo "$STDOUT_FILE" fill-device-buffer-size)"
  ECHO_REGSTEP="$(extract_echo "$STDOUT_FILE" cuda-host-register-step)"
  ECHO_DGEMV="$(extract_echo "$STDOUT_FILE" call-dgemv-with-multiple-threads)"
  SETTINGS_MISMATCH=""
  cmp_echo "$N_FIXED" "$ECHO_N" n
  cmp_echo "$NB_FIXED" "$ECHO_NB" nb
  cmp_echo "$NPROW" "$ECHO_NPROW" nprow
  cmp_echo "$NPCOL" "$ECHO_NPCOL" npcol
  cmp_echo "$NPORDER" "$ECHO_ORDER" order
  cmp_echo "FP16" "$ECHO_SLOPPY" sloppy-type
  cmp_echo "8" "$ECHO_UPANEL" u-panel-chunk-nbs
  cmp_echo "0" "$ECHO_PTRSM" prioritize-trsm
  cmp_echo "0" "$ECHO_PFACT" prioritize-factorization
  cmp_echo "1" "$ECHO_SEPSTREAM" use-separate-stream-for-gemm
  cmp_echo "0" "$ECHO_BCAST" use-mpi-panel-broadcast
  cmp_echo "90" "$ECHO_KERNEL" preset-gemm-kernel
  cmp_echo "1" "$ECHO_TESTLOOP" test-loop
  cmp_echo "0" "$ECHO_SKIPTESTS" skip-tests
  cmp_echo "0" "$ECHO_MONITORGPU" monitor-gpu
  cmp_echo "$FILL_MODE_FIXED" "$ECHO_FILL" fill-device
  cmp_echo "$FILL_BUFFER_FIXED" "$ECHO_BUFFER" fill-device-buffer-size
  cmp_echo "$REG_CONTROL" "$ECHO_REGSTEP" cuda-host-register-step
  cmp_echo "$DGEMV_CONTROL" "$ECHO_DGEMV" call-dgemv-with-multiple-threads
  # Anq-device is overridden by --fill-device 1: the echo is recorded as
  # evidence only.
  ANQ_RECORDED="omitted(overridden;echo=${ECHO_ANQ:-missing})"
  if [ -z "$SETTINGS_MISMATCH" ]; then
    SETTINGS_ECHO_CHECK="PASS"
    SETTINGS_OK=1
  else
    SETTINGS_ECHO_CHECK="FAIL: ${SETTINGS_MISMATCH}"
    SETTINGS_OK=0
  fi

  # Complete host/device memory evidence (Section 1.4 requires the
  # application-reported host/device consumption/headroom per arm).
  if [ -n "$HOST_MEM_LINE" ] && [ -n "$DEVICE_MEM_LINE" ]; then
    MEM_OK=1
  else
    MEM_OK=0
  fi

  ARM_SCORE["$KEY"]="$SCORE"
  ARM_EXIT["$KEY"]="$RC"
  ARM_RUN_VERDICT["$KEY"]="$VERDICT"
  ARM_SETTINGS_OK["$KEY"]="$SETTINGS_OK"
  ARM_LU_SECONDS["$KEY"]="$LU_SECONDS"
  ARM_LU_GFLOPS["$KEY"]="$LU_GFLOPS"
  ARM_IR_SECONDS["$KEY"]="$IR_SECONDS"
  ARM_IR_LU_RATIO["$KEY"]="$IR_LU_RATIO"
  ARM_CONSTRUCTOR_SECONDS["$KEY"]="$CONSTRUCTOR_SECONDS"
  ARM_ITERATIONS["$KEY"]="$SOLVER_ITERATIONS"
  ARM_RESIDUAL["$KEY"]="$RES_VAL"
  ARM_HOST_CONS["$KEY"]="$HOST_CONS_GB"
  ARM_DEVICE_CONS["$KEY"]="$DEVICE_CONS_GB"
  ARM_MEM_OK["$KEY"]="$MEM_OK"
  ARM_MODE["$KEY"]="$MODE"
  if [ "$VERDICT" = "PASSED" ] && [ "$SETTINGS_OK" -eq 1 ]; then
    ARM_VALID["$KEY"]="yes"
  else
    ARM_VALID["$KEY"]="no"
    INVALID_ARMS=$((INVALID_ARMS + 1))
  fi
  if [ "$RC" -ne 0 ]; then
    FAILURES=$((FAILURES + 1))
  fi
  ARMS_RUN=$((ARMS_RUN + 1))

  if [ "$RC" -ne 0 ]; then
    echo "=== arm ${KEY} (${LABEL}) FAILED exit_status=${RC} verdict=${VERDICT} settings_echo=${SETTINGS_ECHO_CHECK%%:*} end=${END_TS}; stopping the sweep before any later arm (status/evidence preserved) ==="
  else
    echo "=== arm ${KEY} (${LABEL}) exit_status=0 verdict=${VERDICT} settings_echo=${SETTINGS_ECHO_CHECK%%:*} gflops=${SCORE:-none} end=${END_TS} ==="
  fi
  {
    echo "attempt=${ATTEMPT}"
    echo "experiment_id=${EXPERIMENT_ID}"
    echo "task_id=TASK-2X8-013"
    echo "task_step=${TASK_STEP}"
    echo "arm_label=${LABEL}"
    echo "arm_mode=${MODE}"
    echo "arm_mode_desc=${MODE_DESC}"
    echo "phase4a_arm_kind=$(case "$KEY" in a0-*) echo "A0 clean control";; a1-*) echo "A1 diagnostic clone";; a2u-*) echo "A2-U conditional MPI/UCX GDR-off diagnostic";; a2n-*) echo "A2-N conditional NCCL GDR-off diagnostic";; *) echo "unknown";; esac)"
    echo "pbs_job_id=${PBS_JOBID:-unknown}"
    echo "queue=${QUEUE}"
    echo "nodes=$(sort -u "$PBS_NODEFILE" | paste -sd' ')"
    echo "n=${N_FIXED}"
    echo "nb=${NB_FIXED}"
    echo "nprow=${NPROW}"
    echo "npcol=${NPCOL}"
    echo "nporder=${NPORDER}"
    echo "omp_num_threads=${OMP_T_FIXED}"
    echo "omp_num_threads_supplied_by=explicit job-shell export after module setup + mpirun -x OMP_NUM_THREADS (effective on all 16 ranks; verified by the per-arm env probe, see ${ENVMAP_LOG})"
    echo "omp_places_supplied=omitted"
    echo "omp_proc_bind_supplied=omitted"
    echo "omp_places_effective=${EFF_PL}"
    echo "omp_proc_bind_effective=${EFF_PB}"
    echo "gpu_affinity=${GPU_AFFINITY_FIXED}"
    echo "mem_affinity=omitted"
    echo "cpu_affinity=omitted"
    echo "ucx_affinity=omitted/automatic"
    echo "ucx_tls_state=recorded per rank by the env probe (see ${ENVMAP_LOG}); effective UCX env view in the arm logs (UCX 'env variables' lines)"
    echo "rank_node_mapping=allocation-level rank-map log ${RANKMAP_LOG} (16 rank lines; per-host local-rank-0 topology reports)"
    echo "cuda_host_register_step_requested=${REG_CONTROL}"
    echo "cuda_host_register_step_echo=${ECHO_REGSTEP:-missing}"
    echo "call_dgemv_with_multiple_threads_requested=${DGEMV_CONTROL}"
    echo "call_dgemv_with_multiple_threads_echo=${ECHO_DGEMV:-missing}"
    echo "fill_device_requested=${FILL_MODE_FIXED}"
    echo "fill_device_echo=${ECHO_FILL:-missing}"
    echo "anq_device_requested=${ANQ_RECORDED}"
    echo "anq_device_echo=${ECHO_ANQ:-missing}"
    echo "fill_device_buffer_size_requested=${FILL_BUFFER_FIXED}"
    echo "fill_device_buffer_size_echo=${ECHO_BUFFER:-missing}"
    echo "settings_echo_n=${ECHO_N:-missing}"
    echo "settings_echo_nb=${ECHO_NB:-missing}"
    echo "settings_echo_nprow=${ECHO_NPROW:-missing}"
    echo "settings_echo_npcol=${ECHO_NPCOL:-missing}"
    echo "settings_echo_order=${ECHO_ORDER:-missing}"
    echo "settings_echo_sloppy_type=${ECHO_SLOPPY:-missing}"
    echo "settings_echo_u_panel_chunk_nbs=${ECHO_UPANEL:-missing}"
    echo "settings_echo_prioritize_trsm=${ECHO_PTRSM:-missing}"
    echo "settings_echo_prioritize_factorization=${ECHO_PFACT:-missing}"
    echo "settings_echo_use_separate_stream_for_gemm=${ECHO_SEPSTREAM:-missing}"
    echo "settings_echo_use_mpi_panel_broadcast=${ECHO_BCAST:-missing}"
    echo "settings_echo_preset_gemm_kernel=${ECHO_KERNEL:-missing} (effective value; flag omitted, CLI accepts only {0,80})"
    echo "settings_echo_test_loop=${ECHO_TESTLOOP:-missing}"
    echo "settings_echo_skip_tests=${ECHO_SKIPTESTS:-missing}"
    echo "settings_echo_monitor_gpu=${ECHO_MONITORGPU:-missing}"
    echo "settings_echo_check=${SETTINGS_ECHO_CHECK}"
    echo "fixed_controls=--n ${N_FIXED} --nb ${NB_FIXED} --nprow ${NPROW} --npcol ${NPCOL} --nporder ${NPORDER} --gpu-affinity ${GPU_AFFINITY_FIXED} --cpu-affinity omitted --mem-affinity omitted --ucx-affinity omitted/automatic --sloppy-type FP16 --use-mpi-panel-broadcast 0 --u-panel-chunk-nbs 8(package default; echoed) --use-separate-stream-for-gemm 1 --prioritize-trsm 0 --prioritize-factorization 0 --fill-device 1 --fill-device-buffer-size 3048 --cuda-host-register-step 2048 --call-dgemv-with-multiple-threads 0 --preset-gemm-kernel 90(effective via package default; CLI {0,80} only; echoed) --test-loop 1 --skip-tests 0 --monitor-gpu 0 OMP_NUM_THREADS=${OMP_T_FIXED} OMP_PLACES=omitted OMP_PROC_BIND=omitted"
    echo "${DIAG_LINE}"
    echo "hca_evidence=pre/post snapshots ${OUTDIR}/${ATTEMPT}_hcapre_hca_<node>.log and ${OUTDIR}/${ATTEMPT}_hcapost_hca_<node>.log (both nodes); derived deltas ${OUTDIR}/${ATTEMPT}.hcadelta"
    echo "allocated_cpuset=${CPUSET}"
    echo "start=${START_TS}"
    echo "end=${END_TS}"
    echo "arm_wallclock_seconds=${WALL_SECONDS}"
    echo "exit_status=${RC}"
    echo "gflops=${SCORE:-unknown}"
    echo "lu_seconds=${LU_SECONDS:-unknown}"
    echo "lu_gflops=${LU_GFLOPS:-unknown}"
    echo "ir_seconds=${IR_SECONDS:-unknown}"
    echo "solver_iterations=${SOLVER_ITERATIONS:-unknown}"
    echo "ir_lu_ratio=${IR_LU_RATIO:-unknown}"
    echo "constructor_seconds=${CONSTRUCTOR_SECONDS:-unknown}"
    echo "timing_markers=${TIMINGS_FILE}"
    echo "host_memory=${HOST_MEM_LINE:-unknown}"
    echo "host_memory_consumption_max_gb=${HOST_CONS_GB:-unknown}"
    echo "device_memory=${DEVICE_MEM_LINE:-unknown}"
    echo "device_memory_consumption_max_gb=${DEVICE_CONS_GB:-unknown}"
    echo "matgen_headroom=${MATGEN_HEADROOM_LINE:-unknown}"
    echo "warning_marker_lines_out=${WARN_OUT}"
    echo "warning_marker_lines_err=${WARN_ERR}"
    echo "verification=${VERDICT}"
    echo "normalized_residual=${RES_VAL:-unknown}"
    echo "valid_performance_point=${ARM_VALID["$KEY"]}"
    echo "performance_role=$(case "$KEY" in a0-*) echo "scored Phase-4 clean reference";; *) echo "diagnostic only (timing perturbed by logging or forced-path controls; not a performance candidate)";; esac)"
    echo "stdout=${STDOUT_FILE}"
    echo "stderr=${STDERR_FILE}"
  } > "$STATUS_FILE"

  # Nonzero arm exit: the arm's .status file above is fully written before
  # this point, so its status/evidence - and the PBS-level .o/.e - remain;
  # now STOP the sweep before any later arm of the authorized path is
  # launched and return nonzero immediately. No in-script retry: a rerun
  # needs a new ATTEMPT_TAG plus human direction (error classification per
  # workflow/05 from the preserved evidence). Exit-0 scientific-correctness
  # failures keep the approved behavior above: preserved invalid/boundary
  # evidence, sweep continues per the task rules, never promoted or
  # repeated.
  if [ "$RC" -ne 0 ]; then
    cflog "SWEEP_ABORTED_AFTER_NONZERO_ARM_EXIT: arm ${KEY} (${LABEL}) exit_status=${RC} run_verdict=${VERDICT} settings_echo=${SETTINGS_ECHO_CHECK%%:*}; status/evidence preserved (${STATUS_FILE}); stopping before any later arm of the authorized path is launched; no in-script retry; a rerun needs a new ATTEMPT_TAG plus human direction"
    echo "arms_run=${ARMS_RUN} arms_exited_nonzero=${FAILURES} arms_invalid=${INVALID_ARMS}"
    echo "FATAL: arm ${KEY} (${LABEL}) exited nonzero (rc=${RC}); its .status/.out/.err evidence is preserved (${STATUS_FILE}); stopping the PBS sweep before any later arm (no automatic retry; rerun with a new ATTEMPT_TAG after human review)" >&2
    exit 1
  fi
}

# log_arm_facts <key>
# Appends one factual per-arm record line to the carry-forward log (no
# percentages, no ranking, no interpretation).
log_arm_facts() {
  LAF_K="$1"
  LAF_S_OK="FAIL"
  if [ "${ARM_SETTINGS_OK[$LAF_K]:-0}" = "1" ]; then LAF_S_OK="PASS"; fi
  cflog "arm ${LAF_K}: mode=${ARM_MODE[$LAF_K]:-unknown} score=${ARM_SCORE[$LAF_K]:-none} run_verdict=${ARM_RUN_VERDICT[$LAF_K]:-unknown} settings_echo=${LAF_S_OK} valid=${ARM_VALID[$LAF_K]:-no} exit=${ARM_EXIT[$LAF_K]:-unknown} lu_seconds=${ARM_LU_SECONDS[$LAF_K]:-unknown} lu_gflops=${ARM_LU_GFLOPS[$LAF_K]:-unknown} ir_seconds=${ARM_IR_SECONDS[$LAF_K]:-unknown} ir_lu_ratio=${ARM_IR_LU_RATIO[$LAF_K]:-unknown} iterations=${ARM_ITERATIONS[$LAF_K]:-unknown} residual=${ARM_RESIDUAL[$LAF_K]:-unknown} host_cons_gb=${ARM_HOST_CONS[$LAF_K]:-unknown} device_cons_gb=${ARM_DEVICE_CONS[$LAF_K]:-unknown} constructor_seconds=${ARM_CONSTRUCTOR_SECONDS[$LAF_K]:-unknown} mem_evidence_complete=${ARM_MEM_OK[$LAF_K]:-0}"
}

# --- Arm A0: clean retained control (TASK-2X8-013 Section 1.6B) --------------------
# One clean scored reference arm under the retained configuration; no
# diagnostic logging (verified UNSET on all 16 ranks by the env probe).
# A0 is the Phase-4 clean reference for this allocation.
cflog "=== Phase 4A arm A0 (a0-clean): clean retained control (Section 1.6B; no diagnostic logging; fixed retained Phase-3 stack) ==="
run_arm a0-clean a0-clean A0 clean
log_arm_facts a0-clean

# --- Arm A1: diagnostic clone (TASK-2X8-013 Section 1.6C) --------------------------
# Exact scientific clone of A0 in the same allocation with targeted
# UCX/NCCL path diagnostics only. Its score is sanity evidence only.
cflog "=== Phase 4A arm A1 (a1-diag): exact scientific clone with UCX/NCCL path diagnostics (Section 1.6C; UCX_LOG_LEVEL=info UCX_PROTO_INFO=y NCCL_DEBUG=INFO NCCL_DEBUG_SUBSYS=${NCCL_DEBUG_SUBSYS_SET} NCCL_DEBUG_FILE=${NCCL_DEBUG_FILE_SET}; same fixed retained stack; score is sanity evidence only) ==="
run_arm a1-diag a1-diag A1 diag
log_arm_facts a1-diag

# --- Section 1.6F conditional-arm gates (mechanical; after A1) ---------------------
# Operationalization of TASK-2X8-013 Section 1.6F on A1's preserved raw
# evidence (.out + .err). The counts below were computed inside run_arm by
# count_diag_markers and are recomputed here from the same files so the
# gate record is self-contained.
A1_OUT="${OUTDIR}/${EXPERIMENT_ID}_a1-diag_${ATTEMPT_TAG}.out"
A1_ERR="${OUTDIR}/${EXPERIMENT_ID}_a1-diag_${ATTEMPT_TAG}.err"
count_diag_markers "$A1_OUT" "$A1_ERR"
A1_ZC="$UCX_ZC"; A1_STAGING="$UCX_STAGING"; A1_FRAGHOST="$UCX_FRAGHOST"
A1_RC_MLX5="$UCX_RC_MLX5"; A1_CFG_INTER="$UCX_CFG_INTER"; A1_CFG_TCP="$UCX_CFG_TCP"
A1_IBEXT="$NCCL_IBEXT_CH"; A1_GDRDMA="$NCCL_GDRDMA_CH"; A1_SOCKET="$NCCL_SOCKET_CH"
A1_BACKENDS="$NCCL_BACKENDS"

cflog "gate_input arm=a1-diag: ucx_zero_copy_rows=${A1_ZC} ucx_staging_rows=${A1_STAGING} ucx_frag_host_rows=${A1_FRAGHOST} ucx_rc_mlx5_refs=${A1_RC_MLX5} ucx_inter_cfg_lines=${A1_CFG_INTER} ucx_inter_cfg_tcp_lines=${A1_CFG_TCP} nccl_backends=${A1_BACKENDS:-none} nccl_ibext_channels=${A1_IBEXT} nccl_gdrdma_channels=${A1_GDRDMA} nccl_socket_channels=${A1_SOCKET}"

# MPI/UCX gate: conclusive iff transfer-level protocol-class rows exist
# (rendezvous zero-copy / cuda_copy / gdr_copy / frag host) AND rc_mlx5
# transport/lane evidence exists. Conclusive -> skip A2-U (Section 1.6F
# rule 1). Do not run A2-U merely because performance is unexpected when
# the path evidence is conclusive (Sections 1.6D, 1.10).
UCX_CONCLUSIVE=0
if [ "$A1_ZC" -ge 1 ] || [ "$A1_STAGING" -ge 1 ] || [ "$UCX_GDRCOPY" -ge 1 ]; then
  if [ "$A1_RC_MLX5" -ge 1 ]; then
    UCX_CONCLUSIVE=1
  fi
fi

# NCCL gate: conclusive iff per-channel inter-node 'via NET/IBext' graph
# evidence exists (the GDRDMA-tagged fraction is then countable).
# Conclusive -> skip A2-N (Section 1.6F rule 2).
NCCL_CONCLUSIVE=0
if [ "$A1_IBEXT" -ge 1 ]; then
  NCCL_CONCLUSIVE=1
fi

# Section 1.9 stop checks on A1's revealed communication path (unexpected
# transport/topology is a STOP, not an A2 trigger):
# - inter-node UCX lanes tcp-only (no rc_mlx5 inter-node lane) => unexpected
#   Socket/TCP-class fallback for the MPI/UCX stack;
# - NCCL data path Socket (no IBext channel but Socket channels) => socket
#   fallback;
# - NCCL backend other than the expected IBext family => unexpected backend;
# - NCCL bond/RoCE/mixed-link warnings matching the case 2026-09-17-A
#   signature => unexpected bond/RoCE topology.
if [ "$A1_CFG_INTER" -ge 1 ] && [ "$A1_RC_MLX5" -eq 0 ] && [ "$A1_CFG_TCP" -ge 1 ]; then
  cflog "STOP_CONDITION: A1 inter-node UCX config lines show tcp-only lanes (inter_cfg=${A1_CFG_INTER}, rc_mlx5_refs=${A1_RC_MLX5}, tcp_lanes=${A1_CFG_TCP}); unexpected Socket/TCP-class transport fallback for the MPI/UCX stack (TASK-2X8-013 Section 1.9); stopping the MPI/UCX diagnostic path with evidence preserved; no A2-U"
  STOP_CONDITIONS="${STOP_CONDITIONS} ucx_tcp_fallback"
  UCX_CONCLUSIVE=1
fi
if [ "$A1_IBEXT" -eq 0 ] && [ "$A1_SOCKET" -ge 1 ]; then
  cflog "STOP_CONDITION: A1 NCCL data path uses Socket channels (ibext=0, socket=${A1_SOCKET}); unexpected Socket/TCP fallback (TASK-2X8-013 Section 1.9); stopping the NCCL diagnostic path with evidence preserved; no A2-N"
  STOP_CONDITIONS="${STOP_CONDITIONS} nccl_socket_fallback"
  NCCL_CONCLUSIVE=1
fi
if [ -n "${A1_BACKENDS:-}" ] && [ "$A1_IBEXT" -eq 0 ] && [ "$A1_BACKENDS" != "IBext_v11" ]; then
  cflog "STOP_CONDITION: A1 NCCL backend is '${A1_BACKENDS}' (expected IBext_v11 family) with no IBext channel evidence; unexpected network backend (TASK-2X8-013 Section 1.9); stopping the NCCL diagnostic path with evidence preserved; no A2-N"
  STOP_CONDITIONS="${STOP_CONDITIONS} nccl_unexpected_backend"
  NCCL_CONCLUSIVE=1
fi
if [ "${NCCL_BOND_WARN:-0}" -ge 1 ]; then
  cflog "STOP_CONDITION: A1 NCCL logs contain ${NCCL_BOND_WARN} bond/RoCE/mixed-link warning line(s) matching the case 2026-09-17-A signature family; unexpected bond/RoCE topology would require a mitigation/configuration change (TASK-2X8-013 Section 1.9); stopping the NCCL diagnostic path with evidence preserved; no A2-N (raw warnings preserved in ${A1_ERR})"
  STOP_CONDITIONS="${STOP_CONDITIONS} nccl_bond_roce_warning"
  NCCL_CONCLUSIVE=1
fi

# Gate records and A2 decisions (Section 1.6F rules 1-5; one stack's GDR-off
# control per arm; never both stacks disabled in one arm).
if [ "$UCX_CONCLUSIVE" -eq 1 ]; then
  cflog "gate_ucx: A1 MPI/UCX transfer-level evidence CONCLUSIVE (zero_copy_rows=${A1_ZC} staging_rows=${A1_STAGING} frag_host_rows=${A1_FRAGHOST} rc_mlx5_refs=${A1_RC_MLX5}); SKIPPING A2-U per Section 1.6F rule 1"
else
  cflog "gate_ucx: A1 MPI/UCX transfer-level evidence AMBIGUOUS (zero_copy_rows=${A1_ZC} staging_rows=${A1_STAGING} frag_host_rows=${A1_FRAGHOST} rc_mlx5_refs=${A1_RC_MLX5} inter_cfg_lines=${A1_CFG_INTER}); A2-U (UCX_IB_GPU_DIRECT_RDMA=n) is triggered per Section 1.6F rules 3/5"
fi
if [ "$NCCL_CONCLUSIVE" -eq 1 ]; then
  cflog "gate_nccl: A1 NCCL channel-level evidence CONCLUSIVE (ibext_channels=${A1_IBEXT} gdrdma_channels=${A1_GDRDMA} backends=${A1_BACKENDS:-none}); SKIPPING A2-N per Section 1.6F rule 2"
else
  cflog "gate_nccl: A1 NCCL channel-level evidence AMBIGUOUS (ibext_channels=${A1_IBEXT} gdrdma_channels=${A1_GDRDMA} socket_channels=${A1_SOCKET} backends=${A1_BACKENDS:-none}); A2-N (NCCL_NET_GDR_LEVEL=LOC) is triggered per Section 1.6F rules 4/5"
fi

# --- Conditional arm A2-U: MPI/UCX GDR-off diagnostic (Section 1.6D) ----------------
# Runs only when the UCX gate found A1 ambiguous. Keeps all A1 diagnostics
# and scientific controls unchanged, adds only UCX_IB_GPU_DIRECT_RDMA=n.
# Purpose: test whether the UCX application path visibly switches from a
# zero-copy GPU-RDMA protocol to cuda_copy/host staging (the validated
# frag-host signature). NOT a performance candidate.
if [ "$UCX_CONCLUSIVE" -eq 0 ]; then
  cflog "=== Phase 4A arm A2-U (a2u-ucx-gdroff): conditional MPI/UCX GDR-off diagnostic (Section 1.6D; all A1 diagnostics retained; +UCX_IB_GPU_DIRECT_RDMA=n; diagnostic only) ==="
  run_arm a2u-ucx-gdroff a2u-ucx-gdroff A2U diag-ucxgdroff
  log_arm_facts a2u-ucx-gdroff
  # Direction check (Sections 1.6D, 1.9): the validated GDR-off signature
  # (frag-host staging rows) must appear in A2-U, confirming the knob
  # changes the intended stack. Otherwise the ambiguity is unresolved or
  # the knob failed: stop the MPI/UCX diagnostic path (no further UCX
  # diagnostics are authorized; evidence preserved).
  A2U_OUT="${OUTDIR}/${EXPERIMENT_ID}_a2u-ucx-gdroff_${ATTEMPT_TAG}.out"
  A2U_ERR="${OUTDIR}/${EXPERIMENT_ID}_a2u-ucx-gdroff_${ATTEMPT_TAG}.err"
  count_diag_markers "$A2U_OUT" "$A2U_ERR"
  cflog "a2u_direction_input: a1_zero_copy_rows=${A1_ZC} a2u_zero_copy_rows=${UCX_ZC} a2u_staging_rows=${UCX_STAGING} a2u_frag_host_rows=${UCX_FRAGHOST} a2u_rc_mlx5_refs=${UCX_RC_MLX5}"
  if [ "${UCX_FRAGHOST:-0}" -ge 1 ]; then
    cflog "a2u_direction_check=CONFIRMED: A2-U shows the validated GDR-off staging signature (frag_host_rows=${UCX_FRAGHOST}); the diagnostic knob changes the intended MPI/UCX stack (A1 vs A2-U zero-copy/staging rows are preserved for analysis)"
  else
    if [ "${UCX_ZC:-0}" -ge 1 ] && [ "$A1_ZC" -ge 1 ]; then
      cflog "STOP_CONDITION: A2-U direction check FAILED: zero-copy rows persist unchanged (a1=${A1_ZC}, a2u=${UCX_ZC}) with no staging signature (frag_host_rows=0); the UCX_IB_GPU_DIRECT_RDMA=n knob did not change the targeted stack in the expected diagnostic direction (TASK-2X8-013 Section 1.9); MPI/UCX diagnostic path stopped with evidence preserved"
    else
      cflog "STOP_CONDITION: A2-U direction check UNRESOLVED: no transfer-level protocol rows in either A1 (zero_copy=${A1_ZC}) or A2-U (zero_copy=${UCX_ZC}, staging=${UCX_STAGING}, frag_host=${UCX_FRAGHOST}); the ambiguity could not be resolved with the authorized diagnostics (TASK-2X8-013 Section 1.9); MPI/UCX diagnostic path stopped with evidence preserved"
    fi
    STOP_CONDITIONS="${STOP_CONDITIONS} a2u_direction_failed"
  fi
else
  cflog "arm a2u-ucx-gdroff: SKIPPED (A1 MPI/UCX evidence conclusive; Section 1.6F rule 1)"
fi

# --- Conditional arm A2-N: NCCL GDR-off diagnostic (Section 1.6E) -------------------
# Runs only when the NCCL gate found A1 ambiguous. Keeps all A1 diagnostics
# and scientific controls unchanged, adds only NCCL_NET_GDR_LEVEL=LOC.
# Purpose: test whether GDRDMA-tagged inter-node channels drop to zero
# while the same IB backend remains. NOT a performance candidate.
if [ "$NCCL_CONCLUSIVE" -eq 0 ]; then
  cflog "=== Phase 4A arm A2-N (a2n-nccl-gdroff): conditional NCCL GDR-off diagnostic (Section 1.6E; all A1 diagnostics retained; +NCCL_NET_GDR_LEVEL=LOC; diagnostic only) ==="
  run_arm a2n-nccl-gdroff a2n-nccl-gdroff A2N diag-ncclgdroff
  log_arm_facts a2n-nccl-gdroff
  # Direction check (Sections 1.6E, 1.9): GDRDMA-tagged channels must drop
  # to zero while the IBext backend remains, confirming the knob changes
  # the intended NCCL path. Otherwise stop the NCCL diagnostic path
  # (evidence preserved; no further NCCL diagnostics authorized).
  A2N_OUT="${OUTDIR}/${EXPERIMENT_ID}_a2n-nccl-gdroff_${ATTEMPT_TAG}.out"
  A2N_ERR="${OUTDIR}/${EXPERIMENT_ID}_a2n-nccl-gdroff_${ATTEMPT_TAG}.err"
  count_diag_markers "$A2N_OUT" "$A2N_ERR"
  cflog "a2n_direction_input: a1_gdrdma_channels=${A1_GDRDMA} a2n_ibext_channels=${NCCL_IBEXT_CH} a2n_gdrdma_channels=${NCCL_GDRDMA_CH} a2n_socket_channels=${NCCL_SOCKET_CH} a2n_backends=${NCCL_BACKENDS:-none} a2n_gdr_knob_echo_lines=${NCCL_ENV_KNOB_ECHO}"
  if [ "${NCCL_GDRDMA_CH:-0}" -eq 0 ] && [ "${NCCL_IBEXT_CH:-0}" -ge 1 ]; then
    cflog "a2n_direction_check=CONFIRMED: A2-N shows 0 GDRDMA-tagged inter-node channels while the IBext backend remains (ibext_channels=${NCCL_IBEXT_CH}); the diagnostic knob changes the intended NCCL stack (A1 GDRDMA channels: ${A1_GDRDMA})"
  elif [ "${NCCL_GDRDMA_CH:-0}" -ge 1 ]; then
    cflog "STOP_CONDITION: A2-N direction check FAILED: GDRDMA-tagged channels persist (a2n_gdrdma=${NCCL_GDRDMA_CH} vs a1_gdrdma=${A1_GDRDMA}); the NCCL_NET_GDR_LEVEL=LOC knob did not change the targeted stack in the expected diagnostic direction (TASK-2X8-013 Section 1.9); NCCL diagnostic path stopped with evidence preserved"
    STOP_CONDITIONS="${STOP_CONDITIONS} a2n_direction_failed"
  else
    cflog "STOP_CONDITION: A2-N direction check UNRESOLVED: no inter-node IBext channel evidence in A2-N (ibext=${NCCL_IBEXT_CH}, socket=${NCCL_SOCKET_CH}, backends=${NCCL_BACKENDS:-none}); the ambiguity could not be resolved with the authorized diagnostics (TASK-2X8-013 Section 1.9); NCCL diagnostic path stopped with evidence preserved"
    STOP_CONDITIONS="${STOP_CONDITIONS} a2n_direction_failed"
  fi
else
  cflog "arm a2n-nccl-gdroff: SKIPPED (A1 NCCL evidence conclusive; Section 1.6F rule 2)"
fi

# --- Sweep end (TASK-2X8-013 stops after the authorized conditional arms) -----------
cflog "sweep_end: all authorized arms of the fixed A0 -> A1 -> conditional A2-U -> conditional A2-N path ran at most once each; TASK-2X8-013 stops after the authorized conditional arms (Section 1.6F rule 7: no further diagnostics, no Phase 4B/4C tuning); the strategic reading belongs to the Strategic Analyst via ANALYSE_RESULTS (Sections 1.4E, 1.10-1.11)"
cflog "anti-loop state: no additional diagnostic arms, no alternative GDR-off mechanisms, no UCX/NCCL transport tuning, no rail filters, no UCC changes, no microbenchmarks, and no profiling were added (TASK-2X8-013 Sections 1.6G, 1.7)"
if [ -n "$STOP_CONDITIONS" ]; then
  cflog "stop_conditions_recorded:${STOP_CONDITIONS} (each stop condition is recorded above with its evidence; affected diagnostic paths stopped without scope expansion)"
fi

# --- Post-sweep hardware-health snapshot (ordinary evidence; must not block) -------
echo "=== post-sweep hardware-health snapshot (mother node $(hostname)) ==="
nvidia-smi topo -m || echo "warn: nvidia-smi topo failed"
nvidia-smi --query-gpu=index,name,driver_version,temperature.gpu,power.draw,clocks.sm,memory.used,memory.total --format=csv || echo "warn: nvidia-smi query failed"

# --- Overall task result ------------------------------------------------------------
# Factual per-arm recap only (no percentages versus the campaign baseline,
# no strategic Phase-4 conclusion; the gate and A2 decisions are in the
# carry-forward log and the final reading belongs to the Strategic Analyst
# via ANALYSE_RESULTS, TASK-2X8-013 Sections 1.4E, 1.10-1.11). Nonzero
# overall if any arm was invalid (exit 0 with a missing PASSED
# verification, a FAILED/non-finite residual, or a failed settings-echo
# check) or if any Section 1.9 stop condition was recorded; those arms
# remain preserved invalid/boundary evidence and the affected diagnostic
# paths were stopped without scope expansion. A nonzero arm command exit
# cannot reach this point: it stops the sweep and returns nonzero
# immediately from run_arm (after its .status file is written), so the
# FAILURES term below is defensive only. Do not classify success from exit
# status alone; the per-arm .status files and .out verification markers
# are the validity record.
echo "=== task recap (factual scores only; gate/A2 decisions in the carry-forward log; interpretation reserved for ANALYSE_RESULTS) ==="
echo "arms_run=${ARMS_RUN} arms_exited_nonzero=${FAILURES} arms_invalid=${INVALID_ARMS} stop_conditions=${STOP_CONDITIONS:-none}"
for KEY in a0-clean a1-diag a2u-ucx-gdroff a2n-nccl-gdroff; do
  if [ -n "${ARM_SCORE[$KEY]+x}" ]; then
    echo "arm=${KEY} mode=${ARM_MODE[$KEY]:-unknown} gflops=${ARM_SCORE[$KEY]:-none} valid=${ARM_VALID[$KEY]:-no} exit=${ARM_EXIT[$KEY]:-unknown}"
  else
    echo "arm=${KEY} not_run"
  fi
done
if [ "$FAILURES" -ne 0 ] || [ "$INVALID_ARMS" -ne 0 ] || [ -n "$STOP_CONDITIONS" ]; then
  echo "=== HPL-MxP 2x8-GAAS phase4a-fast-path-characterization finished with ${FAILURES} arm(s) exited nonzero, ${INVALID_ARMS} invalid arm(s), and stop_conditions='${STOP_CONDITIONS:-none}' of ${ARMS_RUN} run (tag ${ATTEMPT_TAG}); invalid arms and stopped paths are preserved boundary/evidence records ==="
  exit 1
fi
echo "=== HPL-MxP 2x8-GAAS phase4a-fast-path-characterization complete: all ${ARMS_RUN} run arm(s) exited 0 with PASSED verification and PASS settings echo, and no stop condition was recorded (tag ${ATTEMPT_TAG}) ==="




