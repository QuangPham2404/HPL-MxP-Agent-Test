#!/bin/bash
# HPL-MxP 2x8-GAAS TASK-2X8-011 Phase 3C residency closure: 2 GAAS nodes x
# 8 H200 GPUs (16 ranks). The TASK-2X8-011-approved residency arms run
# sequentially within this single PBS allocation at the fixed retained
# TASK-010 geometry/runtime stack (tasks/TASK-2X8-011.md Sections 1.6A-1.6C);
# ONLY the FP64 residency controls (--fill-device, --Anq-device,
# --fill-device-buffer-size) vary:
#
#   Stage A - residency curve, run in exactly this order
#   (TASK-2X8-011 Section 1.6B):
#     F0: --fill-device 1 --fill-device-buffer-size 3048
#         (Anq-device omitted/overridden; record the effective echo only)
#     A0: --fill-device 0 --Anq-device 0
#     A1: --fill-device 0 --Anq-device 24576   (=  8 x NB)
#     A2: --fill-device 0 --Anq-device 49152   (= 16 x NB)
#     A3: --fill-device 0 --Anq-device 73728   (= 24 x NB)
#     A4: --fill-device 0 --Anq-device 98304   (= 32 x NB)
#     F1: --fill-device 1 --fill-device-buffer-size 3048
#   For fill-device 0 arms the fill-device buffer stays at the installed
#   package default (flag omitted; effective echo recorded); it is not a
#   swept variable in those arms. No intermediate or larger Anq values, no
#   added candidates, no repeats of valid points (Section 1.7 prohibitions).
#
#   Stage-A control-stability rule (Section 1.6B), evaluated mechanically
#   after F0..F1:
#     - F0 and F1 must both be valid (exit 0 + PASSED + finite residual +
#       settings-echo PASS). An invalid full-fill control means the bracket
#       cannot be established: STOP the scientific branch, hand the evidence
#       back. F2 is authorized ONLY for the >2.0% score-inconsistency path.
#     - "Differ by <=2.0% in end-to-end score" is encoded as the symmetric
#       spread max(F0,F1) <= min(F0,F1) * 1.02.
#     - "Same qualitative LU/IR/memory regime" is encoded with a deliberately
#       conservative mechanical proxy, defined here and recorded in the
#       carry-forward log with the raw values for orchestrator/Strategic
#       Analyst review: both arms valid, IR seconds numeric and within a
#       factor of 2 of each other, and per-process host-memory consumption
#       MAX numeric and within a factor of 10 of each other. (Observed
#       same-regime repeats move far less; the TASK-010 residency cliff is
#       ~5.5x IR and ~3756x host consumption, far outside both bands.)
#     - If F0/F1 differ by <=2.0% AND the regime proxy is consistent: the
#       bracket is stable; the mechanical full-fill reference is the
#       two-control median (= mean of the F0/F1 scores).
#     - If F0/F1 differ by >2.0%: run AT MOST ONE additional full-fill
#       control F2 at 3048 MB. If F2 is valid and the three controls are
#       mutually within 2.0% (max <= min * 1.02) with the regime proxy
#       consistent pairwise, the bracket is coherent and the reference is
#       the median of the three scores. Otherwise (F2 invalid, spread still
#       >2.0%, or regime materially different) STOP the scientific branch
#       and hand the evidence back; do not expand the sweep.
#     - If F0/F1 differ by <=2.0% but the regime proxy is inconsistent:
#       STOP the scientific branch (the qualitative-regime clause cannot be
#       certified) and hand the evidence back.
#
#   Stage-A bounded branch (Section 1.6B), evaluated only with a stable or
#   coherent full-fill reference:
#     1. Identify the best (highest-scoring) valid partial-residency A-arm;
#        exact score ties resolve to the lowest Anq value (deterministic).
#     2. If that arm is strictly >2.0% above the full-fill reference and its
#        correctness/memory evidence is complete (PASSED + finite residual +
#        host/device memory lines present): SKIP Stage B; run exactly one
#        bounded confirmation pair - repeat the selected Anq arm once
#        (conf-anq<value>) and repeat the full-fill 3048 MB control once
#        (conf-fill3048) - then STOP TASK-2X8-011 and hand the evidence back.
#     3. Otherwise, if the full-fill reference is within the <=2.0% leading
#        region (reference >= highest valid Stage-A score * 0.98), proceed
#        to Stage B.
#     4. Invalid/OOM/correctness-failing points are boundary evidence and
#        are never promoted or repeated for performance. If NO partial arm
#        is promotable and the full-fill reference is outside the leading
#        region (an anomalous mechanical state), STOP and hand the evidence
#        back.
#     This branch is mechanical carry-forward only. The script never declares
#     the final residency winner; that interpretation is reserved for the
#     Strategic Analyst via ANALYSE_RESULTS (Section 1.4).
#
#   Stage B - full-fill buffer closure (Section 1.6C), run ONLY when the
#   Stage-A branch retains full fill inside the leading <=2.0% region.
#   Keep --fill-device 1 and vary only the buffer, in this order:
#     B0: --fill-device 1 --fill-device-buffer-size 2048
#     B1: --fill-device 1 --fill-device-buffer-size 4096
#     B2: --fill-device 1 --fill-device-buffer-size 3048   (final control
#         repeat; F0/F1(/F2) already provide earlier 3048 MB controls)
#   Rules encoded: never test below 2048 MB; no intermediate or larger
#   buffer values; an invalid/correctness-failing buffer arm is a hard
#   safety boundary (preserved; the reserve is never squeezed further);
#   after B0/B1/B2 the task STOPS in every case - the script only records
#   the factual outcome class (plateau within 2.0%; a 2048/4096 arm >2.0%
#   above the in-stage 3048 control B2 preserved without refinement; other
#   >2.0% spread recorded without refinement; or boundary evidence). Stage B
#   never reopens Anq-device, N, NB, grid/order, or host runtime.
#
# Fixed non-residency scientific controls (TASK-2X8-011 Section 1.6A),
# identical for every arm and fixed to the retained TASK-010 stack:
#   N=429056, NB=3072, nprow=4, npcol=4, nporder=row,
#   --gpu-affinity 0:1:2:3:4:5:6:7 (identity map),
#   --cpu-affinity omitted, --mem-affinity omitted, --ucx-affinity omitted,
#   --sloppy-type FP16, --use-mpi-panel-broadcast 0,
#   --use-separate-stream-for-gemm 1, --prioritize-trsm 0,
#   --prioritize-factorization 0, --test-loop 1, --skip-tests 0,
#   --monitor-gpu 0.
#
#   Default-equal controls applied via the installed package defaults
#   (exactly the validated TASK-010 launch form; echoed values verified per
#   arm against the task's fixed values):
#     --u-panel-chunk-nbs                    = 8    (installed default)
#     --cuda-host-register-step              = 2048 (installed default)
#     --call-dgemv-with-multiple-threads     = 0    (installed default)
#     --preset-gemm-kernel                   = 90   (EFFECTIVE value; the
#       v26.02 CLI accepts only {0,80} - flag-check evidence
#       experiments/2x8-GAAS/baseline/outputs/hplmxp_v2602_flag_check_v1.log
#       line "--preset-gemm-kernel INT:{0,80} [0]"; passing 90 on the command
#       line is rejected ("90 not in {0,80}", SingleNode-resweep v1 Track 1
#       record, progress/2026-09-18-progress_s4.md). The effective SM90
#       preset 90 on H200 comes from the default when the flag is omitted -
#       the exact form TASK-010 ran. The flag is therefore OMITTED here and
#       the echoed effective value is verified = 90 per arm.)
#   Every arm's .status file records the application's echoed settings for
#   all fixed controls plus the residency controls, with a PASS/FAIL
#   settings-echo check; a mismatch marks the arm invalid for promotion
#   (control-application failure evidence) and is flagged in the
#   carry-forward log.
#
# Retained host-runtime contract (verified by TASK-009 phase3ab v2, PBS job
# 73174.gaas; TASK-2X8-011 Section 1.6A keeps it fixed for every arm):
#   OMP_NUM_THREADS=4  - explicitly exported in the job shell AFTER the
#                        module/job environment is established, forwarded to
#                        all MPI ranks with mpirun -x OMP_NUM_THREADS, and
#                        VERIFIED = 4 on all 16 ranks by a per-arm
#                        environment probe run immediately before every
#                        scored launch (a mismatch aborts before that arm's
#                        scored launch).
#   OMP_PLACES /       - omitted: the job shell unsets them after recording
#   OMP_PROC_BIND        the incoming values; the allocation-level rank-map
#                        probe verifies they are UNSET on all 16 ranks
#                        (abort before any scored arm otherwise); the
#                        per-arm env probe verifies omp_places=UNSET
#                        omp_proc_bind=UNSET on all 16 ranks with the arm's
#                        exact -x set (PATH, LD_LIBRARY_PATH,
#                        OMP_NUM_THREADS). Effective placement policy = the
#                        installed launcher's package defaults
#                        OMP_PLACES=sockets / OMP_PROC_BIND=TRUE (captured
#                        v26.02 launcher; experiments/2x8-GAAS/baseline/
#                        outputs/hplmxp_v2602_flag_check_v1.log).
#
# Environment-propagation contract (Blocker E, multi-node-test/
# GAAS_MULTINODE_SETUP.md): with this launcher combination, remote-node
# ranks inherit the remote orted/container environment and receive ONLY
# variables explicitly forwarded through mpirun -x (PATH and
# LD_LIBRARY_PATH were the validated precedents; TASK-009 validated -x
# OMP_NUM_THREADS the same way). PBS has previously clobbered
# OMP_NUM_THREADS with the allocation CPU count, so every scored arm
# re-exports OMP_NUM_THREADS=4 explicitly rather than relying on
# PBS/job-shell inheritance alone (TASK-2X8-011 Section 1.6A critical
# launcher contract).
#
# Arm-failure behavior (operational review fix):
# - A scored arm command that exits NONZERO: the arm's evidence is
#   preserved first (its .status file is fully written and the
#   carry-forward log records the abort), then the sweep STOPS before any
#   later arm of the authorized path is launched and the job returns
#   nonzero immediately (the .status file is always on disk before that
#   nonzero return, so the PBS-level and per-arm evidence remain). There
#   is no in-script retry; a rerun needs a new ATTEMPT_TAG plus human
#   direction (error classification per workflow/05 from the preserved
#   evidence).
# - An arm that exits 0 with an invalid verification (FAILED / non-finite
#   residual / missing score or markers) or a failed settings-echo check
#   is a scientific-correctness failure: preserved invalid/boundary
#   evidence under the approved workflow/task rules (TASK-2X8-011
#   Sections 1.4, 1.6B rule 4, 1.8 rule 5; workflow/05
#   scientific-correctness exception); the sweep continues with the next
#   arm of the already-authorized path, and the job returns nonzero
#   overall at the end if any arm was invalid. Invalid arms are never
#   promoted into the confirmation branch or repeated for performance.
#   The branch outcomes (STOP_AFTER_* / confirmation / Stage B) do not
#   affect the job exit status: they are normal authorized outcomes.
#
# Observational preflight failures abort BEFORE any scored arm (Track 2
# stop rules; workflow/05-Workflow-Error-Patching-Procedures.md and
# workflow/08-Workflow-Multinode-Tuning.md Section 5): (1) an allocated
# cpuset/topology that differs from the accepted Phase-0 topology on
# EITHER allocated node invalidates the retained GPU/NUMA identity map and
# the retained platform assumptions - the mother node is gated from the
# job shell and BOTH nodes are gated per host inside the rank-map probe
# stage, exactly as validated for TASK-008/TASK-009/TASK-010
# (replacement-node eligibility); (2) a rank-map probe that fails its
# mechanical 16-rank/8-per-node/2-host check indicates a launch or
# rank-mapping problem; (3) any rank reporting an incoming OMP_PLACES or
# OMP_PROC_BIND value means the "omitted" placement controls cannot be
# guaranteed on all ranks and the retained host-runtime contract cannot
# execute as approved (TASK-2X8-011 Section 1.10). In all cases evidence
# is preserved, no scored arm runs, and any rerun needs a new ATTEMPT_TAG
# plus human direction; the script never retries a hang, failed MPI_Init,
# rank misplacement, transport fallback, or uncertain correctness result.
#
# Purpose: execute the TASK-2X8-011 Phase-3C residency-closure study
# (tasks/TASK-2X8-011.md Sections 1.1-1.6) as ONE same-allocation
# sequential path (Section 1.8 rules 1-2: the entire authorized path runs
# in one clean allocation so all arms share the same node pair and launcher
# state). Execution records factual scores/timing/memory/correctness
# evidence and applies ONLY the pre-authorized mechanical stability rule,
# bounded branch, and stopping rules described above; the final strategic
# residency conclusion is reserved for the post-task Strategic Analyst via
# ANALYSE_RESULTS (Section 1.11). This script computes no percentage
# deltas versus the campaign baseline and performs no ranking beyond the
# mechanical branch rules.
#
# Expected working directory: this experiment directory
# (experiments/2x8-GAAS/phase3c-residency-closure/) on GAAS. Submit with
# (the queue is deliberately NOT selected in this script; pass an approved
# one at qsub):
#   qsub -q <gpu_as|gpu_ded> -v "ATTEMPT_TAG=v1" \
#        -o outputs/2x8-GAAS-phase3c-residency-closure_v1.o \
#        -e outputs/2x8-GAAS-phase3c-residency-closure_v1.e \
#        scripts/run_phase3c_residency_closure.pbs
#
# Inputs (environment, via qsub -v):
#   ATTEMPT_TAG  REQUIRED sweep attempt tag (e.g. v1); it names every
#                per-arm evidence file. A rerun must use a new tag. Before
#                any use the tag is validated against a conservative
#                filename-safe pattern: nonempty, only ASCII alphanumeric
#                characters, dot, underscore, and hyphen, and not '.' or
#                '..' (matched under LC_ALL=C inside a subshell, so the
#                check is locale-independent and leaves the job environment
#                untouched); anything else aborts before anything runs.
# Outputs: per-arm application stdout/stderr and status files under
#   outputs/2x8-GAAS-phase3c-residency-closure_<label>_<ATTEMPT_TAG>.{out,err,status}
#   with <label> one of the always-run Stage-A labels stagea-f0, stagea-a0,
#   stagea-a1, stagea-a2, stagea-a3, stagea-a4, stagea-f1, or the
#   conditional labels stagea-f2 (single authorized F2 control),
#   conf-anq0 / conf-anq24576 / conf-anq49152 / conf-anq73728 /
#   conf-anq98304 + conf-fill3048 (the single authorized confirmation
#   pair), and stageb-b0 / stageb-b1 / stageb-b2 (conditional Stage B);
#   the per-arm raw environment-probe evidence files
#   outputs/2x8-GAAS-phase3c-residency-closure_<label>_<ATTEMPT_TAG>.envprobe
#   (one per arm, attempt-specific; the probe's rank lines are also
#   appended to the env-map log below);
#   the allocation-level rank-map log (16 rank lines with the incoming
#   OMP environment plus the per-host local-rank-0 topology reports for
#   both allocated nodes)
#   outputs/2x8-GAAS-phase3c-residency-closure_rankmap_<ATTEMPT_TAG>.log;
#   the per-arm effective-OMP environment probe log
#   outputs/2x8-GAAS-phase3c-residency-closure_envmap_<ATTEMPT_TAG>.log;
#   the mechanical stability-rule/branch decision log
#   outputs/2x8-GAAS-phase3c-residency-closure_carryforward_<ATTEMPT_TAG>.log;
#   the deduplicated hostfile
#   outputs/2x8-GAAS-phase3c-residency-closure_hostfile_<ATTEMPT_TAG>
#   (shared by the rank-map probe, the per-arm env probes and all arms in
#   this allocation); environment provenance records echoed to the PBS .o
#   after the validated module load: loaded modules ('module list', an
#   optional record that must not fail the job), the Apptainer version,
#   and the container MPI
#   version (/usr/local/mpi/bin/mpirun --version, a lightweight read-only
#   query of the exact container mpirun the probe and arms launch, run
#   before the rank-map probe; both version invocations are
#   required-runtime checks handled deterministically: explicit rc capture
#   and a fatal abort before any scored work on nonzero rc), plus the
#   execution-worktree git revision (git -C "$REPO_ROOT" rev-parse HEAD;
#   non-fatal provenance: REPO_ROOT stays inside the approved remote
#   project root and a commit SHA exposes no secrets; no external
#   image-digest inspection is performed);
#   PBS-level stdout/stderr names are passed at qsub with -o/-e (this
#   script deliberately has no #PBS -o/-e directives). All runtime
#   artifacts this script creates - hostfile, per-arm env-probe output,
#   per-arm evidence, logs - are written beneath outputs/ under
#   attempt-specific names; nothing is left in the experiment root.
#   Existing attempt files are never overwritten: the script aborts before
#   running anything if any target file of this attempt already exists
#   (every possible arm label of the authorized path x
#   {out,err,status,envprobe} plus the rankmap/envmap/carryforward logs
#   and the attempt hostfile). An arm killed mid-run (e.g. by walltime)
#   keeps its .out/.err but has no .status file, and later arms of the
#   authorized path were not run.
# Assumptions: approved container and modules exist on GAAS; one GPU per
#   MPI process; validated Approach-1 multinode launch (container mpirun +
#   rsh_pbsdsh_container.sh bridge; see multi-node-test/GAAS_MULTINODE_SETUP.md);
#   the installed v26.02 launcher implements the captured affinity/OpenMP
#   semantics and the residency flags used here (--fill-device INT:{0,1},
#   --Anq-device INT:NONNEGATIVE, --fill-device-buffer-size
#   INT:NONNEGATIVE [3048]; flag-check evidence in
#   experiments/2x8-GAAS/baseline/outputs/hplmxp_v2602_flag_check_v1.log);
#   the accepted Phase-0 topology: PBS-visible cpuset 0-49,56-101 (96 CPUs:
#   50 on NUMA0/socket0, 46 on NUMA1/socket1; 1 thread per core, no SMT),
#   GPUs 0-3 -> NUMA0, GPUs 4-7 -> NUMA1
#   (scripts/probing_report.md, 2x8 supplement; job 72591.gaas).
#
# Walltime note: TASK-010's five-arm sequential sweep with five per-arm env
# probes used 00:12:48 of 01:30:00 (PBS job 76094.gaas). The longest
# authorized path here is ten scored arms (7 Stage A + 3 Stage B, or
# 7 Stage A + F2 + the 2-arm confirmation pair), each with a per-arm env
# probe; no/partial-residency arms (A0/A1) can run several minutes each
# (TASK-010's fully host-staged N=606208 arm took 03:38). 02:00:00 gives
# margin for the full authorized path; may be overridden at qsub.
#
# Queue policy: no queue is preselected here. TASK-2X8-011 authorizes only
#   gpu_as and gpu_ded (Sections 1.6A, 1.10); the submitting qsub must pass
#   -q explicitly, and this script verifies the actually-assigned queue and
#   aborts on anything else. select=2:ncpus=96:ngpus=8:mem=2000GB (no
#   mpiprocs; one rank per GPU; place=scatter) may likewise be overridden
#   on the qsub command line by a documented host-pinned select (see
#   README.md). Before submission, use the approved node-status workflow
#   (pbsnodes -aSj over the eligible queues) to prefer the cleanest
#   eligible same-queue 2-node allocation and record contention/provenance;
#   that presubmit snapshot is submission-side evidence, not part of this
#   script.

#PBS -N 2x8_phase3c_res
#PBS -P hpc_ebslee
#PBS -l select=2:ncpus=96:ngpus=8:mem=2000GB
#PBS -l place=scatter
#PBS -l walltime=02:00:00

set -euo pipefail

# --- Experiment metadata --------------------------------------------------------
cd "$PBS_O_WORKDIR"
EXPERIMENT_ID="2x8-GAAS-phase3c-residency-closure"
OUTDIR="$PWD/outputs"
mkdir -p "$OUTDIR"

ATTEMPT_TAG="${ATTEMPT_TAG:-}"
if [ -z "$ATTEMPT_TAG" ]; then
  echo "FATAL: ATTEMPT_TAG is required (e.g. -v \"ATTEMPT_TAG=v1\"); it names this sweep's evidence files" >&2
  exit 1
fi
# ATTEMPT_TAG is embedded in every evidence filename, so before it is used
# anywhere it must pass a conservative filename-safety gate: nonempty
# (checked above), only ASCII alphanumeric characters, dot, underscore and
# hyphen, and not '.' or '..'. The match runs under LC_ALL=C inside a
# subshell, making the character ranges byte-exact and locale-independent
# without modifying the job environment; any other value aborts before
# anything runs.
if ( LC_ALL=C
     case "$ATTEMPT_TAG" in
       '.'|'..'|*[!A-Za-z0-9._-]*) exit 1 ;;
     esac
   )
then
  echo "attempt_tag_validation=PASS (conservative filename-safe pattern: nonempty, ASCII alphanumeric '.' '_' '-' only, not '.' or '..')"
else
  echo "FATAL: ATTEMPT_TAG='${ATTEMPT_TAG}' is not a conservative filename-safe tag (required: nonempty, only ASCII alphanumeric characters, '.', '_', '-'; '.' and '..' are not valid tags); it names this sweep's evidence files" >&2
  exit 1
fi

# Only gpu_as and gpu_ded are authorized for TASK-2X8-011 (Sections 1.6A,
# 1.10). The queue is not preselected in this script; fail fast if PBS
# assigned any other queue (including an omitted -q falling through to a
# default queue).
QUEUE="${PBS_O_QUEUE:-unknown}"
case "$QUEUE" in
  gpu_as|gpu_ded) ;;
  *) echo "FATAL: queue '${QUEUE}' is not authorized for TASK-2X8-011 (only gpu_as or gpu_ded; Sections 1.6A, 1.10); pass -q at qsub" >&2; exit 1 ;;
esac

# --- Fixed scientific controls (TASK-2X8-011 Section 1.6A) ----------------------
# Only the FP64 residency controls vary across the arms (Section 1.6B/1.6C).
# Everything below is fixed and identical for all arms, including the
# retained TASK-009 verified host-runtime contract.
N_FIXED=429056
NB_FIXED=3072
NPROW=4
NPCOL=4
NPORDER=row
OMP_T_FIXED=4
FILL_BUFFER_CONTROL=3048

# Fixed identity GPU map (TASK-2X8-011 Section 1.6A): local rank r -> GPU r.
# --cpu-affinity, --mem-affinity and --ucx-affinity are omitted for every
# arm (CPU affinity is not reopened by TASK-2X8-011; memory affinity stays
# omitted by design; UCX device policy stays automatic/default, the retained
# TASK-008 outcome).
GPU_AFFINITY_FIXED="0:1:2:3:4:5:6:7"

# Stage-A approved arm set (TASK-2X8-011 Section 1.6B): exactly the order
# F0,A0,A1,A2,A3,A4,F1, once each, encoded by the explicit run_arm calls
# below. The Anq-device candidates are NB-aligned coarse residency points
# (24576 = 8 x NB, 49152 = 16 x NB, 73728 = 24 x NB, 98304 = 32 x NB with
# NB = 3072); no intermediate or larger Anq values, no additions, no
# repeats of valid points (Section 1.7 prohibitions).
ANQ_VALUES=(0 24576 49152 73728 98304)

echo "experiment_id=${EXPERIMENT_ID}"
echo "attempt_tag=${ATTEMPT_TAG}"
echo "pbs_job_id=${PBS_JOBID:-unknown}"
echo "queue=${QUEUE}"
echo "project=hpc_ebslee"
date --iso-8601=seconds
echo "fixed scientific controls (identical across all arms; only the FP64 residency controls vary; TASK-2X8-011 Section 1.6A):"
echo "--n 429056 --nb 3072 --nprow 4 --npcol 4 --nporder row"
echo "--gpu-affinity 0:1:2:3:4:5:6:7 (fixed identity map; --cpu-affinity omitted, --mem-affinity omitted, --ucx-affinity omitted for every arm)"
echo "OMP_NUM_THREADS=4 (explicit job-shell export after module setup + mpirun -x OMP_NUM_THREADS; verified = 4 on all 16 ranks by the per-arm env probe)"
echo "OMP_PLACES/OMP_PROC_BIND omitted (unset in the job shell; verified UNSET on all 16 ranks; effective launcher package defaults: OMP_PLACES=sockets, OMP_PROC_BIND=TRUE)"
echo "--sloppy-type FP16"
echo "--use-mpi-panel-broadcast 0"
echo "--use-separate-stream-for-gemm 1"
echo "--prioritize-trsm 0"
echo "--prioritize-factorization 0"
echo "--test-loop 1"
echo "--skip-tests 0"
echo "--monitor-gpu 0"
echo "default-equal controls applied via the installed package defaults exactly as in the validated TASK-010 launch, echoed values verified per arm: --u-panel-chunk-nbs = 8, --cuda-host-register-step = 2048, --call-dgemv-with-multiple-threads = 0, --preset-gemm-kernel = 90 (EFFECTIVE value; v26.02 CLI accepts only {0,80} so the flag is omitted and the default supplies the SM90 preset; flag-check evidence hplmxp_v2602_flag_check_v1.log)"
echo "residency controls (the ONLY varying scientific controls): Stage A fill/anq arms per TASK-2X8-011 Section 1.6B; conditional F2/confirmation pair/Stage B per Sections 1.6B-1.6C"
echo "controls NOT reopened by TASK-2X8-011 (Section 1.7): N/NB/grid/order, GPU/CPU/memory/UCX affinity, OMP threads/placement, cuda-host-register-step, call-dgemv-with-multiple-threads, UCX transport, MPI/NCCL panel policy, U-panel chunking, MPI fallbacks, sloppy precision, GEMM kernel, TRSM/factorization priorities, separate-stream policy"
echo "task: TASK-2X8-011 Phase 3C residency closure; Stage A order F0,A0,A1,A2,A3,A4,F1; the F2/confirmation/Stage-B conditional branches and stopping rules are encoded in-script per Sections 1.6B-1.6C"

# --- Locate repo root and the validated launch bridge ---------------------------
# Submission dir is experiments/2x8-GAAS/phase3c-residency-closure/, so the
# repo root is three levels up.
REPO_ROOT="$(cd "${PBS_O_WORKDIR}/../../.." && pwd)"
BRIDGE="${REPO_ROOT}/multi-node-test/rsh_pbsdsh_container.sh"
SIF="/home/pham0094/hpl_hpcg_hplmxp_container/hpc-benchmarks_26.02.sif"

if [ ! -f "$BRIDGE" ]; then
  echo "FATAL: bridge not found at ${BRIDGE}; submit from the experiment directory (experiments/2x8-GAAS/phase3c-residency-closure/)" >&2
  exit 1
fi
if [ ! -f "$SIF" ]; then
  echo "FATAL: container image not found: ${SIF}" >&2
  exit 1
fi

# --- Execution-worktree revision record (provenance; non-fatal) ------------------
# Print the Git revision of the tree this script executes from. REPO_ROOT is
# derived from the submission directory and stays inside the approved remote
# project root (the primary clone or a detached .codex-worktrees/ execution
# worktree beneath it), and 'git rev-parse HEAD' prints only a commit SHA, so
# the record cannot expose secrets. Provenance tool, not a required runtime:
# warn and record 'unknown' if git or the revision is unavailable
# (workflow/03: provenance tools must not block an otherwise valid run).
GIT_RC=0
GIT_REVISION="$(git -C "$REPO_ROOT" rev-parse HEAD 2>&1)" || GIT_RC=$?
if [ "$GIT_RC" -ne 0 ]; then
  echo "warn: 'git -C ${REPO_ROOT} rev-parse HEAD' failed with rc=${GIT_RC}: ${GIT_REVISION}"
  echo "execution_worktree_git_revision=unknown"
else
  echo "execution_worktree_root=${REPO_ROOT}"
  echo "execution_worktree_git_revision=${GIT_REVISION}"
fi

# --- Allocation checks (place=scatter, no mpiprocs; fixed 4x4 grid) --------------
GPUS=8                                   # GPUs (and ranks) per node
EXPECTED_NODES=2
NNODES=$(sort -u "$PBS_NODEFILE" | wc -l)
if [ "$NNODES" -ne "$EXPECTED_NODES" ]; then
  echo "FATAL: expected ${EXPECTED_NODES} distinct nodes, got ${NNODES}" >&2
  exit 1
fi
NPROCS=$((NNODES * GPUS))
if [ "$NPROCS" -ne $((NPROW * NPCOL)) ]; then
  echo "FATAL: fixed grid ${NPROW}x${NPCOL} requires $((NPROW * NPCOL)) ranks, got ${NPROCS}" >&2
  exit 1
fi

echo "layout=${NNODES} nodes x ${GPUS} GPUs = ${NPROCS} ranks (one rank per GPU)"
echo "grid=nprow=4 x npcol=4, nporder=row (fixed for every arm)"
echo "nodes=$(sort -u "$PBS_NODEFILE" | paste -sd' ')"
echo "bridge=${BRIDGE}"
echo "container=${SIF}"

# --- Phase-0 topology consistency gates (TASK-2X8-011 Sections 1.6A, 1.10) -------
# The retained platform identity (accepted Phase-0 topology: PBS-visible
# cpuset 0-49,56-101, Mems_allowed_list 0-1, GPUs 0-3 -> NUMA0 / GPUs 4-7 ->
# NUMA1, the eight 400G IB HCAs) underpins the retained identity GPU map, the
# automatic UCX device policy and the launcher package-default placement
# semantics of the retained TASK-009 host-runtime contract. This block gates
# the mother node (where this script and rank 0 run) from the job shell; the
# rank-map probe stage below additionally validates EVERY allocated host per
# host (two-host gate, retained unchanged from the validated TASK-008/
# TASK-009/TASK-010 scripts, so a replacement node pair such as g12+g14 is
# verified live per host before any scored arm).
CPUSET="$(grep -F 'Cpus_allowed_list:' /proc/self/status | awk '{print $2}')"
if [ "$CPUSET" != "0-49,56-101" ]; then
  echo "FATAL: allocated cpuset '${CPUSET}' differs from the accepted Phase-0 cpuset '0-49,56-101'; the retained GPU/NUMA map and the retained host-runtime contract assumptions are no longer valid (TASK-2X8-011 Sections 1.6A, 1.10; Track 2 stop)" >&2
  exit 1
fi
MEMSET="$(grep -F 'Mems_allowed_list:' /proc/self/status | awk '{print $2}')"
if [ "$MEMSET" != "0-1" ]; then
  echo "FATAL: allocated Mems_allowed_list '${MEMSET}' differs from the accepted Phase-0 value '0-1'; the retained GPU/NUMA map is no longer valid (TASK-2X8-011 Sections 1.6A, 1.10; Track 2 stop)" >&2
  exit 1
fi
NGPU_VISIBLE="$(nvidia-smi -L 2>/dev/null | wc -l || true)"
if [ "$NGPU_VISIBLE" -ne "$GPUS" ]; then
  echo "FATAL: expected ${GPUS} GPUs on the mother node, saw '${NGPU_VISIBLE}'" >&2
  exit 1
fi
for HCA in mlx5_0 mlx5_1 mlx5_2 mlx5_3 mlx5_4 mlx5_5 mlx5_8 mlx5_9; do
  if [ ! -d "/sys/class/infiniband/${HCA}" ]; then
    echo "FATAL: expected IB HCA ${HCA} is absent; the retained platform identity (automatic UCX device policy) is no longer valid (TASK-2X8-011 Sections 1.6A, 1.10; Track 2 stop)" >&2
    exit 1
  fi
done
TOPO_MATRIX="$(nvidia-smi topo -m 2>/dev/null || true)"
echo "=== mother-node GPU topology matrix (gate input + evidence) ==="
echo "$TOPO_MATRIX"
# Row selection is whitespace-tolerant: in the accepted Phase-0 evidence the
# GPU data rows start at column 0 and only the header is tab-indented
# (header bytes: TAB ESC[4m GPU0 TAB GPU1 ...), so the tolerant anchor still
# excludes the header while also accepting a matrix whose data rows arrive
# with leading whitespace. The gate assertion itself is the second-stage
# fixed-string check (CPU-affinity column value), unchanged. The GPU0/GPU4
# NUMA anchors verify that the GPU enumeration still matches the Phase-0
# identity map the retained host-runtime contract assumes.
if ! printf '%s\n' "$TOPO_MATRIX" | grep '^[[:space:]]*GPU0' | grep -Fq '0-49'; then
  echo "FATAL: GPU0 is not on NUMA0 CPUs 0-49 as in the accepted Phase-0 topology; the fixed identity GPU map and the retained host-runtime contract assumptions are no longer valid (TASK-2X8-011 Sections 1.6A, 1.10; Track 2 stop)" >&2
  exit 1
fi
if ! printf '%s\n' "$TOPO_MATRIX" | grep '^[[:space:]]*GPU4' | grep -Fq '56-101'; then
  echo "FATAL: GPU4 is not on NUMA1 CPUs 56-101 as in the accepted Phase-0 topology; the fixed identity GPU map and the retained host-runtime contract assumptions are no longer valid (TASK-2X8-011 Sections 1.6A, 1.10; Track 2 stop)" >&2
  exit 1
fi
for PAIR in "NIC0: mlx5_0" "NIC1: mlx5_1" "NIC2: mlx5_2" "NIC3: mlx5_3" "NIC4: mlx5_4" "NIC5: mlx5_5" "NIC6: mlx5_8" "NIC7: mlx5_9"; do
  if ! printf '%s\n' "$TOPO_MATRIX" | grep -Fq "$PAIR"; then
    echo "FATAL: topology legend no longer maps '${PAIR}'; the retained platform identity is no longer valid (TASK-2X8-011 Section 1.10; Track 2 stop)" >&2
    exit 1
  fi
done
echo "topology_gate=PASS (cpuset=${CPUSET} mems=${MEMSET} gpus=${NGPU_VISIBLE} hcas=mlx5_0..mlx5_5,mlx5_8,mlx5_9 GPU0->NUMA0(0-49) GPU4->NUMA1(56-101) NIC legend matches Phase-0)"

# --- Environment (validated module set) ------------------------------------------
module purge
module load apptainer/1.4.1 nvhpc/26.3 squashfuse/0.5.2 gocryptfs/2.5.0
chmod +x "$BRIDGE"
# Record the incoming job-shell OpenMP environment BEFORE the retained
# per-arm control application (TASK-2X8-011 Section 1.6A critical launcher
# contract: PBS has previously populated/clobbered OMP_NUM_THREADS with the
# allocation CPU count; every scored arm re-exports OMP_NUM_THREADS=4 after
# this environment is in place and -x forwards it to all ranks).
echo "incoming job-shell OpenMP environment (before per-arm control application):"
echo "  OMP_NUM_THREADS=${OMP_NUM_THREADS:-UNSET}"
echo "  OMP_PLACES=${OMP_PLACES:-UNSET}"
echo "  OMP_PROC_BIND=${OMP_PROC_BIND:-UNSET}"
# The retained host-runtime contract requires OMP_PLACES and OMP_PROC_BIND to
# be OMITTED from the job environment (TASK-2X8-011 Section 1.6A): guarantee the
# omission against any PBS/module clobbering. run_env_probe re-applies this
# before every scored arm, so a stale value can never leak into a scored
# launch.
unset OMP_PLACES OMP_PROC_BIND

# --- Environment provenance records (PBS stdout) ----------------------------------
# Read-only records for the PBS .o evidence, taken right after the validated
# module load. 'module list' is an OPTIONAL record: it must not fail the job
# (warn and continue). The Apptainer and container-MPI version invocations
# are REQUIRED runtime checks (the rank-map probe and every scored arm launch
# through these exact runtimes): each rc is captured explicitly and a nonzero
# rc aborts deterministically BEFORE any scored work (workflow/03 preflight
# rule: a tool check is fatal when the next command directly depends on the
# tool). No external image-digest inspection is performed.
echo "=== loaded modules (module list; optional record, non-fatal) ==="
module list 2>&1 || echo "warn: 'module list' failed (optional provenance record; continuing)"

APPTAINER_RC=0
APPTAINER_VERSION_OUTPUT="$(apptainer --version 2>&1)" || APPTAINER_RC=$?
echo "=== apptainer version (required runtime; rc=${APPTAINER_RC}) ==="
echo "${APPTAINER_VERSION_OUTPUT:-<no output>}"
if [ "$APPTAINER_RC" -ne 0 ]; then
  echo "FATAL: 'apptainer --version' failed with rc=${APPTAINER_RC}; apptainer is the required container runtime for every launch in this sweep (deterministic abort before scored work)" >&2
  exit 1
fi

# Container MPI version: lightweight read-only query of the exact container
# mpirun binary the rank-map probe and every scored arm launch, through the
# same apptainer exec prefix and bind mounts as those launches, run BEFORE
# the rank-map probe. REQUIRED runtime: a nonzero rc aborts deterministically
# before scored work (the probe and arms would fail identically).
CONTAINER_MPI_RC=0
CONTAINER_MPI_VERSION_OUTPUT="$(apptainer exec --nv \
  -B /opt/pbs:/opt/pbs \
  -B /var/spool/pbs:/var/spool/pbs \
  -B "$REPO_ROOT":"$REPO_ROOT" \
  "$SIF" \
  /usr/local/mpi/bin/mpirun --version 2>&1)" || CONTAINER_MPI_RC=$?
echo "=== container MPI version (/usr/local/mpi/bin/mpirun --version; required runtime; rc=${CONTAINER_MPI_RC}) ==="
echo "${CONTAINER_MPI_VERSION_OUTPUT:-<no output>}"
if [ "$CONTAINER_MPI_RC" -ne 0 ]; then
  echo "FATAL: container mpirun --version query failed with rc=${CONTAINER_MPI_RC}; the container MPI runtime is required for the rank-map probe and every scored arm (deterministic abort before scored work)" >&2
  exit 1
fi

# --- Pre-sweep hardware-health snapshot (ordinary evidence; must not block) ------
echo "=== pre-sweep hardware-health snapshot (mother node $(hostname)) ==="
nvidia-smi topo -m || echo "warn: nvidia-smi topo failed"
nvidia-smi --query-gpu=index,name,driver_version,temperature.gpu,power.draw,clocks.sm,memory.used,memory.total --format=csv || echo "warn: nvidia-smi query failed"

# --- Attempt-evidence guard (never overwrite existing evidence) -------------------
# Every arm writes attempt-specific .out/.err/.status files plus one
# attempt-specific .envprobe raw env-probe evidence file per arm, and the
# allocation writes one rank-map .log, one env-map .log, one carry-forward
# .log and one deduplicated hostfile, all beneath outputs/. The guard covers
# EVERY target name the authorized path can possibly emit: for each arm
# label below (the seven always-run Stage-A labels, the single conditional
# F2 control, all five possible confirmation Anq labels plus the
# confirmation full-fill control, and the three conditional Stage-B labels)
# the {out,err,status,envprobe} files, plus the rankmap/envmap/carryforward
# logs and the attempt hostfile. The guard runs BEFORE any of those targets
# is created (including the hostfile below). If any target file already
# exists, this ATTEMPT_TAG was already (partially) used: abort before
# running anything; a rerun must take a new ATTEMPT_TAG (anti-loop: every
# arm runs at most once per attempt; TASK-2X8-011 Section 1.7).
GUARD_LABELS=(stagea-f0 stagea-a0 stagea-a1 stagea-a2 stagea-a3 stagea-a4 stagea-f1 stagea-f2 conf-anq0 conf-anq24576 conf-anq49152 conf-anq73728 conf-anq98304 conf-fill3048 stageb-b0 stageb-b1 stageb-b2)
for LABEL in "${GUARD_LABELS[@]}"; do
  ATTEMPT="${EXPERIMENT_ID}_${LABEL}_${ATTEMPT_TAG}"
  for SUFFIX in out err status envprobe; do
    if [ -e "${OUTDIR}/${ATTEMPT}.${SUFFIX}" ]; then
      echo "FATAL: refusing to overwrite existing evidence ${OUTDIR}/${ATTEMPT}.${SUFFIX}; resubmit with a new ATTEMPT_TAG" >&2
      exit 1
    fi
  done
done
for GUARD_TARGET in \
  "${EXPERIMENT_ID}_rankmap_${ATTEMPT_TAG}.log" \
  "${EXPERIMENT_ID}_envmap_${ATTEMPT_TAG}.log" \
  "${EXPERIMENT_ID}_carryforward_${ATTEMPT_TAG}.log" \
  "${EXPERIMENT_ID}_hostfile_${ATTEMPT_TAG}"; do
  if [ -e "${OUTDIR}/${GUARD_TARGET}" ]; then
    echo "FATAL: refusing to overwrite existing evidence ${OUTDIR}/${GUARD_TARGET}; resubmit with a new ATTEMPT_TAG" >&2
    exit 1
  fi
done

# De-duplicated hostfile with explicit per-node slot count (GAAS Blocker 8),
# shared by the rank-map probe, the per-arm env probes and all arms in this
# allocation. Written beneath outputs/ with an attempt-specific name and
# covered by the guard above, so no runtime artifact is left in the
# experiment root.
MPI_HOSTFILE="${OUTDIR}/${EXPERIMENT_ID}_hostfile_${ATTEMPT_TAG}"
awk -v g="$GPUS" '{ sub(/\r$/,""); if (!seen[$0]++) print $0 " slots=" g }' \
  "$PBS_NODEFILE" > "$MPI_HOSTFILE"
echo "=== hostfile (${MPI_HOSTFILE}) ==="
cat "$MPI_HOSTFILE"

# --- Allocation-level rank-map probe (TASK-2X8-011 Sections 1.4, 1.6A, 1.10) -----
# One lightweight 16-rank MPI mapping probe BEFORE any scored arm, using the
# SAME shared hostfile and the SAME container mpirun + bridge + daemon flags
# as the scored launch. No OMP variable is -x forwarded in this probe (only
# PATH/LD_LIBRARY_PATH), so the reported values are what each rank's
# execution environment supplies BEFORE the retained per-arm controls are
# applied. Diagnostic only: it adds no communication tracing and must not
# alter scientific controls. It preserves global_rank / local_rank /
# hostname for all 16 ranks (confirming 16 MPI ranks, 8 ranks/node; the
# rank/node mapping evidence of Section 1.4) AND the INCOMING OMP_NUM_THREADS /
# OMP_PLACES / OMP_PROC_BIND values seen inside each rank's execution
# environment.
#
# The per-host topology validation is retained unchanged from the validated
# TASK-008/TASK-009/TASK-010 two-host gate: node-local rank 0 on each
# allocated host reports the local node topology facts into the SAME rank-map
# log (hostname, cpuset, Mems_allowed_list, GPU count, the eight 400G IB
# HCAs, and the full nvidia-smi topo -m), and the per-host gate below
# requires BOTH allocated hosts to match the accepted Phase-0 topology
# before any scored arm (replacement-node eligibility).
RANKMAP_LOG="${OUTDIR}/${EXPERIMENT_ID}_rankmap_${ATTEMPT_TAG}.log"
RC=0
apptainer exec --nv \
  -B /opt/pbs:/opt/pbs \
  -B /var/spool/pbs:/var/spool/pbs \
  -B "$REPO_ROOT":"$REPO_ROOT" \
  "$SIF" \
  /usr/local/mpi/bin/mpirun -np "$NPROCS" \
    --hostfile "$MPI_HOSTFILE" \
    --mca plm_rsh_agent "$BRIDGE" \
    --mca plm_rsh_no_tree_spawn 1 \
    --mca plm_rsh_num_concurrent 1 \
    --mca routed direct \
    -x PATH -x LD_LIBRARY_PATH \
    --bind-to none \
    bash -c '
      # Mapping line for every rank, including the incoming OpenMP
      # environment (no OMP variable is -x forwarded in this probe, so the
      # reported values are what the rank execution environment supplies
      # before the retained TASK-2X8-011 per-arm controls are applied).
      if [ "${OMPI_COMM_WORLD_LOCAL_RANK:-}" = "0" ]; then
        # Node-local rank 0 only, once per host: read-only report of the
        # local node topology facts into the same rank-map log. No
        # scientific control is touched; a failed query yields a missing or
        # empty fact, which the per-host gate below fails safely.
        H="$(hostname)"
        echo "topo host=${H} begin local_rank0 global_rank=${OMPI_COMM_WORLD_RANK}"
        L="$(grep -F "Cpus_allowed_list:" /proc/self/status || true)"
        L="${L#*:}"; L="${L//[[:space:]]/}"
        echo "topo host=${H} cpuset=${L:-missing}"
        M="$(grep -F "Mems_allowed_list:" /proc/self/status || true)"
        M="${M#*:}"; M="${M//[[:space:]]/}"
        echo "topo host=${H} mems=${M:-missing}"
        NG="$(nvidia-smi -L 2>/dev/null | wc -l || true)"
        NG="${NG//[[:space:]]/}"
        echo "topo host=${H} ngpus=${NG:-missing}"
        for D in mlx5_0 mlx5_1 mlx5_2 mlx5_3 mlx5_4 mlx5_5 mlx5_8 mlx5_9; do
          if [ -d "/sys/class/infiniband/${D}" ]; then
            echo "topo host=${H} hca=${D} present=yes"
          else
            echo "topo host=${H} hca=${D} present=no"
          fi
        done
        nvidia-smi topo -m 2>/dev/null | while IFS= read -r LINE; do
          echo "topo host=${H} topo_m=${LINE}"
        done
        echo "topo host=${H} end local_rank0"
      fi
      echo "rank=${OMPI_COMM_WORLD_RANK}/${OMPI_COMM_WORLD_SIZE} host=$(hostname) local_rank=${OMPI_COMM_WORLD_LOCAL_RANK}/${OMPI_COMM_WORLD_LOCAL_SIZE} omp_num_threads=${OMP_NUM_THREADS:-UNSET} omp_places=${OMP_PLACES:-UNSET} omp_proc_bind=${OMP_PROC_BIND:-UNSET}"
    ' \
  > "$RANKMAP_LOG" 2>&1 || RC=$?

# Mechanical gate: the probe must have exited 0, emitted exactly NPROCS rank
# lines, exactly EXPECTED_NODES distinct hostnames, and exactly GPUS rank
# lines per host. Otherwise abort BEFORE any scored arm (launch/rank-mapping
# problem; TASK-2X8-011 Section 1.10; Track 2 stop); the probe evidence is
# preserved in RANKMAP_LOG and a rerun needs a new ATTEMPT_TAG.
RANK_LINES=$(grep -c "^rank=" "$RANKMAP_LOG" || true)
HOST_COUNT=$(grep "^rank=" "$RANKMAP_LOG" | awk '{ sub(/^host=/, "", $2); seen[$2] = 1 } END { n = 0; for (h in seen) n++; print n }' || true)
MIN_RANKS_PER_HOST=$(grep "^rank=" "$RANKMAP_LOG" | awk '{ sub(/^host=/, "", $2); cnt[$2]++ } END { n = 0; for (h in cnt) { if (n == 0 || cnt[h] < m) m = cnt[h]; n++ } print (n == 0 ? 0 : m) }' || true)
MAX_RANKS_PER_HOST=$(grep "^rank=" "$RANKMAP_LOG" | awk '{ sub(/^host=/, "", $2); cnt[$2]++ } END { n = 0; for (h in cnt) { if (n == 0 || cnt[h] > m) m = cnt[h]; n++ } print (n == 0 ? 0 : m) }' || true)
if [ "$MIN_RANKS_PER_HOST" = "$MAX_RANKS_PER_HOST" ]; then
  RANKS_PER_HOST_SUMMARY="$MIN_RANKS_PER_HOST"
else
  RANKS_PER_HOST_SUMMARY="${MIN_RANKS_PER_HOST}-${MAX_RANKS_PER_HOST}"
fi
echo "=== rank-map probe: rc=${RC} rank_lines=${RANK_LINES} hosts=${HOST_COUNT} ranks_per_host=${RANKS_PER_HOST_SUMMARY} log=${RANKMAP_LOG} ==="
if [ "$RC" -ne 0 ] || [ "$RANK_LINES" -ne "$NPROCS" ] || [ "$HOST_COUNT" -ne "$EXPECTED_NODES" ] || [ "$MIN_RANKS_PER_HOST" -ne "$GPUS" ] || [ "$MAX_RANKS_PER_HOST" -ne "$GPUS" ]; then
  echo "FATAL: rank-map probe failed its mechanical check (rc=${RC} rank_lines=${RANK_LINES} hosts=${HOST_COUNT} ranks_per_host=${RANKS_PER_HOST_SUMMARY}; launch/rank-mapping problem; TASK-2X8-011 Section 1.10; Track 2 stop; evidence preserved in ${RANKMAP_LOG}; rerun needs a new ATTEMPT_TAG)" >&2
  exit 1
fi

# Incoming-OpenMP-environment gate (TASK-2X8-011 Sections 1.6A, 1.10): the
# retained host-runtime contract requires OMP_PLACES and OMP_PROC_BIND to be
# omitted from the rank execution environment so the installed launcher's
# package defaults (OMP_PROC_BIND=TRUE, OMP_PLACES=sockets) remain the
# effective policy. The job shell unsets them above; this gate verifies the
# INCOMING values on every rank (no -x override in the probe). Any rank
# reporting a set OMP_PLACES or OMP_PROC_BIND means the omission cannot be
# guaranteed on all ranks and the retained host-runtime contract cannot
# execute as approved (Track 2 stop before scored work; evidence preserved).
# The incoming OMP_NUM_THREADS values are recorded as evidence only: PBS has
# previously clobbered it with the allocation CPU count, and every scored
# arm re-exports OMP_NUM_THREADS=4 and -x forwards it, which overrides any
# incoming value on every rank.
OMP_PLACES_SET_LINES=$(grep "^rank=" "$RANKMAP_LOG" | grep -vcF "omp_places=UNSET" || true)
OMP_BIND_SET_LINES=$(grep "^rank=" "$RANKMAP_LOG" | grep -vcF "omp_proc_bind=UNSET" || true)
echo "incoming OMP environment across ${RANK_LINES} ranks: ranks_with_OMP_PLACES_set=${OMP_PLACES_SET_LINES} ranks_with_OMP_PROC_BIND_set=${OMP_BIND_SET_LINES}"
echo "incoming OMP_NUM_THREADS values seen (evidence; neutralized per arm by explicit export + -x forwarding):"
grep "^rank=" "$RANKMAP_LOG" | sed 's/^/  /'
if [ "$OMP_PLACES_SET_LINES" -ne 0 ] || [ "$OMP_BIND_SET_LINES" -ne 0 ]; then
  echo "FATAL: incoming OMP_PLACES/OMP_PROC_BIND are set on some ranks (OMP_PLACES_set=${OMP_PLACES_SET_LINES}, OMP_PROC_BIND_set=${OMP_BIND_SET_LINES}); the 'omitted' placement controls of the retained TASK-009 host-runtime contract cannot be guaranteed on all ranks, so the TASK-2X8-011 arm family cannot execute as approved (Sections 1.6A, 1.10; Track 2 stop; evidence preserved in ${RANKMAP_LOG}; rerun needs a new ATTEMPT_TAG)" >&2
  exit 1
fi
echo "incoming_openmp_gate=PASS (OMP_PLACES/OMP_PROC_BIND unset on all ${RANK_LINES} ranks; launcher package defaults remain the effective placement policy)"

# Per-host topology gate (two-host gate; TASK-2X8-011 Sections 1.6A, 1.7, 1.10):
# verify the local-rank-0 topology report collected by the probe above for
# EVERY distinct host in the rank map (the mechanical gate already fixed the
# host set at exactly EXPECTED_NODES hosts with GPUS ranks each). Each host
# must match the accepted Phase-0 topology the retained GPU/NUMA identity
# map and the retained host-runtime contract assumptions require - the same
# assertions as the mother-node gate above, now applied to BOTH allocated
# nodes. Any mismatch means the retained topology assumptions are invalid on
# that host: the rank-map stage FAILS and aborts BEFORE any scored arm
# (observational preflight failure; Track 2 stop, no auto retry), with the
# per-host reports preserved in RANKMAP_LOG; a rerun needs a new
# ATTEMPT_TAG.
TOPO_FAILED_HOSTS=""
for TOPO_HOST in $(grep "^rank=" "$RANKMAP_LOG" | awk '{ sub(/^host=/, "", $2); print $2 }' | sort -u); do
  TOPO_OK=1
  if [ "$(grep -c "^topo host=${TOPO_HOST} begin local_rank0" "$RANKMAP_LOG" || true)" -ne 1 ] \
     || [ "$(grep -c "^topo host=${TOPO_HOST} end local_rank0$" "$RANKMAP_LOG" || true)" -ne 1 ]; then
    echo "  host=${TOPO_HOST} topology_gate=FAIL: expected exactly one local-rank-0 topology report (begin=$(grep -c "^topo host=${TOPO_HOST} begin local_rank0" "$RANKMAP_LOG" || true) end=$(grep -c "^topo host=${TOPO_HOST} end local_rank0$" "$RANKMAP_LOG" || true))" >&2
    TOPO_OK=0
  fi
  TOPO_VAL="$(grep "^topo host=${TOPO_HOST} cpuset=" "$RANKMAP_LOG" | head -n 1 || true)"
  if [ "$TOPO_VAL" != "topo host=${TOPO_HOST} cpuset=0-49,56-101" ]; then
    echo "  host=${TOPO_HOST} topology_gate=FAIL: cpuset is not the accepted Phase-0 value 0-49,56-101 (reported: '${TOPO_VAL:-<none>}')" >&2
    TOPO_OK=0
  fi
  TOPO_VAL="$(grep "^topo host=${TOPO_HOST} mems=" "$RANKMAP_LOG" | head -n 1 || true)"
  if [ "$TOPO_VAL" != "topo host=${TOPO_HOST} mems=0-1" ]; then
    echo "  host=${TOPO_HOST} topology_gate=FAIL: Mems_allowed_list is not the accepted Phase-0 value 0-1 (reported: '${TOPO_VAL:-<none>}')" >&2
    TOPO_OK=0
  fi
  TOPO_VAL="$(grep "^topo host=${TOPO_HOST} ngpus=" "$RANKMAP_LOG" | head -n 1 || true)"
  if [ "$TOPO_VAL" != "topo host=${TOPO_HOST} ngpus=8" ]; then
    echo "  host=${TOPO_HOST} topology_gate=FAIL: expected 8 GPUs on this host (reported: '${TOPO_VAL:-<none>}')" >&2
    TOPO_OK=0
  fi
  for TOPO_HCA in mlx5_0 mlx5_1 mlx5_2 mlx5_3 mlx5_4 mlx5_5 mlx5_8 mlx5_9; do
    if ! grep -q "^topo host=${TOPO_HOST} hca=${TOPO_HCA} present=yes$" "$RANKMAP_LOG"; then
      echo "  host=${TOPO_HOST} topology_gate=FAIL: expected IB HCA ${TOPO_HCA} not reported present (accepted Phase-0 inventory: mlx5_0..mlx5_5,mlx5_8,mlx5_9)" >&2
      TOPO_OK=0
    fi
  done
  # Row selection is whitespace-tolerant (same precedent as the mother-node
  # gate): the GPU0/GPU4 NUMA anchors verify the GPU enumeration still
  # matches the Phase-0 identity map the retained contract assumes.
  if ! grep "^topo host=${TOPO_HOST} topo_m=" "$RANKMAP_LOG" | grep "topo_m=[[:space:]]*GPU0[[:space:]]" | grep -Fq "0-49"; then
    echo "  host=${TOPO_HOST} topology_gate=FAIL: GPU0 is not on NUMA0 CPUs 0-49 as in the accepted Phase-0 topology (full matrix preserved in the rank-map log)" >&2
    TOPO_OK=0
  fi
  if ! grep "^topo host=${TOPO_HOST} topo_m=" "$RANKMAP_LOG" | grep "topo_m=[[:space:]]*GPU4[[:space:]]" | grep -Fq "56-101"; then
    echo "  host=${TOPO_HOST} topology_gate=FAIL: GPU4 is not on NUMA1 CPUs 56-101 as in the accepted Phase-0 topology (full matrix preserved in the rank-map log)" >&2
    TOPO_OK=0
  fi
  for TOPO_PAIR in "NIC0: mlx5_0" "NIC1: mlx5_1" "NIC2: mlx5_2" "NIC3: mlx5_3" "NIC4: mlx5_4" "NIC5: mlx5_5" "NIC6: mlx5_8" "NIC7: mlx5_9"; do
    if ! grep "^topo host=${TOPO_HOST} topo_m=" "$RANKMAP_LOG" | grep -Fq "$TOPO_PAIR"; then
      echo "  host=${TOPO_HOST} topology_gate=FAIL: topology legend no longer maps '${TOPO_PAIR}' (retained platform identity invalid on this host)" >&2
      TOPO_OK=0
    fi
  done
  if [ "$TOPO_OK" -eq 1 ]; then
    echo "  host=${TOPO_HOST} topology_gate=PASS (cpuset=0-49,56-101 mems=0-1 gpus=8 hcas=mlx5_0..mlx5_5,mlx5_8,mlx5_9 GPU0->NUMA0(0-49) GPU4->NUMA1(56-101) NIC0..NIC7->mlx5_0..mlx5_9)"
  else
    TOPO_FAILED_HOSTS="${TOPO_FAILED_HOSTS} ${TOPO_HOST}"
  fi
done
if [ -n "$TOPO_FAILED_HOSTS" ]; then
  echo "rankmap_per_host_topology_gate=FAIL (failed hosts:${TOPO_FAILED_HOSTS})" >&2
  echo "FATAL: rank-map probe per-host topology gate failed on${TOPO_FAILED_HOSTS}; a host that does not match the accepted Phase-0 topology invalidates the retained GPU/NUMA identity map and the retained host-runtime contract assumptions (TASK-2X8-011 Sections 1.6A, 1.7, 1.10; aborting BEFORE any scored arm; Track 2 stop; evidence preserved in ${RANKMAP_LOG}; rerun needs a new ATTEMPT_TAG)" >&2
  exit 1
fi
echo "rankmap_per_host_topology_gate=PASS (every allocated host matches the accepted Phase-0 topology; per-host reports preserved in ${RANKMAP_LOG})"

# --- Helper functions --------------------------------------------------------------
# Overall HPL-MxP GFLOP/s from an application .out file (first "GFLOPS = "
# match is the overall score; "LU GFLOPS" appears later), or empty.
extract_gflops() {
  grep -o 'GFLOPS = [0-9.eE+-]*' "$1" 2>/dev/null | head -n 1 | awk '{ print $3 }' || true
}

# LU factorization time (AVG seconds) from "LU seconds: AVG = <v>, ...".
extract_lu_seconds() {
  grep -o 'LU seconds: AVG = [0-9.]*' "$1" 2>/dev/null | head -n 1 | awk '{ print $5 }' || true
}

# LU GFLOP/s from "LU GFLOPS = <v>, per GPU = ...".
extract_lu_gflops() {
  grep -o 'LU GFLOPS = [0-9.eE+-]*' "$1" 2>/dev/null | head -n 1 | awk '{ print $4 }' || true
}

# Iterative-refinement time (AVG seconds) from
# "Iterative Solver seconds: AVG = <v>, ...".
extract_ir_seconds() {
  grep -o 'Iterative Solver seconds: AVG = [0-9.]*' "$1" 2>/dev/null | head -n 1 | awk '{ print $6 }' || true
}

# Solver iteration count from the "Solver iteration <k>, ..." lines.
count_solver_iterations() {
  grep -c '^Solver iteration' "$1" 2>/dev/null || true
}

# Last line of the .out containing the fixed string (raw emitted evidence).
capture_line() {
  grep -F "$2" "$1" 2>/dev/null | tail -n 1 || true
}

# Effective settings-echo value for --<name> from the application .out
# settings block (lines of the form "   --<name>   = <value> "); empty when
# the block or the entry is absent. The prefix match is exact ("--n" does
# not match the "--nb" line) and whitespace between the flag and '=' is
# tolerated (both "--nprow =  4" and "--fill-device      = 1" forms).
extract_echo() {
  awk -v f="$2" '
    {
      line = $0
      sub(/^[[:space:]]+/, "", line)
      p = "--" f
      if (index(line, p) == 1) {
        rest = substr(line, length(p) + 1)
        if (rest ~ /^[[:space:]]*=/) {
          sub(/^[[:space:]]*=[[:space:]]*/, "", rest)
          sub(/[[:space:]]+$/, "", rest)
          print rest
          exit
        }
      }
    }' "$1" 2>/dev/null || true
}

# Numeric GB value from a captured "consumption MAX = <v> GB" memory line,
# or empty when the line/value is absent.
gb_value() {
  printf '%s\n' "$1" | sed -nE 's/.*MAX = ([0-9]+(\.[0-9]+)?) GB.*/\1/p' || true
}

# Mechanical IR/LU time ratio (TASK-2X8-011 Section 1.4 factual derived
# value), or empty when either input is missing/non-numeric.
ir_lu_ratio() {
  awk -v ir="$1" -v lu="$2" 'BEGIN { if (ir ~ /^[0-9.]+$/ && lu ~ /^[0-9.]+$/ && lu > 0) printf "%.3f", ir / lu }' || true
}

# Indicative allocation/staging/OOM/fallback warning-marker counter for an
# evidence file (lines matched, summed over a fixed pattern list). The raw
# .out/.err files remain the authoritative warning evidence; this counter is
# only a compact summary for the .status/carry-forward records.
warn_count() {
  local f="$1" t=0 c
  c=$(grep -Fic 'out of memory' "$f" 2>/dev/null || true); t=$(( t + ${c:-0} ))
  c=$(grep -Fc 'OOM' "$f" 2>/dev/null || true); t=$(( t + ${c:-0} ))
  c=$(grep -Fic 'CUDA error' "$f" 2>/dev/null || true); t=$(( t + ${c:-0} ))
  c=$(grep -Fic 'failed to allocate' "$f" 2>/dev/null || true); t=$(( t + ${c:-0} ))
  c=$(grep -Fic 'allocation failure' "$f" 2>/dev/null || true); t=$(( t + ${c:-0} ))
  c=$(grep -Fic 'fallback' "$f" 2>/dev/null || true); t=$(( t + ${c:-0} ))
  echo "$t"
}

# cmp_echo <expected> <actual> <name>: records a settings-echo mismatch into
# SETTINGS_MISMATCH (the caller initializes SETTINGS_MISMATCH="").
cmp_echo() {
  if [ "$1" != "$2" ]; then
    SETTINGS_MISMATCH="${SETTINGS_MISMATCH:+$SETTINGS_MISMATCH }$3(expected=$1,echoed=${2:-missing})"
  fi
}

# gt2pct <candidate> <base>: returns 0 iff candidate is strictly >2.0% above
# base (the TASK-2X8-011 Section 1.6B promotion gate; a value exactly 2.0%
# above does NOT clear the gate).
gt2pct() {
  awk -v c="$1" -v b="$2" 'BEGIN { exit (c > b * 1.02) ? 0 : 1 }'
}

# within2pct <candidate> <reference>: returns 0 iff candidate is within 2.0%
# of reference (candidate >= reference * 0.98); the TASK-2X8-011 Section 1.6B
# leading-region membership rule.
within2pct() {
  awk -v c="$1" -v r="$2" 'BEGIN { exit (c >= r * 0.98) ? 0 : 1 }'
}

# gt_num <a> <b>: returns 0 iff a > b (plain numeric comparison for
# leader/best-arm selection).
gt_num() {
  awk -v a="$1" -v b="$2" 'BEGIN { exit (a > b) ? 0 : 1 }'
}

# le2pct_spread <a> <b>: returns 0 iff the two numeric scores differ by
# <=2.0% symmetrically (max <= min * 1.02); the TASK-2X8-011 Section 1.6B
# F0/F1 control-stability spread test. Accepts plain and scientific
# notation (application scores are emitted as e.g. "6.4431e+06").
le2pct_spread() {
  awk -v a="$1" -v b="$2" 'BEGIN {
    if (a !~ /^[0-9][0-9.eE+-]*$/ || b !~ /^[0-9][0-9.eE+-]*$/) exit 1
    lo = (a < b ? a : b); hi = (a < b ? b : a)
    exit (hi <= lo * 1.02) ? 0 : 1
  }'
}

# le2pct_spread_n (stdin: one numeric score per line): returns 0 iff all
# scores are numeric and max <= min * 1.02; the three-control coherence
# spread test after F2. Accepts plain and scientific notation.
le2pct_spread_n() {
  awk '
    {
      if ($1 !~ /^[0-9][0-9.eE+-]*$/) { bad = 1; exit }
      v = $1 + 0
      if (n == 0 || v < mn) mn = v
      if (n == 0 || v > mx) mx = v
      n++
    }
    END {
      if (bad || n == 0) exit 1
      exit (mx <= mn * 1.02) ? 0 : 1
    }'
}

# regime_consistent <ir1> <host1> <ir2> <host2>: returns 0 iff the
# conservative same-regime proxy holds for two full-fill controls (see the
# header): all four inputs numeric, IR seconds within a factor of 2, and
# per-process host-memory consumption MAX within a factor of 10.
regime_consistent() {
  awk -v ir1="$1" -v h1="$2" -v ir2="$3" -v h2="$4" 'BEGIN {
    if (ir1 !~ /^[0-9.]+$/ || ir2 !~ /^[0-9.]+$/ || h1 !~ /^[0-9.]+$/ || h2 !~ /^[0-9.]+$/) exit 1
    irl = (ir1 < ir2 ? ir1 : ir2); irh = (ir1 < ir2 ? ir2 : ir1)
    if (irl + 0 == 0) { if (irh + 0 != 0) exit 1 } else if (irh > irl * 2) exit 1
    hl = (h1 < h2 ? h1 : h2); hh = (h1 < h2 ? h2 : h1)
    if (hl + 0 == 0) { if (hh + 0 != 0) exit 1 } else if (hh > hl * 10) exit 1
    exit 0
  }'
}

# median_score <scores...>: prints the median of the given numeric scores
# (two scores -> their mean, the two-point median; three -> the middle value
# after numeric sort). Used for the mechanical full-fill reference
# (TASK-2X8-011 Section 1.6B: "the median full-fill score").
median_score() {
  local vals n
  vals="$(for v in "$@"; do printf '%s\n' "$v"; done | sort -g)"
  n=$#
  if [ $((n % 2)) -eq 1 ]; then
    printf '%s\n' "$vals" | awk -v m=$(( (n + 1) / 2 )) 'NR == m { print; exit }'
  else
    printf '%s\n' "$vals" | awk -v m1=$(( n / 2 )) -v m2=$(( n / 2 + 1 )) 'NR == m1 { a = $1 } NR == m2 { printf "%.6e", (a + $1) / 2; exit }'
  fi
}

# Mechanical stability-rule/branch decision log (evidence; also echoed to
# job stdout).
CFLOG="${OUTDIR}/${EXPERIMENT_ID}_carryforward_${ATTEMPT_TAG}.log"
cflog() { echo "$*" | tee -a "$CFLOG"; }

# Per-arm effective-OMP environment probe log (evidence).
ENVMAP_LOG="${OUTDIR}/${EXPERIMENT_ID}_envmap_${ATTEMPT_TAG}.log"
: > "$ENVMAP_LOG"

# Per-arm score/validity/exit/timing/memory/settings records.
declare -A ARM_SCORE ARM_VALID ARM_EXIT ARM_RUN_VERDICT ARM_SETTINGS_OK \
  ARM_LU_SECONDS ARM_LU_GFLOPS ARM_IR_SECONDS ARM_IR_LU_RATIO \
  ARM_ITERATIONS ARM_RESIDUAL ARM_HOST_CONS ARM_DEVICE_CONS ARM_MEM_OK \
  ARM_MODE ARM_ANQ ARM_BUFFER
FAILURES=0
INVALID_ARMS=0
ARMS_RUN=0

# run_env_probe <key>
# Establishes the retained host-runtime environment (explicit
# OMP_NUM_THREADS=4 export after the module/job environment, OMP_PLACES and
# OMP_PROC_BIND guaranteed unset), runs one lightweight 16-rank probe with
# the EXACT -x forwarding set of the arm it precedes (PATH,
# LD_LIBRARY_PATH, OMP_NUM_THREADS) and the same hostfile/daemon flags as
# the scored launch, then verifies every rank reports
# omp_num_threads=4 omp_places=UNSET omp_proc_bind=UNSET and appends the
# per-rank lines to ENVMAP_LOG (the raw probe output is preserved as the
# attempt-specific per-arm .envprobe evidence file beneath outputs/). This
# is the TASK-2X8-011 Section 1.4
# "verified OMP_NUM_THREADS=4 on all 16 MPI ranks" evidence for the retained
# contract. On success the shell environment is left in the verified state
# so the immediately following scored launch inherits exactly the verified
# controls. A mismatch means the retained host-runtime contract is not
# effectively applied on all ranks: abort BEFORE that arm's scored launch
# (control-application failure; TASK-2X8-011 Section 1.10; evidence
# preserved). No workload runs in the probe.
run_env_probe() {
  PROBE_KEY="$1"
  export OMP_NUM_THREADS="$OMP_T_FIXED"
  unset OMP_PLACES OMP_PROC_BIND
  local XARGS=(-x PATH -x LD_LIBRARY_PATH -x OMP_NUM_THREADS)
  # Raw probe output beneath outputs/ with an attempt-specific per-arm name
  # (evidence; covered by the pre-run overwrite guard), so no runtime
  # artifact is left in the experiment root.
  local TMP; TMP="${OUTDIR}/${EXPERIMENT_ID}_${PROBE_KEY}_${ATTEMPT_TAG}.envprobe"
  local PRC=0
  apptainer exec --nv \
    -B /opt/pbs:/opt/pbs \
    -B /var/spool/pbs:/var/spool/pbs \
    -B "$REPO_ROOT":"$REPO_ROOT" \
    "$SIF" \
    /usr/local/mpi/bin/mpirun -np "$NPROCS" \
      --hostfile "$MPI_HOSTFILE" \
      --mca plm_rsh_agent "$BRIDGE" \
      --mca plm_rsh_no_tree_spawn 1 \
      --mca plm_rsh_num_concurrent 1 \
      --mca routed direct \
      "${XARGS[@]}" \
      --bind-to none \
      bash -c 'echo "rank=${OMPI_COMM_WORLD_RANK}/${OMPI_COMM_WORLD_SIZE} host=$(hostname) local_rank=${OMPI_COMM_WORLD_LOCAL_RANK}/${OMPI_COMM_WORLD_LOCAL_SIZE} omp_num_threads=${OMP_NUM_THREADS:-UNSET} omp_places=${OMP_PLACES:-UNSET} omp_proc_bind=${OMP_PROC_BIND:-UNSET}"' \
    > "$TMP" 2>&1 || PRC=$?
  local LINES NT_OK PL_OK PB_OK
  LINES=$(grep -c '^rank=' "$TMP" || true)
  NT_OK=$(grep -cF " omp_num_threads=${OMP_T_FIXED} omp_places=" "$TMP" || true)
  PL_OK=$(grep -cF " omp_places=UNSET omp_proc_bind=" "$TMP" || true)
  PB_OK=$(grep -F " omp_proc_bind=UNSET" "$TMP" | grep -c '^rank=' || true)
  {
    echo "envprobe arm=${PROBE_KEY} start=$(date --iso-8601=seconds) rc=${PRC}"
    sed "s/^/arm=${PROBE_KEY} /" "$TMP"
  } >> "$ENVMAP_LOG"
  echo "=== env probe arm=${PROBE_KEY}: rc=${PRC} rank_lines=${LINES} omp_num_threads=${OMP_T_FIXED}_ok=${NT_OK} omp_places=UNSET_ok=${PL_OK} omp_proc_bind=UNSET_ok=${PB_OK} ==="
  if [ "$PRC" -ne 0 ] || [ "$LINES" -ne "$NPROCS" ] || [ "$NT_OK" -ne "$NPROCS" ] || [ "$PL_OK" -ne "$NPROCS" ] || [ "$PB_OK" -ne "$NPROCS" ]; then
    echo "FATAL: env probe for arm ${PROBE_KEY} failed its control-application check (rc=${PRC} rank_lines=${LINES}/${NPROCS} omp_num_threads=${OMP_T_FIXED}_ok=${NT_OK}/${NPROCS} omp_places=UNSET_ok=${PL_OK}/${NPROCS} omp_proc_bind=UNSET_ok=${PB_OK}/${NPROCS}); the retained TASK-009 host-runtime contract would not be effectively applied on all ranks, so the scored launch is aborted (TASK-2X8-011 Section 1.10; evidence preserved in ${ENVMAP_LOG}; rerun needs a new ATTEMPT_TAG)" >&2
    exit 1
  fi
}

# run_arm <key> <label> <mode> <anq> <buffer> <task_step>
# Runs one scored residency arm with the validated Approach-1 launch at the
# fixed controls. mode=fill passes "--fill-device 1 --fill-device-buffer-size
# <buffer>" (Anq-device omitted/overridden); mode=anq passes "--fill-device 0
# --Anq-device <anq>" (fill-device-buffer-size omitted -> installed default).
# The retained host-runtime environment is established first (explicit
# OMP_NUM_THREADS=4 re-export after the module/job environment,
# OMP_PLACES/OMP_PROC_BIND guaranteed unset), verified by the per-arm env
# probe, and then launched with the matching -x forwarding set. After the
# run the script extracts the score, LU/IR timing, iteration count, memory
# evidence, the verification verdict, and the application's echoed settings
# (verifying the task's fixed controls and the arm's residency controls),
# and writes the arm's .status file (TASK-2X8-011 Section 1.4). A NONZERO
# exit of the arm command is preserved evidence that STOPS the sweep: the
# .status file is written first, then the script records the abort and
# returns nonzero before any later arm of the authorized path is launched
# (no in-script retry; a rerun needs a new ATTEMPT_TAG plus human
# direction). An exit-0 arm with an invalid verification or a failed
# settings-echo check is preserved invalid/boundary evidence and the sweep
# continues with the next authorized arm; the arm is then not valid for
# promotion into any branch.
run_arm() {
  KEY="$1"; LABEL="$2"; ARM_MODE="$3"; ANQ_VAL="$4"; BUF_VAL="$5"; TASK_STEP="$6"
  ATTEMPT="${EXPERIMENT_ID}_${LABEL}_${ATTEMPT_TAG}"
  STDOUT_FILE="${OUTDIR}/${ATTEMPT}.out"
  STDERR_FILE="${OUTDIR}/${ATTEMPT}.err"
  STATUS_FILE="${OUTDIR}/${ATTEMPT}.status"

  # Establish the retained host-runtime environment (TASK-2X8-011 Section
  # 1.6A): explicitly re-export OMP_NUM_THREADS=4 after the module/job
  # environment, guarantee the placement-policy omission, and run the
  # control-application probe with the arm's exact -x set. On success the
  # probe leaves the shell environment in the verified state, which the
  # scored launch below inherits.
  run_env_probe "$KEY"

  # Effective OpenMP policy for the record: placement controls omitted, so
  # the installed launcher's package defaults are the effective policy
  # (captured v26.02 launcher: OMP_PROC_BIND=${OMP_PROC_BIND:-TRUE},
  # OMP_PLACES=${OMP_PLACES:-sockets}).
  EFF_PL="sockets (launcher package default)"; EFF_PB="TRUE (launcher package default)"
  ENV_XARGS=(-x PATH -x LD_LIBRARY_PATH -x OMP_NUM_THREADS)

  # Residency arguments: the ONLY scientific controls that vary between
  # arms (TASK-2X8-011 Sections 1.6B, 1.6C).
  if [ "$ARM_MODE" = "fill" ]; then
    RESIDENCY_ARGS=(--fill-device 1 --fill-device-buffer-size "$BUF_VAL")
    RESIDENCY_DESC="--fill-device 1 --fill-device-buffer-size ${BUF_VAL} (Anq-device omitted; --fill-device overrides --Anq-device per the v26.02 flag contract)"
  else
    RESIDENCY_ARGS=(--fill-device 0 --Anq-device "$ANQ_VAL")
    RESIDENCY_DESC="--fill-device 0 --Anq-device ${ANQ_VAL} (fill-device-buffer-size omitted -> installed package default)"
  fi

  START_TS="$(date --iso-8601=seconds)"
  echo "=== arm ${KEY} (${LABEL}) step=${TASK_STEP} attempt=${ATTEMPT} mode=${ARM_MODE} residency=\"${RESIDENCY_DESC}\" n=${N_FIXED} omp_num_threads=${OMP_T_FIXED} omp_places_supplied=omitted omp_proc_bind_supplied=omitted cpu_affinity=omitted start=${START_TS} ==="

  APP_ARGS=(--n "$N_FIXED" --nb "$NB_FIXED" --nprow "$NPROW" --npcol "$NPCOL" --nporder "$NPORDER")
  APP_ARGS+=(--gpu-affinity "$GPU_AFFINITY_FIXED")
  APP_ARGS+=(--sloppy-type FP16 --use-mpi-panel-broadcast 0 --use-separate-stream-for-gemm 1)
  APP_ARGS+=(--prioritize-trsm 0 --prioritize-factorization 0)
  APP_ARGS+=("${RESIDENCY_ARGS[@]}")
  APP_ARGS+=(--test-loop 1 --skip-tests 0 --monitor-gpu 0)

  RC=0
  apptainer exec --nv \
    -B /opt/pbs:/opt/pbs \
    -B /var/spool/pbs:/var/spool/pbs \
    -B "$REPO_ROOT":"$REPO_ROOT" \
    "$SIF" \
    /usr/local/mpi/bin/mpirun -np "$NPROCS" \
      --hostfile "$MPI_HOSTFILE" \
      --mca plm_rsh_agent "$BRIDGE" \
      --mca plm_rsh_no_tree_spawn 1 \
      --mca plm_rsh_num_concurrent 1 \
      --mca routed direct \
      "${ENV_XARGS[@]}" \
      --bind-to none \
      /workspace/hpl-mxp.sh "${APP_ARGS[@]}" \
    > "$STDOUT_FILE" 2> "$STDERR_FILE" || RC=$?

  END_TS="$(date --iso-8601=seconds)"

  # Extract the score, timing/iteration/memory evidence, and the verification
  # verdict (mechanical, TASK-2X8-011 Section 1.4 / APPLICATION.md
  # correctness criteria).
  SCORE="$(extract_gflops "$STDOUT_FILE")"
  LU_SECONDS="$(extract_lu_seconds "$STDOUT_FILE")"
  LU_GFLOPS="$(extract_lu_gflops "$STDOUT_FILE")"
  IR_SECONDS="$(extract_ir_seconds "$STDOUT_FILE")"
  SOLVER_ITERATIONS="$(count_solver_iterations "$STDOUT_FILE")"
  IR_LU_RATIO="$(ir_lu_ratio "${IR_SECONDS}" "${LU_SECONDS}")"
  HOST_MEM_LINE="$(capture_line "$STDOUT_FILE" 'Per process host memory consumption MAX =')"
  DEVICE_MEM_LINE="$(capture_line "$STDOUT_FILE" 'Per process device memory consumption MAX =')"
  MATGEN_HEADROOM_LINE="$(capture_line "$STDOUT_FILE" 'Per process memory available MIN system =')"
  HOST_CONS_GB="$(gb_value "$HOST_MEM_LINE")"
  DEVICE_CONS_GB="$(gb_value "$DEVICE_MEM_LINE")"
  WARN_OUT="$(warn_count "$STDOUT_FILE")"
  WARN_ERR="$(warn_count "$STDERR_FILE")"
  VERDICT="INVALID"
  RES_VAL=""
  RES_LINE="$(grep -F '||Ax-b||_oo / (EPS' "$STDOUT_FILE" 2>/dev/null | tail -n 1 || true)"
  if [ -n "$RES_LINE" ]; then
    case "$RES_LINE" in
      *PASSED*) VERDICT="PASSED" ;;
      *FAILED*) VERDICT="FAILED" ;;
    esac
    case "$RES_LINE" in
      *[Nn][Aa][Nn]*|*[Ii][Nn][Ff]*) VERDICT="INVALID_NONFINITE" ;;
    esac
    RES_VAL="$(printf '%s\n' "$RES_LINE" | sed -E 's/^.*= +([0-9][0-9.Ee+-]*).*$/\1/' || true)"
    if [ -z "$RES_VAL" ]; then VERDICT="INVALID"; fi
  fi
  if grep -Fq 'FAILED' "$STDOUT_FILE" 2>/dev/null; then VERDICT="FAILED"; fi
  if [ -z "$SCORE" ]; then VERDICT="INVALID_NO_SCORE"; fi
  if ! grep -Fq '****** Matrix Generation ******' "$STDOUT_FILE" 2>/dev/null; then VERDICT="INVALID_NO_MATGEN"; fi
  if ! grep -Fq 'LU seconds: AVG =' "$STDOUT_FILE" 2>/dev/null; then VERDICT="INVALID_NO_LU"; fi
  if [ "$RC" -ne 0 ]; then VERDICT="INVALID_EXIT_${RC}"; fi

  # Settings-echo verification (TASK-2X8-011 Sections 1.4 rule 4, 1.8 rule
  # 4): read the application's echoed settings block and verify every fixed
  # control and this arm's residency controls. --fill-device 1 must echo as
  # 1 (overriding the omitted/default Anq-device), partial arms must echo
  # --fill-device 0 with the requested Anq value, and full-fill arms must
  # echo the requested buffer. The default-equal controls
  # (u-panel-chunk-nbs 8, cuda-host-register-step 2048,
  # call-dgemv-with-multiple-threads 0, preset-gemm-kernel 90-effective)
  # are applied via the installed package defaults and verified here
  # against the task's fixed values. A mismatch is control-application
  # failure evidence: the arm is recorded but marked not valid for
  # promotion, and the mismatch is flagged in the carry-forward log.
  ECHO_N="$(extract_echo "$STDOUT_FILE" n)"
  ECHO_NB="$(extract_echo "$STDOUT_FILE" nb)"
  ECHO_NPROW="$(extract_echo "$STDOUT_FILE" nprow)"
  ECHO_NPCOL="$(extract_echo "$STDOUT_FILE" npcol)"
  ECHO_ORDER="$(extract_echo "$STDOUT_FILE" order)"
  ECHO_SLOPPY="$(extract_echo "$STDOUT_FILE" sloppy-type)"
  ECHO_UPANEL="$(extract_echo "$STDOUT_FILE" u-panel-chunk-nbs)"
  ECHO_DGEMV="$(extract_echo "$STDOUT_FILE" call-dgemv-with-multiple-threads)"
  ECHO_PTRSM="$(extract_echo "$STDOUT_FILE" prioritize-trsm)"
  ECHO_PFACT="$(extract_echo "$STDOUT_FILE" prioritize-factorization)"
  ECHO_SEPSTREAM="$(extract_echo "$STDOUT_FILE" use-separate-stream-for-gemm)"
  ECHO_BCAST="$(extract_echo "$STDOUT_FILE" use-mpi-panel-broadcast)"
  ECHO_KERNEL="$(extract_echo "$STDOUT_FILE" preset-gemm-kernel)"
  ECHO_REGSTEP="$(extract_echo "$STDOUT_FILE" cuda-host-register-step)"
  ECHO_TESTLOOP="$(extract_echo "$STDOUT_FILE" test-loop)"
  ECHO_SKIPTESTS="$(extract_echo "$STDOUT_FILE" skip-tests)"
  ECHO_MONITORGPU="$(extract_echo "$STDOUT_FILE" monitor-gpu)"
  ECHO_FILL="$(extract_echo "$STDOUT_FILE" fill-device)"
  ECHO_ANQ="$(extract_echo "$STDOUT_FILE" Anq-device)"
  ECHO_BUFFER="$(extract_echo "$STDOUT_FILE" fill-device-buffer-size)"
  SETTINGS_MISMATCH=""
  cmp_echo "$N_FIXED" "$ECHO_N" n
  cmp_echo "$NB_FIXED" "$ECHO_NB" nb
  cmp_echo "$NPROW" "$ECHO_NPROW" nprow
  cmp_echo "$NPCOL" "$ECHO_NPCOL" npcol
  cmp_echo "$NPORDER" "$ECHO_ORDER" order
  cmp_echo "FP16" "$ECHO_SLOPPY" sloppy-type
  cmp_echo "8" "$ECHO_UPANEL" u-panel-chunk-nbs
  cmp_echo "0" "$ECHO_DGEMV" call-dgemv-with-multiple-threads
  cmp_echo "0" "$ECHO_PTRSM" prioritize-trsm
  cmp_echo "0" "$ECHO_PFACT" prioritize-factorization
  cmp_echo "1" "$ECHO_SEPSTREAM" use-separate-stream-for-gemm
  cmp_echo "0" "$ECHO_BCAST" use-mpi-panel-broadcast
  cmp_echo "90" "$ECHO_KERNEL" preset-gemm-kernel
  cmp_echo "2048" "$ECHO_REGSTEP" cuda-host-register-step
  cmp_echo "1" "$ECHO_TESTLOOP" test-loop
  cmp_echo "0" "$ECHO_SKIPTESTS" skip-tests
  cmp_echo "0" "$ECHO_MONITORGPU" monitor-gpu
  if [ "$ARM_MODE" = "fill" ]; then
    cmp_echo "1" "$ECHO_FILL" fill-device
    cmp_echo "$BUF_VAL" "$ECHO_BUFFER" fill-device-buffer-size
    # Anq-device on a fill arm is overridden by --fill-device 1: the echo is
    # recorded as evidence only (Section 1.6B: "Anq-device is overridden;
    # record the effective echo only").
    ANQ_RECORDED="omitted(overridden;echo=${ECHO_ANQ:-missing})"
    BUFFER_RECORDED="$BUF_VAL"
  else
    cmp_echo "0" "$ECHO_FILL" fill-device
    cmp_echo "$ANQ_VAL" "$ECHO_ANQ" Anq-device
    # Buffer on a partial-residency arm stays at the installed default: the
    # echo is recorded as evidence only (Section 1.6B).
    ANQ_RECORDED="$ANQ_VAL"
    BUFFER_RECORDED="default(echo=${ECHO_BUFFER:-missing})"
  fi
  if [ -z "$SETTINGS_MISMATCH" ]; then
    SETTINGS_ECHO_CHECK="PASS"
    SETTINGS_OK=1
  else
    SETTINGS_ECHO_CHECK="FAIL: ${SETTINGS_MISMATCH}"
    SETTINGS_OK=0
  fi

  # Complete host/device memory evidence gate for branch promotion
  # (Section 1.6B rule 2 requires valid correctness/memory evidence).
  if [ -n "$HOST_MEM_LINE" ] && [ -n "$DEVICE_MEM_LINE" ]; then
    MEM_OK=1
  else
    MEM_OK=0
  fi

  ARM_SCORE["$KEY"]="$SCORE"
  ARM_EXIT["$KEY"]="$RC"
  ARM_RUN_VERDICT["$KEY"]="$VERDICT"
  ARM_SETTINGS_OK["$KEY"]="$SETTINGS_OK"
  ARM_LU_SECONDS["$KEY"]="$LU_SECONDS"
  ARM_LU_GFLOPS["$KEY"]="$LU_GFLOPS"
  ARM_IR_SECONDS["$KEY"]="$IR_SECONDS"
  ARM_IR_LU_RATIO["$KEY"]="$IR_LU_RATIO"
  ARM_ITERATIONS["$KEY"]="$SOLVER_ITERATIONS"
  ARM_RESIDUAL["$KEY"]="$RES_VAL"
  ARM_HOST_CONS["$KEY"]="$HOST_CONS_GB"
  ARM_DEVICE_CONS["$KEY"]="$DEVICE_CONS_GB"
  ARM_MEM_OK["$KEY"]="$MEM_OK"
  ARM_MODE["$KEY"]="$ARM_MODE"
  ARM_ANQ["$KEY"]="$ANQ_RECORDED"
  ARM_BUFFER["$KEY"]="$BUFFER_RECORDED"
  if [ "$VERDICT" = "PASSED" ] && [ "$SETTINGS_OK" -eq 1 ]; then
    ARM_VALID["$KEY"]="yes"
  else
    ARM_VALID["$KEY"]="no"
    INVALID_ARMS=$((INVALID_ARMS + 1))
  fi
  if [ "$RC" -ne 0 ]; then
    FAILURES=$((FAILURES + 1))
  fi
  ARMS_RUN=$((ARMS_RUN + 1))

  if [ "$RC" -ne 0 ]; then
    echo "=== arm ${KEY} (${LABEL}) FAILED exit_status=${RC} verdict=${VERDICT} settings_echo=${SETTINGS_ECHO_CHECK%%:*} end=${END_TS}; stopping the sweep before any later arm (status/evidence preserved) ==="
  else
    echo "=== arm ${KEY} (${LABEL}) exit_status=0 verdict=${VERDICT} settings_echo=${SETTINGS_ECHO_CHECK%%:*} gflops=${SCORE:-none} end=${END_TS} ==="
  fi
  {
    echo "attempt=${ATTEMPT}"
    echo "experiment_id=${EXPERIMENT_ID}"
    echo "task_id=TASK-2X8-011"
    echo "task_step=${TASK_STEP}"
    echo "step_arm=${KEY}"
    echo "arm_label=${LABEL}"
    echo "arm_mode=${ARM_MODE}"
    echo "residency_controls=${RESIDENCY_DESC}"
    echo "pbs_job_id=${PBS_JOBID:-unknown}"
    echo "queue=${QUEUE}"
    echo "nodes=$(sort -u "$PBS_NODEFILE" | paste -sd' ')"
    echo "n=${N_FIXED}"
    echo "nb=${NB_FIXED}"
    echo "nprow=${NPROW}"
    echo "npcol=${NPCOL}"
    echo "nporder=${NPORDER}"
    echo "omp_num_threads=${OMP_T_FIXED}"
    echo "omp_num_threads_supplied_by=explicit job-shell export after module setup + mpirun -x OMP_NUM_THREADS (effective on all 16 ranks; verified by the per-arm env probe, see ${ENVMAP_LOG})"
    echo "omp_places_supplied=omitted"
    echo "omp_proc_bind_supplied=omitted"
    echo "omp_places_effective=${EFF_PL}"
    echo "omp_proc_bind_effective=${EFF_PB}"
    echo "gpu_affinity=${GPU_AFFINITY_FIXED}"
    echo "mem_affinity=omitted"
    echo "cpu_affinity=omitted"
    echo "ucx_affinity=omitted"
    echo "rank_node_mapping=allocation-level rank-map log ${RANKMAP_LOG} (16 rank lines; per-host local-rank-0 topology reports)"
    echo "fill_device_requested=$( [ "$ARM_MODE" = "fill" ] && echo 1 || echo 0 )"
    echo "fill_device_echo=${ECHO_FILL:-missing}"
    echo "anq_device_requested=${ANQ_RECORDED}"
    echo "anq_device_echo=${ECHO_ANQ:-missing}"
    echo "fill_device_buffer_size_requested=${BUFFER_RECORDED}"
    echo "fill_device_buffer_size_echo=${ECHO_BUFFER:-missing}"
    echo "settings_echo_n=${ECHO_N:-missing}"
    echo "settings_echo_nb=${ECHO_NB:-missing}"
    echo "settings_echo_nprow=${ECHO_NPROW:-missing}"
    echo "settings_echo_npcol=${ECHO_NPCOL:-missing}"
    echo "settings_echo_order=${ECHO_ORDER:-missing}"
    echo "settings_echo_sloppy_type=${ECHO_SLOPPY:-missing}"
    echo "settings_echo_u_panel_chunk_nbs=${ECHO_UPANEL:-missing}"
    echo "settings_echo_call_dgemv_with_multiple_threads=${ECHO_DGEMV:-missing}"
    echo "settings_echo_prioritize_trsm=${ECHO_PTRSM:-missing}"
    echo "settings_echo_prioritize_factorization=${ECHO_PFACT:-missing}"
    echo "settings_echo_use_separate_stream_for_gemm=${ECHO_SEPSTREAM:-missing}"
    echo "settings_echo_use_mpi_panel_broadcast=${ECHO_BCAST:-missing}"
    echo "settings_echo_preset_gemm_kernel=${ECHO_KERNEL:-missing} (effective value; flag omitted, CLI accepts only {0,80})"
    echo "settings_echo_cuda_host_register_step=${ECHO_REGSTEP:-missing}"
    echo "settings_echo_test_loop=${ECHO_TESTLOOP:-missing}"
    echo "settings_echo_skip_tests=${ECHO_SKIPTESTS:-missing}"
    echo "settings_echo_monitor_gpu=${ECHO_MONITORGPU:-missing}"
    echo "settings_echo_check=${SETTINGS_ECHO_CHECK}"
    echo "fixed_controls=--n ${N_FIXED} --nb ${NB_FIXED} --nprow ${NPROW} --npcol ${NPCOL} --nporder ${NPORDER} --gpu-affinity ${GPU_AFFINITY_FIXED} --cpu-affinity omitted --mem-affinity omitted --ucx-affinity omitted --sloppy-type FP16 --use-mpi-panel-broadcast 0 --u-panel-chunk-nbs 8(package default; echoed) --use-separate-stream-for-gemm 1 --prioritize-trsm 0 --prioritize-factorization 0 --cuda-host-register-step 2048(package default; echoed) --call-dgemv-with-multiple-threads 0(package default; echoed) --preset-gemm-kernel 90(effective via package default; CLI {0,80} only; echoed) --test-loop 1 --skip-tests 0 --monitor-gpu 0 OMP_NUM_THREADS=${OMP_T_FIXED} OMP_PLACES=omitted OMP_PROC_BIND=omitted"
    echo "allocated_cpuset=${CPUSET}"
    echo "start=${START_TS}"
    echo "end=${END_TS}"
    echo "exit_status=${RC}"
    echo "gflops=${SCORE:-unknown}"
    echo "lu_seconds=${LU_SECONDS:-unknown}"
    echo "lu_gflops=${LU_GFLOPS:-unknown}"
    echo "ir_seconds=${IR_SECONDS:-unknown}"
    echo "solver_iterations=${SOLVER_ITERATIONS:-unknown}"
    echo "ir_lu_ratio=${IR_LU_RATIO:-unknown}"
    echo "host_memory=${HOST_MEM_LINE:-unknown}"
    echo "host_memory_consumption_max_gb=${HOST_CONS_GB:-unknown}"
    echo "device_memory=${DEVICE_MEM_LINE:-unknown}"
    echo "device_memory_consumption_max_gb=${DEVICE_CONS_GB:-unknown}"
    echo "matgen_headroom=${MATGEN_HEADROOM_LINE:-unknown}"
    echo "warning_marker_lines_out=${WARN_OUT}"
    echo "warning_marker_lines_err=${WARN_ERR}"
    echo "verification=${VERDICT}"
    echo "normalized_residual=${RES_VAL:-unknown}"
    echo "valid_for_branch_promotion=${ARM_VALID["$KEY"]}"
    echo "stdout=${STDOUT_FILE}"
    echo "stderr=${STDERR_FILE}"
  } > "$STATUS_FILE"

  # Nonzero arm exit (operational review fix): the arm's .status file above
  # is fully written before this point, so its status/evidence - and the
  # PBS-level .o/.e - remain; now STOP the sweep before any later arm of
  # the authorized path is launched and return nonzero immediately. No
  # in-script retry: a rerun needs a new ATTEMPT_TAG plus human direction
  # (error classification per workflow/05 from the preserved evidence).
  # Exit-0 scientific-correctness failures keep the approved behavior
  # above: preserved invalid/boundary evidence, sweep continues per the
  # task rules, never promoted or repeated.
  if [ "$RC" -ne 0 ]; then
    cflog "SWEEP_ABORTED_AFTER_NONZERO_ARM_EXIT: arm ${KEY} (${LABEL}) exit_status=${RC} run_verdict=${VERDICT} settings_echo=${SETTINGS_ECHO_CHECK%%:*}; status/evidence preserved (${STATUS_FILE}); stopping before any later arm of the authorized path is launched; no in-script retry; a rerun needs a new ATTEMPT_TAG plus human direction"
    echo "arms_run=${ARMS_RUN} arms_exited_nonzero=${FAILURES} arms_invalid=${INVALID_ARMS} branch_outcome=NONE (sweep aborted at arm ${KEY})"
    echo "FATAL: arm ${KEY} (${LABEL}) exited nonzero (rc=${RC}); its .status/.out/.err evidence is preserved (${STATUS_FILE}); stopping the PBS sweep before any later arm (no automatic retry; rerun with a new ATTEMPT_TAG after human review)" >&2
    exit 1
  fi
}

# log_arm_facts <key>
# Appends one factual per-arm record line to the carry-forward log (no
# percentages, no ranking, no interpretation).
log_arm_facts() {
  local K="$1"
  local S_OK="FAIL"
  if [ "${ARM_SETTINGS_OK[$K]:-0}" = "1" ]; then S_OK="PASS"; fi
  cflog "arm ${K}: mode=${ARM_MODE[$K]:-?} anq=${ARM_ANQ[$K]:-unknown} buffer=${ARM_BUFFER[$K]:-unknown} score=${ARM_SCORE[$K]:-none} run_verdict=${ARM_RUN_VERDICT[$K]:-unknown} settings_echo=${S_OK} valid=${ARM_VALID[$K]:-no} exit=${ARM_EXIT[$K]:-unknown} lu_seconds=${ARM_LU_SECONDS[$K]:-unknown} lu_gflops=${ARM_LU_GFLOPS[$K]:-unknown} ir_seconds=${ARM_IR_SECONDS[$K]:-unknown} ir_lu_ratio=${ARM_IR_LU_RATIO[$K]:-unknown} iterations=${ARM_ITERATIONS[$K]:-unknown} residual=${ARM_RESIDUAL[$K]:-unknown} host_cons_gb=${ARM_HOST_CONS[$K]:-unknown} device_cons_gb=${ARM_DEVICE_CONS[$K]:-unknown} mem_evidence_complete=${ARM_MEM_OK[$K]:-0}"
}

# --- Stage A: residency curve (TASK-2X8-011 Section 1.6B) ------------------------
# Exactly the approved arm order F0, A0, A1, A2, A3, A4, F1, once each, under
# the retained TASK-009/TASK-010 stack. Only the residency controls vary.
cflog "=== Stage A: residency curve (TASK-2X8-011 Section 1.6B; order F0,A0,A1,A2,A3,A4,F1; one scored attempt each; only the FP64 residency controls vary; fixed N=429056 NB=3072 4x4 row, retained host-runtime contract) ==="
run_arm stagea-f0 stagea-f0 fill - "$FILL_BUFFER_CONTROL" stagea
log_arm_facts stagea-f0
run_arm stagea-a0 stagea-a0 anq 0 default stagea
log_arm_facts stagea-a0
run_arm stagea-a1 stagea-a1 anq 24576 default stagea
log_arm_facts stagea-a1
run_arm stagea-a2 stagea-a2 anq 49152 default stagea
log_arm_facts stagea-a2
run_arm stagea-a3 stagea-a3 anq 73728 default stagea
log_arm_facts stagea-a3
run_arm stagea-a4 stagea-a4 anq 98304 default stagea
log_arm_facts stagea-a4
run_arm stagea-f1 stagea-f1 fill - "$FILL_BUFFER_CONTROL" stagea
log_arm_facts stagea-f1

# --- Stage-A control-stability rule (TASK-2X8-011 Section 1.6B) ------------------
# Factual only: F0/F1 validity, score spread, and the conservative regime
# proxy are recorded; the pre-authorized F2 allowance is applied at most
# once; the mechanical full-fill reference is established or the scientific
# branch stops and the evidence is handed back.
F0_KEY=stagea-f0
F1_KEY=stagea-f1
STABILITY=""
FULL_FILL_REF=""
BRANCH_OUTCOME=""

if [ "${ARM_VALID[$F0_KEY]:-no}" != "yes" ] || [ "${ARM_VALID[$F1_KEY]:-no}" != "yes" ]; then
  cflog "STOP_BRANCH: full-fill control invalid (F0 valid=${ARM_VALID[$F0_KEY]:-no} run_verdict=${ARM_RUN_VERDICT[$F0_KEY]:-unknown} settings_echo=${ARM_SETTINGS_OK[$F0_KEY]:-unknown}, F1 valid=${ARM_VALID[$F1_KEY]:-no} run_verdict=${ARM_RUN_VERDICT[$F1_KEY]:-unknown} settings_echo=${ARM_SETTINGS_OK[$F1_KEY]:-unknown}); the Stage-A full-fill bracket cannot be established, so no bounded branch can run (TASK-2X8-011 Sections 1.6B stability rule, 1.10 stop conditions; F2 is authorized only for the >2.0% score-inconsistency path); evidence preserved and handed back"
  BRANCH_OUTCOME="STOP_FULL_FILL_CONTROL_INVALID"
else
  SCORE_F0="${ARM_SCORE[$F0_KEY]}"
  SCORE_F1="${ARM_SCORE[$F1_KEY]}"
  IR_F0="${ARM_IR_SECONDS[$F0_KEY]:-}"
  HOST_F0="${ARM_HOST_CONS[$F0_KEY]:-}"
  IR_F1="${ARM_IR_SECONDS[$F1_KEY]:-}"
  HOST_F1="${ARM_HOST_CONS[$F1_KEY]:-}"
  SPREAD_OK=1
  le2pct_spread "$SCORE_F0" "$SCORE_F1" || SPREAD_OK=0
  REGIME_OK=1
  regime_consistent "$IR_F0" "$HOST_F0" "$IR_F1" "$HOST_F1" || REGIME_OK=0
  cflog "stageA full-fill bracket F0/F1: score=${SCORE_F0}/${SCORE_F1} ir_seconds=${IR_F0:-unknown}/${IR_F1:-unknown} host_cons_gb=${HOST_F0:-unknown}/${HOST_F1:-unknown} spread_le_2pct=${SPREAD_OK} regime_proxy_consistent=${REGIME_OK} (thresholds: spread = max <= min*1.02; regime proxy = both valid, IR within 2x, host consumption within 10x, all numeric - conservative mechanical proxy for the task's qualitative LU/IR/memory-regime clause, raw values recorded here for review)"
  if [ "$SPREAD_OK" -eq 1 ] && [ "$REGIME_OK" -eq 1 ]; then
    FULL_FILL_REF="$(median_score "$SCORE_F0" "$SCORE_F1")"
    STABILITY="STABLE"
    cflog "stageA stability=STABLE (F0/F1 within 2.0% with consistent regime); full-fill reference=${FULL_FILL_REF} (two-control median = mean of the F0/F1 scores)"
  elif [ "$SPREAD_OK" -eq 0 ]; then
    # Single authorized F2 allowance (TASK-2X8-011 Section 1.6B).
    cflog "stageA F0/F1 differ by >2.0% in end-to-end score; running the single authorized additional full-fill control F2 at 3048 MB (TASK-2X8-011 Section 1.6B; at most one F2; no other additions)"
    run_arm stagea-f2 stagea-f2 fill - "$FILL_BUFFER_CONTROL" stagea
    log_arm_facts stagea-f2
    if [ "${ARM_VALID[stagea-f2]:-no}" != "yes" ]; then
      cflog "STOP_BRANCH: full-fill controls remain inconsistent after the single authorized F2 (F2 invalid: run_verdict=${ARM_RUN_VERDICT[stagea-f2]:-unknown} settings_echo=${ARM_SETTINGS_OK[stagea-f2]:-unknown}); evidence preserved and handed back (TASK-2X8-011 Sections 1.6B, 1.10; no expansion of the sweep)"
      BRANCH_OUTCOME="STOP_FULL_FILL_CONTROLS_INCONSISTENT_AFTER_F2"
    else
      SCORE_F2="${ARM_SCORE[stagea-f2]}"
      IR_F2="${ARM_IR_SECONDS[stagea-f2]:-}"
      HOST_F2="${ARM_HOST_CONS[stagea-f2]:-}"
      SPREAD3_OK=1
      printf '%s\n%s\n%s\n' "$SCORE_F0" "$SCORE_F1" "$SCORE_F2" | le2pct_spread_n || SPREAD3_OK=0
      R01=1; regime_consistent "$IR_F0" "$HOST_F0" "$IR_F1" "$HOST_F1" || R01=0
      R02=1; regime_consistent "$IR_F0" "$HOST_F0" "$IR_F2" "$HOST_F2" || R02=0
      R12=1; regime_consistent "$IR_F1" "$HOST_F1" "$IR_F2" "$HOST_F2" || R12=0
      cflog "stageA three-control check after F2: scores=${SCORE_F0}/${SCORE_F1}/${SCORE_F2} spread_le_2pct=${SPREAD3_OK} regime_proxy F0-F1=${R01} F0-F2=${R02} F1-F2=${R12}"
      if [ "$SPREAD3_OK" -eq 1 ] && [ "$R01" -eq 1 ] && [ "$R02" -eq 1 ] && [ "$R12" -eq 1 ]; then
        FULL_FILL_REF="$(median_score "$SCORE_F0" "$SCORE_F1" "$SCORE_F2")"
        STABILITY="COHERENT"
        cflog "stageA stability=COHERENT (F2 restores a coherent bracket); full-fill reference=${FULL_FILL_REF} (median of the F0/F1/F2 scores)"
      else
        cflog "STOP_BRANCH: full-fill controls remain inconsistent after the single authorized F2 (three-control spread_le_2pct=${SPREAD3_OK} or regime proxy inconsistent); evidence preserved and handed back (TASK-2X8-011 Sections 1.6B, 1.10; do not expand the sweep)"
        BRANCH_OUTCOME="STOP_FULL_FILL_CONTROLS_INCONSISTENT_AFTER_F2"
      fi
    fi
  else
    cflog "STOP_BRANCH: F0/F1 scores are within 2.0% but the regime proxy is inconsistent (IR/host-memory behavior differs materially between the controls); the qualitative LU/IR/memory-regime clause of the stability rule cannot be certified, so no bounded branch runs (TASK-2X8-011 Sections 1.6B, 1.10); evidence preserved and handed back"
    BRANCH_OUTCOME="STOP_FULL_FILL_CONTROLS_REGIME_INCONSISTENT"
  fi
fi

# --- Stage-A bounded branch / conditional arms (TASK-2X8-011 Sections 1.6B, 1.6C) -
# Mechanical carry-forward only; no strategic interpretation. Runs only when
# a stable or coherent full-fill reference exists.
if [ -n "$STABILITY" ]; then
  # Best (highest-scoring) valid partial-residency A-arm; exact score ties
  # resolve to the lowest Anq value (deterministic first-wins scan).
  BEST_KEY=""
  BEST_SCORE=""
  BEST_ANQ=""
  for I in 0 1 2 3 4; do
    KEY="stagea-a${I}"
    if [ "${ARM_VALID[$KEY]:-no}" = "yes" ]; then
      if [ -z "$BEST_KEY" ] || gt_num "${ARM_SCORE[$KEY]}" "$BEST_SCORE"; then
        BEST_KEY="$KEY"; BEST_SCORE="${ARM_SCORE[$KEY]}"; BEST_ANQ="${ANQ_VALUES[$I]}"
      fi
    fi
  done
  if [ -z "$BEST_KEY" ]; then
    cflog "stageA factual note: no valid partial-residency A-arm exists; every A-arm is boundary evidence (never promoted or repeated for performance; TASK-2X8-011 Section 1.6B rule 4)"
  else
    cflog "stageA best partial-residency arm: ${BEST_KEY} (Anq=${BEST_ANQ}) score=${BEST_SCORE} mem_evidence_complete=${ARM_MEM_OK[$BEST_KEY]:-0}"
  fi

  PROMOTE=0
  if [ -n "$BEST_KEY" ]; then
    if [ "${ARM_MEM_OK[$BEST_KEY]:-0}" -eq 1 ]; then
      if gt2pct "$BEST_SCORE" "$FULL_FILL_REF"; then
        PROMOTE=1
      fi
    else
      cflog "stageA factual anomaly: best partial arm ${BEST_KEY} lacks complete host/device memory evidence; not promotable into the confirmation branch (TASK-2X8-011 Section 1.6B rule 2 requires valid correctness/memory evidence)"
    fi
  fi

  if [ "$PROMOTE" -eq 1 ]; then
    # Bounded confirmation pair, then stop (TASK-2X8-011 Section 1.6B rule
    # 2): repeat the selected partial-residency arm once, then repeat the
    # full-fill 3048 MB control once. No other arms; no Stage B.
    cflog "stageA branch: best partial-residency arm ${BEST_KEY} (Anq=${BEST_ANQ}, score=${BEST_SCORE}) is strictly >2.0% above the full-fill reference ${FULL_FILL_REF} with valid correctness/memory evidence; skipping Stage B and running the single authorized confirmation pair (repeat ${BEST_KEY} once, repeat the full-fill 3048 MB control once), then STOP (TASK-2X8-011 Section 1.6B rule 2)"
    run_arm "conf-anq${BEST_ANQ}" "conf-anq${BEST_ANQ}" anq "$BEST_ANQ" default conf
    log_arm_facts "conf-anq${BEST_ANQ}"
    run_arm conf-fill3048 conf-fill3048 fill - "$FILL_BUFFER_CONTROL" conf
    log_arm_facts conf-fill3048
    BRANCH_OUTCOME="CONFIRMATION_PAIR_RUN_THEN_STOP"
    cflog "confirmation pair complete; TASK-2X8-011 stops after the confirmation branch (Section 1.6B rule 2); no promotion decision is made here - the final residency conclusion is reserved for the Strategic Analyst via ANALYSE_RESULTS (Sections 1.4, 1.11)"
  else
    # Full fill must remain within the <=2.0% leading region to proceed to
    # Stage B (Section 1.6C precondition; Section 1.6B rule 3).
    LEADER_KEY=""
    LEADER_SCORE=""
    for KEY in "${!ARM_VALID[@]}"; do
      if [ "${ARM_VALID[$KEY]}" = "yes" ]; then
        if [ -z "$LEADER_KEY" ] || gt_num "${ARM_SCORE[$KEY]}" "$LEADER_SCORE"; then
          LEADER_KEY="$KEY"; LEADER_SCORE="${ARM_SCORE[$KEY]}"
        fi
      fi
    done
    WITHIN_LEADING=0
    if [ -n "$LEADER_KEY" ]; then
      if within2pct "$FULL_FILL_REF" "$LEADER_SCORE"; then
        WITHIN_LEADING=1
      fi
    fi
    cflog "stageA leader: ${LEADER_KEY:-none} score=${LEADER_SCORE:-none}; full-fill reference=${FULL_FILL_REF}; full_fill_within_2pct_leading_region=${WITHIN_LEADING} (within leading = reference >= leader score * 0.98)"
    if [ "$WITHIN_LEADING" -eq 1 ]; then
      # Stage B: full-fill buffer closure 2048/4096/3048, then stop
      # (TASK-2X8-011 Section 1.6C).
      cflog "stageA branch: full fill remains within the <=2.0% leading region; running the conditional Stage-B full-fill buffer closure B0=2048, B1=4096, B2=3048 (final 3048 control repeat), then STOP (TASK-2X8-011 Section 1.6C; never below 2048; no other buffer values; Stage B never reopens Anq-device, N, NB, grid/order, or host runtime)"
      run_arm stageb-b0 stageb-b0 fill - 2048 stageb
      log_arm_facts stageb-b0
      run_arm stageb-b1 stageb-b1 fill - 4096 stageb
      log_arm_facts stageb-b1
      run_arm stageb-b2 stageb-b2 fill - 3048 stageb
      log_arm_facts stageb-b2
      # Factual Stage-B outcome classification (no further arms in any
      # case; Sections 1.6C rules 3-5).
      B_ALL_VALID=1
      for KEY in stageb-b0 stageb-b1 stageb-b2; do
        if [ "${ARM_VALID[$KEY]:-no}" != "yes" ]; then
          B_ALL_VALID=0
        fi
      done
      if [ "$B_ALL_VALID" -eq 1 ]; then
        SPREAD_B_OK=1
        printf '%s\n%s\n%s\n' "${ARM_SCORE[stageb-b0]}" "${ARM_SCORE[stageb-b1]}" "${ARM_SCORE[stageb-b2]}" | le2pct_spread_n || SPREAD_B_OK=0
        B0_ABOVE=0
        if gt2pct "${ARM_SCORE[stageb-b0]}" "${ARM_SCORE[stageb-b2]}"; then B0_ABOVE=1; fi
        B1_ABOVE=0
        if gt2pct "${ARM_SCORE[stageb-b1]}" "${ARM_SCORE[stageb-b2]}"; then B1_ABOVE=1; fi
        cflog "stageB facts: B0/B1/B2 scores=${ARM_SCORE[stageb-b0]}/${ARM_SCORE[stageb-b1]}/${ARM_SCORE[stageb-b2]} spread_le_2pct=${SPREAD_B_OK} b0_gt2pct_above_b2=${B0_ABOVE} b1_gt2pct_above_b2=${B1_ABOVE} (reference for the >2.0% test is the in-stage 3048 MB control B2; F0/F1(/F2) provide the earlier 3048 MB controls recorded above)"
        if [ "$SPREAD_B_OK" -eq 1 ]; then
          cflog "stageB outcome=PLATEAU_PRESERVED (all three buffer arms valid and within 2.0%; TASK-2X8-011 Section 1.6C rule 4: stop and preserve the observed plateau)"
        elif [ "$B0_ABOVE" -eq 1 ] || [ "$B1_ABOVE" -eq 1 ]; then
          cflog "stageB outcome=DEVIATION_PRESERVED_NO_FURTHER_REFINEMENT (2048 or 4096 is strictly >2.0% above the in-stage 3048 control; preserved but the buffer is not refined further inside this task; TASK-2X8-011 Section 1.6C rule 5)"
        else
          cflog "stageB outcome=SPREAD_RECORDED_NO_FURTHER_REFINEMENT (spread >2.0% without a buffer arm strictly >2.0% above the in-stage 3048 control; preserved without further refinement; TASK-2X8-011 Sections 1.6C rules 4-5)"
        fi
      else
        for KEY in stageb-b0 stageb-b1 stageb-b2; do
          if [ "${ARM_VALID[$KEY]:-no}" != "yes" ]; then
            cflog "stageB boundary evidence: ${KEY} invalid (run_verdict=${ARM_RUN_VERDICT[$KEY]:-unknown} settings_echo=${ARM_SETTINGS_OK[$KEY]:-unknown} exit=${ARM_EXIT[$KEY]:-unknown}); a hard safety boundary, not a slow candidate (TASK-2X8-011 Section 1.6C rule 3)"
          fi
        done
        cflog "stageB outcome=BOUNDARY_EVIDENCE_PRESERVED_NO_FURTHER_RESERVE_SQUEEZE (at least one Stage-B buffer arm invalid; the reserve is not squeezed further; TASK-2X8-011 Section 1.6C rule 3)"
      fi
      BRANCH_OUTCOME="STAGE_B_RUN_THEN_STOP"
      cflog "stageB complete; TASK-2X8-011 stops after the Stage-B buffer closure (Section 1.6C); the final residency conclusion is reserved for the Strategic Analyst via ANALYSE_RESULTS (Sections 1.4, 1.11)"
    else
      BRANCH_OUTCOME="STOP_FULL_FILL_OUTSIDE_LEADING_REGION_NO_PROMOTABLE_PARTIAL_ARM"
      cflog "STOP_BRANCH: the full-fill reference is outside the <=2.0% leading region but no valid partial-residency arm is promotable (anomalous mechanical state); evidence preserved and handed back without expanding the sweep (TASK-2X8-011 Sections 1.6B, 1.10)"
    fi
  fi
fi

cflog "branch_outcome=${BRANCH_OUTCOME:-UNRECORDED} (mechanical carry-forward only; job exit status is unaffected by the branch outcome; the final strategic residency conclusion belongs to the post-task Strategic Analyst via ANALYSE_RESULTS)"
cflog "anti-loop state: every arm of this attempt ran at most once; no new Anq/buffer values, no intermediate points, no second refinement pass, and no automatic N reopen occurred (TASK-2X8-011 Sections 1.7, 1.10)"

# --- Post-sweep hardware-health snapshot (ordinary evidence; must not block) ------
echo "=== post-sweep hardware-health snapshot (mother node $(hostname)) ==="
nvidia-smi topo -m || echo "warn: nvidia-smi topo failed"
nvidia-smi --query-gpu=index,name,driver_version,temperature.gpu,power.draw,clocks.sm,memory.used,memory.total --format=csv || echo "warn: nvidia-smi query failed"

# --- Overall sweep result ----------------------------------------------------------
# Factual per-arm recap only (no percentages versus the campaign baseline, no
# strategic residency decision; the stability-rule/branch outcomes are
# recorded in the carry-forward log and the final residency conclusion is
# reserved for the post-task Strategic Analyst via ANALYSE_RESULTS,
# TASK-2X8-011 Sections 1.4, 1.11). Nonzero overall if any arm was invalid
# (exit 0 with a missing PASSED verification, a FAILED/non-finite residual,
# or a failed settings-echo check); those arms remain preserved
# invalid/boundary evidence and later arms of the authorized path were
# still attempted. A nonzero arm command exit cannot reach this point: it
# stops the sweep and returns nonzero immediately from run_arm (after its
# .status file is written), so the FAILURES term below is defensive only.
# The branch outcome does NOT affect this exit status; STOP_AFTER_*,
# confirmation, and Stage-B outcomes are all normal authorized outcomes.
# Do not classify success from exit status alone; the per-arm .status
# files and .out verification markers are the validity record.
echo "=== sweep recap (factual scores only; stability-rule/branch outcomes recorded in the carry-forward log; interpretation reserved for ANALYSE_RESULTS) ==="
echo "arms_run=${ARMS_RUN} arms_exited_nonzero=${FAILURES} arms_invalid=${INVALID_ARMS} branch_outcome=${BRANCH_OUTCOME:-UNRECORDED}"
for KEY in "${!ARM_SCORE[@]}"; do
  echo "arm=${KEY} mode=${ARM_MODE[$KEY]:-?} anq=${ARM_ANQ[$KEY]:-unknown} buffer=${ARM_BUFFER[$KEY]:-unknown} gflops=${ARM_SCORE[$KEY]:-none} valid=${ARM_VALID[$KEY]:-no} exit=${ARM_EXIT[$KEY]:-unknown}"
done
if [ "$FAILURES" -ne 0 ] || [ "$INVALID_ARMS" -ne 0 ]; then
  echo "=== HPL-MxP 2x8-GAAS phase3c-residency-closure sweep finished with ${FAILURES} arm(s) exited nonzero and ${INVALID_ARMS} invalid arm(s) of ${ARMS_RUN} run (tag ${ATTEMPT_TAG}); invalid arms are preserved boundary/control evidence ==="
  exit 1
fi
echo "=== HPL-MxP 2x8-GAAS phase3c-residency-closure sweep complete: all ${ARMS_RUN} run arm(s) exited 0 with PASSED verification and PASS settings echo (tag ${ATTEMPT_TAG}) ==="
