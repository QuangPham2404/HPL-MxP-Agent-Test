#!/bin/bash
# Parametrized HPL-MxP CPU/memory affinity sweep on GAAS.
# Expected working directory: this experiment directory
# (experiments/affinity-sweep/) on GAAS. Submit with qsub -v
# 'ATTEMPT=<label>[,CPU_AFFINITY=<ranges>][,MEM_AFFINITY=<nodes>]' plus -o/-e for
# the attempt-specific PBS stdout/stderr under outputs/.
# Inputs: ATTEMPT (output stem); optional CPU_AFFINITY and MEM_AFFINITY colon
# lists; if a list is empty or "none" the corresponding flag is omitted. Fixed
# matrix size N=491520, block size NB=3072, 2x4 row grid, gpu-affinity
# 0:1:2:3:4:5:6:7 (the current best from 2026-08-24). Outputs: attempt-specific
# PBS stdout and stderr under outputs/. Assumptions: the approved container and
# required modules exist on GAAS; one GPU per MPI process (8 processes, 8 GPUs).

#PBS -N hpl_mxp_aff_sweep
#PBS -q gpu_as
#PBS -P hpc_admin
#PBS -l select=1:ngpus=8
#PBS -l walltime=00:45:00

set -euo pipefail

# Enter the experiment directory and print reproducibility metadata.
cd "$PBS_O_WORKDIR"
echo "experiment_id=affinity-sweep"
echo "attempt=${ATTEMPT:-unknown}"
echo "n=491520"
echo "nb=3072"
echo "nprow=2"
echo "npcol=4"
echo "nporder=row"
echo "gpu_affinity=0:1:2:3:4:5:6:7"
echo "cpu_affinity=${CPU_AFFINITY:-<none>}"
echo "mem_affinity=${MEM_AFFINITY:-<none>}"
echo "pbs_job_id=${PBS_JOBID:-unknown}"
echo "submitted_workdir=$PWD"
date --iso-8601=seconds
hostname

# Load the exact minimal module environment validated for GAAS.
module purge
module load apptainer/1.4.1
module load nvhpc/26.3
module load squashfuse/0.5.2
module load gocryptfs/2.5.0

# Record the allocated GPU topology before launching the container workload.
nvidia-smi topo -m

# Build optional affinity flags; omit a flag when its variable is unset/"none".
AFF_ARGS=()
if [[ -n "${CPU_AFFINITY:-}" && "${CPU_AFFINITY}" != "none" ]]; then
    AFF_ARGS+=(--cpu-affinity "${CPU_AFFINITY}")
fi
if [[ -n "${MEM_AFFINITY:-}" && "${MEM_AFFINITY}" != "none" ]]; then
    AFF_ARGS+=(--mem-affinity "${MEM_AFFINITY}")
fi

# Execute HPL-MxP with fixed workload and the requested (optional) affinity.
# --skip-tests is set per project convention; GPU monitoring flags are included
# for bottleneck evidence.
apptainer exec --nv "/home/pham0094/hpl_hpcg_hplmxp_container/hpc-benchmarks_26.02.sif" \
  mpirun -np 8 \
    --bind-to none \
    /workspace/hpl-mxp.sh \
      --gpu-affinity 0:1:2:3:4:5:6:7 \
      --nprow 2 \
      --npcol 4 \
      --nporder row \
      --n 491520 \
      --nb 3072 \
      --skip-tests 1 \
      --monitor-gpu 1 \
      --monitor-gpu-interval 10 \
      --monitor-gpu-pcie-width-warning 16 \
      --monitor-gpu-pcie-gen-warning 5 \
      "${AFF_ARGS[@]}"