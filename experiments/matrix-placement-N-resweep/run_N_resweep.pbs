#!/bin/bash
# Parametrized HPL-MxP N re-sweep with --fill-device 1 on GAAS.
# Expected working directory: this experiment directory
# (experiments/matrix-placement-N-resweep/) on GAAS. Submit with qsub -v
# 'ATTEMPT=<label>,N=<n>' plus -o/-e for the attempt-specific PBS
# stdout/stderr under outputs/.
#
# Hypothesis: the iterative-solver stage (~39% of runtime at N=491520) is the
# dominant bottleneck, and at N=491520 the FP64 matrix (~241 GB/GPU) does not
# fit in the H200's ~141 GB VRAM, so part of it stays host-resident and the
# iterative refinement keeps paying staging costs. Lowering N to full
# residency may cut the solver stage enough to net a GFLOPS gain despite the
# lost N^3 work.
#
# Fixed config (from matrix-placement-control 491k_fill_on / omp-sweep best):
#   --fill-device 1, buffer + register-step left at launcher defaults (3048 /
#   2048), NB=3072, 2x4 row grid, gpu-affinity 0:1:2:3:4:5:6:7,
#   no --cpu-affinity / --mem-affinity,
#   OMP_NUM_THREADS=8, OMP_PLACES=sockets, OMP_PROC_BIND=TRUE.
# Swept variable: N (multiples of 1024).
# Outputs: attempt-specific PBS stdout and stderr under outputs/.
# Assumptions: the approved container and required modules exist on GAAS; one
# GPU per MPI process (8 processes, 8 GPUs); OMP env vars forwarded via `mpirun -x`.

#PBS -N hpl_mxp_N_resweep
#PBS -q gpu_as
#PBS -P hpc_admin
#PBS -l select=1:ngpus=8
#PBS -l walltime=00:45:00

set -euo pipefail

N="${N:-491520}"

# Enter the experiment directory and print reproducibility metadata.
cd "$PBS_O_WORKDIR"
echo "experiment_id=matrix-placement-N-resweep"
echo "attempt=${ATTEMPT:-unknown}"
echo "n=${N}"
echo "nb=3072"
echo "nprow=2"
echo "npcol=4"
echo "nporder=row"
echo "gpu_affinity=0:1:2:3:4:5:6:7"
echo "fill_device=1"
echo "fill_device_buffer_size=3048"
echo "cuda_host_register_step=default"
echo "pbs_job_id=${PBS_JOBID:-unknown}"
echo "submitted_workdir=$PWD"
date --iso-8601=seconds
hostname

# Load the exact minimal module environment validated for GAAS.
module purge
module load apptainer/1.4.1
module load nvhpc/26.3
module load squashfuse/0.5.2
module load gocryptfs/2.5.0

# PBS clobbers OMP_NUM_THREADS with the allocated core count (96), so re-export
# the fixed host-thread configuration after `module purge`.
export OMP_NUM_THREADS=8
export OMP_PLACES=sockets
export OMP_PROC_BIND=TRUE

echo "omp_num_threads=${OMP_NUM_THREADS:-unset}"
echo "omp_places=${OMP_PLACES:-unset}"
echo "omp_proc_bind=${OMP_PROC_BIND:-unset}"

# Record the allocated GPU topology before launching the container workload.
nvidia-smi topo -m

# Execute HPL-MxP with --fill-device 1 and default buffer/register-step, sweeping N.
apptainer exec --nv "/home/pham0094/hpl_hpcg_hplmxp_container/hpc-benchmarks_26.02.sif" \
  mpirun -np 8 \
    --bind-to none \
    -x OMP_NUM_THREADS \
    -x OMP_PLACES \
    -x OMP_PROC_BIND \
    /workspace/hpl-mxp.sh \
      --gpu-affinity 0:1:2:3:4:5:6:7 \
      --nprow 2 \
      --npcol 4 \
      --nporder row \
      --n "${N}" \
      --nb 3072 \
      --fill-device 1 \
      --skip-tests 1 \
      --monitor-gpu 1 \
      --monitor-gpu-interval 10 \
      --monitor-gpu-pcie-width-warning 16 \
      --monitor-gpu-pcie-gen-warning 5