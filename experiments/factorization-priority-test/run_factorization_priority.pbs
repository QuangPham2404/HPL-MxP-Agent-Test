# Dependency-priority sweep at N=491520 (factorization-priority-test).
# Expected working directory: this experiment directory
# (experiments/factorization-priority-test/) on GAAS. Submit with
# `qsub run_factorization_priority.pbs` (no -v args needed).
#
# A single node-matched job loops over the four combinations of the two
# dependency-priority flags, bracketed by the default (0,0) control.
#
# Study objective: observe how the LU-scheduling priorities change end-to-end
# GFLOP/s at the fixed best configuration (NOT an optimum search).
#
# Swept variables: --prioritize-trsm <0|1> x --prioritize-factorization <0|1>.
# Fixed config (best previous run, buffer + register-step 2048):
#   N=491520, NB=3072, 2x4 row grid, gpu-affinity 0:1:2:3:4:5:6:7,
#   no --cpu-affinity / --mem-affinity,
#   OMP_NUM_THREADS=8, OMP_PLACES=sockets, OMP_PROC_BIND=TRUE,
#   --fill-device 1 --fill-device-buffer-size 2048 --cuda-host-register-step 2048,
#   --skip-tests 1 + GPU monitoring flags.
#   --use-mpi-panel-broadcast and --u-panel-chunk-nbs are OMITTED so the
#   package defaults (50 and 8) apply.
# Outputs: attempt-specific stdout/stderr under outputs/.
# Assumptions: the approved container and required modules exist on GAAS; one
# GPU per MPI process (8 processes, 8 GPUs); OMP env vars forwarded via
# `mpirun -x`.

#PBS -N hpl_mxp_fp_sweep
#PBS -q gpu_as
#PBS -P hpc_admin
#PBS -l select=1:ngpus=8
#PBS -l walltime=02:00:00
#PBS -o outputs/hpl_mxp_fp_sweep.o
#PBS -e outputs/hpl_mxp_fp_sweep.e

set -euo pipefail

cd "$PBS_O_WORKDIR"

# Load the exact minimal module environment validated for GAAS.
module purge
module load apptainer/1.4.1
module load nvhpc/26.3
module load squashfuse/0.5.2
module load gocryptfs/2.5.0

# PBS clobbers OMP_NUM_THREADS with the allocated core count (96), so re-export
# the fixed host-thread configuration after `module purge`.
export OMP_NUM_THREADS=8
export OMP_PLACES=sockets
export OMP_PROC_BIND=TRUE

mkdir -p outputs

# Sweep sequence: the four combinations of the two dependency-priority flags,
# bracketed by an initial default (0,0) control. Labels encode trsm/factorization.
SWEEP_TRSM=(0 0 1 1)
SWEEP_FACT=(0 1 0 1)
SWEEP_LABEL=(fp_0_0 fp_0_1 fp_1_0 fp_1_1)

run_one() {
  local trsm="$1" fact="$2" label="$3"
  local out="outputs/${label}.o" err="outputs/${label}.e"
  {
    echo "experiment_id=factorization-priority-test"
    echo "attempt=${label}"
    echo "n=491520"
    echo "nb=3072"
    echo "nprow=2"
    echo "npcol=4"
    echo "nporder=row"
    echo "gpu_affinity=0:1:2:3:4:5:6:7"
    echo "fill_device=1"
    echo "fill_device_buffer_size=2048"
    echo "cuda_host_register_step=2048"
    echo "prioritize_trsm=${trsm}"
    echo "prioritize_factorization=${fact}"
    echo "pbs_job_id=${PBS_JOBID:-unknown}"
    echo "submitted_workdir=$PWD"
    date --iso-8601=seconds
    hostname
    echo "omp_num_threads=${OMP_NUM_THREADS:-unset}"
    echo "omp_places=${OMP_PLACES:-unset}"
    echo "omp_proc_bind=${OMP_PROC_BIND:-unset}"
    nvidia-smi topo -m
    apptainer exec --nv "/home/pham0094/hpl_hpcg_hplmxp_container/hpc-benchmarks_26.02.sif" \
      mpirun -np 8 \
        --bind-to none \
        -x OMP_NUM_THREADS \
        -x OMP_PLACES \
        -x OMP_PROC_BIND \
        /workspace/hpl-mxp.sh \
          --gpu-affinity 0:1:2:3:4:5:6:7 \
          --nprow 2 \
          --npcol 4 \
          --nporder row \
          --n 491520 \
          --nb 3072 \
          --fill-device 1 \
          --fill-device-buffer-size 2048 \
          --cuda-host-register-step 2048 \
          --prioritize-trsm "${trsm}" \
          --prioritize-factorization "${fact}" \
          --skip-tests 1 \
          --monitor-gpu 1 \
          --monitor-gpu-interval 10 \
          --monitor-gpu-pcie-width-warning 16 \
          --monitor-gpu-pcie-gen-warning 5
  } > "${out}" 2> "${err}"
}

for i in "${!SWEEP_TRSM[@]}"; do
  echo "[$(date --iso-8601=seconds)] running ${SWEEP_LABEL[$i]} trsm=${SWEEP_TRSM[$i]} factorization=${SWEEP_FACT[$i]}"
  run_one "${SWEEP_TRSM[$i]}" "${SWEEP_FACT[$i]}" "${SWEEP_LABEL[$i]}"
done

echo "factorization-priority-test complete."